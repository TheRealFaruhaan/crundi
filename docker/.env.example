# Copy to docker/.env and fill in. Compose reads this automatically.

# Required — Crundi will not start without these.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
ALLOWED_USERNAME=your_telegram_username

# Where your repositories live on the host. Mounted read-write at /projects.
PROJECTS_DIR=/home/you/code

# Optional — publish the server through a Cloudflare tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_URL=

# ─── Sign-in ───
# Optional. Leave both blank to set a password from the first-run screen instead.
# Generate with: docker compose exec crundi node scripts/make-login.mjs 'a long password'
CRUNDI_PASSWORD_HASH=
CRUNDI_TOTP_SECRET=

# ─── HTTPS ───
# Leave off behind the Cloudflare tunnel or any TLS-terminating proxy.
#   letsencrypt  obtained and renewed automatically (needs ports 80 and 443)
#   provided     your own files, managed by you
TLS_MODE=off
TLS_DOMAIN=
TLS_EMAIL=
# Keep this at 1 until you have confirmed DNS and ports work — real issuance is
# rate-limited sharply.
TLS_STAGING=1
TLS_CERT_PATH=
TLS_KEY_PATH=
