# onnxruntime-node's install script also downloads its CUDA (GPU) build on
# Linux. That download now 404s, which fails the install, and npm then drops
# the (optional) package without a word, so the client packages shipped no
# voice runtime. Crundi uses the CPU runtime only (build/electron-builder-
# client.yml), so the CUDA download is skipped. (Docker and install.sh set
# npm_config_onnxruntime_node_install_cuda=skip the same way.)
onnxruntime-node-install-cuda=skip
