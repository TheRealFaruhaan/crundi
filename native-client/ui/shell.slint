// The PC client's frame, as the web UI draws it (src/webapp-html.js): the top
// bar, the projects sidebar and the tab bar. Sizes and colours are the web
// UI's (measured from the running page).

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "widgets.slint";

export struct ProjectItem {
    alias: string,
    name: string,
    // needs-input | working | waiting | running | "" (the dot's colour)
    state: string,
}

/// The project dot, by the web UI's priority (renderProjects).
export global ProjectDot {
    public pure function color(state: string) -> color {
        return state == "needs-input" ? Theme.accent
            : state == "working" ? Theme.yellow
            : state == "waiting" ? Theme.sky
            : state == "running" ? Theme.green
            : Theme.text-muted;
    }
}

/// The top bar: 48px, logo / project, then Cru and the connection badge.
export component TopBar inherits Rectangle {
    in property <string> project-name;
    in property <bool> online;
    height: Theme.topbar-height;
    background: Theme.bg-secondary;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 9px;
            alignment: start;
            Image { source: @image-url("brand/head.svg"); width: 24px; height: 24px; y: (parent.height - self.height) / 2; }
            Image { source: @image-url("brand/wordmark.svg"); height: 15px; width: 60px; y: (parent.height - self.height) / 2; image-fit: contain; }
        }
        Text { text: "/"; color: Theme.text-muted; vertical-alignment: center; font-size: 14.4px; }
        Text { text: root.project-name == "" ? "No project" : root.project-name; color: Theme.text-secondary; vertical-alignment: center; font-size: 14.4px; }
        Rectangle { horizontal-stretch: 1; }
        // The connection badge: mono, a dot, green-dim when connected.
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 20px;
            width: badge.preferred-width + 20px;
            border-radius: 12px;
            background: root.online ? Theme.green-dim : Theme.red-dim;
            badge := HorizontalLayout {
                x: 10px;
                spacing: 6px;
                alignment: center;
                Rectangle { width: 6px; height: 6px; border-radius: 3px; y: (parent.height - self.height) / 2; background: root.online ? Theme.green : Theme.red; }
                Text { text: root.online ? "connected" : "offline"; color: root.online ? Theme.green : Theme.red; font-size: 12px; font-family: Theme.mono; vertical-alignment: center; }
            }
        }
    }
}

/// The sidebar: 240px. "PROJECTS", the list, then Add project and Inbox.
export component ProjectSidebar inherits Rectangle {
    in property <[ProjectItem]> projects;
    in property <string> current;
    callback select(string);
    width: Theme.sidebar-width;
    background: Theme.bg-secondary;
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }

    VerticalLayout {
        // Header: 49px, padding 12px 16px, a subtle line under it.
        Rectangle {
            height: 49px;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Text { text: "PROJECTS"; color: Theme.text-muted; font-size: 12px; font-weight: 600; letter-spacing: 0.6px; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle {
                    width: 24px; height: 24px; y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: ct.has-hover ? Theme.bg-hover : transparent;
                    Icon { source: Icons.chevrons-left; width: 14px; height: 14px; tint: Theme.text-muted; }
                    ct := TouchArea { mouse-cursor: pointer; }
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 1px;
                alignment: start;
                for p in root.projects: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: p.alias == root.current ? Theme.accent-dim : ta.has-hover ? Theme.bg-hover : transparent;
                    // The active row's gradient bar on the left.
                    if p.alias == root.current: Rectangle {
                        x: 0px; y: 7px; width: 3px; height: parent.height - 14px;
                        border-top-right-radius: 3px; border-bottom-right-radius: 3px;
                        background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent-hover 100%);
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Rectangle {
                            width: 8px; height: 8px; y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: ProjectDot.color(p.state);
                            // needs-input: a 3px ring
                            border-width: p.state == "needs-input" ? 0px : 0px;
                        }
                        Text {
                            text: p.name;
                            color: p.alias == root.current ? Theme.accent-hover : Theme.text-secondary;
                            font-size: 14.08px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    ta := TouchArea { mouse-cursor: pointer; clicked => { root.select(p.alias); } }
                }
            }
        }
        // Footer: padding 8, a subtle line above.
        Rectangle {
            height: footer.preferred-height;
            Rectangle { height: 1px; background: Theme.border-subtle; }
            footer := VerticalLayout {
                padding: 8px;
                spacing: 8px;
                Rectangle {
                    height: 34px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: ap.has-hover ? Theme.accent : Theme.border;
                    background: ap.has-hover ? Theme.accent-dim : transparent;
                    Text { text: "+ Add project"; color: ap.has-hover ? Theme.accent-hover : Theme.text-muted; font-size: 13.6px; }
                    ap := TouchArea { mouse-cursor: pointer; }
                }
                Rectangle {
                    height: 34px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    background: ib.has-hover ? Theme.bg-hover : transparent;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Icon { source: Icons.mail; width: 15px; height: 15px; y: (parent.height - self.height) / 2; tint: Theme.text-muted; }
                        Text { text: "Inbox"; color: Theme.text-muted; font-size: 13.6px; vertical-alignment: center; }
                    }
                    ib := TouchArea { mouse-cursor: pointer; }
                }
            }
        }
    }
}

export struct TabItem {
    id: string,
    label: string,
    icon: image,
}

/// The tab bar: 36px. Workbench, its "+", the other tabs, and Browser on the right.
export component TabBar inherits Rectangle {
    in property <[TabItem]> tabs;
    in property <string> current;
    in property <bool> drawer-open;
    in property <bool> drawer-has-tabs;
    callback select(string);
    callback add-menu();
    callback toggle-browser();
    height: 36px;
    background: Theme.bg-secondary;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        // The tabs scroll sideways when they do not fit (the web UI hides the
        // scrollbar); they never widen the window.
        Flickable {
            horizontal-stretch: 1;
            content-width: tabrow.preferred-width;
            tabrow := HorizontalLayout {
        for t[i] in root.tabs: HorizontalLayout {
            Rectangle {
                width: tab.preferred-width + 28px;
                height: 35px;
                tab := HorizontalLayout {
                    x: 14px;
                    spacing: 6px;
                    Icon { source: t.icon; width: 15px; height: 15px; y: (parent.height - self.height) / 2; tint: t.id == root.current ? Theme.accent-hover : th.has-hover ? Theme.text-secondary : Theme.text-muted; }
                    Text { text: t.label; color: t.id == root.current ? Theme.accent-hover : th.has-hover ? Theme.text-secondary : Theme.text-muted; font-size: 13.12px; font-weight: 500; vertical-alignment: center; }
                }
                // The active tab's 2px gradient underline, inset 12px.
                if t.id == root.current: Rectangle {
                    x: 12px; y: parent.height - 2px; width: parent.width - 24px; height: 2px;
                    border-top-left-radius: 2px; border-top-right-radius: 2px;
                    background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent-hover 100%);
                }
                th := TouchArea { mouse-cursor: pointer; clicked => { root.select(t.id); } }
            }
            // The "+" right after Workbench.
            if i == 0: Rectangle {
                width: 30px;
                Rectangle {
                    width: 24px; height: 24px;
                    border-radius: 6px;
                    background: pl.has-hover ? Theme.accent : Theme.bg-tertiary;
                    border-width: 1px;
                    border-color: pl.has-hover ? Theme.accent : Theme.border;
                    Icon { source: Icons.plus; width: 14px; height: 14px; tint: pl.has-hover ? white : Theme.text-secondary; }
                    pl := TouchArea { mouse-cursor: pointer; clicked => { root.add-menu(); } }
                }
            }
        }
            }
        }
        // Browser, pinned right; gone while the drawer is open.
        if !root.drawer-open: Rectangle {
            width: bl.preferred-width + 28px;
            bl := HorizontalLayout {
                x: 14px;
                spacing: 6px;
                Icon { source: Icons.globe; width: 15px; height: 15px; y: (parent.height - self.height) / 2; tint: bh.has-hover ? Theme.text-secondary : Theme.text-muted; }
                Text { text: "Browser"; color: bh.has-hover ? Theme.text-secondary : Theme.text-muted; font-size: 13.12px; font-weight: 500; vertical-alignment: center; }
            }
            // Pages still open behind a hidden drawer: a 7px accent dot.
            if root.drawer-has-tabs: Rectangle {
                x: parent.width - 14px; y: 9px; width: 11px; height: 11px; border-radius: 5.5px;
                background: Theme.bg-secondary;
                Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: Theme.accent; }
            }
            bh := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-browser(); } }
        }
    }
}
