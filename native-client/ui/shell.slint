// The PC client's frame, as the web UI draws it (src/webapp-html.js): the top
// bar, the projects sidebar and the tab bar. Every size, gap and colour here
// is measured from the running web page (getComputedStyle).

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "widgets.slint";

export struct ProjectItem {
    alias: string,
    name: string,
    // Two letters for the folded sidebar's avatar.
    initials: string,
    // needs-input | working | waiting | running | "" (the dot's colour)
    state: string,
}

/// The project dot, by the web UI's priority (renderProjects).
export global ProjectDot {
    public pure function color(state: string) -> color {
        return state == "needs-input" ? Theme.accent
            : state == "working" ? Theme.yellow
            : state == "waiting" ? Theme.sky
            : state == "running" ? Theme.green
            : Theme.text-muted;
    }
}

/// A 1px dashed outline (CSS "1px dashed"): 3px dashes, 3px gaps.
export component Dashed inherits Rectangle {
    in property <color> line: Theme.border;
    for i in ceil(self.width / 6px): Rectangle { x: i * 6px; y: 0px; width: min(3px, root.width - i * 6px); height: 1px; background: root.line; }
    for i in ceil(self.width / 6px): Rectangle { x: i * 6px; y: root.height - 1px; width: min(3px, root.width - i * 6px); height: 1px; background: root.line; }
    for i in ceil(self.height / 6px): Rectangle { x: 0px; y: i * 6px; width: 1px; height: min(3px, root.height - i * 6px); background: root.line; }
    for i in ceil(self.height / 6px): Rectangle { x: root.width - 1px; y: i * 6px; width: 1px; height: min(3px, root.height - i * 6px); background: root.line; }
}

/// One row of the usage bars behind the top bar (the web UI's .urow).
component UsageRow inherits Rectangle {
    in property <float> used;
    in property <float> passed;
    in property <string> tag;
    in property <string> left;
    // Time behind usage: how much of the window has passed.
    Rectangle { x: 0px; width: parent.width * root.passed / 100; background: #7daaff29; }
    Rectangle { x: 0px; width: parent.width * root.used / 100; background: #6366f138; }
    Text {
        x: parent.width * root.used / 100 + 6px; y: 1px;
        text: root.tag + " " + round(root.used) + "%";
        font-size: 8.96px; font-weight: 700; color: Theme.text-primary;
    }
    HorizontalLayout {
        x: parent.width * root.passed / 100 + 6px; y: 12px;
        height: 10px;
        spacing: 3px;
        opacity: 0.7;
        Icon { source: Icons.clock; width: 8px; height: 8px; y: 1px; tint: Theme.text-secondary; }
        Text { text: root.left; font-size: 8.96px; font-weight: 700; color: Theme.text-secondary; vertical-alignment: center; }
    }
}

/// A window button (36×28): minimise, maximise, close (red on hover).
component WinBtn inherits Rectangle {
    in property <int> kind;
    callback clicked();
    width: 36px;
    height: 28px;
    border-radius: 6px;
    background: ta.has-hover ? (root.kind == 2 ? #ef4444 : Theme.bg-hover) : transparent;
    if root.kind == 0: Rectangle { width: 10px; height: 1px; background: ta.has-hover ? Theme.text-primary : Theme.text-secondary; }
    if root.kind == 1: Rectangle { width: 9px; height: 9px; border-width: 1px; border-color: ta.has-hover ? Theme.text-primary : Theme.text-secondary; }
    if root.kind == 2: Icon { source: Icons.x; width: 13px; height: 13px; tint: ta.has-hover ? white : Theme.text-secondary; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

/// The top bar: 48px. Usage bars behind; logo / project; the usage age, Cru,
/// the connection badge and the window buttons on the right.
export component TopBar inherits Rectangle {
    in property <string> project-name;
    in property <bool> online;
    in property <bool> usage-on;
    in property <float> wk-used;
    in property <float> wk-time;
    in property <string> wk-left;
    in property <float> fh-used;
    in property <float> fh-time;
    in property <string> fh-left;
    in property <string> usage-age;
    callback drag();
    callback minimize();
    callback maximize();
    callback close();
    height: Theme.topbar-height;
    background: Theme.bg-secondary;

    // Dragging the bar moves the window; a double click maximises it.
    TouchArea {
        pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.drag(); } }
        double-clicked => { root.maximize(); }
    }
    if root.usage-on: Rectangle {
        height: 47px;
        UsageRow { y: 0px; height: 23px; used: root.wk-used; passed: root.wk-time; tag: "wk"; left: root.wk-left; }
        Rectangle { y: 23px; height: 1px; background: #ffffff0d; }
        UsageRow { y: 24px; height: 23px; used: root.fh-used; passed: root.fh-time; tag: "5h"; left: root.fh-left; }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 9px;
            Image { source: @image-url("brand/head.svg"); width: 24px; height: 24px; y: 12px; }
            Image { source: @image-url("brand/wordmark.svg"); width: 60px; height: 15px; y: 16px; image-fit: contain; }
        }
        Text { text: "/"; color: Theme.text-muted; vertical-alignment: center; font-size: 14.4px; }
        Text { text: root.project-name == "" ? "No project" : root.project-name; color: Theme.text-secondary; vertical-alignment: center; font-size: 14.4px; }
        Rectangle { horizontal-stretch: 1; }
        // How old the usage numbers are.
        if root.usage-on && root.usage-age != "": Rectangle {
            y: 14px; height: 20px;
            width: age.preferred-width + 20px;
            border-radius: 12px;
            background: Theme.slate-dim;
            age := HorizontalLayout {
                x: 10px;
                spacing: 6px;
                Icon { source: Icons.bar-chart; width: 12px; height: 12px; y: 4px; tint: Theme.text-secondary; }
                Text { text: root.usage-age; font-family: Theme.mono; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
            }
        }
        // Cru's mark (the voice assistant; it opens in a later phase).
        Rectangle {
            y: 10px; width: 44px; height: 28px;
            border-radius: 99px;
            Image { source: @image-url("brand/cru.svg"); width: 40px; height: 24px; }
        }
        // The connection badge: 3px 10px, a 6px dot (with its ring) and a 6px gap, mono 12px.
        Rectangle {
            y: 14px;
            height: 20px;
            width: badge.preferred-width + 20px;
            border-radius: 12px;
            background: root.online ? Theme.green-dim : Theme.red-dim;
            badge := HorizontalLayout {
                x: 10px;
                spacing: 6px;
                Rectangle {
                    width: 6px; height: 6px; y: 7px;
                    // The pulsing ring, at rest.
                    Rectangle { width: 13px; height: 13px; border-radius: 6.5px; background: root.online ? #10b98134 : #ef444434; }
                    Rectangle { border-radius: 3px; background: root.online ? Theme.green : Theme.red; }
                }
                Text { text: root.online ? "connected" : "disconnected"; color: root.online ? Theme.green : Theme.red; font-size: 12px; font-family: Theme.mono; vertical-alignment: center; }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            WinBtn { y: 10px; kind: 0; clicked => { root.minimize(); } }
            WinBtn { y: 10px; kind: 1; clicked => { root.maximize(); } }
            WinBtn { y: 10px; kind: 2; clicked => { root.close(); } }
        }
    }
}

/// The sidebar: 240px (60px folded). "PROJECTS" and the fold button; the
/// projects; Add project (dashed) and Inbox.
export component ProjectSidebar inherits Rectangle {
    in property <[ProjectItem]> projects;
    in property <string> current;
    in property <int> inbox-unread;
    in-out property <bool> folded;
    callback select(string);
    width: root.folded ? 60px : Theme.sidebar-width;
    background: Theme.bg-secondary;
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }

    VerticalLayout {
        width: parent.width - 1px;
        // Header: 49px, padding 12px 16px, a subtle line under it.
        Rectangle {
            height: 49px;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
            if !root.folded: Text { x: 16px; y: 17px; text: "PROJECTS"; color: Theme.text-muted; font-size: 12px; font-weight: 600; letter-spacing: 0.6px; }
            Rectangle {
                x: root.folded ? (parent.width - 24px) / 2 : 199px; y: 12px;
                width: 24px; height: 24px;
                border-radius: 6px;
                background: ct.has-hover ? Theme.bg-hover : transparent;
                Icon { source: root.folded ? Icons.chevron-right : Icons.chevrons-left; width: 14px; height: 14px; tint: ct.has-hover ? Theme.text-primary : Theme.text-muted; }
                ct := TouchArea { mouse-cursor: pointer; clicked => { root.folded = !root.folded; } }
            }
        }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 2px;
                alignment: start;
                for p in root.projects: Rectangle {
                    height: root.folded ? 46px : 32px;
                    // Folded: a 38px round avatar with the project's initials
                    // (.proj-initials). Its state wins over the active look:
                    // running a green edge, working a yellow edge and glow,
                    // needs input an accent edge and glow; waiting draws as
                    // nothing running (the web has no rule for it).
                    if root.folded: av := Rectangle {
                        property <bool> active: p.alias == root.current;
                        property <string> st: p.state == "waiting" ? "" : p.state;
                        width: 38px; height: 38px;
                        // The glows (0 0 10px -2px yellow, 0 0 12px -2px accent;
                        // the active look's own) in soft rings.
                        for l in [{ e: 2px, a: 0.28 }, { e: 4px, a: 0.14 }, { e: 6px, a: 0.06 }]: Rectangle {
                            visible: parent.st == "working" || parent.st == "needs-input" || (parent.active && parent.st == "");
                            x: -l.e; y: -l.e; width: 38px + 2 * l.e; height: 38px + 2 * l.e; border-radius: 19px + l.e;
                            background: (parent.st == "working" ? Theme.yellow : Theme.accent).with-alpha(l.a);
                        }
                        // The active look's 1px ring (0 0 0 1px accent), none or running.
                        if self.active && (self.st == "" || self.st == "running"): Rectangle { x: -1px; y: -1px; width: 40px; height: 40px; border-radius: 20px; background: Theme.accent; }
                        Rectangle {
                            border-radius: 19px;
                            background: parent.active ? @linear-gradient(135deg, Theme.accent 0%, Theme.accent-hover 100%) : Theme.bg-tertiary;
                            border-width: 1px;
                            border-color: parent.st == "running" ? Theme.green : parent.st == "working" ? Theme.yellow
                                : parent.st == "needs-input" || parent.active || ta.has-hover ? Theme.accent : Theme.border;
                            Text {
                                text: p.initials; font-family: Theme.mono; font-size: 11.84px; font-weight: 700; letter-spacing: 0.3552px;
                                color: av.st == "running" || av.st == "working" ? Theme.text-primary
                                    : av.st == "needs-input" || av.active ? white
                                    : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                overflow: elide; width: 26px; horizontal-alignment: center;
                            }
                        }
                    }
                    if !root.folded: Rectangle {
                        border-radius: 6px;
                        background: p.alias == root.current ? Theme.accent-dim : ta.has-hover ? Theme.bg-hover : transparent;
                        // The active row's gradient bar: 3px, inset 7px.
                        if p.alias == root.current: Rectangle {
                            x: 0px; y: 7px; width: 3px; height: parent.height - 14px;
                            border-top-right-radius: 3px; border-bottom-right-radius: 3px;
                            background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent-hover 100%);
                        }
                        // The dot: 8px at 12px; needs input, working and waiting wear
                        // a 3px ring. The active row with nothing running is green.
                        if p.state == "needs-input" || p.state == "working" || p.state == "waiting": Rectangle {
                            x: 9px; y: 9px; width: 14px; height: 14px; border-radius: 7px;
                            background: p.state == "needs-input" ? Theme.accent-dim : p.state == "working" ? Theme.yellow-dim : Theme.sky-ring;
                        }
                        Rectangle {
                            x: 12px; y: 12px; width: 8px; height: 8px; border-radius: 4px;
                            background: p.state == "" && p.alias == root.current ? Theme.green : ProjectDot.color(p.state);
                        }
                        Text {
                            x: 30px; width: parent.width - 42px;
                            text: p.name;
                            color: p.alias == root.current ? Theme.accent-hover : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                            font-size: 14.08px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    ta := TouchArea { mouse-cursor: pointer; clicked => { root.select(p.alias); } }
                }
            }
        }
        // Footer: padding 8, a subtle line above.
        Rectangle {
            height: 95px;
            Rectangle { height: 1px; background: Theme.border-subtle; }
            if !root.folded: Rectangle {
                x: 8px; y: 9px; width: parent.width - 16px; height: 34px;
                border-radius: 6px;
                background: ap.has-hover ? Theme.accent-dim : transparent;
                Dashed { line: ap.has-hover ? Theme.accent : Theme.border; }
                Text { text: "+ Add project"; color: ap.has-hover ? Theme.accent-hover : Theme.text-muted; font-size: 13.6px; }
                ap := TouchArea { mouse-cursor: pointer; }
            }
            Rectangle {
                x: 8px; y: root.inbox-unread > 0 ? 51px : 52px;
                width: parent.width - 16px; height: root.inbox-unread > 0 ? 36px : 34px;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.inbox-unread > 0 ? Theme.accent : Theme.border-subtle;
                background: ib.has-hover ? Theme.bg-hover : transparent;
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Icon { source: Icons.mail; width: 16px; height: 16px; y: (parent.height - 16px) / 2; tint: root.inbox-unread > 0 ? Theme.text-primary : Theme.text-muted; }
                    if !root.folded: Text { text: "Inbox"; color: root.inbox-unread > 0 ? Theme.text-primary : Theme.text-muted; font-size: 13.6px; vertical-alignment: center; }
                    if root.inbox-unread > 0: Rectangle {
                        y: (parent.height - 18px) / 2;
                        height: 18px; width: max(18px, ib-n.preferred-width + 10px);
                        border-radius: 9px;
                        background: Theme.accent;
                        ib-n := Text { text: root.inbox-unread > 99 ? "99+" : root.inbox-unread; color: white; font-size: 10.88px; font-weight: 700; }
                    }
                }
                ib := TouchArea { mouse-cursor: pointer; }
            }
        }
    }
}

export struct TabItem {
    id: string,
    label: string,
    icon: image,
}

/// The tab bar: 36px. Workbench, its "+", the other tabs, and Browser on the right.
export component TabBar inherits Rectangle {
    in property <[TabItem]> tabs;
    in property <string> current;
    in property <bool> drawer-open;
    in property <bool> drawer-has-tabs;
    callback select(string);
    callback add-menu();
    callback toggle-browser();
    height: 36px;
    background: Theme.bg-secondary;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        // The tabs scroll sideways when they do not fit; they never widen the window.
        Flickable {
            horizontal-stretch: 1;
            content-width: tabrow.preferred-width;
            tabrow := HorizontalLayout {
                for t[i] in root.tabs: HorizontalLayout {
                    // A tab: padding 10px 14px, gap 6, a 15px icon, 13.12px/500.
                    Rectangle {
                        width: tab.preferred-width + 28px;
                        height: 35px;
                        tab := HorizontalLayout {
                            x: 14px;
                            spacing: 6px;
                            Icon { source: t.icon; width: 15px; height: 15px; y: 10px; tint: t.id == root.current ? Theme.accent-hover : th.has-hover ? Theme.text-secondary : Theme.text-muted; }
                            Text { text: t.label; color: t.id == root.current ? Theme.accent-hover : th.has-hover ? Theme.text-secondary : Theme.text-muted; font-size: 13.12px; font-weight: 500; vertical-alignment: center; }
                        }
                        // The active tab's 2px gradient underline, inset 12px.
                        if t.id == root.current: Rectangle {
                            x: 12px; y: parent.height - 2px; width: parent.width - 24px; height: 2px;
                            border-top-left-radius: 2px; border-top-right-radius: 2px;
                            background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent-hover 100%);
                        }
                        th := TouchArea { mouse-cursor: pointer; clicked => { root.select(t.id); } }
                    }
                    // The "+": 24px, bg-tertiary, 1px border, radius 6, a 17px "+", 6px after it.
                    if i == 0: Rectangle {
                        width: 30px;
                        Rectangle {
                            x: 0px; y: 5.5px;
                            width: 24px; height: 24px;
                            border-radius: 6px;
                            background: pl.has-hover ? Theme.accent : Theme.bg-tertiary;
                            border-width: 1px;
                            border-color: pl.has-hover ? Theme.accent : Theme.border;
                            Text { text: "+"; font-size: 17px; color: pl.has-hover ? white : Theme.text-secondary; }
                            pl := TouchArea { mouse-cursor: pointer; clicked => { root.add-menu(); } }
                        }
                    }
                }
            }
        }
        // Browser, pinned right; gone while the drawer is open.
        if !root.drawer-open: Rectangle {
            width: bl.preferred-width + 28px;
            bl := HorizontalLayout {
                x: 14px;
                spacing: 6px;
                Icon { source: Icons.globe; width: 15px; height: 15px; y: 10px; tint: bh.has-hover ? Theme.text-secondary : Theme.text-muted; }
                Text { text: "Browser"; color: bh.has-hover ? Theme.text-secondary : Theme.text-muted; font-size: 13.12px; font-weight: 500; vertical-alignment: center; }
            }
            // Pages still open behind a hidden drawer: a 7px accent dot with a 2px ring.
            if root.drawer-has-tabs: Rectangle {
                x: parent.width - 14px; y: 8px; width: 11px; height: 11px; border-radius: 5.5px;
                background: Theme.bg-secondary;
                Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: Theme.accent; }
            }
            bh := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-browser(); } }
        }
    }
}
