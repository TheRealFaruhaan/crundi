// The PC client's frame, as the web UI draws it (src/webapp-html.js): the top
// bar, the projects sidebar and the tab bar. Every size, gap and colour here
// is measured from the running web page (getComputedStyle).

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, AccentFill, SoftShadow } from "widgets.slint";

export struct ProjectItem {
    alias: string,
    name: string,
    // Two letters for the folded sidebar's avatar.
    initials: string,
    // needs-input | working | waiting | running | "" (the dot's colour)
    state: string,
}

/// The project dot, by the web UI's priority (renderProjects).
export global ProjectDot {
    public pure function color(state: string) -> color {
        return state == "needs-input" ? Theme.accent
            : state == "working" ? Theme.yellow
            : state == "waiting" ? Theme.sky
            : state == "running" ? Theme.green
            : Theme.text-muted;
    }
}

/// A hairline dashed outline (CSS "1px dashed").
export component Dashed inherits Rectangle {
    in property <color> line: Theme.border;
    for i in ceil(self.width / Theme.sp-6): Rectangle { x: i * Theme.sp-6; y: 0px; width: min(Theme.sp-4, root.width - i * Theme.sp-6); height: 1px; background: root.line; }
    for i in ceil(self.width / Theme.sp-6): Rectangle { x: i * Theme.sp-6; y: root.height - 1px; width: min(Theme.sp-4, root.width - i * Theme.sp-6); height: 1px; background: root.line; }
    for i in ceil(self.height / Theme.sp-6): Rectangle { x: 0px; y: i * Theme.sp-6; width: 1px; height: min(Theme.sp-4, root.height - i * Theme.sp-6); background: root.line; }
    for i in ceil(self.height / Theme.sp-6): Rectangle { x: root.width - 1px; y: i * Theme.sp-6; width: 1px; height: min(Theme.sp-4, root.height - i * Theme.sp-6); background: root.line; }
}

/// One row of the usage bars behind the top bar (the web UI's .urow).
component UsageRow inherits Rectangle {
    in property <float> used;
    in property <float> passed;
    in property <string> tag;
    in property <string> left;
    // Time behind usage: how much of the window has passed.
    Rectangle { x: 0px; width: parent.width * root.passed / 100; background: Theme.usage-time; }
    Rectangle { x: 0px; width: parent.width * root.used / 100; background: Theme.usage-used; }
    Text {
        x: parent.width * root.used / 100 + Theme.sp-6; y: 1px;
        text: root.tag + " " + round(root.used) + "%";
        font-size: Theme.text-10; font-weight: Theme.w-bold; color: Theme.text-primary;
    }
    HorizontalLayout {
        x: parent.width * root.passed / 100 + Theme.sp-6; y: Theme.sp-12;
        height: Theme.sp-10;
        spacing: Theme.sp-4;
        opacity: Theme.o-usage;
        Icon { source: Icons.clock; width: Theme.sp-8; height: Theme.sp-8; y: 1px; tint: Theme.text-secondary; }
        Text { text: root.left; font-size: Theme.text-10; font-weight: Theme.w-bold; color: Theme.text-secondary; vertical-alignment: center; }
    }
}

/// A window button: minimise, maximise, close (red on hover).
component WinBtn inherits Rectangle {
    in property <int> kind;
    callback clicked();
    width: Theme.control-lg;
    height: Theme.control-sm;
    border-radius: Theme.r-control;
    background: ta.has-hover ? (root.kind == 2 ? Theme.red : Theme.bg-hover) : transparent;
    if root.kind == 0: Rectangle { width: Theme.sp-10; height: 1px; background: ta.has-hover ? Theme.text-primary : Theme.text-secondary; }
    if root.kind == 1: Rectangle { width: Theme.sp-10; height: Theme.sp-10; border-width: 1px; border-color: ta.has-hover ? Theme.text-primary : Theme.text-secondary; }
    if root.kind == 2: Icon { source: Icons.x; width: Theme.icon-md; height: Theme.icon-md; tint: ta.has-hover ? Theme.white : Theme.text-secondary; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

/// The top bar. Usage bars behind; logo / project; the usage age, Cru,
/// the connection badge and the window buttons on the right.
export component TopBar inherits Rectangle {
    in property <string> project-name;
    in property <bool> online;
    in property <bool> usage-on;
    in property <float> wk-used;
    in property <float> wk-time;
    in property <string> wk-left;
    in property <float> fh-used;
    in property <float> fh-time;
    in property <string> fh-left;
    in property <string> usage-age;
    callback drag();
    callback minimize();
    callback maximize();
    callback close();
    height: Theme.topbar-height;
    background: Theme.bg-secondary;

    // Dragging the bar moves the window; a double click maximises it.
    TouchArea {
        pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.drag(); } }
        double-clicked => { root.maximize(); }
    }
    if root.usage-on: Rectangle {
        height: Theme.sp-48;
        UsageRow { y: 0px; height: Theme.sp-24; used: root.wk-used; passed: root.wk-time; tag: "wk"; left: root.wk-left; }
        Rectangle { y: Theme.sp-24; height: 1px; background: Theme.hairline-light; }
        UsageRow { y: Theme.sp-24; height: Theme.sp-24; used: root.fh-used; passed: root.fh-time; tag: "5h"; left: root.fh-left; }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }

    HorizontalLayout {
        padding-left: Theme.sp-16;
        padding-right: Theme.sp-16;
        spacing: Theme.sp-12;
        HorizontalLayout {
            spacing: Theme.sp-10;
            Image { source: @image-url("brand/head.svg"); width: Theme.sp-24; height: Theme.sp-24; y: Theme.sp-12; }
            Image { source: @image-url("brand/wordmark.svg"); height: Theme.sp-16; width: self.height * self.source.width / self.source.height; y: Theme.sp-16; image-fit: contain; }
        }
        Text { text: "/"; color: Theme.text-muted; vertical-alignment: center; font-size: Theme.text-14; }
        Text { text: root.project-name == "" ? "No project" : root.project-name; color: Theme.text-secondary; vertical-alignment: center; font-size: Theme.text-14; }
        Rectangle { horizontal-stretch: 1; }
        // How old the usage numbers are.
        if root.usage-on && root.usage-age != "": Rectangle {
            y: Theme.sp-12; height: Theme.sp-20;
            width: age.preferred-width + Theme.sp-20;
            border-radius: Theme.r-bubble;
            background: Theme.slate-dim;
            age := HorizontalLayout {
                x: Theme.sp-10;
                spacing: Theme.sp-6;
                Icon { source: Icons.bar-chart; width: Theme.icon-sm; height: Theme.icon-sm; y: Theme.sp-4; tint: Theme.text-secondary; }
                Text { text: root.usage-age; font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-secondary; vertical-alignment: center; }
            }
        }
        // Cru's mark (the voice assistant; it opens in a later phase).
        Rectangle {
            y: Theme.sp-10; width: Theme.sp-40; height: Theme.control-sm;
            border-radius: Theme.r-pill;
            Image { source: @image-url("brand/cru.svg"); width: Theme.sp-40; height: Theme.sp-24; }
        }
        // The connection badge: a dot (with its ring), mono text.
        Rectangle {
            y: Theme.sp-12;
            height: Theme.sp-20;
            width: badge.preferred-width + Theme.sp-20;
            border-radius: Theme.r-bubble;
            background: root.online ? Theme.green-dim : Theme.red-dim;
            badge := HorizontalLayout {
                x: Theme.sp-10;
                spacing: Theme.sp-6;
                Rectangle {
                    width: Theme.sp-6; height: Theme.sp-6; y: Theme.sp-8;
                    // The pulsing ring, at rest.
                    Rectangle { width: Theme.sp-12; height: Theme.sp-12; border-radius: Theme.r-pill; background: root.online ? Theme.green-ring : Theme.red-ring; }
                    Rectangle { border-radius: Theme.r-chip; background: root.online ? Theme.green : Theme.red; }
                }
                Text { text: root.online ? "connected" : "disconnected"; color: root.online ? Theme.green : Theme.red; font-size: Theme.text-12; font-family: Theme.mono; vertical-alignment: center; }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            WinBtn { y: Theme.sp-10; kind: 0; clicked => { root.minimize(); } }
            WinBtn { y: Theme.sp-10; kind: 1; clicked => { root.maximize(); } }
            WinBtn { y: Theme.sp-10; kind: 2; clicked => { root.close(); } }
        }
    }
}

/// The sidebar (narrower folded). "PROJECTS" and the fold button; the
/// projects; Add project (dashed) and Inbox.
export component ProjectSidebar inherits Rectangle {
    in property <[ProjectItem]> projects;
    in property <string> current;
    in property <int> inbox-unread;
    in-out property <bool> folded;
    callback select(string);
    width: root.folded ? Theme.sidebar-folded : Theme.sidebar-width;
    background: Theme.bg-secondary;
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }

    VerticalLayout {
        width: parent.width - 1px;
        // Header: as tall as the top bar, a subtle line under it.
        Rectangle {
            height: Theme.topbar-height;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
            if !root.folded: Text { x: Theme.sp-16; y: Theme.sp-16; text: "PROJECTS"; color: Theme.text-muted; font-size: Theme.text-12; font-weight: Theme.w-semibold; letter-spacing: Theme.track-wide; }
            Rectangle {
                x: root.folded ? (parent.width - Theme.sp-24) / 2 : Theme.sidebar-width - Theme.sp-40; y: Theme.sp-12;
                width: Theme.sp-24; height: Theme.sp-24;
                border-radius: Theme.r-control;
                background: ct.has-hover ? Theme.bg-hover : transparent;
                Icon { source: root.folded ? Icons.chevrons-right : Icons.chevrons-left; width: Theme.icon-md; height: Theme.icon-md; tint: ct.has-hover ? Theme.text-primary : Theme.text-muted; }
                ct := TouchArea { mouse-cursor: pointer; clicked => { root.folded = !root.folded; } }
            }
        }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                padding-top: Theme.sp-4;
                padding-bottom: Theme.sp-4;
                padding-left: Theme.sp-8;
                padding-right: Theme.sp-8;
                spacing: Theme.sp-2;
                alignment: start;
                for p in root.projects: Rectangle {
                    height: root.folded ? Theme.sp-48 : Theme.sp-32;
                    // Folded: a round avatar with the project's initials
                    // (.proj-initials). Its state wins over the active look:
                    // running a green edge, working a yellow edge and glow,
                    // needs input an accent edge and glow; waiting draws as
                    // nothing running (the web has no rule for it).
                    if root.folded: av := Rectangle {
                        property <bool> active: p.alias == root.current;
                        property <string> st: p.state == "waiting" ? "" : p.state;
                        width: Theme.control-lg; height: Theme.control-lg;
                        // The glows (yellow working; accent needing input, or the
                        // active look's own), soft.
                        if av.st == "working" || av.st == "needs-input" || (av.active && av.st == ""): SoftShadow {
                            width: parent.width; height: parent.height; radius: parent.width / 2;
                            shadow: av.st == "working" ? Theme.glow-yellow : Theme.glow-accent;
                        }
                        // The active look's hairline ring, none or running.
                        if self.active && (self.st == "" || self.st == "running"): Rectangle { x: -1px; y: -1px; width: parent.width + Theme.sp-2; height: parent.height + Theme.sp-2; border-radius: Theme.r-pill; background: Theme.accent; }
                        // Active: the accent gradient as a circle (AccentFill), under the edge.
                        if self.active: AccentFill { round: true; width: parent.width; height: parent.height; }
                        Rectangle {
                            border-radius: Theme.r-pill;
                            background: parent.active ? transparent : Theme.bg-tertiary;
                            border-width: 1px;
                            border-color: parent.st == "running" ? Theme.green : parent.st == "working" ? Theme.yellow
                                : parent.st == "needs-input" || parent.active || ta.has-hover ? Theme.accent : Theme.border;
                            Text {
                                text: p.initials; font-family: Theme.mono; font-size: Theme.text-12; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide;
                                color: av.st == "running" || av.st == "working" ? Theme.text-primary
                                    : av.st == "needs-input" || av.active ? Theme.white
                                    : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                overflow: elide; width: Theme.sp-24; horizontal-alignment: center;
                            }
                        }
                    }
                    if !root.folded: Rectangle {
                        border-radius: Theme.r-control;
                        background: p.alias == root.current ? Theme.accent-dim : ta.has-hover ? Theme.bg-hover : transparent;
                        // The active row's gradient bar, inset from the row's ends.
                        if p.alias == root.current: Rectangle {
                            x: 0px; y: Theme.sp-8; width: Theme.sp-4; height: parent.height - Theme.sp-12;
                            border-top-right-radius: Theme.r-chip; border-bottom-right-radius: Theme.r-chip;
                            background: Theme.grad-accent;
                        }
                        // The dot; needs input, working and waiting wear
                        // a ring. The active row with nothing running is green.
                        if p.state == "needs-input" || p.state == "working" || p.state == "waiting": Rectangle {
                            x: Theme.sp-12 + (Theme.sp-8 - self.width) / 2; y: Theme.sp-12 + (Theme.sp-8 - self.height) / 2; width: Theme.sp-12; height: Theme.sp-12; border-radius: Theme.r-pill;
                            background: p.state == "needs-input" ? Theme.accent-dim : p.state == "working" ? Theme.yellow-dim : Theme.sky-ring;
                        }
                        Rectangle {
                            x: Theme.sp-12; y: Theme.sp-12; width: Theme.sp-8; height: Theme.sp-8; border-radius: Theme.r-pill;
                            background: p.state == "" && p.alias == root.current ? Theme.green : ProjectDot.color(p.state);
                        }
                        Text {
                            x: Theme.sp-32; width: parent.width - Theme.sp-40;
                            text: p.name;
                            color: p.alias == root.current ? Theme.accent-hover : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                            font-size: Theme.text-14;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    ta := TouchArea { mouse-cursor: pointer; clicked => { root.select(p.alias); } }
                }
            }
        }
        // Footer: a subtle line at its top, then Add project and Inbox.
        Rectangle { height: 1px; background: Theme.border-subtle; }
        VerticalLayout {
            padding-top: Theme.sp-10; padding-bottom: Theme.sp-10;
            padding-left: root.folded ? Theme.sp-6 : Theme.sp-8; padding-right: self.padding-left;
            spacing: Theme.sp-8;
            // Add project: a dashed box; folded, just its "+" (the web's rail
            // keeps it, above Inbox).
            Rectangle {
                height: Theme.control;
                border-radius: Theme.r-control;
                background: ap.has-hover ? Theme.accent-dim : transparent;
                Dashed { line: ap.has-hover ? Theme.accent : Theme.border; }
                Text {
                    text: root.folded ? "+" : "+ Add project";
                    color: ap.has-hover ? Theme.accent-hover : Theme.text-muted;
                    font-size: root.folded ? Theme.text-16 : Theme.text-14;
                }
                ap := TouchArea { mouse-cursor: pointer; }
            }
            Rectangle {
                height: root.inbox-unread > 0 ? Theme.control-lg : Theme.control;
                border-radius: Theme.r-control;
                border-width: 1px;
                border-color: root.inbox-unread > 0 ? Theme.accent : Theme.border-subtle;
                background: ib.has-hover ? Theme.bg-hover : transparent;
                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.sp-8;
                    Icon { source: Icons.mail; width: Theme.icon-lg; height: Theme.icon-lg; y: (parent.height - Theme.sp-16) / 2; tint: root.inbox-unread > 0 ? Theme.text-primary : Theme.text-muted; }
                    if !root.folded: Text { text: "Inbox"; color: root.inbox-unread > 0 ? Theme.text-primary : Theme.text-muted; font-size: Theme.text-14; vertical-alignment: center; }
                    if root.inbox-unread > 0 && !root.folded: Rectangle {
                        y: (parent.height - Theme.sp-16) / 2;
                        height: Theme.sp-16; width: max(Theme.sp-16, ib-n.preferred-width + Theme.sp-10);
                        border-radius: Theme.r-field;
                        background: Theme.accent;
                        ib-n := Text { text: root.inbox-unread > 99 ? "99+" : root.inbox-unread; color: Theme.white; font-size: Theme.text-11; font-weight: Theme.w-bold; }
                    }
                }
                // Folded: the count sits on the envelope's top-right corner.
                if root.inbox-unread > 0 && root.folded: Rectangle {
                    x: parent.width - Theme.sp-6 - self.width; y: Theme.sp-2;
                    height: Theme.icon-lg; width: max(Theme.icon-lg, fb-n.preferred-width + 2 * Theme.sp-4);
                    border-radius: Theme.r-pill;
                    background: Theme.accent;
                    fb-n := Text { text: root.inbox-unread > 99 ? "99+" : root.inbox-unread; color: Theme.white; font-size: Theme.text-10; font-weight: Theme.w-bold; }
                }
                ib := TouchArea { mouse-cursor: pointer; }
            }
        }
    }
}

export struct TabItem {
    id: string,
    label: string,
    icon: image,
}

/// The tab bar. Workbench, its "+", the other tabs, and Browser on the right.
export component TabBar inherits Rectangle {
    in property <[TabItem]> tabs;
    in property <string> current;
    in property <bool> drawer-open;
    in property <bool> drawer-has-tabs;
    callback select(string);
    callback add-menu();
    callback toggle-browser();
    height: Theme.tabbar-height;
    background: Theme.bg-secondary;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    HorizontalLayout {
        padding-left: Theme.sp-12;
        padding-right: Theme.sp-12;
        // The tabs scroll sideways when they do not fit; they never widen the window.
        Flickable {
            horizontal-stretch: 1;
            content-width: tabrow.preferred-width;
            tabrow := HorizontalLayout {
                for t[i] in root.tabs: HorizontalLayout {
                    // A tab: an icon and its label.
                    Rectangle {
                        width: tab.preferred-width + Theme.sp-24;
                        height: Theme.tabbar-height;
                        tab := HorizontalLayout {
                            x: Theme.sp-12;
                            spacing: Theme.sp-6;
                            Icon { source: t.icon; width: Theme.icon-lg; height: Theme.icon-lg; y: Theme.sp-10; tint: t.id == root.current ? Theme.accent-hover : th.has-hover ? Theme.text-secondary : Theme.text-muted; }
                            Text { text: t.label; color: t.id == root.current ? Theme.accent-hover : th.has-hover ? Theme.text-secondary : Theme.text-muted; font-size: Theme.text-13; font-weight: Theme.w-medium; vertical-alignment: center; }
                        }
                        // The active tab's gradient underline.
                        if t.id == root.current: Rectangle {
                            x: Theme.sp-12; y: parent.height - Theme.sp-2; width: parent.width - Theme.sp-24; height: Theme.sp-2;
                            border-top-left-radius: Theme.r-chip; border-top-right-radius: Theme.r-chip;
                            background: Theme.grad-accent;
                        }
                        th := TouchArea { mouse-cursor: pointer; clicked => { root.select(t.id); } }
                    }
                    // The "+": bg-tertiary, a border, radius 6.
                    if i == 0: Rectangle {
                        width: Theme.sp-32;
                        Rectangle {
                            x: 0px; y: Theme.sp-6;
                            width: Theme.sp-24; height: Theme.sp-24;
                            border-radius: Theme.r-control;
                            background: pl.has-hover ? Theme.accent : Theme.bg-tertiary;
                            border-width: 1px;
                            border-color: pl.has-hover ? Theme.accent : Theme.border;
                            Text { text: "+"; font-size: Theme.text-16; color: pl.has-hover ? Theme.white : Theme.text-secondary; }
                            pl := TouchArea { mouse-cursor: pointer; clicked => { root.add-menu(); } }
                        }
                    }
                }
            }
        }
        // Browser, pinned right; gone while the drawer is open.
        if !root.drawer-open: Rectangle {
            width: bl.preferred-width + Theme.sp-24;
            bl := HorizontalLayout {
                x: Theme.sp-12;
                spacing: Theme.sp-6;
                Icon { source: Icons.globe; width: Theme.icon-lg; height: Theme.icon-lg; y: Theme.sp-10; tint: bh.has-hover ? Theme.text-secondary : Theme.text-muted; }
                Text { text: "Browser"; color: bh.has-hover ? Theme.text-secondary : Theme.text-muted; font-size: Theme.text-13; font-weight: Theme.w-medium; vertical-alignment: center; }
            }
            // Pages still open behind a hidden drawer: an accent dot with a ring.
            if root.drawer-has-tabs: Rectangle {
                x: parent.width - Theme.sp-12; y: Theme.sp-8; width: Theme.sp-12; height: Theme.sp-12; border-radius: Theme.r-control;
                background: Theme.bg-secondary;
                Rectangle { width: Theme.sp-8; height: Theme.sp-8; border-radius: Theme.r-chip; background: Theme.accent; }
            }
            bh := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-browser(); } }
        }
    }
}
