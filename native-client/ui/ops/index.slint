// The ops area (AREAS.md): phase 5: Services, forwards, Docker, Secrets, Skills, Usage, Settings, Homepool, Info, Panels, What's new.
//
// This file is the area's entry point: main.slint and the workbench reach
// the area only through OpsView (a tab, or a panel in a workbench pane) and
// OpsOverlay (the area's dialogs, over the whole window). Everything else
// the area draws lives in ui/ops/ and is imported from here. What Rust
// sets and hears (globals, and the structs of their models) goes in
// ui/ops/api.slint, named with the Ops prefix.
//
// Kinds: services, docker, homepool, info, secrets, settings, panels (tabs); widget (panel)

import { Theme, Icons, PanelPage, EmptyState, SmallBtn } from "../kit.slint";
import { Shell } from "../hooks.slint";
import { OpsUi } from "api.slint";

/// One of the area's screens: `kind` is the tab's id (or the pane's kind),
/// `key` the pane's key when embedded in a workbench pane ("" in a tab).
export component OpsView inherits Rectangle {
    in property <string> kind;
    in property <string> key;
    in property <bool> embedded;
    background: Theme.bg-primary;
    // Placeholder until the area builds its screens.
    PanelPage {
        embedded: root.embedded;
        EmptyState { has-icon: false; title: "Not built yet: " + root.kind; hint: "The ops area builds this screen."; }
        // Signing out lives in Settings, as in the PC client (kept from
        // phase 1 until Settings is built).
        if root.kind == "settings": HorizontalLayout {
            alignment: center;
            SmallBtn { text: "Sign out of " + Shell.server; kind: "danger"; clicked => { Shell.sign-out(); } }
        }
    }
}

/// The area's layer over the whole window (its dialogs and popovers); it
/// takes no input where it draws nothing.
export component OpsOverlay inherits Rectangle {
}

