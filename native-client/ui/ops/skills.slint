// Ops area: Settings' Skills, Backup / sign-in restore and Usage sections (drawn inside Settings).
// OpsSkills (the global) is what Rust reads, sets and handles: src/ops/skills.rs.
// It is exported to Rust by ui/ops/api.slint (one line per file there).
//
// The web's renderSkillsSection / drawSkills (Skills), renderBackupSection /
// drawBackupForm / drawBackupNotice (Backup & restore), the "Usage" section
// of renderSettings (Keep the 5-hour window warm), and the sign-in screen's
// "Restore from a backup" (showLoginRestore, lrPoll). Rust builds every
// line's words; this file only lays them out. Every button calls
// OpsSkills.act(action, argument).

import { Theme, Icons, Icon, IconButton, PanelPage, EmptyState, SmallBtn, TextField, TextArea, Select, Seg, Toggle, CheckRow, Spinner, SoftShadow } from "../kit.slint";
import { SkHint, SkErr, SkHead, SkLabel, SkNote, SkForm, SkBar, SkLink } from "skills-parts.slint";

/// A row of the skills list: a group's head ("group": title, path, toggle
/// "Show"/"Hide"/""), a skill ("skill") or a group with none ("empty").
export struct OpsSkillRow { kind: string, title: string, path: string, toggle: string, scope: string, name: string, meta: string, desc: string, open: bool, bundled: bool, synced: bool, linked: bool, github: bool, problem: bool, first: bool, last: bool }
/// A file of the open skill.
export struct OpsSkillFile { path: string, size: string, deletable: bool, on: bool }
/// A skill a link holds (the "which one?" question).
export struct OpsSkillPick { name: string, description: string }
/// A line of the backup status box: "line" (key, bold, text, tone good/bad),
/// "bar", "waiting", "staged" (text "restart" when Crundi can restart
/// itself), "run" (tone "on" when it can run).
export struct OpsBkLine { kind: string, key: string, bold: string, text: string, tone: string }
/// A backup in storage.
export struct OpsBkItem { key: string, when: string, tag: string, size: string, host: string, confirming: bool }
/// A backup found at sign-in (the restore's list).
export struct OpsLrItem { key: string, when: string, host: string, size: string }

export global OpsSkills {
    /// A dialog of this screen covers the window (OpsOverlay sets Shell.modal-ops).
    in-out property <bool> modal;
    /// Every button of the three sections: (action, argument).
    callback act(string, string);

    // ── Skills ──
    in property <string> sk-state: "loading";
    in property <string> sk-load-error;
    in property <[string]> sk-scopes;
    in-out property <int> sk-target;
    in property <string> sk-upload-hint;
    in property <bool> sk-link-off;
    in property <bool> sk-link-busy;
    in-out property <string> sk-link-text;
    in property <string> sk-error;
    in property <bool> sk-busy;
    in property <string> sk-form;
    in property <string> sk-new-label;
    in-out property <string> sk-new-name;
    in-out property <string> sk-new-desc;
    in property <string> sk-pending;
    in property <string> sk-pending-text;
    in property <[OpsSkillPick]> sk-picks;
    in-out property <string> sk-pending-name;
    in property <[OpsSkillRow]> sk-rows;
    // The open skill.
    in property <string> sd-state;
    in property <string> sd-error;
    in property <string> sd-ro-reason;
    in property <string> sd-problem;
    in property <bool> sd-has-source;
    in property <string> sd-src-repo;
    in property <string> sd-src-url;
    in property <string> sd-src-rest;
    in property <bool> sd-can-update;
    in property <bool> sd-ro;
    in property <bool> sd-can-delete;
    in-out property <string> sd-rename;
    in-out property <int> sd-to;
    in-out property <string> sd-as;
    in-out property <string> sd-newfile;
    in property <[OpsSkillFile]> sd-files;
    in property <string> sd-more;
    in property <string> sd-links;
    // Its file in the editor.
    in property <bool> ed-open;
    in property <string> ed-path;
    in property <string> ed-size;
    in property <bool> ed-binary;
    in property <string> ed-note;
    in property <bool> ed-ro;
    in-out property <string> ed-text;

    // ── Backup & restore ──
    in property <string> bk-state: "loading";
    in property <string> bk-load-error;
    in property <[OpsBkLine]> bk-lines;
    in property <float> bk-frac: -1;
    in-out property <string> bk-endpoint;
    in-out property <string> bk-bucket;
    in-out property <string> bk-region;
    in-out property <string> bk-prefix;
    in-out property <int> bk-style;
    in-out property <string> bk-keyid;
    in-out property <string> bk-secret;
    in property <string> bk-secret-ph;
    in property <string> bk-test-out;
    in property <string> bk-test-tone;
    in property <string> bk-pass-label: "Passphrase";
    in property <string> bk-pass-ph;
    in-out property <string> bk-pass;
    in-out property <string> bk-pass2;
    in-out property <bool> bk-on;
    in-out property <int> bk-freq;
    in-out property <int> bk-weekday;
    in-out property <string> bk-hours;
    in-out property <string> bk-time;
    in-out property <string> bk-keep;
    in property <string> bk-tz;
    in property <string> bk-save-out;
    in property <string> bk-save-tone;
    in property <string> bk-list-btn: "Show";
    in property <string> bk-items-state;
    in property <string> bk-items-error;
    in property <[OpsBkItem]> bk-items;
    in-out property <string> bk-restore-pass;
    in property <bool> bk-busy;
    // The "scheduled backup waiting" notice (#bk-notice).
    in property <bool> bkn-visible;
    in property <bool> bkn-busy;

    // ── Usage (Keep the 5-hour window warm) ──
    in property <string> us-state: "loading";
    in property <string> us-error;
    in property <bool> us-on;
    in property <string> us-last;
    in property <string> us-reset;

    // ── Restore from a backup, at sign-in ──
    in property <bool> lr-open;
    in-out property <string> lr-endpoint;
    in-out property <string> lr-bucket;
    in-out property <string> lr-region;
    in-out property <string> lr-prefix: "crundi/";
    in-out property <string> lr-key;
    in-out property <string> lr-secret;
    in-out property <bool> lr-vhost;
    in property <bool> lr-finding;
    in property <string> lr-list;
    in property <[OpsLrItem]> lr-items;
    in-out property <int> lr-picked;
    in-out property <string> lr-pass;
    in property <bool> lr-going;
    in property <bool> lr-progress;
    in property <string> lr-phase;
    in property <float> lr-frac: -1;
    in property <string> lr-error;
}

/// This screen's layer over the window: the backup notice (bottom left).
/// Sign-in's restore (OpsLoginRestore) is drawn by the window over the
/// sign-in page, not here (the areas' overlays are drawn signed in only).
export component OpsSkillsOverlay inherits Rectangle {
    if OpsSkills.bkn-visible: Rectangle {
        x: Theme.sp-16;
        y: parent.height - self.height - Theme.sp-16;
        width: min(parent.width - 2 * Theme.sp-16, Theme.dialog-w-lg - Theme.sp-48 - Theme.sp-48);
        height: nl.preferred-height;
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-card; shadow: Theme.shadow-card; }
        Rectangle { background: Theme.bg-secondary; border-radius: Theme.r-card; border-width: 1px; border-color: Theme.border; }
        Rectangle { x: 0px; width: Theme.sp-2 + 1px; border-radius: Theme.r-chip; background: Theme.accent; }
        TouchArea { }
        nl := VerticalLayout {
            padding-left: Theme.sp-16; padding-right: Theme.sp-32; padding-top: Theme.sp-12; padding-bottom: Theme.sp-12;
            spacing: Theme.sp-2;
            Text { text: "Scheduled backup waiting"; font-size: Theme.text-13; font-weight: Theme.w-semibold; color: Theme.text-primary; }
            Text { text: "It starts once you have left Crundi, so it does not slow down your work."; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
            HorizontalLayout {
                padding-top: Theme.sp-10;
                spacing: Theme.sp-8;
                alignment: start;
                SmallBtn { text: "Back up now"; kind: "primary"; enabled: !OpsSkills.bkn-busy; clicked => { OpsSkills.act("bkn-run", ""); } }
                SmallBtn { text: "Skip this one"; enabled: !OpsSkills.bkn-busy; clicked => { OpsSkills.act("bkn-skip", ""); } }
            }
        }
        IconButton {
            x: parent.width - self.width - Theme.sp-6; y: Theme.sp-6;
            size: Theme.sp-24; icon: Icons.x; tooltip: "Hide";
            clicked => { OpsSkills.act("bkn-hide", ""); }
        }
    }
}

// ─────────────────────────── Skills ───────────────────────────

/// A tag beside a skill's name (.sk-tag).
component SkTag inherits Rectangle {
    in property <string> text;
    in property <bool> warn;
    height: tt.preferred-height + Theme.sp-2;
    width: tt.preferred-width + Theme.sp-12;
    border-radius: Theme.r-chip;
    background: root.warn ? Theme.yellow-dim : Theme.bg-tertiary;
    tt := Text { text: root.text; font-size: Theme.text-10; font-weight: Theme.w-medium; color: root.warn ? Theme.amber : Theme.text-secondary; }
}

/// One skill's head (.sk-head): the name and its tags, the files' count on
/// the right, the description under (two lines until it is open).
component SkSkillHead inherits Rectangle {
    in property <OpsSkillRow> item;
    background: root.item.open || ha.has-hover ? Theme.bg-hover : transparent;
    ha := TouchArea { mouse-cursor: pointer; clicked => { OpsSkills.act("open", root.item.scope + "\n" + root.item.name); } }
    VerticalLayout {
        padding-left: Theme.sp-12; padding-right: Theme.sp-12; padding-top: Theme.sp-10; padding-bottom: Theme.sp-10;
        spacing: Theme.sp-4;
        HorizontalLayout {
            spacing: Theme.sp-8;
            Text { text: root.item.name; font-size: Theme.text-14; font-weight: Theme.w-semibold; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
            if root.item.bundled: SkTag { y: (parent.height - self.height) / 2; text: "Included with Crundi"; }
            if root.item.synced: SkTag { y: (parent.height - self.height) / 2; text: "Synced"; }
            if root.item.linked: SkTag { y: (parent.height - self.height) / 2; text: "Link"; }
            if root.item.github: SkTag { y: (parent.height - self.height) / 2; text: "GitHub"; }
            if root.item.problem: SkTag { y: (parent.height - self.height) / 2; text: "Needs attention"; warn: true; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.item.meta; font-size: Theme.text-11; color: Theme.text-muted; vertical-alignment: center; }
        }
        dt := Text {
            property <length> two: 2 * Theme.text-12 * Theme.lh-ui + Theme.sp-4;
            text: root.item.desc;
            font-size: Theme.text-12; color: Theme.text-secondary;
            wrap: word-wrap;
            overflow: elide;
            height: root.item.open ? self.preferred-height : min(self.preferred-height, self.two);
        }
    }
}

/// The open skill (.sk-detail): notes, actions, forms, files, the editor.
component SkDetail inherits VerticalLayout {
    padding-left: Theme.sp-12; padding-right: Theme.sp-12; padding-top: Theme.sp-4; padding-bottom: Theme.sp-16;
    spacing: Theme.sp-10;
    if OpsSkills.sd-state == "loading": SkHint { text: "Loading…"; }
    if OpsSkills.sd-state == "error": SkErr { text: OpsSkills.sd-error; }
    if OpsSkills.sd-state == "data": VerticalLayout {
        spacing: Theme.sp-10;
        if OpsSkills.sd-ro-reason != "": SkNote { icon: Icons.lock; text: OpsSkills.sd-ro-reason; }
        if OpsSkills.sd-problem != "": SkNote { icon: Icons.info; warn: true; text: OpsSkills.sd-problem; }
        if OpsSkills.sd-has-source: SkNote {
            icon: Icons.git-branch;
            HorizontalLayout {
                spacing: Theme.sp-4;
                Text { text: "From"; font-size: Theme.text-12; color: Theme.text-secondary; }
                SkLink { text: OpsSkills.sd-src-repo; clicked => { OpsSkills.act("open-url", OpsSkills.sd-src-url); } }
                Text { horizontal-stretch: 1; text: OpsSkills.sd-src-rest; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
            }
        }
        HorizontalLayout {
            spacing: Theme.sp-8;
            alignment: start;
            if OpsSkills.sd-can-update: SmallBtn { text: "Update"; has-icon: true; icon: Icons.refresh; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("update", ""); } }
            if !OpsSkills.sd-ro: SmallBtn { text: "Rename"; has-icon: true; icon: Icons.pencil; clicked => { OpsSkills.act("rename", ""); } }
            SmallBtn { text: OpsSkills.sd-ro ? "Copy to…" : "Copy or move…"; has-icon: true; icon: Icons.copy; clicked => { OpsSkills.act("transfer", ""); } }
            SmallBtn { text: "Download"; has-icon: true; icon: Icons.download; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("download", ""); } }
            if OpsSkills.sd-can-delete: SmallBtn { text: "Delete"; kind: "danger"; has-icon: true; icon: Icons.trash; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("delete", ""); } }
        }
        if OpsSkills.sk-form == "rename": SkForm {
            label: "New name. Lowercase letters, digits and hyphens.";
            rn := TextField { horizontal-stretch: 1; text <=> OpsSkills.sd-rename; init => { self.focus-input(); } accepted => { OpsSkills.act("rename-go", ""); } escape => { OpsSkills.act("form-close", ""); } }
            SmallBtn { text: "Rename"; kind: "primary"; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("rename-go", ""); } }
            SmallBtn { text: "Cancel"; clicked => { OpsSkills.act("form-close", ""); } }
        }
        if OpsSkills.sk-form == "transfer": SkForm {
            label: "Where to, and under what name. A copy leaves this one where it is.";
            Select { horizontal-stretch: 1; options: OpsSkills.sk-scopes; selected: OpsSkills.sd-to; picked(i) => { OpsSkills.sd-to = i; } }
            TextField { horizontal-stretch: 1; text <=> OpsSkills.sd-as; accepted => { OpsSkills.act("copy-go", ""); } escape => { OpsSkills.act("form-close", ""); } }
            SmallBtn { text: "Copy"; kind: "primary"; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("copy-go", ""); } }
            if !OpsSkills.sd-ro: SmallBtn { text: "Move"; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("move-go", ""); } }
            SmallBtn { text: "Cancel"; clicked => { OpsSkills.act("form-close", ""); } }
        }
        // The files (.sk-files).
        Rectangle {
            border-radius: Theme.r-field;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            VerticalLayout {
                for f[i] in OpsSkills.sd-files: Rectangle {
                    height: max(Theme.control, fl.preferred-height);
                    background: f.on || fa.has-hover ? Theme.bg-hover : transparent;
                    if i > 0: Rectangle { y: 0px; height: 1px; background: Theme.border; }
                    fa := TouchArea { mouse-cursor: pointer; clicked => { OpsSkills.act("file", f.path); } }
                    fl := HorizontalLayout {
                        padding-left: Theme.sp-10; padding-right: Theme.sp-6;
                        spacing: Theme.sp-8;
                        Text { horizontal-stretch: 1; text: f.path; font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
                        Text { text: f.size; font-size: Theme.text-11; color: Theme.text-muted; vertical-alignment: center; }
                        if f.deletable: SmallBtn { kind: "danger"; has-icon: true; icon: Icons.trash; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("file-delete", f.path); } }
                    }
                }
            }
        }
        if OpsSkills.sd-more != "": SkHint { text: OpsSkills.sd-more; }
        if OpsSkills.sd-links != "": SkHint { text: OpsSkills.sd-links; }
        if !OpsSkills.sd-ro: HorizontalLayout {
            spacing: Theme.sp-8;
            alignment: start;
            SmallBtn { text: "New file"; has-icon: true; icon: Icons.plus; clicked => { OpsSkills.act("newfile", ""); } }
            SmallBtn { text: "Upload file"; has-icon: true; icon: Icons.upload; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("asset", ""); } }
        }
        if !OpsSkills.sd-ro && OpsSkills.sk-form == "newfile": SkForm {
            label: "Path inside the skill, for example reference/notes.md";
            TextField { horizontal-stretch: 1; text <=> OpsSkills.sd-newfile; placeholder: "reference/notes.md"; mono: true; init => { self.focus-input(); } accepted => { OpsSkills.act("newfile-go", ""); } escape => { OpsSkills.act("form-close", ""); } }
            SmallBtn { text: "Create"; kind: "primary"; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("newfile-go", ""); } }
            SmallBtn { text: "Cancel"; clicked => { OpsSkills.act("form-close", ""); } }
        }
        // The editor (.sk-editor).
        if OpsSkills.ed-open: VerticalLayout {
            spacing: Theme.sp-8;
            HorizontalLayout {
                Text { horizontal-stretch: 1; text: OpsSkills.ed-path; font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-primary; overflow: elide; }
                Text { text: OpsSkills.ed-size; font-size: Theme.text-11; color: Theme.text-muted; }
            }
            if OpsSkills.ed-binary: SkNote { icon: Icons.file; text: OpsSkills.ed-note; }
            if !OpsSkills.ed-binary: TextArea {
                text <=> OpsSkills.ed-text;
                mono: true;
                rows: 16;
                enabled: !OpsSkills.ed-ro;
                submit => { if !OpsSkills.ed-ro { OpsSkills.act("save", ""); } }
            }
            HorizontalLayout {
                spacing: Theme.sp-8;
                alignment: start;
                if !OpsSkills.ed-binary && !OpsSkills.ed-ro: SmallBtn { text: "Save"; kind: "primary"; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("save", ""); } }
                SmallBtn { text: "Download"; has-icon: true; icon: Icons.download; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("file-download", ""); } }
                SmallBtn { text: "Close"; clicked => { OpsSkills.act("file-close", ""); } }
            }
        }
    }
}

/// Settings → Skills (#skills-body).
export component OpsSkillsSection inherits VerticalLayout {
    spacing: Theme.sp-8;
    if OpsSkills.sk-state == "loading": SkHint { text: "Loading…"; }
    if OpsSkills.sk-state == "error": SkErr { text: OpsSkills.sk-load-error; }
    if OpsSkills.sk-state == "data": VerticalLayout {
        spacing: Theme.sp-8;
        SkHint { text: "A skill is a folder with a SKILL.md that tells Claude how to do one kind of task. A chat loads its skills when it starts, so changes here reach new chats. Chats that are already running keep the skills they started with."; }
        // .sk-bar: Add to [scope] Upload New
        HorizontalLayout {
            padding-top: Theme.sp-4;
            spacing: Theme.sp-8;
            Text { text: "Add to"; font-size: Theme.text-12; color: Theme.text-secondary; vertical-alignment: center; }
            Select {
                max-width: Theme.dialog-w-lg - Theme.sp-48 - Theme.sp-48 - Theme.sp-40 - Theme.sp-32;
                horizontal-stretch: 1;
                options: OpsSkills.sk-scopes;
                selected: OpsSkills.sk-target;
                picked(i) => { OpsSkills.act("target", "" + i); }
            }
            SmallBtn { text: "Upload"; kind: "primary"; has-icon: true; icon: Icons.upload; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("upload", ""); } }
            SmallBtn { text: "New"; has-icon: true; icon: Icons.plus; clicked => { OpsSkills.act("new", ""); } }
            Rectangle { horizontal-stretch: 1; }
        }
        SkHint { text: OpsSkills.sk-upload-hint; }
        // .sk-link: install from a GitHub link.
        SkForm {
            label: "Or install from a GitHub link, or paste an npx skills add line. Only the skill’s files are copied; nothing from the repository is run.";
            TextField {
                horizontal-stretch: 3;
                text <=> OpsSkills.sk-link-text;
                mono: true;
                placeholder: "https://github.com/owner/repo --skill name";
                enabled: !OpsSkills.sk-link-off && !OpsSkills.sk-link-busy;
                accepted => { OpsSkills.act("link-go", ""); }
            }
            SmallBtn {
                text: OpsSkills.sk-link-busy ? "Fetching…" : "Install from link";
                kind: "primary"; has-icon: true; icon: Icons.git-branch;
                enabled: !OpsSkills.sk-link-off && !OpsSkills.sk-link-busy;
                clicked => { OpsSkills.act("link-go", ""); }
            }
        }
        if OpsSkills.sk-link-off: SkHint { text: "This server does not support this yet. Update the server to use it. Upload still works."; }
        if OpsSkills.sk-error != "": SkErr { text: OpsSkills.sk-error; }
        // Something waiting on an answer.
        if OpsSkills.sk-pending == "choose": SkNote {
            icon: Icons.info; warn: true; text: OpsSkills.sk-pending-text;
            VerticalLayout {
                spacing: Theme.sp-6;
                for p in OpsSkills.sk-picks: Rectangle {
                    border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border; background: Theme.bg-primary;
                    height: pl.preferred-height;
                    pl := HorizontalLayout {
                        padding: Theme.sp-6; padding-left: Theme.sp-8;
                        spacing: Theme.sp-8;
                        Text { horizontal-stretch: 1; text: p.description != "" ? p.name + " " + p.description : p.name; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; vertical-alignment: center; }
                        SmallBtn { text: "Install"; enabled: !OpsSkills.sk-link-busy; clicked => { OpsSkills.act("link-pick", p.name); } }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.sp-8; alignment: start;
                SmallBtn { text: "Install all " + OpsSkills.sk-picks.length; kind: "primary"; enabled: !OpsSkills.sk-link-busy; clicked => { OpsSkills.act("link-all", ""); } }
                SmallBtn { text: "Cancel"; clicked => { OpsSkills.act("pending-cancel", ""); } }
            }
        }
        if OpsSkills.sk-pending == "name": SkForm {
            label: OpsSkills.sk-pending-text;
            TextField { horizontal-stretch: 1; text <=> OpsSkills.sk-pending-name; placeholder: "skill-name"; init => { self.focus-input(); } accepted => { OpsSkills.act("pending-name", ""); } }
            SmallBtn { text: "Install"; kind: "primary"; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("pending-name", ""); } }
            SmallBtn { text: "Cancel"; clicked => { OpsSkills.act("pending-cancel", ""); } }
        }
        if OpsSkills.sk-pending == "replace": SkNote {
            icon: Icons.info; warn: true; text: OpsSkills.sk-pending-text;
            HorizontalLayout {
                spacing: Theme.sp-8; alignment: start;
                SmallBtn { text: "Replace"; kind: "danger"; enabled: !OpsSkills.sk-busy && !OpsSkills.sk-link-busy; clicked => { OpsSkills.act("pending-replace", ""); } }
                SmallBtn { text: "Cancel"; clicked => { OpsSkills.act("pending-cancel", ""); } }
            }
        }
        if OpsSkills.sk-form == "new": SkForm {
            label: OpsSkills.sk-new-label;
            TextField { horizontal-stretch: 1; text <=> OpsSkills.sk-new-name; placeholder: "skill-name"; init => { self.focus-input(); } accepted => { OpsSkills.act("new-go", ""); } escape => { OpsSkills.act("form-close", ""); } }
            TextField { horizontal-stretch: 3; text <=> OpsSkills.sk-new-desc; placeholder: "What it does and when to use it"; accepted => { OpsSkills.act("new-go", ""); } escape => { OpsSkills.act("form-close", ""); } }
            SmallBtn { text: "Create"; kind: "primary"; enabled: !OpsSkills.sk-busy; clicked => { OpsSkills.act("new-go", ""); } }
            SmallBtn { text: "Cancel"; clicked => { OpsSkills.act("form-close", ""); } }
        }
        // The groups (.sk-group): a head, then its list (.bk-list) of skills.
        for r in OpsSkills.sk-rows: VerticalLayout {
            if r.kind == "group": HorizontalLayout {
                padding-top: Theme.sp-16; padding-bottom: Theme.sp-2;
                spacing: Theme.sp-8;
                SkHead { text: r.title; }
                if r.path != "": Text { text: r.path; font-family: Theme.mono; font-size: Theme.text-11; color: Theme.text-muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                if r.path == "": Rectangle { horizontal-stretch: 1; }
                if r.toggle != "": SmallBtn { text: r.toggle; clicked => { OpsSkills.act("synced-toggle", ""); } }
            }
            if r.kind == "empty": Rectangle {
                border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border;
                height: et.preferred-height + 2 * Theme.sp-12;
                et := Text { x: Theme.sp-12; text: "None yet."; font-size: Theme.text-13; color: Theme.text-muted; }
            }
            if r.kind == "skill": Rectangle {
                // One bordered list per group: the first row rounds the top, the last the bottom.
                border-top-left-radius: r.first ? Theme.r-field : 0px;
                border-top-right-radius: r.first ? Theme.r-field : 0px;
                border-bottom-left-radius: r.last ? Theme.r-field : 0px;
                border-bottom-right-radius: r.last ? Theme.r-field : 0px;
                border-width: 1px; border-color: Theme.border;
                clip: true;
                VerticalLayout {
                    SkSkillHead { item: r; }
                    if r.open: SkDetail { }
                }
                if !r.first: Rectangle { y: 0px; height: 1px; background: Theme.border; }
            }
        }
    }
}

// ─────────────────────────── Backup & restore ───────────────────────────

/// A line of the status box (.bk-line).
component BkLine inherits HorizontalLayout {
    in property <OpsBkLine> line;
    spacing: Theme.sp-10;
    if root.line.key != "": Text { width: Theme.skills-key-w; text: root.line.key; font-size: Theme.text-12; color: Theme.text-muted; }
    if root.line.bold != "": Text {
        text: root.line.bold; font-size: Theme.text-12; font-weight: Theme.w-semibold;
        color: root.line.tone == "bad" ? Theme.red : root.line.tone == "good" ? Theme.green : Theme.text-primary;
    }
    Text { horizontal-stretch: 1; text: root.line.text; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
}

/// A labelled field of the storage grid (.bk-grid > div).
component BkField inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: Theme.sp-4;
    horizontal-stretch: 1;
    SkLabel { text: root.label; }
    @children
    if root.hint != "": SkHint { text: root.hint; }
}

/// Settings → Backup & restore (#backup-body).
export component OpsBackupSection inherits VerticalLayout {
    spacing: Theme.sp-8;
    if OpsSkills.bk-state == "loading": SkHint { text: "Loading…"; }
    if OpsSkills.bk-state == "error": SkErr { text: OpsSkills.bk-load-error; }
    if OpsSkills.bk-state == "data": VerticalLayout {
        spacing: Theme.sp-16;
        // The status (.bk-status).
        Rectangle {
            border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border; background: Theme.bg-primary;
            VerticalLayout {
                padding-left: Theme.sp-16; padding-right: Theme.sp-16; padding-top: Theme.sp-12; padding-bottom: Theme.sp-12;
                spacing: Theme.sp-6;
                for l in OpsSkills.bk-lines: VerticalLayout {
                    if l.kind == "line": BkLine { line: l; }
                    if l.kind == "bar": SkBar { frac: OpsSkills.bk-frac; }
                    if l.kind == "waiting": HorizontalLayout {
                        padding-top: Theme.sp-4; spacing: Theme.sp-8; alignment: start;
                        SmallBtn { text: "Back up now"; kind: "primary"; enabled: !OpsSkills.bk-busy; clicked => { OpsSkills.act("bk-run", ""); } }
                        SmallBtn { text: "Skip this one"; clicked => { OpsSkills.act("bk-skip", ""); } }
                    }
                    if l.kind == "staged": HorizontalLayout {
                        padding-top: Theme.sp-4; spacing: Theme.sp-8; alignment: start;
                        if l.text == "restart": SmallBtn { text: "Restart now"; kind: "primary"; clicked => { OpsSkills.act("bk-restart", ""); } }
                        if l.text != "restart": SkHint { horizontal-stretch: 0; text: "Restart Crundi the way you started it."; vertical-alignment: center; }
                        SmallBtn { text: "Cancel the restore"; clicked => { OpsSkills.act("bk-cancel-restore", ""); } }
                    }
                    if l.kind == "run": HorizontalLayout {
                        padding-top: Theme.sp-4; alignment: start;
                        SmallBtn { text: "Back up now"; kind: "primary"; has-icon: true; icon: Icons.upload; enabled: l.tone == "on" && !OpsSkills.bk-busy; clicked => { OpsSkills.act("bk-run", ""); } }
                    }
                }
            }
        }
        // Storage.
        VerticalLayout {
            spacing: Theme.sp-10;
            SkHead { text: "Storage"; }
            BkField {
                label: "Endpoint";
                hint: "Any S3-compatible storage: Cloudflare R2, AWS S3, Backblaze B2, MinIO, Wasabi…";
                TextField { text <=> OpsSkills.bk-endpoint; placeholder: "https://ACCOUNT.r2.cloudflarestorage.com"; }
            }
            HorizontalLayout {
                spacing: Theme.sp-16;
                BkField { label: "Bucket"; TextField { text <=> OpsSkills.bk-bucket; } }
                BkField { label: "Region"; hint: "R2 uses auto; AWS needs the bucket’s region."; TextField { text <=> OpsSkills.bk-region; placeholder: "auto"; } }
            }
            HorizontalLayout {
                spacing: Theme.sp-16;
                BkField { label: "Folder"; TextField { text <=> OpsSkills.bk-prefix; placeholder: "crundi/"; } }
                BkField { label: "Addresses"; Seg { options: ["Path", "Virtual-hosted"]; selected: OpsSkills.bk-style; picked(i) => { OpsSkills.bk-style = i; } } }
            }
            HorizontalLayout {
                spacing: Theme.sp-16;
                BkField { label: "Access key ID"; TextField { text <=> OpsSkills.bk-keyid; } }
                BkField { label: "Secret access key"; TextField { text <=> OpsSkills.bk-secret; password: true; placeholder: OpsSkills.bk-secret-ph; } }
            }
            HorizontalLayout {
                spacing: Theme.sp-8; alignment: start;
                SmallBtn { text: "Test the connection"; clicked => { OpsSkills.act("bk-test", ""); } }
                Text {
                    text: OpsSkills.bk-test-out; vertical-alignment: center; font-size: Theme.text-11; wrap: word-wrap;
                    color: OpsSkills.bk-test-tone == "good" ? Theme.green : OpsSkills.bk-test-tone == "bad" ? Theme.red : Theme.text-muted;
                }
            }
        }
        // Passphrase.
        VerticalLayout {
            spacing: Theme.sp-10;
            SkHead { text: "Passphrase"; }
            HorizontalLayout {
                spacing: Theme.sp-16;
                BkField { label: OpsSkills.bk-pass-label; TextField { text <=> OpsSkills.bk-pass; password: true; placeholder: OpsSkills.bk-pass-ph; } }
                BkField { label: "Again"; TextField { text <=> OpsSkills.bk-pass2; password: true; } }
            }
            SkHint { text: "Backups hold your sign-in and settings, so they are encrypted with this. You need it to restore; without it a backup cannot be opened. Keep it somewhere other than this server."; }
        }
        // Schedule.
        VerticalLayout {
            spacing: Theme.sp-10;
            SkHead { text: "Schedule"; }
            CheckRow { text: "Back up automatically"; checked: OpsSkills.bk-on; toggled(v) => { OpsSkills.bk-on = v; } }
            HorizontalLayout {
                spacing: Theme.sp-10;
                alignment: start;
                Seg { options: ["Daily", "Weekly", "Every few hours"]; selected: OpsSkills.bk-freq; picked(i) => { OpsSkills.bk-freq = i; } }
                if OpsSkills.bk-freq == 1: Select {
                    width: Theme.sp-48 + Theme.sp-48 + Theme.sp-24;
                    options: ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
                    selected: OpsSkills.bk-weekday;
                    picked(i) => { OpsSkills.bk-weekday = i; }
                }
                if OpsSkills.bk-freq == 2: Text { text: "every"; font-size: Theme.text-12; color: Theme.text-secondary; vertical-alignment: center; }
                if OpsSkills.bk-freq == 2: TextField { width: Theme.sp-48 + Theme.sp-24; text <=> OpsSkills.bk-hours; }
                if OpsSkills.bk-freq == 2: Text { text: "hours from"; font-size: Theme.text-12; color: Theme.text-secondary; vertical-alignment: center; }
                if OpsSkills.bk-freq != 2: Text { text: "at"; font-size: Theme.text-12; color: Theme.text-secondary; vertical-alignment: center; }
                TextField { width: Theme.sp-48 + Theme.sp-32; text <=> OpsSkills.bk-time; placeholder: "03:00"; mono: true; }
                Text { text: OpsSkills.bk-tz != "" ? OpsSkills.bk-tz + " time" : ""; font-size: Theme.text-11; color: Theme.text-muted; vertical-alignment: center; }
            }
            VerticalLayout {
                padding-top: Theme.sp-2;
                spacing: Theme.sp-4;
                SkLabel { text: "Keep the last"; }
                HorizontalLayout {
                    spacing: Theme.sp-10; alignment: start;
                    TextField { width: Theme.sp-48 + Theme.sp-40; text <=> OpsSkills.bk-keep; }
                    Text { text: "scheduled backups"; font-size: Theme.text-12; color: Theme.text-secondary; vertical-alignment: center; }
                }
                SkHint { text: "Older scheduled backups of this machine are deleted after each new one. 0 keeps them all. Backups you make by hand are kept until you delete them."; }
            }
            SkHint { text: "If you are using Crundi when a backup is due, it tells you and waits until you have left."; }
        }
        HorizontalLayout {
            spacing: Theme.sp-8; alignment: start;
            SmallBtn { text: "Save"; kind: "primary"; clicked => { OpsSkills.act("bk-save", ""); } }
            Text {
                text: OpsSkills.bk-save-out; vertical-alignment: center; font-size: Theme.text-11; wrap: word-wrap;
                color: OpsSkills.bk-save-tone == "bad" ? Theme.red : Theme.text-muted;
            }
        }
        // Backups in storage.
        VerticalLayout {
            spacing: Theme.sp-10;
            padding-top: Theme.sp-2;
            HorizontalLayout {
                SkHead { horizontal-stretch: 1; text: "Backups in storage"; }
                SmallBtn { text: OpsSkills.bk-list-btn; clicked => { OpsSkills.act("bk-list", ""); } }
            }
            if OpsSkills.bk-items-state == "error": SkErr { text: OpsSkills.bk-items-error; }
            if OpsSkills.bk-items-state == "empty": Rectangle {
                border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border;
                height: ee.preferred-height + 2 * Theme.sp-12;
                ee := Text { x: Theme.sp-12; width: parent.width - 2 * Theme.sp-12; text: "No backups in this folder yet. Back up now to make the first."; font-size: Theme.text-13; color: Theme.text-muted; wrap: word-wrap; }
            }
            if OpsSkills.bk-items-state == "data": Rectangle {
                border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border;
                clip: true;
                VerticalLayout {
                    for it[i] in OpsSkills.bk-items: Rectangle {
                        if i > 0: Rectangle { y: 0px; height: 1px; background: Theme.border-subtle; }
                        VerticalLayout {
                            padding-left: Theme.sp-12; padding-right: Theme.sp-12; padding-top: Theme.sp-10; padding-bottom: Theme.sp-10;
                            spacing: Theme.sp-4;
                            HorizontalLayout {
                                spacing: Theme.sp-6;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: Theme.sp-4;
                                    Text { text: it.when; font-size: Theme.text-13; color: Theme.text-primary; }
                                    HorizontalLayout {
                                        spacing: Theme.sp-10; alignment: start;
                                        Rectangle {
                                            width: tg.preferred-width + Theme.sp-12; border-radius: Theme.r-chip; background: Theme.bg-tertiary;
                                            tg := Text { text: it.tag; font-size: Theme.text-11; color: Theme.text-secondary; }
                                        }
                                        Text { text: it.size; font-size: Theme.text-11; color: Theme.text-muted; }
                                        if it.host != "": Text { text: it.host; font-size: Theme.text-11; color: Theme.text-muted; }
                                    }
                                }
                                VerticalLayout { alignment: center; SmallBtn { text: "Restore"; has-icon: true; icon: Icons.download; clicked => { OpsSkills.act("bk-restore-ask", it.key); } } }
                                VerticalLayout { alignment: center; SmallBtn { has-icon: true; icon: Icons.trash; clicked => { OpsSkills.act("bk-delete", it.key); } } }
                            }
                            if it.confirming: Rectangle {
                                border-radius: Theme.r-field; border-width: 1px; border-color: Theme.yellow-edge; background: Theme.yellow-dim;
                                VerticalLayout {
                                    padding: Theme.sp-12; spacing: Theme.sp-8;
                                    Text { text: "This replaces this Crundi’s settings, sign-in, projects, layouts, kanban, notes, mindmap, media, schedules and services with the backup’s, and adds back its Claude transcripts and any global skills that are not already here. What it replaces is kept in a pre-restore folder. Crundi restarts to finish."; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: Theme.sp-10;
                                        TextField { horizontal-stretch: 1; text <=> OpsSkills.bk-restore-pass; password: true; placeholder: "Passphrase (blank: the saved one)"; init => { self.focus-input(); } accepted => { OpsSkills.act("bk-restore-go", it.key); } }
                                        SmallBtn { text: "Restore and restart"; kind: "primary"; enabled: !OpsSkills.bk-busy; clicked => { OpsSkills.act("bk-restore-go", it.key); } }
                                        SmallBtn { text: "Cancel"; clicked => { OpsSkills.act("bk-restore-cancel", ""); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ─────────────────────────── Usage ───────────────────────────

/// Settings → Usage: keep the 5-hour window warm (.seg-pref-row).
export component OpsUsageSection inherits VerticalLayout {
    if OpsSkills.us-state == "loading": SkHint { text: "Loading…"; }
    if OpsSkills.us-state == "error": SkErr { text: OpsSkills.us-error; }
    if OpsSkills.us-state == "data": HorizontalLayout {
        spacing: Theme.sp-16;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.sp-4;
            Text { text: "Keep the 5-hour window warm"; font-size: Theme.text-14; color: Theme.text-primary; }
            SkHint { text: "Claude’s 5-hour allowance is a rolling window that starts on your first message — so beginning real work also starts the clock, and it can run out mid-session. When on, Crundi checks about once a minute and, if the window has lapsed while you were idle, sends a one-word message to open the next one. Never while a session is working, and never if your own work already opened a window."; }
            if OpsSkills.us-last != "": SkHint { text: OpsSkills.us-last; }
            if OpsSkills.us-reset != "": SkHint { text: OpsSkills.us-reset; }
        }
        VerticalLayout { alignment: start; Toggle { on: OpsSkills.us-on; toggled(v) => { OpsSkills.act("us-toggle", v ? "on" : "off"); } } }
    }
}


// ─────────────────────────── Restore at sign-in ───────────────────────────

/// The sign-in screen's "Restore from a backup" (#login-restore), for a
/// server with no sign-in set up yet. The window draws it over the sign-in
/// page while OpsSkills.lr-open (Rust: skills::open_login_restore(server)).
export component OpsLoginRestore inherits Rectangle {
    background: Theme.scrim;
    TouchArea { }
    card := Rectangle {
        width: min(Theme.skills-restore-w + 2 * Theme.sp-24, root.width - 2 * Theme.sp-24);
        height: min(col.preferred-height, root.height - 2 * Theme.sp-24);
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-card; shadow: Theme.shadow-card; }
        Rectangle { background: Theme.bg-secondary; border-radius: Theme.r-card; border-width: 1px; border-color: Theme.border; }
        fl := Flickable {
            content-height: max(self.height, col.preferred-height);
            col := VerticalLayout {
                width: fl.width;
                padding: Theme.sp-24;
                spacing: Theme.sp-8;
                Text { text: "Restore from a backup"; horizontal-alignment: center; font-size: Theme.text-16; font-weight: Theme.w-semibold; color: Theme.text-primary; }
                TextField { text <=> OpsSkills.lr-endpoint; placeholder: "Endpoint, e.g. https://ACCOUNT.r2.cloudflarestorage.com"; init => { self.focus-input(); } }
                HorizontalLayout {
                    spacing: Theme.sp-8;
                    TextField { horizontal-stretch: 1; text <=> OpsSkills.lr-bucket; placeholder: "Bucket"; }
                    TextField { width: Theme.sp-48 + Theme.sp-48 + Theme.sp-24; text <=> OpsSkills.lr-region; placeholder: "Region (auto)"; }
                }
                TextField { text <=> OpsSkills.lr-prefix; placeholder: "Folder (crundi/)"; }
                TextField { text <=> OpsSkills.lr-key; placeholder: "Access key ID"; }
                TextField { text <=> OpsSkills.lr-secret; password: true; placeholder: "Secret access key"; }
                CheckRow { text: "Virtual-hosted addresses (bucket in the hostname)"; checked: OpsSkills.lr-vhost; toggled(v) => { OpsSkills.lr-vhost = v; } }
                HorizontalLayout { alignment: center; SmallBtn { kind: "primary"; text: OpsSkills.lr-finding ? "Looking…" : "Find backups"; enabled: !OpsSkills.lr-finding; clicked => { OpsSkills.act("lr-find", ""); } } }
                if OpsSkills.lr-list == "empty": Rectangle {
                    border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border;
                    height: le.preferred-height + 2 * Theme.sp-12;
                    le := Text { x: Theme.sp-12; width: parent.width - 2 * Theme.sp-12; text: "No backups in this folder. Check the folder name."; font-size: Theme.text-12; color: Theme.text-muted; wrap: word-wrap; }
                }
                if OpsSkills.lr-list == "data": Rectangle {
                    border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border;
                    clip: true;
                    VerticalLayout {
                        for it[i] in OpsSkills.lr-items: Rectangle {
                            height: Theme.control;
                            background: ra.has-hover ? Theme.bg-hover : transparent;
                            if i > 0: Rectangle { y: 0px; height: 1px; background: Theme.border; }
                            ra := TouchArea { mouse-cursor: pointer; clicked => { OpsSkills.lr-picked = i; } }
                            HorizontalLayout {
                                padding-left: Theme.sp-10; padding-right: Theme.sp-10;
                                spacing: Theme.sp-8;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: Theme.icon-md; height: Theme.icon-md;
                                    border-radius: Theme.r-pill; border-width: 1px;
                                    border-color: i == OpsSkills.lr-picked ? Theme.accent : Theme.border;
                                    if i == OpsSkills.lr-picked: Rectangle { width: Theme.sp-6; height: Theme.sp-6; border-radius: Theme.r-pill; background: Theme.accent; }
                                }
                                Text { text: it.when; font-size: Theme.text-12; color: Theme.text-primary; vertical-alignment: center; }
                                if it.host != "": Text { text: it.host; font-size: Theme.text-11; color: Theme.text-muted; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: it.size; font-size: Theme.text-11; color: Theme.text-muted; vertical-alignment: center; }
                            }
                        }
                    }
                }
                if OpsSkills.lr-list == "data": TextField { text <=> OpsSkills.lr-pass; password: true; placeholder: "Backup passphrase"; accepted => { OpsSkills.act("lr-go", ""); } }
                if OpsSkills.lr-list == "data": HorizontalLayout { alignment: center; SmallBtn { kind: "primary"; text: "Restore"; enabled: !OpsSkills.lr-going; clicked => { OpsSkills.act("lr-go", ""); } } }
                if OpsSkills.lr-progress: VerticalLayout {
                    spacing: Theme.sp-4;
                    Text { text: OpsSkills.lr-phase; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
                    SkBar { frac: OpsSkills.lr-frac; }
                }
                Text { text: OpsSkills.lr-error; font-size: Theme.text-12; color: Theme.red; wrap: word-wrap; min-height: Theme.sp-16; }
                HorizontalLayout { alignment: center; SkLink { text: "Set up a new password instead"; clicked => { OpsSkills.act("lr-back", ""); } } }
            }
        }
    }
}

/// The screen (not a tab of its own: Settings places the sections below).
export component OpsSkillsView inherits Rectangle {
    in property <string> kind;
    in property <string> key;
    in property <bool> embedded;
    PanelPage {
        embedded: root.embedded;
        OpsSkillsSection { }
        OpsBackupSection { }
        OpsUsageSection { }
    }
}
