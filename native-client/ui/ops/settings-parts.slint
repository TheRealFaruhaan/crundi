// Ops area, Settings: the parts its sections share (the web's .set-group,
// .info-section.set-fold, .seg-pref-row, labels and hints, the
// notification matrix's lamp). Only ui/ops/settings*.slint use them.

import { Theme, Icons, Icon, Toggle, Seg } from "../kit.slint";

/// A group's heading (.set-group): small, upper case, muted, wide.
export component SetGroup inherits VerticalLayout {
    in property <string> text;
    padding-left: Theme.sp-2;
    Text {
        text: root.text;
        font-size: Theme.text-11;
        letter-spacing: Theme.track-wide;
        color: Theme.text-muted;
    }
}

/// A section folded under its title (.info-section.set-fold): a card whose
/// head (the title and a chevron that turns when open) opens and closes it.
export component SetFold inherits Rectangle {
    in property <string> title;
    in-out property <bool> open;
    background: Theme.bg-secondary;
    border-radius: Theme.r-field;
    border-width: 1px;
    border-color: Theme.border;
    property <color> fg: ha.has-hover ? Theme.accent : Theme.text-primary;
    VerticalLayout {
        Rectangle {
            HorizontalLayout {
                padding-left: Theme.sp-16; padding-right: Theme.sp-16;
                padding-top: Theme.sp-12; padding-bottom: Theme.sp-12;
                spacing: Theme.sp-8;
                Text { text: root.title; horizontal-stretch: 1; vertical-alignment: center; font-size: Theme.text-14; font-weight: Theme.w-medium; color: root.fg; }
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: Icons.chevron-right; width: Theme.icon-sm; height: Theme.icon-sm; tint: root.fg;
                        transform-rotation: root.open ? 90deg : 0deg;
                        animate transform-rotation { duration: Theme.motion-fast; }
                    }
                }
            }
            ha := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open = !root.open; }
            }
            accessible-role: button;
            accessible-label: root.title;
        }
        body := VerticalLayout {
            padding-left: Theme.sp-16; padding-right: Theme.sp-16;
            padding-bottom: root.open ? Theme.sp-16 : 0;
            spacing: Theme.sp-12;
            visible: root.open;
            max-height: root.open ? self.preferred-height : 0;
            @children
        }
    }
}

/// A field's label (labelStyle): secondary, small.
export component SetLabel inherits Text {
    font-size: Theme.text-12;
    color: Theme.text-secondary;
    wrap: word-wrap;
}

/// A hint under a field or a row (hintStyle): muted, smaller.
export component SetHint inherits Text {
    font-size: Theme.text-11;
    color: Theme.text-muted;
    wrap: word-wrap;
}

/// A status line beside a Save button (#settings-status …): muted, or a tone.
export component SetStatus inherits Text {
    in property <string> tone;
    font-size: Theme.text-12;
    vertical-alignment: center;
    color: root.tone == "warn" ? Theme.yellow : root.tone == "error" ? Theme.red : root.tone == "ok" ? Theme.green : Theme.text-muted;
}

/// A switch row (.seg-pref-row): the title and its hint on the left, the
/// switch on the right, top-aligned. Extra parts go under the hint.
export component SetToggleRow inherits HorizontalLayout {
    in property <string> title;
    in property <image> mark;
    in property <bool> has-mark;
    in property <string> hint;
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    spacing: Theme.sp-16;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Theme.sp-4;
        HorizontalLayout {
            spacing: Theme.sp-6;
            if root.has-mark: VerticalLayout { alignment: center; Image { source: root.mark; width: Theme.icon-sm; height: Theme.icon-sm; colorize: Theme.text-primary; } }
            Text { text: root.title; font-size: Theme.text-14; color: Theme.text-primary; wrap: word-wrap; horizontal-stretch: 1; }
        }
        if root.hint != "": SetHint { text: root.hint; }
        @children
    }
    VerticalLayout {
        alignment: start;
        Toggle { on: root.on; enabled: root.enabled; toggled(v) => { root.toggled(v); } }
    }
}

/// A row with a title and sub line on the left and its controls on the right
/// (the update sections' rows).
export component SetInfoRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> sub;
    in property <color> sub-color: Theme.text-muted;
    spacing: Theme.sp-12;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: Theme.sp-2;
        Text { text: root.title; font-size: Theme.text-14; color: Theme.text-primary; wrap: word-wrap; }
        if root.sub != "": Text { text: root.sub; font-size: Theme.text-11; color: root.sub-color; wrap: word-wrap; }
    }
    HorizontalLayout {
        alignment: end;
        spacing: Theme.sp-8;
        @children
    }
}

/// A hairline between the blocks of a section (border-top: 1px).
export component SetRule inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

/// A link-looking button (.lr-link): accent text, underlined on hover.
export component SetLink inherits Text {
    callback clicked();
    font-size: Theme.text-12;
    color: la.has-hover ? Theme.accent : Theme.accent-hover;
    vertical-alignment: center;
    la := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// One cell of the notification matrix (.ntf-cell): its lamp lit in the
/// mode's colour when chosen.
export component NotifyLamp inherits Rectangle {
    in property <bool> on;
    in property <string> mode;
    callback picked();
    property <length> lamp: Theme.sp-16;
    Rectangle {
        width: la.has-hover && !root.on ? root.lamp + Theme.sp-2 : root.lamp;
        height: self.width;
        border-radius: self.width / 2;
        border-width: root.on ? 0 : Theme.sp-2;
        border-color: la.has-hover ? Theme.text-secondary : Theme.border;
        background: !root.on ? transparent : root.mode == "always" ? Theme.green : root.mode == "away" ? Theme.accent : Theme.text-muted;
        animate background, width { duration: Theme.motion-fast; }
    }
    la := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
    accessible-role: checkbox;
    accessible-checked: root.on;
    accessible-label: root.mode;
}
