// Ops area: Settings, for the owner (the web's renderSettings and
// organizeSettings, src/webapp-html.js ~15370-16000): the groups and their
// folded sections, in the web's order. Skills, Backup & restore and Usage
// are drawn by ui/ops/skills.slint (OpsSkillsSection, OpsBackupSection,
// OpsUsageSection) and placed here where organizeSettings puts them.
// OpsSettings (the global) is what Rust reads, sets and handles:
// src/ops/settings.rs. It is exported to Rust by ui/ops/api.slint.

import { Theme, Icons, Icon, PanelPage, EmptyState, ErrorState, LoadingState, SmallBtn, Btn, TextField, TextArea, Seg, Toggle, CheckRow, Select, Modal, ModalActions, Spinner } from "../kit.slint";
import { Shell } from "../hooks.slint";
import { SetGroup, SetFold, SetLabel, SetHint, SetStatus, SetToggleRow, SetInfoRow, SetRule, SetLink, NotifyLamp } from "settings-parts.slint";
import { OpsSkillsSection, OpsBackupSection, OpsUsageSection } from "skills.slint";

/// Google or GitHub sign-in (authOAuthSettings): what the block shows.
export struct OpsSettingsOAuth {
    key: string,
    label: string,
    on: bool,
    can-on: bool,
    status: string,
    url: string,
    local: bool,
    howto: string,
    acct: string,
    ph: string,
    configured: bool,
    secret-set: bool,
    test-line: string,
}

/// A notification channel (GET /api/notify/channels).
export struct OpsSettingsChannel {
    id: string,
    label: string,
    hint: string,
    enabled: bool,
    can-toggle: bool,
    always-on: bool,
    available: bool,
    telegram: bool,
}

/// A row of the notification matrix: a category heading (cat) or an event.
export struct OpsSettingsNotify {
    cat: string,
    key: string,
    label: string,
    mode: string,
}

/// A signed-in device (GET /api/auth/sessions).
export struct OpsSettingsSession {
    id: string,
    label: string,
    current: bool,
    desc: string,
}

/// A ticked choice (Cru on its own's classes).
export struct OpsSettingsCheck {
    id: string,
    label: string,
    checked: bool,
}

export global OpsSettings {
    /// A dialog of this screen covers the window (OpsOverlay sets Shell.modal-ops).
    in-out property <bool> modal;

    // The page: "loading", "error" (error), "data".
    in-out property <string> state: "loading";
    in-out property <string> error;
    callback reload();

    // Which sections are open (kept while the client runs, as the web's
    // settingsOpen).
    in-out property <bool> open-server;
    in-out property <bool> open-cc;
    in-out property <bool> open-whatsnew;
    in-out property <bool> open-sysprompt;
    in-out property <bool> open-skills;
    in-out property <bool> open-usage;
    in-out property <bool> open-voice;
    in-out property <bool> open-channels;
    in-out property <bool> open-notify;
    in-out property <bool> open-signin;
    in-out property <bool> open-phone;
    in-out property <bool> open-session;
    in-out property <bool> open-config;
    in-out property <bool> open-terminal;
    in-out property <bool> open-backup;
    in-out property <bool> open-desktop;

    // ── Server (renderServerUpdate) ──
    in-out property <bool> srv-shown: true;
    in-out property <string> srv-body;           // "checking", "error", "starting", "data"
    in-out property <string> srv-error;
    in-out property <string> srv-version;
    in-out property <string> srv-sub;
    in-out property <string> srv-act;            // "applying", "update", "check"
    in-out property <string> srv-latest;
    in-out property <int> srv-channel;           // 0 production, 1 dev
    in-out property <string> srv-dev-note;
    in-out property <string> srv-blocker;
    in-out property <string> srv-notes-url;
    in-out property <string> srv-log;
    in-out property <bool> srv-can-restart;
    callback srv-check();
    callback srv-apply();
    callback srv-set-channel(int);
    callback restart();
    callback open-url(string);

    // ── Claude Code (renderClaudeUpdate) ──
    in-out property <string> cc-body;            // "checking", "error", "installing", "data"
    in-out property <string> cc-error;
    in-out property <string> cc-version;
    in-out property <string> cc-sub;
    in-out property <string> cc-act;             // "applying", "update", "check"
    in-out property <string> cc-latest;
    in-out property <bool> cc-beyond;
    in-out property <string> cc-tested;
    in-out property <string> cc-tested-warn;
    in-out property <string> cc-blocker;
    in-out property <string> cc-sudo;
    in-out property <string> cc-last;
    callback cc-check();
    callback cc-apply();

    callback whats-new();

    // ── System prompt ──
    in-out property <string> sysprompt;
    in-out property <string> proj-sysprompt;
    in-out property <string> proj-name;          // "" no project open
    in-out property <string> sp-status;
    in-out property <string> sp-tone;
    callback save-prompts();

    // ── Voice assistant (showVoiceServer, the server's part) ──
    in-out property <bool> vs-shown;
    in-out property <bool> vs-has-brain;
    in-out property <int> vs-brain;
    in-out property <[string]> vs-models;
    in-out property <int> vs-model;
    in-out property <bool> vs-has-effort;
    in-out property <[string]> vs-efforts;
    in-out property <int> vs-effort;
    in-out property <string> vs-effort-hint;
    in-out property <[string]> vs-cidles;
    in-out property <int> vs-cidle;
    in-out property <[string]> vs-rates;
    in-out property <int> vs-rate;
    in-out property <bool> vs-has-volume;
    in-out property <[string]> vs-vols;
    in-out property <int> vs-vol;
    in-out property <[string]> vs-pauses;
    in-out property <int> vs-pause;
    in-out property <bool> vs-has-sclose;
    in-out property <[string]> vs-scloses;
    in-out property <int> vs-sclose;
    in-out property <bool> vs-has-admin;
    in-out property <bool> vs-admin;
    in-out property <string> vs-admin-hint;
    in-out property <bool> vs-has-away;
    in-out property <bool> vs-away;
    in-out property <[OpsSettingsCheck]> vs-away-classes;
    in-out property <string> vs-away-note;
    in-out property <bool> vs-away-bad;
    in-out property <string> vs-spend;
    in-out property <string> vs-limit;
    in-out property <string> vs-bday;
    in-out property <string> vs-dlimit;
    in-out property <string> vs-dday;
    in-out property <string> vs-spend-note;
    in-out property <bool> vs-spend-bad;
    in-out property <string> vs-akey;
    in-out property <string> vs-dkey;
    in-out property <string> vs-xkey;
    in-out property <bool> vs-akey-set;
    in-out property <bool> vs-dkey-set;
    in-out property <bool> vs-xkey-set;
    in-out property <string> vs-keys-note;
    in-out property <bool> vs-keys-bad;
    in-out property <string> vs-reset-note;
    in-out property <bool> vs-reset-bad;
    in-out property <string> vs-status;
    in-out property <bool> vs-status-bad;
    callback vs-pick(string, int);
    callback vs-set-admin(bool);
    callback vs-set-away(bool);
    callback vs-away-class(string, bool);
    callback vs-away-stop();
    callback vs-save-spend();
    callback vs-save-keys();
    callback vs-reset();

    // ── Notification Channels and Settings ──
    in-out property <[OpsSettingsChannel]> channels;
    in-out property <string> tgc-tone;           // "ok", "warn", "error", ""
    in-out property <string> tgc-state;
    in-out property <bool> tgc-token-set;
    in-out property <string> chat-id;
    in-out property <[OpsSettingsNotify]> notify;
    callback channel-toggle(string, bool);
    callback push-test();
    callback chat-save();
    callback goto-signin-telegram();
    callback notify-pref(string, string);

    // ── Sign-in ──
    in-out property <bool> pw-set;
    in-out property <bool> pw-on;
    in-out property <string> new-password;
    in-out property <string> enrol-secret;
    callback set-password();
    callback method-toggle(string, bool);
    in-out property <bool> tg-has;               // the server sends telegramBot
    in-out property <bool> tg-on;
    in-out property <bool> tg-can;
    in-out property <string> tg-status;
    in-out property <bool> tg-token-set;
    in-out property <bool> tg-restart;
    in-out property <string> tg-token;
    in-out property <string> tg-user;
    callback tg-save();
    callback tg-clear();
    in-out property <bool> oauth-has;
    in-out property <OpsSettingsOAuth> google;
    in-out property <OpsSettingsOAuth> github;
    in-out property <string> google-id;
    in-out property <string> google-secret;
    in-out property <string> google-allowed;
    in-out property <string> github-id;
    in-out property <string> github-secret;
    in-out property <string> github-allowed;
    callback oauth-save(string);
    callback oauth-test(string);
    callback oauth-clear(string);
    callback oauth-copy(string);

    // ── Phone app ──
    callback phone-connect();
    in-out property <string> push-state;         // "checking", "none", "data"
    in-out property <string> push-line;
    in-out property <string> push-contact;
    in-out property <string> push-contact-url;
    in-out property <string> push-error;
    in-out property <bool> push-has-key;
    in-out property <string> push-key;
    in-out property <string> relay-summary;
    in-out property <bool> relay-custom;
    in-out property <bool> relay-open;
    in-out property <string> relay-url;
    callback push-save();
    callback push-mobile-test();
    callback push-remove();
    callback relay-save(string);

    // The pairing dialog (crundi-phone.js connect()).
    in-out property <bool> pair-open;
    in-out property <image> pair-image;
    in-out property <bool> pair-has-image;
    in-out property <string> pair-pic-text;
    in-out property <string> pair-line;
    in-out property <bool> pair-done;
    in-out property <string> pair-small;
    in-out property <string> pair-swap;          // "" hidden
    in-out property <string> pair-copy;          // "" hidden
    in-out property <bool> pair-again;
    callback pair-close();
    callback pair-swap-clicked();
    callback pair-copy-clicked();
    callback pair-again-clicked();

    // ── Session ──
    in-out property <bool> sess-open;
    in-out property <string> sess-state;         // "loading", "error", "empty", "list"
    in-out property <string> sess-error;
    in-out property <[OpsSettingsSession]> sessions;
    in-out property <int> sess-others;
    callback sess-toggle();
    callback sess-revoke(string);
    callback sess-revoke-others();

    // ── Configuration ──
    in-out property <string> env-path;
    in-out property <string> projects-dir;
    in-out property <string> web-port;
    in-out property <string> tunnel-token;
    in-out property <string> tunnel-url;
    in-out property <string> data-dir;
    in-out property <string> config-status;
    in-out property <string> config-tone;
    callback save-config();

    // ── Terminal ──
    in-out property <int> newline-key;           // 0 Shift+Enter, 1 Ctrl+Enter
    in-out property <string> autopark;
    in-out property <int> autopark-min: 10;
    callback set-newline-key(int);
    callback autopark-commit(string);

    // ── Desktop App (the PC client itself: the web's buildUpdatesSection) ──
    in-out property <bool> launch;
    in-out property <string> launch-hint;
    in-out property <bool> auto-update;
    in-out property <int> upd-channel;
    in-out property <string> upd-status;
    in-out property <bool> upd-avail;
    callback launch-toggle(bool);
    callback update-toggle(bool);
    callback upd-set-channel(int);
    callback update-check();
}

// ─── The sections ───

component ServerBody inherits VerticalLayout {
    spacing: Theme.sp-12;
    if OpsSettings.srv-body == "checking": SetHint { text: "Checking for updates…"; font-size: Theme.text-13; }
    if OpsSettings.srv-body == "starting": SetHint { text: "Starting the update…"; font-size: Theme.text-13; }
    if OpsSettings.srv-body == "error": SetHint { text: "Could not check for updates: " + OpsSettings.srv-error; font-size: Theme.text-13; }
    if OpsSettings.srv-body == "data": VerticalLayout {
        spacing: Theme.sp-12;
        SetInfoRow {
            title: "Version " + OpsSettings.srv-version;
            sub: OpsSettings.srv-sub;
            if OpsSettings.srv-act == "applying": SetStatus { text: "Working…"; }
            if OpsSettings.srv-act == "update": SmallBtn { text: "Check"; clicked => { OpsSettings.srv-check(); } }
            if OpsSettings.srv-act == "update": Btn { text: "Update to " + OpsSettings.srv-latest; primary: true; clicked => { OpsSettings.srv-apply(); } }
            if OpsSettings.srv-act == "check": SmallBtn { text: "Check now"; clicked => { OpsSettings.srv-check(); } }
        }
        SetInfoRow {
            title: "Release channel";
            sub: "Dev gets preview builds early. A newer production release is offered either way.";
            Seg { options: ["Production", "Dev"]; selected: OpsSettings.srv-channel; picked(i) => { OpsSettings.srv-set-channel(i); } }
        }
        if OpsSettings.srv-dev-note != "": SetHint { text: OpsSettings.srv-dev-note; }
        if OpsSettings.srv-blocker != "": SetHint { text: OpsSettings.srv-blocker; color: Theme.yellow; }
        if OpsSettings.srv-notes-url != "": HorizontalLayout {
            SetLink { text: "Release notes"; clicked => { OpsSettings.open-url(OpsSettings.srv-notes-url); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if OpsSettings.srv-log != "": Rectangle {
            background: Theme.bg-primary;
            border-radius: Theme.r-control;
            border-width: 1px; border-color: Theme.border;
            HorizontalLayout {
                padding: Theme.sp-8;
                Text { text: OpsSettings.srv-log; font-family: Theme.mono; font-size: Theme.text-10; color: Theme.text-muted; wrap: word-wrap; }
            }
        }
        if OpsSettings.srv-can-restart: VerticalLayout {
            spacing: Theme.sp-12;
            SetRule { }
            SetInfoRow {
                title: "";
                sub: "Settings like the Telegram token and TLS only take effect after a restart.";
                SmallBtn { text: "Restart server"; clicked => { OpsSettings.restart(); } }
            }
        }
    }
}

component ClaudeCodeBody inherits VerticalLayout {
    spacing: Theme.sp-8;
    if OpsSettings.cc-body == "checking": SetHint { text: "Checking…"; font-size: Theme.text-13; }
    if OpsSettings.cc-body == "installing": SetHint { text: "Installing… this can take a minute."; font-size: Theme.text-13; }
    if OpsSettings.cc-body == "error": SetHint { text: "Could not check: " + OpsSettings.cc-error; font-size: Theme.text-13; }
    if OpsSettings.cc-body == "data": VerticalLayout {
        spacing: Theme.sp-8;
        SetInfoRow {
            title: "Version " + OpsSettings.cc-version;
            sub: OpsSettings.cc-sub;
            if OpsSettings.cc-act == "applying": SetStatus { text: "Working…"; }
            if OpsSettings.cc-act == "update": SmallBtn { text: "Check"; clicked => { OpsSettings.cc-check(); } }
            if OpsSettings.cc-act == "update" && !OpsSettings.cc-beyond: Btn { text: "Update to " + OpsSettings.cc-latest; primary: true; clicked => { OpsSettings.cc-apply(); } }
            // Past the tested version: another colour, so the two decisions never look alike.
            if OpsSettings.cc-act == "update" && OpsSettings.cc-beyond: Rectangle {
                height: Theme.control;
                width: wl.preferred-width;
                border-radius: Theme.r-control;
                border-width: 1px; border-color: Theme.yellow;
                background: Theme.yellow-dim;
                wl := HorizontalLayout {
                    padding-left: Theme.sp-16; padding-right: Theme.sp-16;
                    Text { text: "Update to " + OpsSettings.cc-latest; vertical-alignment: center; color: Theme.yellow; font-size: Theme.text-13; font-weight: Theme.w-semibold; }
                }
                TouchArea { mouse-cursor: pointer; clicked => { OpsSettings.cc-apply(); } }
            }
            if OpsSettings.cc-act == "check": SmallBtn { text: "Check now"; clicked => { OpsSettings.cc-check(); } }
        }
        if OpsSettings.cc-tested != "": SetHint { text: OpsSettings.cc-tested; }
        if OpsSettings.cc-tested-warn != "": SetHint { text: OpsSettings.cc-tested-warn; color: Theme.yellow; }
        if OpsSettings.cc-blocker != "": SetHint { text: OpsSettings.cc-blocker; color: Theme.yellow; }
        if OpsSettings.cc-sudo != "": SetHint { text: OpsSettings.cc-sudo; }
        if OpsSettings.cc-last != "": SetHint { text: OpsSettings.cc-last; }
    }
}

component SysPromptBody inherits VerticalLayout {
    spacing: Theme.sp-12;
    SetHint { text: "Added to every chat and terminal Crundi starts, after its own description of this machine and the tools available here. Scheduled jobs deliberately get only that description, so an edit here cannot change what an unattended job does."; }
    VerticalLayout {
        spacing: Theme.sp-4;
        SetLabel { text: "Everywhere"; }
        TextArea { rows: 5; text <=> OpsSettings.sysprompt; placeholder: "e.g. Prefer small commits. Ask before installing anything globally."; }
        SetHint { text: "Applies to every project."; }
    }
    if OpsSettings.proj-name != "": VerticalLayout {
        spacing: Theme.sp-4;
        SetLabel { text: "Just " + OpsSettings.proj-name; }
        TextArea { rows: 5; text <=> OpsSettings.proj-sysprompt; placeholder: "e.g. This repo deploys on merge to main. Never push directly."; }
        SetHint { text: "Read last, so it wins where it disagrees with the box above."; }
    }
    if OpsSettings.proj-name == "": SetHint { text: "Open a project to give it its own additional prompt."; }
    SetHint { text: "Takes effect for new conversations. Claude Code records a conversation’s system prompt the first time it runs and replays that recording on every later turn and on resume, so a chat already open keeps the wording it started with."; }
    HorizontalLayout {
        spacing: Theme.sp-8;
        Btn { text: "Save prompts"; primary: true; clicked => { OpsSettings.save-prompts(); } }
        SetStatus { text: OpsSettings.sp-status; tone: OpsSettings.sp-tone; }
        Rectangle { horizontal-stretch: 1; }
    }
}

component VsSub inherits Text {
    font-size: Theme.text-13; font-weight: Theme.w-semibold; color: Theme.text-primary;
}

component VsSelect inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <[string]> options;
    in property <int> selected;
    callback picked(int);
    spacing: Theme.sp-4;
    SetLabel { text: root.label; }
    HorizontalLayout {
        Select { width: Theme.settings-select-w; options: root.options; selected: root.selected; picked(i) => { root.picked(i); } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.hint != "": SetHint { text: root.hint; }
}

component VsField inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> placeholder;
    in property <bool> password;
    in-out property <string> text;
    spacing: Theme.sp-4;
    SetLabel { text: root.label; }
    HorizontalLayout {
        TextField { width: Theme.settings-select-w; text <=> root.text; placeholder: root.placeholder; password: root.password; }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.hint != "": SetHint { text: root.hint; }
}

component VsNote inherits SetStatus {
    in property <bool> bad;
    tone: root.bad ? "error" : "";
}

component VoiceBody inherits VerticalLayout {
    spacing: Theme.sp-10;
    SetHint { text: "Click the mic in the top bar, hover over it, or hold the shortcut anywhere to talk to Cru, the voice assistant. What follows applies to Cru on every device."; }
    if OpsSettings.vs-shown: VerticalLayout {
        spacing: Theme.sp-10;
        VsSub { text: "Brain and model"; }
        if OpsSettings.vs-has-brain: VsSelect {
            label: "Brain"; options: ["Claude API (the key)", "Claude Code (your subscription)"]; selected: OpsSettings.vs-brain;
            hint: "An experiment: the same tools, rules and notebook either way. Each keeps its own conversation.";
            picked(i) => { OpsSettings.vs-pick("brain", i); }
        }
        VsSelect {
            label: "Model"; options: OpsSettings.vs-models; selected: OpsSettings.vs-model;
            hint: "Haiku is the quickest and cheapest. A change applies from the next conversation.";
            picked(i) => { OpsSettings.vs-pick("model", i); }
        }
        if OpsSettings.vs-has-effort: VsSelect {
            label: "Thinking effort"; options: OpsSettings.vs-efforts; selected: OpsSettings.vs-effort; hint: OpsSettings.vs-effort-hint;
            picked(i) => { OpsSettings.vs-pick("effort", i); }
        }
        if OpsSettings.vs-has-brain: VsSelect {
            label: "Stop Claude Code after"; options: OpsSettings.vs-cidles; selected: OpsSettings.vs-cidle;
            hint: "Your next message starts it again and carries on the same conversation.";
            picked(i) => { OpsSettings.vs-pick("cliIdleMinutes", i); }
        }
        VsSub { text: "Voice and listening"; }
        VsSelect { label: "Talking speed"; options: OpsSettings.vs-rates; selected: OpsSettings.vs-rate; picked(i) => { OpsSettings.vs-pick("speechRate", i); } }
        if OpsSettings.vs-has-volume: VsSelect {
            label: "Volume"; options: OpsSettings.vs-vols; selected: OpsSettings.vs-vol;
            hint: "How loud Cru talks, everywhere. Cru can change it too: say louder or quieter.";
            picked(i) => { OpsSettings.vs-pick("volume", i); }
        }
        VsSelect {
            label: "Pause before sending"; options: OpsSettings.vs-pauses; selected: OpsSettings.vs-pause;
            hint: "How long you may pause before what you said is sent.";
            picked(i) => { OpsSettings.vs-pick("pauseMs", i); }
        }
        if OpsSettings.vs-has-sclose: VsSelect {
            label: "Close the voice screen after"; options: OpsSettings.vs-scloses; selected: OpsSettings.vs-sclose;
            hint: "On the phone, the web and the PC. Hey Cru opens it again.";
            picked(i) => { OpsSettings.vs-pick("screenCloseSeconds", i); }
        }
        if OpsSettings.vs-has-admin: VerticalLayout {
            spacing: Theme.sp-4;
            HorizontalLayout {
                spacing: Theme.sp-6;
                CheckRow { text: ""; checked: OpsSettings.vs-admin; toggled(v) => { OpsSettings.vs-set-admin(v); } }
                VerticalLayout { alignment: center; Icon { source: Icons.shield-alert; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.text-primary; } }
                Text { text: "Admin mode"; font-size: Theme.text-13; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
            }
            SetHint { text: OpsSettings.vs-admin-hint; }
        }
        if OpsSettings.vs-has-away: VerticalLayout {
            spacing: Theme.sp-4;
            HorizontalLayout {
                spacing: Theme.sp-6;
                CheckRow { text: ""; checked: OpsSettings.vs-away; toggled(v) => { OpsSettings.vs-set-away(v); } }
                VerticalLayout { alignment: center; Icon { source: Icons.zap; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.text-primary; } }
                Text { text: "Cru on its own"; font-size: Theme.text-13; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
            }
            SetHint { text: "When nobody is talking to it (a wake-up, the heartbeat, a job it took on), Cru may do what is ticked below without asking. Anything else comes to your phone to approve or decline. With chats ticked, Cru also closes a chat without asking, even while you talk to it, once it has read what the chat is doing. Cru can switch this off, never on."; }
            VerticalLayout {
                padding-left: Theme.sp-24;
                spacing: Theme.sp-4;
                opacity: OpsSettings.vs-away ? 1 : Theme.o-dim;
                for c in OpsSettings.vs-away-classes: CheckRow { text: c.label; checked: c.checked; toggled(v) => { OpsSettings.vs-away-class(c.id, v); } }
            }
            HorizontalLayout {
                spacing: Theme.sp-8;
                SmallBtn { text: "Stop everything"; kind: "danger"; has-icon: true; icon: Icons.pause; clicked => { OpsSettings.vs-away-stop(); } }
                VsNote { text: OpsSettings.vs-away-note; bad: OpsSettings.vs-away-bad; }
                Rectangle { horizontal-stretch: 1; }
            }
            SetHint { text: "Switches this off, pauses every ticker and trigger Cru keeps (the heartbeat too), drops its questions and pauses its jobs."; }
        }
        VsSub { text: "Spending"; }
        SetHint { text: OpsSettings.vs-spend; }
        VsField { label: "Claude API monthly limit (US$)"; text <=> OpsSettings.vs-limit; hint: "Cru stops answering through the API at it."; }
        VsField { label: "Claude API billing day"; text <=> OpsSettings.vs-bday; hint: "The day of the month the API is billed; its spend restarts then."; }
        VsField { label: "Deepgram monthly limit (US$)"; text <=> OpsSettings.vs-dlimit; hint: "At it, the device voice and recogniser take over."; }
        VsField { label: "Deepgram billing day"; text <=> OpsSettings.vs-dday; }
        HorizontalLayout {
            spacing: Theme.sp-8;
            SmallBtn { text: "Save spending"; clicked => { OpsSettings.vs-save-spend(); } }
            VsNote { text: OpsSettings.vs-spend-note; bad: OpsSettings.vs-spend-bad; }
            Rectangle { horizontal-stretch: 1; }
        }
        VsSub { text: "Keys"; }
        VsField { label: "Claude API key (" + (OpsSettings.vs-akey-set ? "set" : "not set") + ")"; password: true; text <=> OpsSettings.vs-akey; placeholder: "Leave empty to keep the current key"; }
        VsField { label: "Deepgram API key (" + (OpsSettings.vs-dkey-set ? "set" : "not set") + ")"; password: true; text <=> OpsSettings.vs-dkey; placeholder: "Leave empty to keep the current key"; hint: "Listening and speaking."; }
        VsField { label: "Anthropic Admin API key, optional (" + (OpsSettings.vs-xkey-set ? "set" : "not set") + ")"; password: true; text <=> OpsSettings.vs-xkey; placeholder: "Leave empty to keep the current key"; hint: "Only to show the whole account usage."; }
        HorizontalLayout {
            spacing: Theme.sp-8;
            SmallBtn { text: "Save keys"; clicked => { OpsSettings.vs-save-keys(); } }
            VsNote { text: OpsSettings.vs-keys-note; bad: OpsSettings.vs-keys-bad; }
            Rectangle { horizontal-stretch: 1; }
        }
        VsSub { text: "Conversation and notebook"; }
        HorizontalLayout {
            spacing: Theme.sp-8;
            SmallBtn { text: "Start a fresh conversation"; clicked => { OpsSettings.vs-reset(); } }
            VsNote { text: OpsSettings.vs-reset-note; bad: OpsSettings.vs-reset-bad; }
            Rectangle { horizontal-stretch: 1; }
        }
        SetHint { text: "Nothing is lost: memory search keeps every earlier turn."; }
        if OpsSettings.vs-status != "": VsNote { text: OpsSettings.vs-status; bad: OpsSettings.vs-status-bad; }
    }
}

component ChannelsBody inherits VerticalLayout {
    spacing: Theme.sp-12;
    SetHint { text: "Which of these get told. Everything for you lands in the Crundi inbox first, and it is always on; turn on as many of the others as you like, or none at all. The table below decides which events are worth telling you about."; }
    for c in OpsSettings.channels: SetToggleRow {
        title: c.label; hint: c.hint; on: c.enabled; enabled: c.can-toggle;
        toggled(v) => { OpsSettings.channel-toggle(c.id, v); }
        // Web Push is a browser's: this client offers only the test (no "Allow in this browser").
        if c.id == "webpush" && c.available: HorizontalLayout {
            padding-top: Theme.sp-4;
            SmallBtn { text: "Send a test"; clicked => { OpsSettings.push-test(); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if c.telegram: VerticalLayout {
            spacing: Theme.sp-8;
            padding-top: Theme.sp-4;
            HorizontalLayout {
                spacing: Theme.sp-6;
                Text { text: "Bot:"; font-size: Theme.text-12; color: Theme.text-secondary; vertical-alignment: center; }
                VerticalLayout { alignment: center; Rectangle {
                    width: Theme.sp-8; height: Theme.sp-8; border-radius: Theme.sp-4;
                    background: OpsSettings.tgc-tone == "ok" ? Theme.green : OpsSettings.tgc-tone == "warn" ? Theme.yellow : OpsSettings.tgc-tone == "error" ? Theme.red : Theme.text-muted;
                } }
                Text { text: OpsSettings.tgc-state; font-size: Theme.text-12; color: Theme.text-secondary; vertical-alignment: center; }
                Text { text: "· token " + (OpsSettings.tgc-token-set ? "set" : "not set") + ","; font-size: Theme.text-12; color: Theme.text-muted; vertical-alignment: center; }
                SetLink { text: OpsSettings.tgc-token-set ? "edit under Sign-in" : "set it up under Sign-in"; clicked => { OpsSettings.goto-signin-telegram(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: Theme.sp-8;
                TextField { width: Theme.settings-chat-w; mono: true; text <=> OpsSettings.chat-id; placeholder: "Chat ID (filled in when you send /start)"; accepted => { OpsSettings.chat-save(); } }
                SmallBtn { text: "Save"; clicked => { OpsSettings.chat-save(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            SetHint { text: "Where messages go. Send /start to the bot and it fills itself in, or enter it by hand."; }
        }
    }
}

component NotifyBody inherits VerticalLayout {
    spacing: Theme.sp-12;
    SetHint { text: "Which events are worth a notification, sent on whichever channels are on above. “Always” sends every time; “When Away” only while you’re not focused on Crundi (browser tab / desktop app); “Never” is off."; }
    Rectangle {
        border-radius: Theme.r-card;
        border-width: 1px; border-color: Theme.border;
        background: Theme.bg-secondary;
        clip: true;
        VerticalLayout {
            // The head: Event, then the three modes.
            Rectangle {
                background: Theme.bg-tertiary;
                HorizontalLayout {
                    Text { horizontal-stretch: 1; text: "EVENT"; font-family: Theme.mono; font-size: Theme.text-10; letter-spacing: Theme.track-wide; color: Theme.text-muted; vertical-alignment: center; }
                    for m in ["ALWAYS", "WHEN AWAY", "NEVER"]: Rectangle {
                        width: Theme.settings-ntf-col;
                        Rectangle { x: 0; width: 1px; background: Theme.border; }
                        Text { text: m; font-family: Theme.mono; font-size: Theme.text-10; color: Theme.text-muted; horizontal-alignment: center; wrap: word-wrap; width: parent.width - Theme.sp-4; }
                    }
                    padding-left: Theme.sp-12;
                    min-height: Theme.control-lg;
                }
            }
            for r in OpsSettings.notify: VerticalLayout {
                Rectangle { height: 1px; background: Theme.border; }
                if r.cat != "": Rectangle {
                    background: Theme.bg-tertiary;
                    HorizontalLayout {
                        padding-left: Theme.sp-12; padding-top: Theme.sp-6; padding-bottom: Theme.sp-6;
                        Text { text: r.cat; font-size: Theme.text-10; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide; color: Theme.accent; }
                    }
                }
                if r.cat == "": Rectangle {
                    background: ra.has-hover ? Theme.bg-hover : transparent;
                    ra := TouchArea { }
                    HorizontalLayout {
                        Text { horizontal-stretch: 1; text: r.label; font-size: Theme.text-13; color: Theme.text-primary; vertical-alignment: center; wrap: word-wrap; }
                        padding-left: Theme.sp-12;
                        min-height: Theme.control-lg;
                        for m in ["always", "away", "never"]: Rectangle {
                            width: Theme.settings-ntf-col;
                            Rectangle { x: 0; width: 1px; background: Theme.border; }
                            NotifyLamp { on: r.mode == m; mode: m; picked => { OpsSettings.notify-pref(r.key, m); } }
                        }
                    }
                }
            }
        }
    }
}

component OAuthBlock inherits VerticalLayout {
    in property <OpsSettingsOAuth> o;
    in property <image> mark;
    in-out property <string> client-id;
    in-out property <string> secret;
    in-out property <string> allowed;
    spacing: Theme.sp-8;
    padding-top: Theme.sp-6;
    SetRule { }
    SetToggleRow {
        title: root.o.label; mark: root.mark; has-mark: true; hint: root.o.status;
        on: root.o.on; enabled: root.o.can-on || root.o.on;
        toggled(v) => { OpsSettings.method-toggle(root.o.key, v); }
    }
    SetLabel { text: "Callback URL to give " + root.o.label; }
    HorizontalLayout {
        spacing: Theme.sp-8;
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg-primary;
            border-radius: Theme.r-control;
            border-width: 1px; border-color: Theme.border;
            HorizontalLayout {
                padding-left: Theme.sp-10; padding-right: Theme.sp-10; padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
                Text { text: root.o.url != "" ? root.o.url : "Unknown until this server has a public address"; font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-primary; wrap: word-wrap; }
            }
        }
        if root.o.url != "": SmallBtn { text: "Copy"; clicked => { OpsSettings.oauth-copy(root.o.key); } }
    }
    HorizontalLayout {
        spacing: Theme.sp-6;
        SetHint { horizontal-stretch: 1; text: root.o.howto + (root.o.local ? " This is a local address: it only works when signing in on this computer." : ""); }
        VerticalLayout { alignment: start; SetLink { text: "Open"; clicked => { OpsSettings.open-url(root.o.key == "google" ? "https://console.cloud.google.com/apis/credentials" : "https://github.com/settings/applications/new"); } } }
    }
    HorizontalLayout {
        spacing: Theme.sp-8;
        VerticalLayout { spacing: Theme.sp-4; horizontal-stretch: 1; SetLabel { text: "Client ID"; } TextField { mono: true; text <=> root.client-id; } }
        VerticalLayout { spacing: Theme.sp-4; horizontal-stretch: 1; SetLabel { text: "Client secret"; } TextField { mono: true; password: true; text <=> root.secret; placeholder: root.o.secret-set ? "Saved (leave blank to keep)" : "Not set"; } }
    }
    VerticalLayout { spacing: Theme.sp-4; SetLabel { text: root.o.acct; } TextField { text <=> root.allowed; placeholder: root.o.ph; } }
    HorizontalLayout {
        spacing: Theme.sp-8;
        Btn { text: "Save"; primary: true; clicked => { OpsSettings.oauth-save(root.o.key); } }
        SmallBtn { text: "Test"; enabled: root.o.configured; clicked => { OpsSettings.oauth-test(root.o.key); } }
        if root.o.configured: SmallBtn { text: "Remove"; clicked => { OpsSettings.oauth-clear(root.o.key); } }
        SetStatus { text: root.o.test-line; }
        Rectangle { horizontal-stretch: 1; }
    }
}

component SignInBody inherits VerticalLayout {
    spacing: Theme.sp-10;
    SetHint { text: "Any one of these is enough, any mix can be on, and one must always stay on."; }
    SetToggleRow {
        title: "Password + authenticator code";
        hint: OpsSettings.pw-set ? "A password and a 6-digit code. Setting a new password issues a new code source." : "Not set up yet. Choose a password below to enable it.";
        on: OpsSettings.pw-on; enabled: OpsSettings.pw-set;
        toggled(v) => { OpsSettings.method-toggle("password", v); }
    }
    HorizontalLayout {
        spacing: Theme.sp-8;
        TextField {
            horizontal-stretch: 1; password: true; text <=> OpsSettings.new-password;
            placeholder: OpsSettings.pw-set ? "New password (12+ characters)" : "Choose a password (12+ characters)";
            accepted => { OpsSettings.set-password(); }
        }
        Btn { text: OpsSettings.pw-set ? "Change" : "Set"; primary: true; clicked => { OpsSettings.set-password(); } }
    }
    if OpsSettings.enrol-secret != "": Rectangle {
        border-radius: Theme.r-field;
        border-width: 1px; border-color: Theme.accent;
        background: Theme.accent-dim;
        VerticalLayout {
            padding: Theme.sp-12;
            spacing: Theme.sp-6;
            Text { text: "Add this to your authenticator app"; font-weight: Theme.w-semibold; color: Theme.text-primary; font-size: Theme.text-13; }
            SetHint { text: "Shown once. Without it you will not be able to sign in with the new password."; }
            Rectangle {
                background: Theme.bg-primary;
                border-radius: Theme.r-control;
                border-width: 1px; border-color: Theme.border;
                HorizontalLayout {
                    padding: Theme.sp-8;
                    TextInput { text: OpsSettings.enrol-secret; read-only: true; font-family: Theme.mono; font-size: Theme.text-15; letter-spacing: Theme.track-wide; color: Theme.text-primary; horizontal-alignment: center; wrap: word-wrap; }
                }
            }
        }
    }
    // Telegram (authTelegramSettings): an older server sends no bot block, so only the switch.
    if !OpsSettings.tg-has: SetToggleRow {
        title: "Telegram"; mark: @image-url("settings-icons/telegram.svg"); has-mark: true;
        on: OpsSettings.tg-on; enabled: OpsSettings.tg-can || OpsSettings.tg-on;
        toggled(v) => { OpsSettings.method-toggle("telegram", v); }
    }
    if OpsSettings.tg-has: VerticalLayout {
        spacing: Theme.sp-8;
        padding-top: Theme.sp-6;
        SetRule { }
        SetToggleRow {
            title: "Telegram"; mark: @image-url("settings-icons/telegram.svg"); has-mark: true; hint: OpsSettings.tg-status;
            on: OpsSettings.tg-on; enabled: OpsSettings.tg-can || OpsSettings.tg-on;
            toggled(v) => { OpsSettings.method-toggle("telegram", v); }
        }
        HorizontalLayout {
            spacing: Theme.sp-6;
            SetHint { horizontal-stretch: 1; text: "In Telegram, message @BotFather, send /newbot and copy the token it gives you. The same bot sends the Telegram notification channel."; }
            VerticalLayout { alignment: start; SetLink { text: "Open"; clicked => { OpsSettings.open-url("https://t.me/BotFather"); } } }
        }
        HorizontalLayout {
            spacing: Theme.sp-8;
            VerticalLayout { spacing: Theme.sp-4; horizontal-stretch: 1; SetLabel { text: "Bot token"; } TextField { mono: true; password: true; text <=> OpsSettings.tg-token; placeholder: OpsSettings.tg-token-set ? "Saved (leave blank to keep)" : "123456:ABC-DEF..."; } }
            VerticalLayout { spacing: Theme.sp-4; horizontal-stretch: 1; SetLabel { text: "Allowed Telegram username"; } TextField { text <=> OpsSettings.tg-user; placeholder: "your-username"; } }
        }
        HorizontalLayout {
            spacing: Theme.sp-8;
            Btn { text: "Save"; primary: true; clicked => { OpsSettings.tg-save(); } }
            if OpsSettings.tg-restart: SmallBtn { text: "Restart now"; clicked => { OpsSettings.restart(); } }
            if OpsSettings.tg-token-set: SmallBtn { text: "Remove"; clicked => { OpsSettings.tg-clear(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    if OpsSettings.oauth-has: OAuthBlock {
        o: OpsSettings.google; mark: @image-url("settings-icons/google.svg");
        client-id <=> OpsSettings.google-id; secret <=> OpsSettings.google-secret; allowed <=> OpsSettings.google-allowed;
    }
    if OpsSettings.oauth-has: OAuthBlock {
        o: OpsSettings.github; mark: @image-url("settings-icons/github.svg");
        client-id <=> OpsSettings.github-id; secret <=> OpsSettings.github-secret; allowed <=> OpsSettings.github-allowed;
    }
}

component PhoneBody inherits VerticalLayout {
    spacing: Theme.sp-10;
    HorizontalLayout {
        spacing: Theme.sp-12;
        SetHint { horizontal-stretch: 1; vertical-alignment: center; text: "Pair the Crundi app on a phone with this server. It shows a picture for the phone to scan, so no password is typed on the phone."; }
        VerticalLayout { alignment: center; SmallBtn { text: "Connect a phone"; clicked => { OpsSettings.phone-connect(); } } }
    }
    Text { text: "Notifications on the phone"; font-size: Theme.text-12; color: Theme.text-secondary; }
    if OpsSettings.push-state == "checking": SetHint { text: "Checking…"; font-size: Theme.text-12; }
    if OpsSettings.push-state == "none": SetHint { text: "Phone notifications are not available on this server."; font-size: Theme.text-12; }
    if OpsSettings.push-state == "data": VerticalLayout {
        spacing: Theme.sp-8;
        Text { text: OpsSettings.push-line; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
        if OpsSettings.push-contact != "": HorizontalLayout {
            SetLink { text: OpsSettings.push-contact; clicked => { OpsSettings.open-url(OpsSettings.push-contact-url); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if OpsSettings.push-error != "": SetHint { text: OpsSettings.push-error; color: Theme.yellow; }
        HorizontalLayout {
            spacing: Theme.sp-8;
            TextField {
                horizontal-stretch: 1; password: true; text <=> OpsSettings.push-key;
                placeholder: OpsSettings.push-has-key ? "Paste a new key to replace it" : "Paste the push key";
                accepted => { OpsSettings.push-save(); }
            }
            Btn { text: "Save"; primary: true; clicked => { OpsSettings.push-save(); } }
            if OpsSettings.push-has-key: SmallBtn { text: "Test"; clicked => { OpsSettings.push-mobile-test(); } }
            if OpsSettings.push-has-key: SmallBtn { text: "Remove"; clicked => { OpsSettings.push-remove(); } }
        }
        // A custom relay is for a custom build of the app: folded away (<details>).
        HorizontalLayout {
            spacing: Theme.sp-4;
            VerticalLayout { alignment: center; Icon { source: OpsSettings.relay-open ? @image-url("../shapes/chevron-down.svg") : Icons.chevron-right; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.text-muted; } }
            Text {
                text: "Relay: " + OpsSettings.relay-summary; font-size: Theme.text-12; color: Theme.text-muted; vertical-alignment: center;
                TouchArea { mouse-cursor: pointer; clicked => { OpsSettings.relay-open = !OpsSettings.relay-open; } }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if OpsSettings.relay-open: VerticalLayout {
            spacing: Theme.sp-8;
            SetHint { text: "Only change this if you use your own build of the app, with its own relay. The published app works with the published relay and no other. Changing the relay removes the key."; }
            HorizontalLayout {
                spacing: Theme.sp-8;
                TextField { horizontal-stretch: 1; text <=> OpsSettings.relay-url; placeholder: "https://your-relay.example"; }
                SmallBtn { text: OpsSettings.relay-custom ? "Save" : "Use this relay"; clicked => { OpsSettings.relay-save(OpsSettings.relay-url); } }
                if OpsSettings.relay-custom: SmallBtn { text: "Use the published relay"; clicked => { OpsSettings.relay-save(""); } }
            }
        }
    }
}

component SessionBody inherits VerticalLayout {
    spacing: Theme.sp-10;
    HorizontalLayout {
        spacing: Theme.sp-12;
        SetHint { horizontal-stretch: 1; vertical-alignment: center; text: "Ends this sign-in on this device and revokes its tokens, so they cannot be refreshed. Also clears the cookie that reaches private forwards."; }
        // Two-step, as the web's: easy to hit by accident, and the way back is the sign-in screen.
        VerticalLayout { alignment: center; SmallBtn { text: "Sign out of " + Shell.server; confirm-text: "Sign out?"; clicked => { Shell.sign-out(); } } }
    }
    HorizontalLayout {
        spacing: Theme.sp-8;
        Text { horizontal-stretch: 1; text: "Signed in devices"; font-size: Theme.text-12; color: Theme.text-secondary; vertical-alignment: center; }
        SmallBtn { text: OpsSettings.sess-open ? "Hide" : "Show"; clicked => { OpsSettings.sess-toggle(); } }
    }
    if OpsSettings.sess-open && OpsSettings.sess-state == "loading": SetHint { text: "Loading…"; font-size: Theme.text-13; }
    if OpsSettings.sess-open && OpsSettings.sess-state == "error": SetHint { text: "Could not load sessions: " + OpsSettings.sess-error; font-size: Theme.text-13; }
    if OpsSettings.sess-open && OpsSettings.sess-state == "empty": SetHint { text: "No active sessions."; font-size: Theme.text-13; }
    if OpsSettings.sess-open && OpsSettings.sess-state == "list": VerticalLayout {
        for s[i] in OpsSettings.sessions: VerticalLayout {
            if i > 0: SetRule { }
            HorizontalLayout {
                padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
                spacing: Theme.sp-12;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.sp-2;
                    HorizontalLayout {
                        spacing: Theme.sp-6;
                        Text { text: s.label; font-size: Theme.text-13; color: Theme.text-primary; overflow: elide; }
                        if s.current: Rectangle {
                            border-radius: Theme.r-chip;
                            background: Theme.accent-dim;
                            width: tl.preferred-width + Theme.sp-12;
                            tl := Text { text: "this device"; font-size: Theme.text-10; color: Theme.accent-hover; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    SetHint { text: s.desc; }
                }
                VerticalLayout {
                    alignment: center;
                    if s.current: Text { text: "—"; color: Theme.text-muted; font-size: Theme.text-12; }
                    if !s.current: SmallBtn { text: "Revoke"; kind: "danger"; confirm-text: "Revoke?"; clicked => { OpsSettings.sess-revoke(s.id); } }
                }
            }
        }
        if OpsSettings.sess-others > 0: HorizontalLayout {
            padding-top: Theme.sp-10;
            alignment: end;
            SmallBtn {
                text: "Sign out the other " + (OpsSettings.sess-others == 1 ? "device" : OpsSettings.sess-others + " devices");
                kind: "danger"; confirm-text: "Sign them all out?";
                clicked => { OpsSettings.sess-revoke-others(); }
            }
        }
    }
}

component ConfigField inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> placeholder;
    in property <bool> password;
    in-out property <string> text;
    spacing: Theme.sp-4;
    SetLabel { text: root.label; }
    TextField { mono: true; password: root.password; text <=> root.text; placeholder: root.placeholder; }
    SetHint { text: root.hint; }
}

component ConfigBody inherits VerticalLayout {
    spacing: Theme.sp-12;
    HorizontalLayout {
        spacing: Theme.sp-6;
        Text { text: "Changes are saved to"; font-size: Theme.text-12; color: Theme.text-muted; vertical-alignment: center; }
        Rectangle {
            background: Theme.bg-tertiary; border-radius: Theme.r-chip;
            HorizontalLayout { padding-left: Theme.sp-4; padding-right: Theme.sp-4; padding-top: Theme.sp-2; padding-bottom: Theme.sp-2;
                Text { text: OpsSettings.env-path; font-family: Theme.mono; font-size: Theme.text-11; color: Theme.text-secondary; overflow: elide; } }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    ConfigField { label: "Projects Directory"; text <=> OpsSettings.projects-dir; placeholder: "C:\\Projects"; hint: "Single mode: subfolders auto-discovered. Leave empty for multi mode (add projects individually)."; }
    ConfigField { label: "Web Port"; text <=> OpsSettings.web-port; placeholder: "0 (auto)"; hint: "Port for the web UI. 0 = auto-assign."; }
    ConfigField { label: "Cloudflare Tunnel Token"; password: true; text <=> OpsSettings.tunnel-token; placeholder: "(optional)"; hint: "For a persistent custom domain. Leave empty for random quick tunnel."; }
    ConfigField { label: "Cloudflare Tunnel URL"; text <=> OpsSettings.tunnel-url; placeholder: "https://crundi.example.com"; hint: "Your public tunnel URL (used with named tunnel token above)."; }
    ConfigField { label: "Data Directory"; text <=> OpsSettings.data-dir; placeholder: "(default: platform app dir)"; hint: "Override data storage location. Leave empty for default."; }
    HorizontalLayout {
        spacing: Theme.sp-8;
        Btn { text: "Save"; primary: true; clicked => { OpsSettings.save-config(); } }
        SetStatus { text: OpsSettings.config-status; tone: OpsSettings.config-tone; }
        Rectangle { horizontal-stretch: 1; }
    }
}

component TerminalBody inherits VerticalLayout {
    spacing: Theme.sp-12;
    VerticalLayout {
        spacing: Theme.sp-4;
        SetLabel { text: "New Line Key"; }
        Seg { options: ["Shift + Enter", "Ctrl + Enter"]; selected: OpsSettings.newline-key; picked(i) => { OpsSettings.set-newline-key(i); } }
        SetHint { text: "Inserts a newline in the terminal instead of submitting — the other key still submits. Applies instantly to all terminals."; }
    }
    VerticalLayout {
        spacing: Theme.sp-4;
        SetLabel { text: "Close idle panes after (minutes)"; }
        HorizontalLayout {
            ap := TextField {
                width: Theme.settings-num-w; text <=> OpsSettings.autopark;
                accepted(t) => { OpsSettings.autopark-commit(t); }
                // The web saves on change: Enter, or leaving the field.
                changed has-focus => { if !self.has-focus { OpsSettings.autopark-commit(self.text); } }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        SetHint { text: "A chat or Claude terminal with nothing going on closes once you have also been away this long. It keeps its place, shows what it was, and Resume picks the conversation back up. 0 turns it off; otherwise at least " + OpsSettings.autopark-min + ". Shells are never closed for being idle. After a restart, every pane that was open comes back the same way."; }
    }
}

component DesktopBody inherits VerticalLayout {
    spacing: Theme.sp-12;
    SetInfoRow {
        title: "Launch at startup"; sub: OpsSettings.launch-hint;
        Toggle { on: OpsSettings.launch; toggled(v) => { OpsSettings.launch-toggle(v); } }
    }
    SetInfoRow {
        title: "Automatic updates"; sub: "Check on launch and once a day. Always asks before installing.";
        Toggle { on: OpsSettings.auto-update; toggled(v) => { OpsSettings.update-toggle(v); } }
    }
    SetInfoRow {
        title: "Release channel"; sub: "Dev gets preview builds early. A newer production release is offered either way.";
        Seg { options: ["Production", "Dev"]; selected: OpsSettings.upd-channel; picked(i) => { OpsSettings.upd-set-channel(i); } }
    }
    HorizontalLayout {
        spacing: Theme.sp-12;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.sp-8;
            VerticalLayout { alignment: center; Rectangle { width: Theme.sp-8; height: Theme.sp-8; border-radius: Theme.sp-4; background: OpsSettings.upd-avail ? Theme.accent : Theme.green; } }
            Text { text: OpsSettings.upd-status; font-size: Theme.text-13; color: OpsSettings.upd-avail ? Theme.accent-hover : Theme.text-secondary; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        SmallBtn { text: "Check now"; clicked => { OpsSettings.update-check(); } }
    }
}

/// The screen (a tab, or a panel in a workbench pane: `embedded`, `key`).
export component OpsSettingsView inherits Rectangle {
    in property <string> kind;
    in property <string> key;
    in property <bool> embedded;
    PanelPage {
        embedded: root.embedded;
        if OpsSettings.state == "loading": LoadingState { }
        if OpsSettings.state == "error": ErrorState { text: OpsSettings.error; retried => { OpsSettings.reload(); } }
        if OpsSettings.state == "data": VerticalLayout {
            spacing: Theme.sp-12;
            SetGroup { text: "CRUNDI"; }
            if OpsSettings.srv-shown: SetFold { title: "Server"; open <=> OpsSettings.open-server; ServerBody { } }
            SetFold { title: "Claude Code"; open <=> OpsSettings.open-cc; ClaudeCodeBody { } }
            SetFold {
                title: "What’s new"; open <=> OpsSettings.open-whatsnew;
                HorizontalLayout {
                    spacing: Theme.sp-12;
                    SetHint { horizontal-stretch: 1; vertical-alignment: center; font-size: Theme.text-12; text: "A short tour of what the latest update added. It shows by itself once after each update."; }
                    VerticalLayout { alignment: center; SmallBtn { text: "Show it again"; clicked => { OpsSettings.whats-new(); } } }
                }
            }
            SetGroup { text: "CLAUDE"; padding-top: Theme.sp-8; }
            SetFold { title: "System prompt"; open <=> OpsSettings.open-sysprompt; SysPromptBody { } }
            SetFold { title: "Skills"; open <=> OpsSettings.open-skills; OpsSkillsSection { } }
            SetFold { title: "Usage"; open <=> OpsSettings.open-usage; OpsUsageSection { } }
            SetGroup { text: "CRU"; padding-top: Theme.sp-8; }
            SetFold { title: "Voice assistant"; open <=> OpsSettings.open-voice; VoiceBody { } }
            SetGroup { text: "NOTIFICATIONS"; padding-top: Theme.sp-8; }
            SetFold { title: "Notification Channels"; open <=> OpsSettings.open-channels; ChannelsBody { } }
            SetFold { title: "Notification Settings"; open <=> OpsSettings.open-notify; NotifyBody { } }
            SetGroup { text: "ACCESS"; padding-top: Theme.sp-8; }
            SetFold { title: "Sign-in"; open <=> OpsSettings.open-signin; SignInBody { } }
            SetFold { title: "Phone app"; open <=> OpsSettings.open-phone; PhoneBody { } }
            SetFold { title: "Session"; open <=> OpsSettings.open-session; SessionBody { } }
            SetGroup { text: "THIS SERVER"; padding-top: Theme.sp-8; }
            SetFold { title: "Configuration"; open <=> OpsSettings.open-config; ConfigBody { } }
            SetFold { title: "Terminal"; open <=> OpsSettings.open-terminal; TerminalBody { } }
            SetFold { title: "Backup & restore"; open <=> OpsSettings.open-backup; OpsBackupSection { } }
            // Not in the web's groups: organizeSettings puts it under "More", at the end.
            SetGroup { text: "MORE"; padding-top: Theme.sp-8; }
            SetFold { title: "Desktop App"; open <=> OpsSettings.open-desktop; DesktopBody { } }
        }
    }
}

/// This screen's dialogs over the whole window (no input where it draws nothing).
export component OpsSettingsOverlay inherits Rectangle {
    // Connect a phone (crundi-phone.js connect()): the picture, the line under
    // it, the countdown, the swap and copy links, New code and Close.
    if OpsSettings.pair-open: Modal {
        width: root.width; height: root.height;
        title: "Connect a phone";
        close => { OpsSettings.pair-close(); }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(Theme.settings-pair-pic, root.width - 2 * Theme.sp-48);
                height: self.width;
                border-radius: Theme.r-bubble + Theme.sp-10;
                background: Theme.backdrop;
                clip: true;
                if OpsSettings.pair-has-image: Image { width: parent.width; height: parent.height; source: OpsSettings.pair-image; image-fit: contain; }
                if !OpsSettings.pair-has-image: Text { text: OpsSettings.pair-pic-text; color: Theme.text-muted; font-size: Theme.text-13; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text {
            text: OpsSettings.pair-line; horizontal-alignment: center; wrap: word-wrap;
            font-size: Theme.text-13; color: OpsSettings.pair-done ? Theme.green : Theme.text-secondary;
            font-weight: OpsSettings.pair-done ? Theme.w-bold : Theme.w-regular;
        }
        if OpsSettings.pair-small != "": Text { text: OpsSettings.pair-small; horizontal-alignment: center; wrap: word-wrap; font-size: Theme.text-11; color: Theme.text-muted; }
        if OpsSettings.pair-swap != "": HorizontalLayout { alignment: center; SetLink { text: OpsSettings.pair-swap; clicked => { OpsSettings.pair-swap-clicked(); } } }
        if OpsSettings.pair-copy != "": HorizontalLayout { alignment: center; SetLink { text: OpsSettings.pair-copy; clicked => { OpsSettings.pair-copy-clicked(); } } }
        HorizontalLayout {
            alignment: center;
            spacing: Theme.sp-10;
            if OpsSettings.pair-again: Btn { text: "New code"; primary: true; clicked => { OpsSettings.pair-again-clicked(); } }
            Btn { text: "Close"; clicked => { OpsSettings.pair-close(); } }
        }
    }
}
