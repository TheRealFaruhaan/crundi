// Ops area: Homepool (app/vendor/crundi-homepool.js, loadHomepoolTab and
// homepoolFromHash in src/webapp-html.js): the shared exit. Networks (the
// server, the standalone homepool bridge, the owner's own networks and their
// nodes), Access (every key), Requests (what chats asked for) and Activity
// (the change log); the summary; the node, access, node-setup and secret
// dialogs. Confirms and prompts are the shared ones (kit::confirm/prompt).
// OpsHomepool (the global) is what Rust reads, sets and handles: src/ops/homepool.rs.

import { Theme, Icons, Icon, PanelPage, SmallBtn, TextField, CheckRow, Select, Toggle, Modal, ModalActions, FormLabel } from "../kit.slint";
import { OpsDkChip, DkChip, DkSegBtn, DkSeg, DkStat, DkQuiet } from "docker-parts.slint";

export struct OpsHpTab { key: string, label: string, count: string, alert: bool }
export struct OpsHpStat { v: string, l: string }
export struct OpsHpNode { id: string, name: string, dot: string, state: string, tone: string, meta: string, net: int, on: bool }
export struct OpsHpNet { id: string, name: string, kind: string, chip: string, tone: string, on: bool, body: string, err: string, nodes: [OpsHpNode] }
/// A line of "how to use" or a dialog: "quiet" words, or "code" with its Copy.
export struct OpsHpUse { label: string, kind: string, text: string }
export struct OpsHpKey { id: string, name: string, nets: [string], state: string, tone: string, on: bool, meta: string, open: bool, software: bool, uses: [OpsHpUse] }
export struct OpsHpReq { id: string, title: string, nets: [string], status: string, tone: string, pending: bool, meta: string, reason: string }
export struct OpsHpLog { at: string, what: string, subj: string }
export struct OpsHpCheck { label: string, on: bool }

export global OpsHomepool {
    /// A dialog of this screen covers the window (OpsOverlay sets Shell.modal-ops).
    in-out property <bool> modal;
    in property <string> state: "loading";   // "loading", "error", "data"
    in property <string> error;
    in property <string> tab: "networks";
    in property <[OpsHpTab]> tabs;
    in property <[OpsHpStat]> sum;
    in property <[OpsHpNet]> nets;
    in property <[OpsHpNode]> loose;
    in property <[string]> move-opts;          // a node's network <select>
    in property <[OpsHpKey]> keys;
    in property <[OpsHpReq]> reqs;
    in property <[OpsHpLog]> log;
    // The dialogs: "" none, "node" (add a node), "key" (give or change access), "show" (a key or secret, shown once).
    in property <string> dlg;
    in property <string> dlg-title;
    in property <string> dlg-label;
    in-out property <string> n-name;
    in-out property <int> n-net;
    in property <[string]> n-nets;
    in-out property <int> k-kind;
    in property <bool> k-kind-locked;
    in-out property <string> k-name;
    in-out property <int> k-project;
    in property <[string]> k-projects;
    in property <bool> k-project-locked;
    in-out property <string> k-chat;
    in property <[OpsHpCheck]> k-nets;
    in-out property <bool> k-fb;
    in-out property <string> k-exp;
    in-out property <string> k-cap;
    in-out property <string> k-slots;
    in-out property <bool> k-block;
    in-out property <string> k-from;
    in property <string> show-warn;
    in property <[OpsHpUse]> show-items;
    in property <string> qr;
    in property <float> qr-n;
    in property <string> show-warn2;

    callback set-tab(string);
    callback act(string, string);
    callback node-move(string, int);
    callback toggle(string, string, bool);
    callback copy(string);
    callback key-net(int, bool);
    callback dlg-ok();
    callback dlg-close();
}

component HpChip inherits DkChip {
    in property <string> text;
    in property <string> tone;
    c: { text: root.text, tone: root.tone };
}

component HpCard inherits Rectangle {
    background: Theme.bg-secondary;
    border-radius: Theme.r-field;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    VerticalLayout { @children }
}

component HpHead inherits Rectangle {
    min-height: Theme.control + Theme.sp-4;
    HorizontalLayout {
        padding-left: Theme.sp-12; padding-right: Theme.sp-12;
        padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
        spacing: Theme.sp-8;
        @children
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
}

component HpTitle inherits Text {
    vertical-alignment: center; font-size: Theme.text-14; font-weight: Theme.w-semibold; color: Theme.text-primary;
}

component HpMeta inherits Text {
    font-size: Theme.text-12; color: Theme.text-muted; wrap: word-wrap;
}

/// "code": a mono box and its Copy (.hp-code); "quiet": muted words.
component HpUseLine inherits VerticalLayout {
    in property <OpsHpUse> u;
    spacing: Theme.sp-4;
    if root.u.label != "": FormLabel { text: root.u.label; }
    if root.u.kind == "quiet": HpMeta { text: root.u.text; }
    if root.u.kind == "warn": Rectangle {
        background: Theme.yellow-dim; border-radius: Theme.r-field; border-width: 1px; border-color: Theme.yellow;
        HorizontalLayout { padding: Theme.sp-8; Text { text: root.u.text; font-size: Theme.text-12; color: Theme.text-primary; wrap: word-wrap; } }
    }
    if root.u.kind == "code": Rectangle {
        background: Theme.bg-tertiary; border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border;
        HorizontalLayout { padding: Theme.sp-8; Text { text: root.u.text; font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-primary; wrap: char-wrap; } }
    }
    if root.u.kind == "code": HorizontalLayout { alignment: start; SmallBtn { has-icon: true; icon: Icons.copy; text: "Copy"; clicked => { OpsHomepool.copy(root.u.text); } } }
}

component HpNodeRow inherits HorizontalLayout {
    in property <OpsHpNode> n;
    padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
    spacing: Theme.sp-10;
    VerticalLayout {
        padding-top: Theme.sp-4;
        Rectangle {
            width: Theme.sp-8; height: Theme.sp-8; border-radius: Theme.sp-4;
            background: root.n.dot == "up" ? Theme.green : root.n.dot == "paused" ? Theme.yellow : Theme.text-muted;
        }
        Rectangle { }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Theme.sp-4;
        HorizontalLayout {
            spacing: Theme.sp-6;
            Text { text: root.n.name; font-size: Theme.text-13; font-weight: Theme.w-semibold; color: Theme.text-primary; vertical-alignment: center; }
            VerticalLayout { alignment: center; HpChip { text: root.n.state; tone: root.n.tone; } }
            Rectangle { horizontal-stretch: 1; }
        }
        HpMeta { text: root.n.meta; }
        HorizontalLayout {
            spacing: Theme.sp-6;
            alignment: start;
            Select { width: Theme.docker-filter-w; options: OpsHomepool.move-opts; selected: root.n.net; picked(i) => { OpsHomepool.node-move(root.n.id, i); } }
            VerticalLayout { alignment: center; Toggle { on: root.n.on; toggled(on) => { OpsHomepool.toggle("node", root.n.id, on); } } }
            VerticalLayout { alignment: center; SmallBtn { text: "Rename"; clicked => { OpsHomepool.act("node-rename", root.n.id); } } }
            VerticalLayout { alignment: center; SmallBtn { text: "New key"; clicked => { OpsHomepool.act("node-reissue", root.n.id); } } }
            VerticalLayout { alignment: center; SmallBtn { kind: "danger"; text: "Remove"; clicked => { OpsHomepool.act("node-remove", root.n.id); } } }
        }
    }
}

component HpNetworks inherits VerticalLayout {
    spacing: Theme.sp-12;
    HpMeta { text: "Traffic leaves only through a network a key was given. Put each node in the network it really is on: two phones on one home Wi-Fi share one address."; }
    for n in OpsHomepool.nets: HpCard {
        HpHead {
            HpTitle { text: n.name; }
            VerticalLayout { alignment: center; HpChip { text: n.id; } }
            if n.chip != "": VerticalLayout { alignment: center; HpChip { text: n.chip; tone: n.tone; } }
            Rectangle { horizontal-stretch: 1; }
            if n.kind == "pool": VerticalLayout { alignment: center; Toggle { on: n.on; toggled(on) => { OpsHomepool.toggle("pool", "pool", on); } } }
            if n.kind == "own": VerticalLayout { alignment: center; SmallBtn { text: "Rename"; clicked => { OpsHomepool.act("net-rename", n.id); } } }
            if n.kind == "own": VerticalLayout { alignment: center; SmallBtn { kind: "danger"; text: "Remove"; clicked => { OpsHomepool.act("net-remove", n.id); } } }
        }
        VerticalLayout {
            padding-left: Theme.sp-12; padding-right: Theme.sp-12;
            padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
            if n.body != "": HpMeta { text: n.body; }
            if n.err != "": Text { text: n.err; font-size: Theme.text-12; color: Theme.red; wrap: word-wrap; }
            for x[i] in n.nodes: VerticalLayout {
                if i > 0: Rectangle { height: 1px; background: Theme.border-subtle; }
                HpNodeRow { n: x; }
            }
        }
    }
    if OpsHomepool.loose.length > 0: HpCard {
        HpHead {
            HpTitle { text: "Not in a network"; }
            Text { text: "carry nothing until you put them in one"; vertical-alignment: center; font-size: Theme.text-12; color: Theme.text-muted; }
            Rectangle { horizontal-stretch: 1; }
        }
        VerticalLayout {
            padding-left: Theme.sp-12; padding-right: Theme.sp-12;
            padding-top: Theme.sp-4; padding-bottom: Theme.sp-4;
            for x[i] in OpsHomepool.loose: VerticalLayout {
                if i > 0: Rectangle { height: 1px; background: Theme.border-subtle; }
                HpNodeRow { n: x; }
            }
        }
    }
}

component HpAccess inherits VerticalLayout {
    spacing: Theme.sp-12;
    if OpsHomepool.keys.length == 0: DkQuiet { text: "No access given yet, so nothing can use homepool. Add access for a chat, a project or a piece of software, or approve a request from a chat."; }
    for k in OpsHomepool.keys: HpCard {
        HpHead {
            HpTitle { text: k.name; }
            for n in k.nets: VerticalLayout { alignment: center; HpChip { text: n; } }
            VerticalLayout { alignment: center; HpChip { text: k.state; tone: k.tone; } }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout { alignment: center; Toggle { on: k.on; toggled(on) => { OpsHomepool.toggle("key", k.id, on); } } }
        }
        VerticalLayout {
            padding-left: Theme.sp-12; padding-right: Theme.sp-12;
            padding-top: Theme.sp-8; padding-bottom: Theme.sp-10;
            spacing: Theme.sp-6;
            HpMeta { text: k.meta; }
            HorizontalLayout {
                spacing: Theme.sp-6;
                alignment: start;
                SmallBtn { text: k.open ? "Hide" : "How to use"; clicked => { OpsHomepool.act("key-use", k.id); } }
                SmallBtn { has-icon: true; icon: Icons.pencil; text: "Change"; clicked => { OpsHomepool.act("key-edit", k.id); } }
                if k.software: SmallBtn { text: "New secret"; clicked => { OpsHomepool.act("key-reissue", k.id); } }
                SmallBtn { kind: "danger"; has-icon: true; icon: Icons.trash; text: "Revoke"; clicked => { OpsHomepool.act("key-remove", k.id); } }
            }
            if k.open: VerticalLayout {
                padding-top: Theme.sp-4;
                spacing: Theme.sp-6;
                for u in k.uses: HpUseLine { u: u; }
            }
        }
    }
}

component HpRequests inherits VerticalLayout {
    spacing: Theme.sp-12;
    if OpsHomepool.reqs.length == 0: DkQuiet { text: "No requests. A chat asks with the MCP tool homepool_request, and nothing is made until you approve it here."; }
    for r in OpsHomepool.reqs: HpCard {
        opacity: r.pending ? 1 : Theme.o-soft;
        HpHead {
            HpTitle { text: r.title; }
            for n in r.nets: VerticalLayout { alignment: center; HpChip { text: n; } }
            VerticalLayout { alignment: center; HpChip { text: r.status; tone: r.tone; } }
            Rectangle { horizontal-stretch: 1; }
        }
        VerticalLayout {
            padding-left: Theme.sp-12; padding-right: Theme.sp-12;
            padding-top: Theme.sp-8; padding-bottom: Theme.sp-10;
            spacing: Theme.sp-6;
            Text { text: r.meta; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
            if r.reason != "": Text { text: r.reason; font-size: Theme.text-13; color: Theme.text-primary; wrap: word-wrap; }
            if r.pending: HorizontalLayout {
                spacing: Theme.sp-6;
                alignment: start;
                SmallBtn { kind: "primary"; has-icon: true; icon: Icons.check; text: "Approve"; clicked => { OpsHomepool.act("req-approve", r.id); } }
                SmallBtn { text: "Change and approve"; clicked => { OpsHomepool.act("req-change", r.id); } }
                SmallBtn { kind: "danger"; text: "Refuse"; clicked => { OpsHomepool.act("req-refuse", r.id); } }
            }
        }
    }
}

component HpActivity inherits HpCard {
    VerticalLayout {
        padding: Theme.sp-12;
        spacing: Theme.sp-4;
        if OpsHomepool.log.length == 0: DkQuiet { text: "Nothing yet."; }
        for e in OpsHomepool.log: HorizontalLayout {
            spacing: Theme.sp-8;
            Text { text: e.at; font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-muted; }
            Text { text: e.what; font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-primary; }
            if e.subj != "": Text { text: e.subj; font-family: Theme.mono; font-size: Theme.text-12; font-weight: Theme.w-bold; color: Theme.text-primary; horizontal-stretch: 1; overflow: elide; }
            if e.subj == "": Rectangle { horizontal-stretch: 1; }
        }
    }
}

/// The screen (a tab, or a panel in a workbench pane: `embedded`, `key`).
export component OpsHomepoolView inherits Rectangle {
    in property <string> kind;
    in property <string> key;
    in property <bool> embedded;
    background: Theme.bg-primary;
    if OpsHomepool.state != "data": PanelPage {
        embedded: root.embedded;
        DkQuiet { text: OpsHomepool.state == "error" ? OpsHomepool.error : "Loading…"; }
    }
    if OpsHomepool.state == "data": VerticalLayout {
        Rectangle {
            height: Theme.control-sm + Theme.sp-6 + Theme.sp-20;
            HorizontalLayout {
                padding-left: Theme.sp-16; padding-right: Theme.sp-16;
                padding-top: Theme.sp-10; padding-bottom: Theme.sp-10;
                spacing: Theme.sp-8;
                DkSeg {
                    for t in OpsHomepool.tabs: VerticalLayout {
                        alignment: center;
                        DkSegBtn { has-icon: false; label: t.label; count: t.count; alert: t.alert; on: OpsHomepool.tab == t.key; clicked => { OpsHomepool.set-tab(t.key); } }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if OpsHomepool.tab == "networks": VerticalLayout { alignment: center; SmallBtn { has-icon: true; icon: Icons.plus; text: "Network"; clicked => { OpsHomepool.act("net-add", ""); } } }
                if OpsHomepool.tab == "networks": VerticalLayout { alignment: center; SmallBtn { kind: "primary"; has-icon: true; icon: Icons.plus; text: "Node"; clicked => { OpsHomepool.act("node-add", ""); } } }
                if OpsHomepool.tab == "access": VerticalLayout { alignment: center; SmallBtn { kind: "primary"; has-icon: true; icon: Icons.plus; text: "Access"; clicked => { OpsHomepool.act("key-add", ""); } } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        PanelPage {
            vertical-stretch: 1;
            embedded: root.embedded;
            HorizontalLayout {
                alignment: start;
                spacing: Theme.sp-20;
                for s in OpsHomepool.sum: DkStat { v: s.v; l: s.l; }
            }
            if OpsHomepool.tab == "networks": HpNetworks { }
            if OpsHomepool.tab == "access": HpAccess { }
            if OpsHomepool.tab == "requests": HpRequests { }
            if OpsHomepool.tab == "activity": HpActivity { }
        }
    }
}

/// The dialogs (.hp-modal / .hp-dlg) over the whole window.
export component OpsHomepoolOverlay inherits Rectangle {
    if OpsHomepool.dlg != "": Modal {
        width: parent.width; height: parent.height;
        title: OpsHomepool.dlg-title;
        card-w: Theme.homepool-dlg-w;
        close => { OpsHomepool.dlg-close(); }
        fl := Flickable {
            height: min(body.preferred-height, Theme.dialog-max-h - Theme.sp-48 - Theme.sp-48 - Theme.sp-40, root.height - Theme.sp-48 - Theme.sp-48 - Theme.sp-48 - Theme.sp-48);
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: fl.width;
                spacing: Theme.sp-12;
                // Add a node.
                if OpsHomepool.dlg == "node": VerticalLayout {
                    spacing: Theme.sp-4;
                    FormLabel { text: "NAME"; }
                    TextField { placeholder: "e.g. Ali’s PC"; text <=> OpsHomepool.n-name; accepted => { OpsHomepool.dlg-ok(); } }
                }
                if OpsHomepool.dlg == "node": VerticalLayout {
                    spacing: Theme.sp-4;
                    FormLabel { text: "NETWORK"; }
                    Select { options: OpsHomepool.n-nets; selected: OpsHomepool.n-net; picked(i) => { OpsHomepool.n-net = i; } }
                    HpMeta { text: "A friend’s line is a network of its own: make one first if it does not exist (Network button)."; }
                }
                // Give or change access.
                if OpsHomepool.dlg == "key": VerticalLayout {
                    spacing: Theme.sp-4;
                    FormLabel { text: "FOR"; }
                    Select { enabled: !OpsHomepool.k-kind-locked; options: ["Software", "Project", "Chat"]; selected: OpsHomepool.k-kind; picked(i) => { OpsHomepool.k-kind = i; } }
                    HpMeta { text: "Software: a scraper, script or container, with a login of its own. Project: every chat of a project. Chat: one chat."; }
                }
                if OpsHomepool.dlg == "key" && OpsHomepool.k-kind == 0: VerticalLayout {
                    spacing: Theme.sp-4;
                    FormLabel { text: "NAME"; }
                    TextField { placeholder: "e.g. insta-scraper"; text <=> OpsHomepool.k-name; }
                }
                if OpsHomepool.dlg == "key" && OpsHomepool.k-kind != 0: VerticalLayout {
                    spacing: Theme.sp-4;
                    FormLabel { text: "PROJECT"; }
                    Select { enabled: !OpsHomepool.k-project-locked; options: OpsHomepool.k-projects; selected: OpsHomepool.k-project; picked(i) => { OpsHomepool.k-project = i; } }
                }
                if OpsHomepool.dlg == "key" && OpsHomepool.k-kind == 2: VerticalLayout {
                    spacing: Theme.sp-4;
                    FormLabel { text: "CHAT ID"; }
                    TextField { enabled: !OpsHomepool.k-project-locked; placeholder: "the chat’s id"; text <=> OpsHomepool.k-chat; }
                    HpMeta { text: "Easier: let the chat ask with homepool_request, then approve it."; }
                }
                if OpsHomepool.dlg == "key": VerticalLayout {
                    spacing: Theme.sp-6;
                    FormLabel { text: "NETWORKS IT MAY USE"; }
                    HorizontalLayout {
                        spacing: Theme.sp-12;
                        alignment: start;
                        for c[i] in OpsHomepool.k-nets: CheckRow { text: c.label; checked: c.on; toggled(on) => { OpsHomepool.key-net(i, on); } }
                    }
                    HpMeta { text: "With more than one, its slots spread over all of them and each slot stays on one exit, as the standalone homepool does. A login can pin one with user@network."; }
                }
                if OpsHomepool.dlg == "key": VerticalLayout {
                    spacing: Theme.sp-4;
                    CheckRow { text: "Fall back to the server when none of them is up"; checked: OpsHomepool.k-fb; toggled(on) => { OpsHomepool.k-fb = on; } }
                    HpMeta { text: "Off: with no exit up, connections are refused rather than quietly leaving from the server."; }
                }
                if OpsHomepool.dlg == "key": VerticalLayout {
                    spacing: Theme.sp-4;
                    FormLabel { text: "EXPIRES"; }
                    TextField { placeholder: "YYYY-MM-DD HH:MM"; mono: true; text <=> OpsHomepool.k-exp; }
                    HpMeta { text: "Empty: until you revoke it."; }
                }
                if OpsHomepool.dlg == "key": HorizontalLayout {
                    spacing: Theme.sp-12;
                    VerticalLayout { horizontal-stretch: 1; spacing: Theme.sp-4; FormLabel { text: "DATA CAP PER DAY (MB, 0 = NONE)"; } TextField { mono: true; text <=> OpsHomepool.k-cap; } }
                    VerticalLayout { horizontal-stretch: 1; spacing: Theme.sp-4; FormLabel { text: "SLOTS"; } TextField { mono: true; text <=> OpsHomepool.k-slots; } }
                }
                if OpsHomepool.dlg == "key": HpMeta { text: "Slots: identities that should each keep one exit (one per account)."; }
                if OpsHomepool.dlg == "key" && OpsHomepool.k-kind == 0: VerticalLayout {
                    spacing: Theme.sp-6;
                    CheckRow { text: "Port block, for software that cannot send a proxy login (Chromium with SOCKS)"; checked: OpsHomepool.k-block; toggled(on) => { OpsHomepool.k-block = on; } }
                    TextField { placeholder: "homepool, loopback, 172.21.0.0/16"; mono: true; text <=> OpsHomepool.k-from; }
                    HpMeta { text: "Who may use the ports: Docker network names, loopback, or address ranges. Nothing else can."; }
                }
                // A node's code, a key's secret: shown once.
                if OpsHomepool.dlg == "show" && OpsHomepool.show-warn != "": HpUseLine { u: { kind: "warn", text: OpsHomepool.show-warn }; }
                if OpsHomepool.dlg == "show" && OpsHomepool.qr != "": HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        width: Theme.homepool-qr; height: Theme.homepool-qr;
                        background: Theme.white;
                        border-radius: Theme.r-field;
                        Path {
                            x: Theme.sp-8; y: Theme.sp-8; width: parent.width - Theme.sp-16; height: parent.height - Theme.sp-16;
                            viewbox-width: OpsHomepool.qr-n; viewbox-height: OpsHomepool.qr-n;
                            commands: OpsHomepool.qr;
                            fill: Theme.bg-primary;
                        }
                    }
                }
                if OpsHomepool.dlg == "show": VerticalLayout { spacing: Theme.sp-10; for u in OpsHomepool.show-items: HpUseLine { u: u; } }
                if OpsHomepool.dlg == "show" && OpsHomepool.show-warn2 != "": HpUseLine { u: { kind: "warn", text: OpsHomepool.show-warn2 }; }
            }
        }
        ModalActions {
            if OpsHomepool.dlg-label != "": SmallBtn { text: "Cancel"; clicked => { OpsHomepool.dlg-close(); } }
            if OpsHomepool.dlg-label != "": SmallBtn { kind: "primary"; text: OpsHomepool.dlg-label; clicked => { OpsHomepool.dlg-ok(); } }
            if OpsHomepool.dlg-label == "": SmallBtn { kind: "primary"; text: "Done"; clicked => { OpsHomepool.dlg-close(); } }
        }
    }
}
