// Ops (vault, extras): the parts their dialogs share. A centred card over a
// scrim without a head (the web's .pin-modal, #add-project-modal and
// crundi-secret-lock.js's .csl-card draw their own titles), a lock field
// (a 6-digit PIN: mono, centred, spaced; a passphrase: plain), and the
// dialogs' buttons (.csl-btn, .pin-buttons button).

import { Theme, Icons, Icon, SoftShadow } from "../kit.slint";

/// A dialog card over the window: the scrim (no click-through; a click on it
/// does nothing, as the web's), the card (bg-secondary, border, soft shadow),
/// its children stacked `gap` apart and scrolling when taller than the
/// window. Esc calls `escape`.
export component OpsCard inherits Rectangle {
    in property <length> card-w: Theme.dialog-w;
    in property <length> pad: Theme.sp-16;
    in property <length> gap: Theme.sp-10;
    in property <bool> center;
    callback escape();
    background: Theme.scrim;
    TouchArea { }
    keys := FocusScope {
        key-pressed(ev) => { if ev.text == Key.Escape { root.escape(); return accept; } return reject; }
    }
    property <length> max-h: root.height - 2 * Theme.sp-16;
    card := Rectangle {
        width: min(root.card-w, root.width - 2 * Theme.sp-16);
        height: min(col.preferred-height, root.max-h);
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-card; shadow: Theme.shadow-card; }
        Rectangle { background: Theme.bg-secondary; border-radius: Theme.r-card; border-width: 1px; border-color: Theme.border; }
        TouchArea { }
        fl := Flickable {
            width: parent.width; height: parent.height;
            content-height: max(self.height, col.preferred-height);
            col := VerticalLayout {
                width: fl.width;
                padding: root.pad;
                spacing: root.gap;
                alignment: start;
                @children
            }
        }
    }
    public function grab() { keys.focus(); }
}

/// A dialog's button (.csl-btn / .pin-buttons button): quiet, or the
/// primary one (accent). `stretch`: shares the row (the PIN modal's two).
export component OpsDlgBtn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <image> icon;
    in property <bool> has-icon;
    callback clicked();
    height: Theme.control;
    min-width: lay.preferred-width;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.primary ? Theme.accent : Theme.border;
    background: root.primary ? (ta.has-hover && root.enabled ? Theme.accent-hover : Theme.accent)
        : ta.has-hover && root.enabled ? Theme.bg-hover : Theme.bg-tertiary;
    opacity: root.enabled ? 1 : Theme.o-soft;
    accessible-role: button;
    accessible-label: root.text;
    lay := HorizontalLayout {
        padding-left: Theme.sp-16; padding-right: Theme.sp-16;
        spacing: Theme.sp-6;
        alignment: center;
        if root.has-icon: Icon { y: (parent.height - self.height) / 2; source: root.icon; width: Theme.icon-md; height: Theme.icon-md; tint: root.primary ? Theme.white : Theme.text-primary; }
        Text { text: root.text; vertical-alignment: center; font-size: Theme.text-13; font-weight: root.primary ? Theme.w-semibold : Theme.w-regular; color: root.primary ? Theme.white : Theme.text-primary; }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

/// A lock field: a PIN (6 digits: mono, centred, spaced out) or a
/// passphrase (plain text), both hidden as typed. `big`: the PIN modal's
/// tall field.
export component OpsLockField inherits Rectangle {
    in-out property <string> text;
    in property <string> lock;
    in property <string> placeholder;
    in property <bool> big;
    in property <bool> invalid;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted();
    callback escape();
    property <bool> pin: root.lock != "passphrase";
    height: root.big ? Theme.control-lg + Theme.sp-8 : Theme.control;
    border-radius: Theme.r-control;
    background: Theme.bg-primary;
    border-width: 1px;
    border-color: root.invalid ? Theme.red : input.has-focus ? Theme.accent : Theme.border;
    input := TextInput {
        x: Theme.sp-10; width: parent.width - 2 * Theme.sp-10;
        text <=> root.text;
        single-line: true;
        vertical-alignment: center;
        horizontal-alignment: root.pin ? center : left;
        input-type: InputType.password;
        color: Theme.text-primary;
        font-size: root.pin && root.big ? Theme.text-20 : Theme.text-14;
        font-family: root.pin ? Theme.mono : Theme.ui-font;
        letter-spacing: root.pin ? Theme.vault-pin-track : 0px;
        selection-background-color: Theme.selection;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
        key-pressed(ev) => { if ev.text == Key.Escape { root.escape(); return accept; } return reject; }
    }
    if root.text == "": Text {
        x: Theme.sp-10; width: parent.width - 2 * Theme.sp-10; height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: root.pin ? center : left;
        text: root.placeholder; color: Theme.placeholder;
        font-size: root.pin && root.big ? Theme.text-20 : Theme.text-14;
        font-family: root.pin ? Theme.mono : Theme.ui-font;
        letter-spacing: root.pin ? Theme.vault-pin-track : 0px;
    }
    public function focus-input() { input.focus(); }
    public function select-all() { input.select-all(); }
}

/// The lock dialogs' head (.csl-head): the lock in accent, the title.
export component OpsLockHead inherits HorizontalLayout {
    in property <string> title;
    spacing: Theme.sp-8;
    Icon { y: (parent.height - self.height) / 2; source: Icons.lock; width: Theme.icon-md; height: Theme.icon-md; tint: Theme.accent-hover; }
    Text { horizontal-stretch: 1; text: root.title; font-size: Theme.text-15; font-weight: Theme.w-semibold; color: Theme.text-primary; vertical-alignment: center; wrap: word-wrap; }
}

/// A section's small upper-case label (.csl-sec / .secrets-section-title).
export component OpsSecLabel inherits Text {
    font-size: Theme.text-11; font-weight: Theme.w-semibold; letter-spacing: Theme.track-wide;
    color: Theme.text-secondary;
    wrap: word-wrap;
}

/// A hint line (.csl-hint): muted, yellow when it warns.
export component OpsHint inherits Text {
    in property <bool> warn;
    font-size: Theme.text-12; color: root.warn ? Theme.yellow : Theme.text-secondary;
    wrap: word-wrap;
}
