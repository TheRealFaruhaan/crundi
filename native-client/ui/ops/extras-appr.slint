// Ops (extras): the top bar's approvals button (#approvals-btn), placed in
// ui/shell.slint's top bar beside the connection badge. Hidden at zero (a
// permanent grey icon teaches you to stop looking at it); yellow with the
// count otherwise. A click opens the panel (ui/ops/extras.slint).

import { Theme, Icons, Icon } from "../kit.slint";
import { OpsExtras } from "extras.slint";

export component OpsApprovalsBtn inherits Rectangle {
    property <int> n: OpsExtras.appr-items.length;
    height: Theme.sp-24;
    width: lay.preferred-width;
    border-radius: Theme.r-pill;
    border-width: 1px;
    border-color: Theme.yellow;
    background: Theme.bg-secondary;
    accessible-role: button;
    accessible-label: "Things waiting on you";
    lay := HorizontalLayout {
        padding-left: Theme.sp-8; padding-right: Theme.sp-8;
        spacing: Theme.sp-6;
        Icon { y: (parent.height - self.height) / 2; source: Icons.shield-alert; width: Theme.icon-md; height: Theme.icon-md; tint: ta.has-hover ? Theme.text-primary : Theme.yellow; }
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: ct.preferred-height;
            width: max(ct.preferred-width + Theme.sp-10, Theme.sp-16);
            border-radius: Theme.r-pill;
            background: Theme.yellow;
            ct := Text { text: root.n; font-size: Theme.text-10; font-weight: Theme.w-bold; color: Theme.bg-primary; }
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { OpsExtras.appr-toggle(); } }
}
