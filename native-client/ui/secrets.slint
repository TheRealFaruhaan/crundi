// The chat secrets dialog (2.12, specs/chat-secrets.md): what a chat
// header's lock opens. The secrets pre-authorised for this chat (revoke one
// or all), and more to pre-authorise: tick, type each one's PIN or
// passphrase, pick a duration. The app (src/app.rs) holds its state.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, SoftShadow, RevealFlickable } from "widgets.slint";

/// A grant: the secret, how long it lasts ("until 12:24 (15 min left)"),
/// and whether its Revoke is pending.
export struct SecGrant { id: string, name: string, when: string, busy: bool }

/// A secret to pick: its lock kind (pin | passphrase), ticked, its field
/// marked bad, what is typed in it.
export struct SecPick { id: string, name: string, lock: string, chosen: bool, bad: bool, pin: string }

/// A quiet button of the dialog (Revoke, Close, Revoke all with `danger`
/// text), or the primary one (Pre-authorise).
component SecBtn inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();
    height: Theme.control-sm;
    width: bt.preferred-width + 2 * Theme.sp-12;
    border-radius: Theme.r-control;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border;
    background: root.primary ? (ta.has-hover && root.enabled ? Theme.accent-hover : Theme.accent) : ta.has-hover && root.enabled ? Theme.bg-hover : Theme.bg-tertiary;
    opacity: root.enabled ? 1 : Theme.o-soft;
    bt := Text {
        text: root.label; font-size: Theme.text-12; font-weight: Theme.w-semibold;
        color: root.primary ? Theme.white : root.danger ? Theme.red : Theme.text-primary;
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// A secret to pick: a checkbox and its name as one label; ticked, its lock
/// field at the right (a PIN: digits, centred, mono; a passphrase: text).
component PickRow inherits Rectangle {
    in property <SecPick> p;
    // Counts the app's changes to what is typed (a refusal empties a field).
    in property <int> pin-gen;
    // The keyboard asks for this field (Tab), by id; counted.
    in property <string> focus-id;
    in property <int> focus-gen;
    callback tick();
    callback typed(string);
    callback enter();
    callback focused();
    height: row.preferred-height;
    row := HorizontalLayout {
        padding-top: Theme.sp-4; padding-bottom: Theme.sp-4; padding-left: Theme.sp-2; padding-right: Theme.sp-2;
        spacing: Theme.sp-8;
        Rectangle {
            horizontal-stretch: 1;
            height: lab.preferred-height;
            lab := HorizontalLayout {
                spacing: Theme.sp-8;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: Theme.icon-lg; height: Theme.icon-lg;
                    border-radius: Theme.r-chip; border-width: 1px;
                    border-color: root.p.chosen ? Theme.accent : Theme.border;
                    background: root.p.chosen ? Theme.accent : Theme.bg-primary;
                    if root.p.chosen: Icon { source: Icons.check; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.white; }
                }
                Text {
                    horizontal-stretch: 1; min-width: 0; preferred-width: 0;
                    vertical-alignment: center; wrap: word-wrap;
                    text: root.p.name; font-family: Theme.mono; font-size: Theme.text-13; color: Theme.text-primary;
                }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.tick(); } }
        }
        if root.p.chosen: Rectangle {
            width: Theme.lock-field-w; height: Theme.control;
            // Focused: the ring other fields wear, outside the border.
            if lf.has-focus: Rectangle {
                x: -Theme.sp-4; y: -Theme.sp-4; width: parent.width + 2 * Theme.sp-4; height: parent.height + 2 * Theme.sp-4;
                border-radius: Theme.r-card; background: Theme.accent-ring;
            }
            Rectangle {
                border-radius: Theme.r-control; border-width: 1px;
                border-color: root.p.bad ? Theme.red : lf.has-focus ? Theme.accent : Theme.border;
                background: Theme.bg-primary;
            }
            lf := TextInput {
                x: Theme.sp-8; width: parent.width - 2 * Theme.sp-8;
                vertical-alignment: center; single-line: true;
                input-type: InputType.password;
                horizontal-alignment: root.p.lock == "pin" ? center : left;
                font-family: root.p.lock == "pin" ? Theme.mono : "";
                letter-spacing: root.p.lock == "pin" ? Theme.track-wide : 0px;
                font-size: Theme.text-15; color: Theme.text-primary;
                // It appears when ticked, and takes the focus.
                init => { self.text = root.p.pin; self.focus(); }
                edited => { root.typed(self.text); }
                accepted => { root.enter(); }
                changed has-focus => { if self.has-focus { root.focused(); } }
            }
            if lf.text == "": Text {
                x: Theme.sp-8; width: parent.width - 2 * Theme.sp-8; height: parent.height;
                vertical-alignment: center; horizontal-alignment: root.p.lock == "pin" ? center : left;
                text: root.p.lock == "pin" ? "PIN" : "Passphrase"; font-size: Theme.text-15; color: Theme.text-muted;
            }
            property <int> gen: root.pin-gen;
            changed gen => { lf.text = root.p.pin; }
            property <int> fgen: root.focus-gen;
            changed fgen => { if root.focus-id == root.p.id { lf.focus(); } }
        }
    }
}

/// A duration chip: a pill; on, accent.
component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback clicked();
    height: ct.preferred-height + 2 * Theme.sp-6;
    width: ct.preferred-width + 2 * Theme.sp-12;
    border-radius: Theme.r-pill; border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    background: root.on ? Theme.accent-dim : Theme.bg-tertiary;
    ct := Text { text: root.label; font-size: Theme.text-12; color: root.on ? Theme.accent-hover : Theme.text-primary; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// The dialog: modal, over the scrim, centred; the card scrolls as one when
/// the window is short.
export component SecretsDialog inherits Rectangle {
    in property <[SecGrant]> grants;
    in property <[SecPick]> picks;
    // The pick list's own line: loading, no secrets, or "" (the list).
    in property <string> pick-line;
    in property <string> duration;
    in property <string> err;
    in property <bool> busy;
    in property <bool> revoking-all;
    in property <bool> unsupported;
    in property <int> pin-gen;
    callback close();
    callback tick(string);
    callback typed(string, string);
    callback set-duration(string);
    callback grant();
    callback revoke(string);
    callback revoke-all();
    // Tab / Shift+Tab: the next lock field after this one (the app knows the order).
    pure callback next-field(string, bool) -> string;
    property <string> focus-id;
    property <int> focus-gen;
    property <string> current;
    background: Theme.scrim;
    TouchArea { clicked => { root.close(); } }
    keys := FocusScope {
        init => { self.focus(); }
        capture-key-pressed(ev) => {
            if ev.text == Key.Tab || ev.text == Key.Backtab {
                root.focus-id = root.next-field(root.current, ev.text == Key.Backtab);
                root.focus-gen += 1;
                return accept;
            }
            return reject;
        }
        key-pressed(ev) => {
            if ev.text == Key.Escape { root.close(); return accept; }
            // Nothing behind the dialog takes keys while it is open.
            accept
        }
    }
    card := Rectangle {
        property <length> room-h: root.height - 2 * Theme.sp-16;
        width: min(Theme.dialog-w-lg, root.width - 2 * Theme.sp-16);
        height: min(body.preferred-height + Theme.sp-2, self.room-h);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-card; shadow: Theme.shadow-card; }
        Rectangle { background: Theme.bg-secondary; border-radius: Theme.r-card; border-width: 1px; border-color: Theme.border; }
        TouchArea { }
        cf := RevealFlickable {
            x: 1px; y: 1px; width: parent.width - Theme.sp-2; height: parent.height - Theme.sp-2;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: cf.width;
                padding: Theme.sp-16;
                spacing: Theme.sp-10;
                HorizontalLayout {
                    spacing: Theme.sp-8;
                    Icon { y: (parent.height - self.height) / 2; source: Icons.lock; width: Theme.icon-lg; height: Theme.icon-lg; tint: Theme.accent-hover; }
                    Text { horizontal-stretch: 1; vertical-alignment: center; text: "Secrets for this chat"; font-size: Theme.text-15; font-weight: Theme.w-semibold; color: Theme.text-primary; }
                    Rectangle {
                        width: Theme.icon-md + Theme.sp-8; height: Theme.icon-md + Theme.sp-8;
                        Icon { source: Icons.x; width: Theme.icon-md; height: Theme.icon-md; tint: xa.has-hover ? Theme.text-primary : Theme.text-secondary; }
                        xa := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
                    }
                }
                Text {
                    text: "A pre-authorised secret lets this chat run commands with it without asking for the PIN or passphrase. Only to run: its value is never shown, and Claude reading a value still asks you every time. They are kept in the server’s memory only, for this chat only.";
                    font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; line-height-factor: Theme.lh-chat;
                }
                Rectangle { height: Theme.sp-4; }
                Text { text: "PRE-AUTHORISED NOW"; font-size: Theme.text-11; font-weight: Theme.w-semibold; letter-spacing: Theme.track-wide; color: Theme.text-secondary; }
                if root.grants.length == 0: Text { text: "Nothing is pre-authorised for this chat."; font-size: Theme.text-13; color: Theme.text-muted; wrap: word-wrap; }
                if root.grants.length > 0: VerticalLayout {
                    spacing: Theme.sp-6;
                    for g in root.grants: Rectangle {
                        height: gr.preferred-height;
                        border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border;
                        background: Theme.bg-primary;
                        gr := HorizontalLayout {
                            padding-top: Theme.sp-8; padding-bottom: Theme.sp-8; padding-left: Theme.sp-10; padding-right: Theme.sp-10;
                            spacing: Theme.sp-10;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: g.name; font-family: Theme.mono; font-size: Theme.text-13; color: Theme.text-primary; wrap: word-wrap; }
                                Text { text: g.when; font-size: Theme.text-12; color: Theme.text-secondary; }
                            }
                            VerticalLayout {
                                alignment: center;
                                SecBtn { label: "Revoke"; enabled: !g.busy; clicked => { root.revoke(g.id); } }
                            }
                        }
                    }
                    if root.grants.length >= 2: HorizontalLayout {
                        alignment: end;
                        SecBtn { label: "Revoke all"; danger: true; enabled: !root.revoking-all; clicked => { root.revoke-all(); } }
                    }
                }
                Rectangle { height: Theme.sp-4; }
                Text { text: "PRE-AUTHORISE"; font-size: Theme.text-11; font-weight: Theme.w-semibold; letter-spacing: Theme.track-wide; color: Theme.text-secondary; }
                if root.pick-line != "": Text { text: root.pick-line; font-size: Theme.text-13; color: Theme.text-muted; wrap: word-wrap; }
                if root.pick-line == "": Rectangle {
                    height: min(pl.preferred-height, Theme.pick-max-h);
                    pf := RevealFlickable {
                        width: parent.width; height: parent.height;
                        content-height: pl.preferred-height;
                        pl := VerticalLayout {
                            width: pf.width;
                            spacing: Theme.sp-6;
                            for p in root.picks: PickRow {
                                p: p; pin-gen: root.pin-gen; focus-id: root.focus-id; focus-gen: root.focus-gen;
                                tick => { root.tick(p.id); }
                                typed(t) => { root.typed(p.id, t); }
                                enter => { root.grant(); }
                                focused => { root.current = p.id; }
                            }
                        }
                    }
                }
                // The durations: a wrapping row, one on.
                FlexboxLayout {
                    flex-wrap: wrap;
                    spacing: Theme.sp-6;
                    Chip { label: "15 minutes"; on: root.duration == "15m"; clicked => { root.set-duration("15m"); } }
                    Chip { label: "1 hour"; on: root.duration == "1h"; clicked => { root.set-duration("1h"); } }
                    Chip { label: "8 hours"; on: root.duration == "8h"; clicked => { root.set-duration("8h"); } }
                    Chip { label: "Until this chat ends"; on: root.duration == "chat"; clicked => { root.set-duration("chat"); } }
                }
                if root.err != "": Text { text: root.err; font-size: Theme.text-12; color: Theme.red; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.sp-8;
                    SecBtn { label: "Close"; clicked => { root.close(); } }
                    SecBtn { label: root.busy ? "Checking…" : "Pre-authorise"; primary: true; enabled: !root.busy && !root.unsupported; clicked => { root.grant(); } }
                }
            }
        }
    }
}
