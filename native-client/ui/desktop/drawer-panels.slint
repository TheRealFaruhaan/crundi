// The browser drawer's full-cover panels (.brd-panel, crundi-browser-drawer.js):
// History, Clear browsing data, Saved passwords, Homepool for this browser.
// Each has the head (.brd-ph: title, close ×), a scrolling body (.brd-pb)
// and, for the forms, a foot of buttons (.brd-pf).

import { Theme, Icons, Icon, TextField } from "../kit.slint";
import { Tip } from "../chat.slint";
import { DesktopDrawer, DesktopRow } from "api.slint";

/// A ticked line with its explanation under it (.brd-chk).
component ChkLine inherits Rectangle {
    in property <bool> checked;
    in property <bool> radio;
    in property <string> text;
    in property <string> sub;
    in property <bool> enabled: true;
    callback toggled();
    height: lay.preferred-height;
    opacity: root.enabled ? 1 : Theme.o-dim;
    lay := HorizontalLayout {
        padding-top: Theme.sp-8; padding-bottom: Theme.sp-8; padding-left: Theme.sp-2;
        spacing: Theme.sp-10;
        Rectangle {
            width: Theme.sp-16; height: Theme.sp-16;
            border-radius: root.radio ? self.width / 2 : Theme.r-chip;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.border;
            background: root.checked && !root.radio ? Theme.accent : Theme.bg-primary;
            if root.checked && !root.radio: Icon { source: Icons.check; width: Theme.icon-sm * Theme.drawer-check-k; height: self.width; tint: Theme.white; }
            if root.checked && root.radio: Rectangle { width: Theme.sp-8; height: Theme.sp-8; border-radius: Theme.sp-4; background: Theme.accent; }
        }
        VerticalLayout {
            spacing: Theme.sp-2;
            Text { text: root.text; color: Theme.text-primary; font-size: Theme.text-13; wrap: word-wrap; }
            if root.sub != "": Text { text: root.sub; color: Theme.text-muted; font-size: Theme.text-12; wrap: word-wrap; }
        }
    }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.toggled(); } }
}

/// A small bordered button (.brd-btn), danger or primary.
component PanBtn inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    in property <bool> primary;
    callback clicked();
    height: Theme.control-sm;
    width: t.preferred-width + Theme.sp-24;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.danger ? Theme.red : root.primary ? Theme.accent : ta.has-hover ? Theme.accent : Theme.border;
    background: root.danger ? Theme.red : root.primary ? Theme.accent : Theme.bg-primary;
    t := Text { text: root.text; color: root.danger || root.primary ? Theme.white : Theme.text-primary; font-size: Theme.text-12; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// A muted note (.brd-note2).
component Note inherits Text {
    color: Theme.text-muted; font-size: Theme.text-12; wrap: word-wrap;
}

/// A row with a title, a muted line, and a button on the right (.brd-hpnet).
component RowLine inherits Rectangle {
    in property <DesktopRow> r;
    in property <string> button;
    in property <string> extra;
    callback act();
    callback extra-act();
    height: lay.preferred-height;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    lay := HorizontalLayout {
        padding-top: Theme.sp-6; padding-bottom: Theme.sp-6;
        spacing: Theme.sp-10;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.r.title; color: Theme.text-primary; font-size: Theme.text-13; overflow: elide; }
            if root.r.sub != "": Text { text: root.r.sub; color: Theme.text-muted; font-size: Theme.text-11; overflow: elide; }
        }
        if root.r.note != "": Text {
            text: root.r.note; vertical-alignment: center;
            color: root.r.tone == "bad" ? Theme.red : root.r.tone == "ok" ? Theme.green : Theme.text-secondary;
            font-size: Theme.text-12; font-family: root.r.tone == "mono" ? Theme.mono : Theme.ui-font;
        }
        if root.extra != "": VerticalLayout { alignment: center; PanBtn { text: root.extra; clicked => { root.extra-act(); } } }
        if root.button != "": VerticalLayout { alignment: center; PanBtn { text: root.button; clicked => { root.act(); } } }
    }
}

export component DrawerPanels inherits Rectangle {
    background: Theme.bg-secondary;
    // The panel takes every press (nothing reaches the page under it).
    TouchArea {}
    VerticalLayout {
        // The head (.brd-ph).
        Rectangle {
            height: Theme.control + Theme.sp-6;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-left: Theme.sp-12; padding-right: Theme.sp-12;
                spacing: Theme.sp-8;
                Text {
                    vertical-alignment: center; font-weight: Theme.w-semibold; font-size: Theme.text-13; color: Theme.text-primary;
                    text: DesktopDrawer.panel == "history" ? "History" : DesktopDrawer.panel == "clear" ? "Clear browsing data"
                        : DesktopDrawer.panel == "passwords" ? "Saved passwords" : "Homepool for this browser";
                }
                Rectangle { horizontal-stretch: 1; }
                if DesktopDrawer.panel == "history": VerticalLayout { alignment: center; PanBtn { text: "Clear browsing data…"; clicked => { DesktopDrawer.pw-act("panel-clear"); } } }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: Theme.sp-24 + Theme.sp-2; height: self.width; border-radius: Theme.r-control;
                        background: xa.has-hover ? Theme.bg-tertiary : transparent;
                        Icon { source: Icons.x; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.text-secondary; }
                        xa := TouchArea { mouse-cursor: pointer; clicked => { DesktopDrawer.panel-close(); } }
                        Tip { on: xa.has-hover; text: "Close"; }
                    }
                }
            }
        }
        // History: a search, the rows (title and url, how long ago).
        if DesktopDrawer.panel == "history": Flickable {
            vertical-stretch: 1;
            content-height: hist.preferred-height;
            hist := VerticalLayout {
                padding-left: Theme.sp-12; padding-right: Theme.sp-12; padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
                spacing: Theme.sp-2;
                TextField {
                    text <=> DesktopDrawer.history-q;
                    placeholder: "Search history";
                    edited(t) => { DesktopDrawer.history-query(t); }
                }
                Rectangle { height: Theme.sp-6; }
                if DesktopDrawer.history.length == 0: Note { text: DesktopDrawer.history-empty; }
                for h in DesktopDrawer.history: Rectangle {
                    height: hr.preferred-height;
                    border-radius: Theme.r-control;
                    background: ha.has-hover ? Theme.bg-tertiary : transparent;
                    hr := HorizontalLayout {
                        padding: Theme.sp-6; padding-left: Theme.sp-4; spacing: Theme.sp-10;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text { text: h.title != "" ? h.title : h.url; color: Theme.text-primary; font-size: Theme.text-13; overflow: elide; }
                            Text { text: h.url; color: Theme.text-muted; font-size: Theme.text-11; font-family: Theme.mono; overflow: elide; }
                        }
                        Text { text: h.age; color: Theme.text-muted; font-size: Theme.text-12; }
                    }
                    ha := TouchArea { mouse-cursor: pointer; clicked => { DesktopDrawer.history-open(h.url); } }
                    Tip { on: ha.has-hover; text: h.url; }
                }
            }
        }
        // Clear browsing data: which sites, what, the note; Cancel / Clear.
        if DesktopDrawer.panel == "clear": Flickable {
            vertical-stretch: 1;
            content-height: clr.preferred-height;
            clr := VerticalLayout {
                padding-left: Theme.sp-12; padding-right: Theme.sp-12; padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
                ChkLine { radio: true; checked: !DesktopDrawer.clr-site-only; text: "Every site"; toggled => { DesktopDrawer.clr-site-only = false; } }
                ChkLine { radio: true; checked: DesktopDrawer.clr-site-only; text: "Only this site"; sub: "Its subdomains too"; toggled => { DesktopDrawer.clr-site-only = true; } }
                if DesktopDrawer.clr-site-only: TextField { text <=> DesktopDrawer.clr-site; placeholder: "example.com"; mono: true; }
                Rectangle { height: Theme.sp-8; }
                ChkLine { checked: DesktopDrawer.clr-history; text: "Browsing history"; sub: "Every address visited, and each tab’s back and forward list"; toggled => { DesktopDrawer.clr-history = !DesktopDrawer.clr-history; } }
                ChkLine { checked: DesktopDrawer.clr-cookies; text: "Cookies and site data"; sub: "Logins, local storage, databases, service workers. Signs you out of sites."; toggled => { DesktopDrawer.clr-cookies = !DesktopDrawer.clr-cookies; } }
                ChkLine { checked: DesktopDrawer.clr-cache; text: "Cached images and files"; sub: "Pages load again from the network"; toggled => { DesktopDrawer.clr-cache = !DesktopDrawer.clr-cache; } }
                ChkLine { checked: DesktopDrawer.clr-passwords; text: "Saved passwords"; sub: "Every saved login, on every site (not limited to one site)"; toggled => { DesktopDrawer.clr-passwords = !DesktopDrawer.clr-passwords; } }
                Note { text: "For this computer’s browser: every tab in every project, on every network. Open tabs stay open. For one site, the back and forward lists are left as they are."; }
            }
        }
        // Saved passwords: the reason when unavailable, the note, the rows, the PIN, the never list.
        if DesktopDrawer.panel == "passwords": Flickable {
            vertical-stretch: 1;
            content-height: pw.preferred-height;
            pw := VerticalLayout {
                padding-left: Theme.sp-12; padding-right: Theme.sp-12; padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
                spacing: Theme.sp-4;
                if DesktopDrawer.pw-filter-site != "": Text { text: DesktopDrawer.pw-filter-site; color: Theme.red; font-size: Theme.text-12; wrap: word-wrap; }
                Note { text: "Kept on this computer only, encrypted for your account on it, as Chrome keeps them. Filling needs no PIN; showing one does. Chats can never read them."; }
                if DesktopDrawer.pw-pin-open: HorizontalLayout {
                    spacing: Theme.sp-8; padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
                    TextField {
                        width: Theme.lock-field-w;
                        text <=> DesktopDrawer.pw-pin; placeholder: "PIN"; password: true;
                        accepted(t) => { DesktopDrawer.pw-pin-check(t); }
                    }
                    VerticalLayout { alignment: center; PanBtn { primary: true; text: "Unlock"; clicked => { DesktopDrawer.pw-pin-check(DesktopDrawer.pw-pin); } } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if DesktopDrawer.pw-rows.length == 0: Note { text: "No saved passwords yet. Sign in to a site in a drawer tab and choose Save."; }
                for r in DesktopDrawer.pw-rows: Rectangle {
                    height: pr.preferred-height;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    pr := HorizontalLayout {
                        padding-top: Theme.sp-6; padding-bottom: Theme.sp-6; spacing: Theme.sp-10;
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center;
                            Text { text: r.title; color: Theme.text-primary; font-size: Theme.text-13; overflow: elide; }
                            Text { text: r.sub; color: Theme.text-muted; font-size: Theme.text-11; overflow: elide; }
                        }
                        Text { text: DesktopDrawer.pw-shown-id == r.id ? DesktopDrawer.pw-shown : "••••••••"; vertical-alignment: center; font-family: Theme.mono; color: Theme.text-secondary; font-size: Theme.text-12; }
                        VerticalLayout { alignment: center; PanBtn { text: DesktopDrawer.pw-shown-id == r.id ? "Hide" : "Show"; clicked => { DesktopDrawer.pw-row("show", r.id); } } }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: Theme.control-sm; height: self.width; border-radius: Theme.r-control;
                                background: da.has-hover ? Theme.red-dim : transparent;
                                Icon { source: Icons.trash; width: Theme.icon-sm; height: Theme.icon-sm; tint: da.has-hover ? Theme.red : Theme.text-secondary; }
                                da := TouchArea { mouse-cursor: pointer; clicked => { DesktopDrawer.pw-row("delete", r.id); } }
                            }
                        }
                    }
                }
                if DesktopDrawer.pw-never.length > 0: Note { text: "Never offered for:"; }
                for r in DesktopDrawer.pw-never: RowLine { r: r; button: "Remove"; act => { DesktopDrawer.pw-row("unnever", r.id); } }
            }
        }
        // Homepool for this browser: no key (make one), or the key's settings.
        if DesktopDrawer.panel == "homepool": Flickable {
            vertical-stretch: 1;
            content-height: hp.preferred-height;
            hp := VerticalLayout {
                padding-left: Theme.sp-12; padding-right: Theme.sp-12; padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
                spacing: Theme.sp-2;
                if DesktopDrawer.hp-state == "loading": Note { text: "Loading…"; }
                if DesktopDrawer.hp-state == "none": Note { text: "Homepool is not available on this server."; }
                if DesktopDrawer.hp-state == "nokey": Note { text: "Tabs can go out through your homepool networks: your home line, a friend’s. This makes the PC browser key: you choose the networks it may use, and switch it off here or in Homepool › Access at any time. Chats ask you before they use it."; }
                if DesktopDrawer.hp-state == "key": ChkLine {
                    checked: DesktopDrawer.hp-on; text: "PC browser key on";
                    sub: DesktopDrawer.hp-refusal != "" ? DesktopDrawer.hp-refusal : "Off: homepool tabs stop loading at once";
                    toggled => { DesktopDrawer.hp-on = !DesktopDrawer.hp-on; }
                }
                if DesktopDrawer.hp-state == "key": Note { text: "Exits now (each network keeps one line, so its tabs keep one address):"; }
                if DesktopDrawer.hp-state == "key" && DesktopDrawer.hp-exits.length == 0: Note { text: "No networks."; }
                if DesktopDrawer.hp-state == "key": VerticalLayout { for r in DesktopDrawer.hp-exits: RowLine { r: r; } }
                if DesktopDrawer.hp-state == "key": Note { text: "Networks it may use:"; }
                if DesktopDrawer.hp-state == "key" || DesktopDrawer.hp-state == "nokey": VerticalLayout {
                    if DesktopDrawer.hp-nets.length == 0: Note { text: "You have no homepool networks yet: make one in the Homepool tab."; }
                    for r in DesktopDrawer.hp-nets: ChkLine {
                        checked: r.on; enabled: r.enabled; text: r.title; sub: r.sub;
                        toggled => { DesktopDrawer.hp-toggle-net(r.id, !r.on); }
                    }
                }
                if DesktopDrawer.hp-state == "key" || DesktopDrawer.hp-state == "nokey": ChkLine {
                    checked: DesktopDrawer.hp-fallback; text: "Leave from the server when no exit is up";
                    sub: "Off: with no node up, pages do not load (nothing leaves another way)";
                    toggled => { DesktopDrawer.hp-fallback = !DesktopDrawer.hp-fallback; }
                }
                if DesktopDrawer.hp-state == "key": Note { text: "Chats you approved (others ask you first; their requests are in Homepool › Requests):"; }
                if DesktopDrawer.hp-state == "key" && DesktopDrawer.hp-chats.length == 0: Note { text: "None yet."; }
                if DesktopDrawer.hp-state == "key": VerticalLayout { for r in DesktopDrawer.hp-chats: RowLine { r: r; button: "Remove"; act => { DesktopDrawer.hp-remove(r.id); } } }
            }
        }
        // The foot (.brd-pf): the forms' buttons.
        if DesktopDrawer.panel == "clear" || (DesktopDrawer.panel == "homepool" && (DesktopDrawer.hp-state == "nokey" || DesktopDrawer.hp-state == "key")): Rectangle {
            height: Theme.control-sm + Theme.sp-20 + 1px;
            Rectangle { height: 1px; y: 0; background: Theme.border; }
            HorizontalLayout {
                padding: Theme.sp-10; padding-left: Theme.sp-12; padding-right: Theme.sp-12;
                spacing: Theme.sp-8; alignment: end;
                PanBtn { text: DesktopDrawer.panel == "homepool" && DesktopDrawer.hp-state == "key" ? "Close" : "Cancel"; clicked => { DesktopDrawer.panel-close(); } }
                if DesktopDrawer.panel == "clear": PanBtn { danger: true; text: "Clear"; clicked => { DesktopDrawer.clear-run(); } }
                if DesktopDrawer.panel == "homepool": PanBtn { primary: true; text: DesktopDrawer.hp-state == "key" ? "Save" : "Make the PC browser key"; clicked => { DesktopDrawer.hp-save(); } }
            }
        }
    }
}
