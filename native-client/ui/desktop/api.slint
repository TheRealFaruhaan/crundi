// The desktop area's face to Rust (AREAS.md): every global Rust reads, sets or
// handles (`w.global::<crate::DesktopDrawer>()`…), and the structs of their
// models. Components don't go here (ui/browser.slint and ui/desktop/ draw).

/// The area's state for Rust (src/desktop/).
export global DesktopUi {
    in-out property <bool> ready;
}

/// A drawer tab in the strip (.brd-tab).
export struct DesktopTab {
    id: string,
    title: string,
    // The tooltip: title or url, url, "Network: …", asleep.
    tip: string,
    // "" (this PC), "SRV" (the server's network), "HP" (homepool).
    badge: string,
    bad: bool,
    active: bool,
    sleeping: bool,
}

/// A popover's line: kind "item" (picks `id`), "group" (a heading), "note".
export struct DesktopPopItem { id: string, label: string, kind: string, on: bool, icon: image, has-icon: bool }

/// A history row (the History panel and the address field's suggestions).
export struct DesktopHistRow { url: string, title: string, age: string }

/// A row of a drawer panel's list (homepool exits, approved chats, saved logins).
export struct DesktopRow { id: string, title: string, sub: string, note: string, tone: string, on: bool, enabled: bool, action: string }

/// A button of the password bar: `on` is the primary one.
export struct DesktopBtn { id: string, label: string, on: bool }

/// The browser drawer (crundi-browser-drawer.js): tabs per project, the
/// address and annotation bars, the popovers, the panels.
export global DesktopDrawer {
    // The area runs the drawer (else main.slint's prototype panels show).
    in property <bool> hooked;
    in property <[DesktopTab]> tabs;
    in property <bool> has-tab;
    in property <string> side: "right";
    // The address field's text (the active tab's url; "" for about:blank).
    in property <string> url;
    in property <[DesktopHistRow]> suggest;
    in-out property <int> suggest-pick: -1;
    in property <string> diag;
    in property <int> logins;
    // The network and device buttons.
    in property <string> net-tip: "Network";
    in property <string> net-tone;
    in property <bool> dev-on;
    in property <string> dev-tip: "Device size: Responsive";
    // A popover: "", "net", "dev", "menu", "chat".
    in property <string> pop;
    in property <string> pop-title;
    in property <[DesktopPopItem]> pop-items;
    // Annotating.
    in property <string> tool: "pick";
    in property <string> count-text: "Select an element, or draw";
    in property <[string]> chats;
    in property <int> chat: -1;
    in property <bool> css-ok;
    in property <string> css-tip;
    in property <bool> shot-ok;
    in property <string> shot-tip;
    in property <bool> note-open;
    in property <float> note-x;
    in property <float> note-y;
    // The password bar (save / update / fill): "" hides it.
    in property <string> pw-bar;
    in property <string> pw-text;
    in property <[DesktopBtn]> pw-buttons;
    // A full-cover panel: "", "history", "clear", "passwords", "homepool".
    in property <string> panel;
    in property <[DesktopHistRow]> history;
    in property <string> history-empty;
    in-out property <string> history-q;
    // Clear browsing data.
    in-out property <bool> clr-site-only;
    in-out property <string> clr-site;
    in-out property <bool> clr-history: true;
    in-out property <bool> clr-cookies;
    in-out property <bool> clr-cache: true;
    in-out property <bool> clr-passwords;
    // Saved passwords: the list, the PIN step, the never list.
    in property <[DesktopRow]> pw-rows;
    in property <[DesktopRow]> pw-never;
    in property <string> pw-filter-site;
    in property <bool> pw-pin-open;
    in property <string> pw-pin-error;
    in-out property <string> pw-pin;
    in property <string> pw-shown-id;
    in property <string> pw-shown;
    // Homepool for this browser.
    in property <string> hp-state;     // "none" (not available), "nokey", "key", "loading"
    in property <string> hp-refusal;
    in-out property <bool> hp-on;
    in-out property <bool> hp-fallback;
    in property <[DesktopRow]> hp-nets;     // checkboxes: networks it may use
    in property <[DesktopRow]> hp-exits;    // exits now
    in property <[DesktopRow]> hp-chats;    // approved chats and projects
    callback new-tab();
    callback close-tab(string);
    callback activate(string);
    callback hidden();
    callback close-all();
    callback reset-width();
    callback width-done();
    callback go(string);
    callback url-typed(string);
    callback pop-open(string);
    callback pop-pick(string);
    callback annotate(bool);
    callback set-tool(string);
    callback send(bool /* with the screenshot */);
    callback note(string, bool /* keep */);
    callback devtools();
    callback panel-close();
    callback history-query(string);
    callback history-open(string);
    callback clear-run();
    callback pw-act(string);
    callback pw-row(string /* action */, string /* id */);
    callback pw-pin-check(string);
    callback hp-toggle-net(string, bool);
    callback hp-save();
    callback hp-remove(string);
}

/// The Inbox (src/webapp-html.js #inbox-panel): threads, and the open one.
export struct DesktopThread { key: string, kind: string, title: string, sub: string, last: string, unread: int, badge: string, age: string, selected: bool }
/// A message's picture or file (a picture: `pic` once loaded).
export struct DesktopMedia { name: string, size: string, url: string, is-pic: bool, kept: bool, pic: image, loaded: bool }
export struct DesktopItem { id: string, kind: string, kind-label: string, title: string, text: string, age: string, fresh: bool, media: [DesktopMedia] }

export global DesktopInbox {
    in property <[DesktopThread]> threads;
    in property <string> sub;
    // "loading", "error", "ok"
    in property <string> list-state: "loading";
    in property <string> open-key;
    in property <string> open-kind;
    in property <string> open-title;
    in property <string> open-sub;
    in property <bool> open-chat;
    in property <[DesktopItem]> items;
    in property <bool> more;
    in property <int> unread;
    // The conversation's scroll: pinned to the bottom.
    in property <int> pin-gen;
    callback open(string);
    callback mark-all();
    callback mark-read();
    callback open-chat-clicked();
    callback delete-thread();
    callback delete-item(string);
    callback older();
    callback media(string /* url */, bool /* a picture */);
    callback retry();
}

/// The Browsers tab (src/webapp-html.js renderBrowsers): the chats' hidden browsers.
export struct DesktopBrowserCard { key: string, name: string, place: string, url: string, shot: image, shot-state: string, shot-error: string }
export global DesktopBrowsers {
    in property <[DesktopBrowserCard]> cards;
    in property <bool> loaded;
    // The device list (grouped: "group" lines), the chosen one.
    in property <[string]> devices;
    in-out property <int> device;
    in property <bool> places;
    in-out property <int> place;
    in-out property <string> url: "http://localhost:3000";
    callback open();
    callback go(string, string);
    callback shot(string);
    callback close(string);
}

/// Cru's screen (app/vendor/crundi-voice.js): a line of the conversation.
export struct DesktopCruTurn { mine: bool, text: string }
export global DesktopCru {
    in property <bool> open;
    // waking, listen, think, speak, ended, offline, problem
    in property <string> phase;
    in property <string> pill;
    in property <string> status;
    in property <string> words;
    in property <string> reply;
    in property <string> detail;
    in property <string> notice;
    in property <string> question;
    in property <string> legend;
    in property <string> hint;
    in property <bool> keyboard;
    in property <bool> voice-off;
    in property <bool> chat-view: true;
    in property <bool> menu;
    in property <bool> more;
    in property <int> unread;
    in property <[DesktopCruTurn]> turns;
    in-out property <string> draft;
    callback close();
    callback mic();
    callback send(string);
    callback keyboard-toggle();
    callback menu-open();
    callback menu-pick(string);
    callback older();
    callback answer(bool);
    callback say-again(string);
}
