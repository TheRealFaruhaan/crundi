// The desktop area (AREAS.md): phase 3's browser drawer and phase 6: the Browsers tab, notifications and the tray, the Inbox, the chat bubble, saved passwords, the homepool node, Cru.
//
// This file is the area's entry point: main.slint and the workbench reach
// the area only through DesktopView (a tab, or a panel in a workbench pane) and
// DesktopOverlay (the area's dialogs, over the whole window). Everything else
// the area draws lives in ui/desktop/ and is imported from here. What Rust
// sets and hears (globals, and the structs of their models) goes in
// ui/desktop/api.slint, named with the Desktop prefix.
//
// Kinds: browsers (tab)

import { Theme, Icons, PanelPage, EmptyState } from "../kit.slint";
import { DesktopUi } from "api.slint";

/// One of the area's screens: `kind` is the tab's id (or the pane's kind),
/// `key` the pane's key when embedded in a workbench pane ("" in a tab).
export component DesktopView inherits Rectangle {
    in property <string> kind;
    in property <string> key;
    in property <bool> embedded;
    background: Theme.bg-primary;
    // Placeholder until the area builds its screens.
    PanelPage {
        embedded: root.embedded;
        EmptyState { has-icon: false; title: "Not built yet: " + root.kind; hint: "The desktop area builds this screen."; }
    }
}

/// The area's layer over the whole window (its dialogs and popovers); it
/// takes no input where it draws nothing.
export component DesktopOverlay inherits Rectangle {
}
