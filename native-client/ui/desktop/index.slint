// The desktop area (AREAS.md): phase 3's browser drawer and phase 6: the
// Browsers tab, notifications, the Inbox, saved passwords, the homepool
// node, Cru.
//
// This file is the area's entry point: main.slint and the workbench reach
// the area only through DesktopView (a tab, or a panel in a workbench pane) and
// DesktopOverlay (the area's dialogs, over the whole window). The drawer
// itself is ui/browser.slint (main.slint places it). What Rust sets and
// hears goes in ui/desktop/api.slint, named with the Desktop prefix.
//
// Kinds: browsers (tab), inbox (the sidebar's Inbox: a page with no tab button)

import { Theme } from "../kit.slint";
import { BrowsersPage } from "browsers.slint";
import { InboxPage } from "inbox.slint";
import { CruScreen } from "cru.slint";
import { DesktopCru } from "api.slint";

/// One of the area's screens: `kind` is the tab's id (or the pane's kind),
/// `key` the pane's key when embedded in a workbench pane ("" in a tab).
export component DesktopView inherits Rectangle {
    in property <string> kind;
    in property <string> key;
    in property <bool> embedded;
    background: Theme.bg-primary;
    if root.kind == "browsers": BrowsersPage { width: parent.width; height: parent.height; embedded: root.embedded; }
    if root.kind == "inbox": InboxPage { width: parent.width; height: parent.height; }
}

/// The area's layer over the whole window (its dialogs and popovers); it
/// takes no input where it draws nothing.
export component DesktopOverlay inherits Rectangle {
    // Cru's screen, under the top bar's Cru mark (right aligned).
    if DesktopCru.open: CruScreen {
        x: parent.width - self.width - Theme.sp-48 * 4;
        y: Theme.topbar-height + Theme.sp-4;
    }
}
