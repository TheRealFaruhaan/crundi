// The Browsers tab (src/webapp-html.js #browsers-panel): the browsers chats
// opened with browser_open (not the drawer's tabs). The toolbar (device,
// where it runs, the address, + Open), then a card per browser: its name and
// place, its address and Go, a screenshot, Screenshot and Close.

import { Theme, Icons, Icon, PanelPage, Card, CardHead, SmallBtn, TextField, Select, EmptyState } from "../kit.slint";
import { DesktopBrowsers } from "api.slint";

export component BrowsersPage inherits Rectangle {
    in property <bool> embedded;
    background: Theme.bg-primary;
    PanelPage {
        embedded: root.embedded;
        VerticalLayout {
            spacing: Theme.sp-6;
            HorizontalLayout {
                spacing: Theme.sp-6;
                Select { horizontal-stretch: 1; options: DesktopBrowsers.devices; selected: DesktopBrowsers.device; picked(i) => { DesktopBrowsers.device = i; } }
                if DesktopBrowsers.places: Select {
                    width: Theme.title-cap;
                    options: ["Run on: default", "Run on this server", "Run on the desktop app"];
                    selected: DesktopBrowsers.place;
                    picked(i) => { DesktopBrowsers.place = i; }
                }
            }
            HorizontalLayout {
                spacing: Theme.sp-6;
                TextField { horizontal-stretch: 1; text <=> DesktopBrowsers.url; placeholder: "URL to open"; mono: true; accepted => { DesktopBrowsers.open(); } }
                SmallBtn { kind: "primary"; text: "+ Open"; clicked => { DesktopBrowsers.open(); } }
            }
        }
        if DesktopBrowsers.loaded && DesktopBrowsers.cards.length == 0: EmptyState { icon: Icons.globe; title: "No browser instances open"; }
        for b in DesktopBrowsers.cards: Card {
            VerticalLayout {
                spacing: Theme.sp-8;
                CardHead { name: b.name; tone: "running"; dot: false; tag: b.place; }
                HorizontalLayout {
                    spacing: Theme.sp-4;
                    u := TextField { horizontal-stretch: 1; text: b.url; placeholder: "URL"; mono: true; accepted(t) => { DesktopBrowsers.go(b.key, t); } }
                    SmallBtn { text: "Go"; clicked => { DesktopBrowsers.go(b.key, u.text); } }
                }
                Rectangle {
                    height: b.shot-state == "ok" ? min(Theme.shot-h, self.width * (sh.source.height / max(1, sh.source.width))) : Theme.sp-48 + Theme.sp-8;
                    border-radius: Theme.r-chip; border-width: 1px; border-color: Theme.border; background: Theme.bg-primary; clip: true;
                    sh := Image { width: parent.width; height: parent.height; source: b.shot; image-fit: contain; visible: b.shot-state == "ok"; }
                    if b.shot-state != "ok": Text {
                        text: b.shot-state == "loading" ? "Loading..." : b.shot-state == "error" ? b.shot-error : "Click to take screenshot";
                        color: b.shot-state == "error" ? Theme.red : Theme.text-muted; font-size: Theme.text-11;
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { DesktopBrowsers.shot(b.key); } }
                }
                HorizontalLayout {
                    spacing: Theme.sp-6; alignment: start;
                    SmallBtn { has-icon: true; icon: Icons.image; text: "Screenshot"; clicked => { DesktopBrowsers.shot(b.key); } }
                    SmallBtn { has-icon: true; icon: Icons.x; kind: "danger"; text: "Close"; clicked => { DesktopBrowsers.close(b.key); } }
                }
            }
        }
    }
}
