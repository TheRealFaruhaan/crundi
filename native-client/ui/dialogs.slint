// The window's shared dialogs, one instance each, over every area: confirm
// (the web's window.confirm, which Electron shows as a system dialog),
// prompt (the web's .input-modal) and the context menu (.ctx-menu). Areas
// never draw their own: Rust opens them through src/kit.rs (kit::confirm,
// kit::prompt, kit::menu) and gets the answer in a closure.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Pointer, Icon, SoftShadow } from "widgets.slint";
import { Modal, ModalActions, SmallBtn, TextField, TextArea } from "kit.slint";
import { Btn } from "widgets.slint";

/// The confirm / prompt dialog's state (src/kit.rs sets it).
export global DialogUi {
    in-out property <bool> open;
    in-out property <string> title;
    in-out property <string> message;
    in-out property <string> ok-label: "OK";
    in-out property <string> cancel-label: "Cancel";
    in-out property <bool> danger;
    // A prompt: a field under the message.
    in-out property <bool> prompt;
    in-out property <bool> multiline;
    in-out property <string> value;
    in-out property <string> placeholder;
    // Bumped on each open (the field takes the focus again).
    in-out property <int> gen;
    // ok: OK/Enter; else Cancel, ×, Esc or the scrim. value: the field.
    callback answer(bool, string);
}

/// One item of the context menu: an id for the answer, the label, an icon,
/// danger (red), a separator line before it, disabled.
export struct MenuEntry { id: string, label: string, icon: image, has-icon: bool, danger: bool, sep: bool, enabled: bool }

/// The context menu's state (src/kit.rs sets it).
export global MenuUi {
    in-out property <bool> open;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <[MenuEntry]> items;
    callback picked(string);
    callback closed();
}

export component DialogLayer inherits Rectangle {
    Modal {
        width: root.width; height: root.height;
        title: DialogUi.title;
        close => { DialogUi.answer(false, DialogUi.value); }
        if DialogUi.message != "": Text {
            text: DialogUi.message; wrap: word-wrap;
            font-size: Theme.text-13; color: Theme.text-secondary;
        }
        if DialogUi.prompt && !DialogUi.multiline: tf := TextField {
            text <=> DialogUi.value;
            placeholder: DialogUi.placeholder;
            init => { self.focus-input(); self.select-all(); }
            accepted => { DialogUi.answer(true, DialogUi.value); }
            escape => { DialogUi.answer(false, DialogUi.value); }
        }
        if DialogUi.prompt && DialogUi.multiline: TextArea {
            text <=> DialogUi.value;
            placeholder: DialogUi.placeholder;
            init => { self.focus-input(); }
            submit => { DialogUi.answer(true, DialogUi.value); }
        }
        ModalActions {
            Btn { text: DialogUi.cancel-label; clicked => { DialogUi.answer(false, DialogUi.value); } }
            Btn {
                text: DialogUi.ok-label;
                primary: !DialogUi.danger; danger: DialogUi.danger;
                clicked => { DialogUi.answer(true, DialogUi.value); }
            }
        }
    }
    // Enter confirms a plain confirm (no field to take it).
    if !DialogUi.prompt: FocusScope {
        init => { self.focus(); }
        key-pressed(ev) => {
            if ev.text == Key.Return { DialogUi.answer(true, ""); return accept; }
            if ev.text == Key.Escape { DialogUi.answer(false, ""); return accept; }
            return reject;
        }
    }
}

export component MenuLayer inherits Rectangle {
    // A press anywhere outside closes it.
    TouchArea { clicked => { MenuUi.open = false; MenuUi.closed(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(ev) => { if ev.text == Key.Escape { MenuUi.open = false; MenuUi.closed(); return accept; } return reject; }
    }
    box := Rectangle {
        width: max(Theme.menu-min-w, col.preferred-width);
        height: col.preferred-height;
        // Inside the window: shifted left at the right edge, above at the bottom.
        x: max(Theme.sp-6, min(MenuUi.x, root.width - self.width - Theme.sp-6));
        y: MenuUi.y + self.height > root.height - Theme.sp-6 ? max(Theme.sp-6, MenuUi.y - self.height) : MenuUi.y;
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-card; shadow: Theme.shadow-menu; }
        Rectangle { background: Theme.bg-secondary; border-radius: Theme.r-card; border-width: 1px; border-color: Theme.border; }
        TouchArea { }
        col := VerticalLayout {
            padding: Theme.sp-4;
            spacing: 1px;
            for it in MenuUi.items: VerticalLayout {
                if it.sep: Rectangle { height: Theme.sp-8; Rectangle { height: 1px; background: Theme.border-subtle; } }
                Rectangle {
                    height: Theme.control;
                    border-radius: Theme.r-control;
                    background: !ia.has-hover || !it.enabled ? transparent : it.danger ? Theme.red-dim : Theme.bg-hover;
                    opacity: it.enabled ? 1 : Theme.o-dim;
                    HorizontalLayout {
                        padding-left: Theme.sp-10; padding-right: Theme.sp-12;
                        spacing: Theme.sp-10;
                        Rectangle {
                            width: Theme.icon-md;
                            if it.has-icon: Icon { source: it.icon; tint: it.danger ? Theme.red : Theme.text-secondary; }
                        }
                        Text { text: it.label; vertical-alignment: center; font-size: Theme.text-13; color: it.danger ? Theme.red : Theme.text-primary; }
                    }
                    ia := TouchArea {
                        enabled: it.enabled;
                        mouse-cursor: pointer;
                        clicked => { MenuUi.open = false; MenuUi.picked(it.id); }
                    }
                }
            }
        }
    }
}
