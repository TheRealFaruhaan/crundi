// The shared kit for every area's screens (AREAS.md): the parts the web's
// panels share, built from the theme's tokens only. Import from here (it also
// re-exports widgets.slint's building blocks), never copy a part into an
// area: a part two areas need belongs here, and only the Lead changes it.
//
// The web's names, for finding the reference:
//   PanelPage   .services-panel / .tab-panel (padding 16, gap 12, scrolls)
//   Toolbar     .svc-toolbar (title, spacer, actions)   AddButton  .svc-add-btn
//   Card        .svc-card    CardHead .svc-header (dot, name, status pill)
//   SmallBtn    .svc-btn (primary, danger, on, disabled, two-click confirm)
//   StatusTag   .svc-status  StateDot .svc-dot
//   EmptyState  .services-empty   ErrorState / LoadingState: the panels' lines
//   ListRow     .file-item (icon, name, meta, hover, selected, "…" more)
//   Table       header + rows (Docker, Usage, Secrets lists)
//   FormLabel   .sm-label    TextField / TextArea .sm-input   Seg .sm-seg
//   Toggle      the settings' switches   CheckRow  a ticked row
//   Select      a <select>: a button and its list
//   Modal       .sched-modal-card (scrim, card, head with ×, body)
// Confirm, prompt and the context menu are one shared instance each
// (ui/dialogs.slint, driven from Rust by src/kit.rs).

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Pointer, Icon, IconButton, Btn, Field, Dot, DashedBox, SoftShadow, RevealFlickable, ScrollThumb, AccentFill, States, SendBtn, UploadStrip } from "widgets.slint";
import { Spinner } from "chat.slint";
import { ListView } from "std-widgets.slint";

export { Theme, Icons, Pointer, Icon, IconButton, Btn, Field, Dot, DashedBox, SoftShadow, RevealFlickable, ScrollThumb, AccentFill, States, Spinner, SendBtn, UploadStrip }

/// A tab's page: padding sp-16, its children stacked sp-12 apart, scrolling
/// when taller than the tab (.services-panel). `embedded`: inside a
/// workbench pane (the web's .wb-embedded: tighter padding).
export component PanelPage inherits Rectangle {
    in property <bool> embedded;
    background: Theme.bg-primary;
    fl := Flickable {
        width: parent.width; height: parent.height;
        content-height: max(self.height, col.preferred-height);
        col := VerticalLayout {
            width: fl.width;
            padding: root.embedded ? Theme.sp-10 : Theme.sp-16;
            spacing: Theme.sp-12;
            alignment: start;
            @children
        }
    }
    ScrollThumb {
        width: root.width; height: root.height;
        view-h: fl.height; content-h: fl.content-height; offset: -fl.content-y;
    }
}

/// The panel's toolbar: a title (secondary, semibold), then its actions on
/// the right (children).
export component Toolbar inherits HorizontalLayout {
    in property <string> title;
    spacing: Theme.sp-8;
    padding-bottom: Theme.sp-4;
    Text {
        text: root.title;
        vertical-alignment: center;
        font-size: Theme.text-13; font-weight: Theme.w-semibold;
        color: Theme.text-secondary;
        overflow: elide;
    }
    Rectangle { horizontal-stretch: 1; }
    @children
}

/// The toolbar's primary action (+ Register service, + New card…).
export component AddButton inherits Rectangle {
    in property <string> text;
    in property <image> icon: Icons.plus;
    in property <bool> enabled: true;
    callback clicked();
    height: Theme.control;
    width: lay.preferred-width;
    border-radius: Theme.r-control;
    background: !root.enabled ? Theme.bg-tertiary : ta.has-hover ? Theme.accent-hover : Theme.accent;
    accessible-role: button;
    accessible-label: root.text;
    lay := HorizontalLayout {
        padding-left: Theme.sp-12; padding-right: Theme.sp-12;
        spacing: Theme.sp-6;
        Icon { y: (parent.height - self.height) / 2; source: root.icon; tint: root.enabled ? Theme.white : Theme.text-muted; }
        Text { text: root.text; vertical-alignment: center; font-size: Theme.text-13; font-weight: Theme.w-medium; color: root.enabled ? Theme.white : Theme.text-muted; }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

/// A card's small button (.svc-btn). kind: "" (quiet), "primary", "danger"
/// (red on hover), "on" (green: a switch that is on). With `confirm-text`
/// the first click arms it (red, that text) and only a second click within
/// Theme.confirm-arm fires `clicked` (the web's .confirming).
export component SmallBtn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> kind;
    in property <bool> enabled: true;
    in property <string> confirm-text;
    in-out property <bool> armed;
    callback clicked();
    // Its own height whatever the row gives it, centred (a toolbar's row is
    // taller).
    min-height: Theme.control-sm;
    preferred-height: Theme.control-sm;
    width: lay.preferred-width;
    property <bool> hot: ta.has-hover && root.enabled;
    opacity: root.enabled ? 1 : Theme.o-dim;
    body := Rectangle {
        y: (root.height - self.height) / 2;
        height: Theme.control-sm;
        border-radius: Theme.r-control;
        border-width: 1px;
        background: root.armed ? Theme.red-dim
            : root.kind == "primary" ? (root.hot ? Theme.accent-hover : Theme.accent)
            : root.kind == "danger" && root.hot ? Theme.red-dim
            : Theme.bg-tertiary;
        border-color: root.armed ? Theme.red
            : root.kind == "primary" ? Theme.accent
            : root.kind == "on" ? Theme.green
            : root.hot ? (root.kind == "danger" ? Theme.red : Theme.accent)
            : Theme.border;
    }
    property <color> fg: root.armed ? Theme.red
        : root.kind == "primary" ? Theme.white
        : root.kind == "on" ? Theme.green
        : root.hot ? (root.kind == "danger" ? Theme.red : Theme.text-primary)
        : Theme.text-secondary;
    accessible-role: button;
    accessible-label: root.text;
    lay := HorizontalLayout {
        y: body.y; height: body.height;
        padding-left: Theme.sp-10; padding-right: Theme.sp-10;
        spacing: Theme.sp-4;
        if root.has-icon && !root.armed: VerticalLayout { alignment: center; Icon { width: Theme.icon-sm; height: Theme.icon-sm; source: root.icon; tint: root.fg; } }
        Text { text: root.armed ? root.confirm-text : root.text; vertical-alignment: center; font-size: Theme.text-12; color: root.fg; }
    }
    disarm := Timer { interval: Theme.confirm-arm; running: false; triggered => { self.running = false; root.armed = false; } }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.confirm-text != "" && !root.armed { root.armed = true; disarm.running = true; return; }
            root.armed = false; disarm.running = false;
            root.clicked();
        }
    }
}

/// The colour pair for a tone: "running"/"ok" green, "error" red,
/// "warn" yellow, "accent", anything else muted.
export global Tones {
    public pure function fg(tone: string) -> color {
        return tone == "running" || tone == "ok" ? Theme.green
            : tone == "error" ? Theme.red
            : tone == "warn" ? Theme.yellow
            : tone == "accent" ? Theme.accent-hover
            : Theme.text-muted;
    }
    public pure function bg(tone: string) -> color {
        return tone == "running" || tone == "ok" ? Theme.green-dim
            : tone == "error" ? Theme.red-dim
            : tone == "warn" ? Theme.yellow-dim
            : tone == "accent" ? Theme.accent-dim
            : Theme.bg-tertiary;
    }
}

/// A status pill: mono, upper case, wide tracking (.svc-status).
export component StatusTag inherits Rectangle {
    in property <string> text;
    in property <string> tone;
    height: t.preferred-height + Theme.sp-4;
    width: t.preferred-width + Theme.sp-16;
    border-radius: Theme.r-pill;
    background: Tones.bg(root.tone);
    t := Text { text: root.text; font-family: Theme.mono; font-size: Theme.text-10; letter-spacing: Theme.track-wide; color: Tones.fg(root.tone); }
}

/// A state dot with its soft ring (.svc-dot): running and error have a ring.
export component StateDot inherits Rectangle {
    in property <string> tone;
    width: Theme.sp-12; height: Theme.sp-12;
    if root.tone == "running" || root.tone == "ok" || root.tone == "error" || root.tone == "warn": Rectangle {
        border-radius: Theme.r-control; background: Tones.bg(root.tone);
    }
    Rectangle { width: Theme.sp-8; height: Theme.sp-8; border-radius: Theme.r-chip; background: root.tone == "" ? Theme.text-muted : Tones.fg(root.tone); }
}

/// A count badge (the tabs' and the inbox's): accent pill, white bold.
export component CountBadge inherits Rectangle {
    in property <string> text;
    in property <color> fill: Theme.accent;
    visible: root.text != "";
    height: Theme.sp-16;
    width: max(Theme.sp-16, n.preferred-width + Theme.sp-10);
    border-radius: Theme.r-pill;
    background: root.fill;
    n := Text { text: root.text; color: Theme.white; font-size: Theme.text-10; font-weight: Theme.w-bold; }
}

/// A card (.svc-card): bg-card, border (lighter on hover), radius r-card,
/// its children stacked sp-10 apart.
export component Card inherits Rectangle {
    in property <bool> selected;
    callback clicked();
    background: Theme.bg-card;
    border-radius: Theme.r-card;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : ca.has-hover ? Theme.accent-edge : Theme.border;
    ca := TouchArea { clicked => { root.clicked(); } }
    VerticalLayout {
        padding-top: Theme.sp-12; padding-bottom: Theme.sp-12;
        padding-left: Theme.sp-16; padding-right: Theme.sp-16;
        spacing: Theme.sp-10;
        @children
    }
}

/// A card's head: the state dot, the name (elided), the status pill, then
/// anything else (children) on the right.
export component CardHead inherits HorizontalLayout {
    in property <string> name;
    in property <string> tone;
    in property <bool> dot: true;
    in property <string> tag;
    spacing: Theme.sp-8;
    if root.dot: StateDot { y: (parent.height - self.height) / 2; tone: root.tone; }
    Text { horizontal-stretch: 1; text: root.name; vertical-alignment: center; font-size: Theme.text-14; font-weight: Theme.w-semibold; color: Theme.text-primary; overflow: elide; }
    if root.tag != "": StatusTag { y: (parent.height - self.height) / 2; text: root.tag; tone: root.tone; }
    @children
}

/// A muted mono line under a card's head (.svc-meta).
export component MetaLine inherits Text {
    font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-muted; overflow: elide;
}

/// Nothing to show (.services-empty): a big faint icon, a line, a hint.
export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <string> title;
    in property <string> hint;
    alignment: center;
    spacing: Theme.sp-12;
    padding: Theme.sp-24;
    if root.has-icon: HorizontalLayout { alignment: center; Icon { width: Theme.sp-40; height: Theme.sp-40; source: root.icon; tint: Theme.text-muted; opacity: Theme.o-dim; } }
    Text { text: root.title; horizontal-alignment: center; color: Theme.text-muted; font-size: Theme.text-14; wrap: word-wrap; }
    if root.hint != "": Text { text: root.hint; horizontal-alignment: center; color: Theme.text-muted; font-size: Theme.text-12; wrap: word-wrap; }
    @children
}

/// A load that failed: the server's words in red, and Retry.
export component ErrorState inherits VerticalLayout {
    in property <string> text;
    in property <bool> retry: true;
    callback retried();
    alignment: center;
    spacing: Theme.sp-12;
    padding: Theme.sp-24;
    Text { text: root.text; horizontal-alignment: center; color: Theme.red; font-size: Theme.text-13; wrap: word-wrap; }
    if root.retry: HorizontalLayout { alignment: center; SmallBtn { text: "Retry"; clicked => { root.retried(); } } }
}

/// Loading: the spinner and a muted line ("Loading…").
export component LoadingState inherits HorizontalLayout {
    in property <string> text: "Loading…";
    alignment: center;
    spacing: Theme.sp-8;
    padding: Theme.sp-24;
    VerticalLayout { alignment: center; Spinner { } }
    Text { text: root.text; vertical-alignment: center; color: Theme.text-muted; font-size: Theme.text-13; }
}

/// A list row (.file-item): icon, name, meta on the right, an optional
/// second line, hover and selected; the "…" button shows on hover or
/// selection. A right click or "…" asks for the menu at a window point
/// (give it to kit::menu in Rust).
export component ListRow inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <color> icon-tint: Theme.text-muted;
    in property <string> title;
    in property <string> sub;
    in property <string> meta;
    in property <bool> mono;
    in property <bool> selected;
    in property <bool> more: true;
    callback clicked();
    callback double-clicked();
    callback context(length, length);
    height: max(Theme.control, lay.preferred-height);
    border-radius: Theme.r-control;
    background: root.selected ? Theme.accent-dim : ta.has-hover ? Theme.bg-hover : transparent;
    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(ev) => {
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    lay := HorizontalLayout {
        padding-left: Theme.sp-8; padding-right: Theme.sp-4;
        padding-top: Theme.sp-4; padding-bottom: Theme.sp-4;
        spacing: Theme.sp-8;
        if root.has-icon: VerticalLayout { alignment: center; Icon { source: root.icon; tint: root.icon-tint; } }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text { text: root.title; font-size: Theme.text-13; color: Theme.text-primary; overflow: elide; font-family: root.mono ? Theme.mono : Theme.ui-font; }
            if root.sub != "": Text { text: root.sub; font-size: Theme.text-11; color: Theme.text-muted; overflow: elide; }
        }
        if root.meta != "": Text { text: root.meta; vertical-alignment: center; font-size: Theme.text-11; color: Theme.text-muted; }
        if root.more: Rectangle {
            width: Theme.control-sm;
            opacity: ta.has-hover || mt.has-hover || root.selected ? 1 : 0;
            Rectangle {
                width: Theme.control-sm; height: Theme.control-sm; border-radius: Theme.r-chip;
                background: mt.has-hover ? Theme.bg-tertiary : transparent;
                Icon { source: Icons.more; width: Theme.icon-sm; height: Theme.icon-sm; tint: mt.has-hover ? Theme.text-primary : Theme.text-muted; }
                mt := TouchArea { mouse-cursor: pointer; clicked => { root.context(self.absolute-position.x, self.absolute-position.y + self.height); } }
            }
        }
    }
}

/// A table's column: its title, its share of the width (columns with
/// share 0 take `width`), right-aligned (numbers), mono.
export struct TableCol { title: string, share: float, width: length, right: bool, mono: bool }
/// A table's row: its key (for callbacks), its cells in column order, a tone
/// for the first cell's dot ("" none).
export struct TableRow { key: string, cells: [string], tone: string, selected: bool }

/// A table: the head (muted, upper case), then the rows (hover, selected),
/// a hairline between rows. Scrolls with its own view. Columns (at most
/// eight) are placed by hand, not by a layout: their widths come from the
/// table's own width.
export component Table inherits Rectangle {
    in property <[TableCol]> cols;
    in property <[TableRow]> rows;
    in property <string> empty: "Nothing here yet";
    callback row-clicked(string);
    callback row-context(string, length, length);
    // The share columns' room, and their shares' sum.
    property <length> room: root.width - 2 * Theme.sp-12 - root.fixed;
    property <float> shares: root.share-of(0) + root.share-of(1) + root.share-of(2) + root.share-of(3)
        + root.share-of(4) + root.share-of(5) + root.share-of(6) + root.share-of(7);
    property <length> fixed: root.fixed-of(0) + root.fixed-of(1) + root.fixed-of(2) + root.fixed-of(3)
        + root.fixed-of(4) + root.fixed-of(5) + root.fixed-of(6) + root.fixed-of(7);
    pure function share-of(i: int) -> float { return i < root.cols.length ? root.cols[i].share : 0; }
    pure function fixed-of(i: int) -> length { return i < root.cols.length && root.cols[i].share == 0 ? root.cols[i].width : 0px; }
    /// Column i's width.
    pure function cw(i: int) -> length {
        return i >= root.cols.length ? 0px
            : root.cols[i].share > 0 ? max(0px, root.room) * root.cols[i].share / (root.shares > 0 ? root.shares : 1)
            : root.cols[i].width;
    }
    /// Column i's left edge.
    pure function cx(i: int) -> length {
        return Theme.sp-12 + (i > 0 ? root.cw(0) : 0px) + (i > 1 ? root.cw(1) : 0px) + (i > 2 ? root.cw(2) : 0px)
            + (i > 3 ? root.cw(3) : 0px) + (i > 4 ? root.cw(4) : 0px) + (i > 5 ? root.cw(5) : 0px) + (i > 6 ? root.cw(6) : 0px);
    }
    border-radius: Theme.r-card;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg-card;
    clip: true;
    VerticalLayout {
        Rectangle {
            height: Theme.control;
            for c[i] in root.cols: Text {
                x: root.cx(i); width: root.cw(i) - (c.right ? 0px : Theme.sp-8); height: parent.height;
                text: c.title;
                vertical-alignment: center;
                horizontal-alignment: c.right ? right : left;
                font-size: Theme.text-11; font-weight: Theme.w-semibold; letter-spacing: Theme.track-wide;
                color: Theme.text-muted; overflow: elide;
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        if root.rows.length == 0: Rectangle {
            height: Theme.control-lg;
            Text { text: root.empty; color: Theme.text-muted; font-size: Theme.text-13; }
        }
        ListView {
            vertical-stretch: 1;
            for r in root.rows: Rectangle {
                height: Theme.control;
                background: r.selected ? Theme.accent-dim : rt.has-hover ? Theme.bg-hover : transparent;
                rt := TouchArea {
                    clicked => { root.row-clicked(r.key); }
                    pointer-event(ev) => {
                        if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.up {
                            root.row-context(r.key, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                if r.tone != "": StateDot { x: Theme.sp-12; y: (parent.height - self.height) / 2; tone: r.tone; }
                for c[i] in root.cols: Text {
                    property <length> dot: i == 0 && r.tone != "" ? Theme.sp-12 + Theme.sp-6 : 0px;
                    x: root.cx(i) + self.dot; width: root.cw(i) - self.dot - (c.right ? 0px : Theme.sp-8); height: parent.height;
                    text: r.cells[i];
                    vertical-alignment: center;
                    horizontal-alignment: c.right ? right : left;
                    font-size: Theme.text-12;
                    font-family: c.mono ? Theme.mono : Theme.ui-font;
                    color: i == 0 ? Theme.text-primary : Theme.text-secondary;
                    overflow: elide;
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
            }
        }
    }
}

/// A form field's label (.sm-label): small, upper case, muted, wide.
export component FormLabel inherits Text {
    font-size: Theme.text-11; letter-spacing: Theme.track-wide; color: Theme.text-muted;
    wrap: word-wrap;
}

/// A one-line input (.sm-input): bg-tertiary, a border, accent when focused.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <bool> invalid;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited(string);
    callback escape();
    height: Theme.control;
    border-radius: Theme.r-control;
    background: Theme.bg-tertiary;
    border-width: 1px;
    border-color: root.invalid ? Theme.red : input.has-focus ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1 : Theme.o-dim;
    HorizontalLayout {
        padding-left: Theme.sp-10; padding-right: Theme.sp-10;
        input := TextInput {
            text <=> root.text;
            enabled: root.enabled;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text-primary;
            font-size: Theme.text-13;
            font-family: root.mono ? Theme.mono : Theme.ui-font;
            selection-background-color: Theme.selection;
            input-type: root.password ? InputType.password : InputType.text;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
            key-pressed(ev) => { if ev.text == Key.Escape { root.escape(); return accept; } return reject; }
        }
    }
    if root.text == "": Text {
        x: Theme.sp-10; height: parent.height; vertical-alignment: center;
        text: root.placeholder; color: Theme.placeholder; font-size: Theme.text-13;
        font-family: root.mono ? Theme.mono : Theme.ui-font;
    }
    public function focus-input() { input.focus(); }
    public function select-all() { input.select-all(); }
}

/// A multi-line input (textarea.sm-input): `rows` lines high, scrolls inside.
export component TextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono;
    in property <int> rows: 4;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    // Ctrl/Cmd+Enter (the web's "save" in its editors).
    callback submit();
    height: root.rows * Theme.text-13 * Theme.lh-ui + 2 * Theme.sp-8;
    border-radius: Theme.r-control;
    background: Theme.bg-tertiary;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    fl := Flickable {
        x: Theme.sp-10; y: Theme.sp-8;
        width: parent.width - 2 * Theme.sp-10; height: parent.height - 2 * Theme.sp-8;
        content-height: max(self.height, input.preferred-height);
        input := TextInput {
            width: fl.width;
            text <=> root.text;
            enabled: root.enabled;
            single-line: false;
            wrap: word-wrap;
            color: Theme.text-primary;
            font-size: Theme.text-13;
            font-family: root.mono ? Theme.mono : Theme.ui-font;
            selection-background-color: Theme.selection;
            edited => { root.edited(self.text); }
            key-pressed(ev) => {
                if ev.text == Key.Return && (ev.modifiers.control || ev.modifiers.meta) { root.submit(); return accept; }
                return reject;
            }
        }
    }
    if root.text == "": Text {
        x: Theme.sp-10; y: Theme.sp-8;
        text: root.placeholder; color: Theme.placeholder; font-size: Theme.text-13;
    }
    public function focus-input() { input.focus(); }
}

/// A segmented choice (.sm-seg / .seg-pref): one of `options`, the chosen
/// one in accent-dim with an accent edge.
export component Seg inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> enabled: true;
    callback picked(int);
    spacing: Theme.sp-6;
    alignment: start;
    for o[i] in root.options: Rectangle {
        height: Theme.control-sm;
        width: st.preferred-width + Theme.sp-24;
        border-radius: Theme.r-control;
        border-width: 1px;
        border-color: i == root.selected ? Theme.accent : Theme.border;
        background: i == root.selected ? Theme.accent-dim : sa.has-hover ? Theme.bg-hover : Theme.bg-tertiary;
        st := Text { text: o; font-size: Theme.text-12; color: i == root.selected ? Theme.accent-hover : Theme.text-secondary; }
        sa := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.picked(i); } }
    }
}

/// An on/off switch: a pill track, accent when on, the knob sliding.
export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: Theme.sp-32 + Theme.sp-4; height: Theme.sp-20;
    border-radius: Theme.r-pill;
    background: root.on ? Theme.accent : Theme.bg-tertiary;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1 : Theme.o-dim;
    Rectangle {
        width: Theme.sp-16; height: Theme.sp-16; y: Theme.sp-2 - 1px;
        x: root.on ? parent.width - self.width - Theme.sp-2 : Theme.sp-2 - 1px;
        border-radius: Theme.r-pill;
        background: Theme.white;
        animate x { duration: Theme.motion-fast; }
    }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.toggled(!root.on); } }
}

/// A ticked row: the client's own box (accent with a check) and its label.
export component CheckRow inherits HorizontalLayout {
    in property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled(bool);
    spacing: Theme.sp-8;
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: Theme.sp-16; height: Theme.sp-16;
        border-radius: Theme.r-chip;
        border-width: 1px;
        border-color: root.checked ? Theme.accent : Theme.border;
        background: root.checked ? Theme.accent : Theme.bg-tertiary;
        if root.checked: Icon { source: Icons.check; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.white; }
    }
    Text { text: root.text; vertical-alignment: center; font-size: Theme.text-13; color: root.enabled ? Theme.text-primary : Theme.text-muted; wrap: word-wrap; horizontal-stretch: 1; }
    TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
}

/// A drop-down (<select>): a field-looking button with the chosen label and
/// a chevron; its list opens under it (a popup), Esc or a click outside
/// closes it.
export component Select inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <string> placeholder: "Choose…";
    in property <bool> enabled: true;
    callback picked(int);
    height: Theme.control;
    min-width: Theme.sp-48 + Theme.sp-40;
    border-radius: Theme.r-control;
    background: sa.has-hover && root.enabled ? Theme.bg-hover : Theme.bg-tertiary;
    border-width: 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : Theme.o-dim;
    HorizontalLayout {
        padding-left: Theme.sp-10; padding-right: Theme.sp-8;
        spacing: Theme.sp-6;
        Text {
            horizontal-stretch: 1;
            text: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : root.placeholder;
            color: root.selected >= 0 ? Theme.text-primary : Theme.placeholder;
            vertical-alignment: center; font-size: Theme.text-13; overflow: elide;
        }
        Icon { y: (parent.height - self.height) / 2; source: Icons.chevron-right; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.text-muted; }
    }
    sa := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { pop.show(); } }
    pop := PopupWindow {
        x: 0; y: root.height + Theme.sp-4;
        width: root.width;
        Rectangle {
            background: Theme.bg-secondary;
            border-radius: Theme.r-card;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.sp-4;
                spacing: 1px;
                for o[i] in root.options: Rectangle {
                    height: Theme.control-sm + Theme.sp-4;
                    border-radius: Theme.r-control;
                    background: oa.has-hover ? Theme.bg-hover : i == root.selected ? Theme.accent-dim : transparent;
                    Text { x: Theme.sp-8; width: parent.width - Theme.sp-16; text: o; vertical-alignment: center; font-size: Theme.text-13; color: Theme.text-primary; overflow: elide; }
                    oa := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
                }
            }
        }
    }
}

/// A modal dialog over the window: the scrim (a click on it closes), a
/// card (bg-secondary, border, r-card, soft shadow) with its head (title,
/// ×) and the children as its body. Esc closes. Place it at the window's
/// size (an area's overlay is). Tell the window it is open through the
/// area's modal flag (AREAS.md: Shell.modal-<area>), so nothing under the
/// scrim takes the pointer.
export component Modal inherits Rectangle {
    in property <string> title;
    in property <length> card-w: Theme.dialog-w;
    in property <bool> closable: true;
    callback close();
    background: Theme.scrim;
    TouchArea { clicked => { if root.closable { root.close(); } } }
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(ev) => { if ev.text == Key.Escape && root.closable { root.close(); return accept; } return reject; }
    }
    card := Rectangle {
        width: min(root.card-w, root.width - 2 * Theme.sp-24);
        height: min(col.preferred-height, root.height - 2 * Theme.sp-24, Theme.dialog-max-h);
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-card; shadow: Theme.shadow-card; }
        Rectangle { background: Theme.bg-secondary; border-radius: Theme.r-card; border-width: 1px; border-color: Theme.border; }
        // The card takes its own presses (they don't reach the scrim).
        TouchArea { }
        col := VerticalLayout {
            Rectangle {
                height: Theme.sp-48;
                HorizontalLayout {
                    padding-left: Theme.sp-16; padding-right: Theme.sp-8;
                    Text { horizontal-stretch: 1; text: root.title; vertical-alignment: center; font-size: Theme.text-16; font-weight: Theme.w-semibold; color: Theme.text-primary; overflow: elide; }
                    if root.closable: IconButton { y: (parent.height - self.height) / 2; icon: Icons.x; tooltip: "Close"; clicked => { root.close(); } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            VerticalLayout {
                padding: Theme.sp-16;
                spacing: Theme.sp-10;
                @children
            }
        }
    }
}

/// A modal's buttons, on the right (Cancel, then the action).
export component ModalActions inherits HorizontalLayout {
    alignment: end;
    spacing: Theme.sp-8;
    padding-top: Theme.sp-4;
    @children
}
