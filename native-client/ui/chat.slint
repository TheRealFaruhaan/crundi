// A chat pane, as the web UI's chat (app/vendor/claude-chat.js) draws it:
// the pane header, the log, and the composer. Sizes and colours are its CSS.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Pointer, AccentFill, SoftShadow, ScrollThumb, DashedBox, RevealFlickable, SendBtn, UploadStrip } from "widgets.slint";
import { ListView, DatePickerPopup, TimePickerPopup, Date, Time } from "std-widgets.slint";

/// A row of the agent dock's list (2.18): the record's toolUseId, title,
/// sub, running | failed | done.
export struct AgentRow { id: string, title: string, sub: string, state: string }

/// A block of a side question's answer: p | li | code, a list item's
/// marker, its markdown (or a code block's text).
export struct AnsBlock { kind: string, marker: string, md: styled-text, text: string }

/// A factory's result card (2.20, specs/cards.md, src/fresult.rs): a file
/// row, a follow-up, a button, and the whole card with its open parts.
export struct FrFile { name: string, add: string, del: string }
export struct FrFu { id: string, text: string, place: string, blocking: bool }
export struct FrBtn { key: string, label: string, primary: bool, danger: bool }
export struct FrView {
    title: string,
    blocks: [AnsBlock],
    add: string, del: string, n: string, branch: string,
    files-open: bool, files: [FrFile], more: string,
    can-diff: bool, diff-loading: bool, diff-on: bool, diff: [string], diff-cols: int, diff-err: string,
    msg: styled-text, msg-on: bool, usage: string,
    fu-line: string, fu-open: bool, fus: [FrFu],
    error: string,
    btns: [FrBtn], busy: bool,
    note-open: bool, note: string, note-gen: int, note-focus: int,
    act-err: string,
}

/// What a factory result card does (src/app.rs), by the chat and the entry:
/// open or close a list (files | fu), press a button (its key), the note
/// typed, Send to the Manager, Show the full diff.
export global FrAct {
    callback toggle(string, string, string);
    callback press(string, string, string);
    callback note(string, string, string);
    callback send(string, string);
    callback diff(string, string);
}

/// The last user bubble drawn (F122, the test driver): its drawn text's
/// height, its selectable copy's, and the bubble's.
export global BubbleProbe {
    in-out property <length> drawn;
    in-out property <length> copy;
    in-out property <length> box;
}

/// Live frames in the log (2.16f, src/frames.rs): the Workbench is shown;
/// the chat full screen ("" none, else its pane key); a counter bumped on
/// every paint (the images are re-read on it). By frame key: its picture,
/// painted yet, its page's cursor. A box on the log reports itself (key,
/// chat, target, the view's size); the pointer, the wheel, keys and focus
/// go to its page.
export global FrameUi {
    in-out property <bool> shown: true;
    in-out property <string> full-key;
    in-out property <int> gen;
    pure callback image(string, int) -> image;
    pure callback painted(string, int) -> bool;
    pure callback cursor(string, int) -> int;
    callback seen(string, string, string, length, length, length, length);
    callback pointer(string, int, length, length, int);
    callback wheel(string, length, length, length, length);
    // (key, text, down, Ctrl, Shift, Alt, Meta)
    callback key(string, string, bool, bool, bool, bool, bool);
    // Does the page take this wheel (its root can still scroll that way)?
    // Else the log scrolls (F134).
    pure callback wheel-takes(string, length, length) -> bool;
    callback focus(string, bool);
}

/// The window's height (main.slint keeps it): the full diff is at most half of it.
export global Win {
    in-out property <length> height;
}

/// A medium a show_* call showed (2.16m): its kind (image | video | audio |
/// file | embed), its cache key, stored name, file id and name, its box (w, h
/// in px, before anything loads), caption and a frame's Open link and url,
/// loading | ready | gone | empty, the picture (or a video's poster),
/// fetching (on its way to the player), a file's line, a duration.
export struct MediaItem { kind: string, key: string, name: string, id: string, filename: string, w: float, h: float, caption: string, link: string, url: string, state: string, image: image, fetching: bool, line: string, duration: string, chat: string, frame: string, fixed-h: bool }
/// A download's row: its id, name, line, running | done | failed | cancelled, progress.
/// A widget check's screenshot (2.20): its picture's key, caption, state,
/// picture, and width over height.
export struct ShotItem { key: string, caption: string, state: string, image: image, ratio: float }
export struct DlRow { id: int, name: string, line: string, state: string, frac: float }

/// An Edit's diff line ("- old" / "+ new"), and a to-do (completed |
/// in_progress | pending).
export struct DiffLine { text: string, add: bool }
export struct TodoItem { text: string, state: string }

/// A tool card (2.14): its entry, the tool's name as sent, the summary, the
/// result as shown, running | done | unanswered, failed, open; the body's
/// arguments by kind (bash: the command and its description; write: the
/// content; diff: its lines; todos: its items; json: the input as JSON).
export struct ToolView {
    id: string,
    title: string,
    detail: string,
    text: string,
    status: string,
    error: bool,
    open: bool,
    kind: string,
    args: string,
    note: string,
    lines: [DiffLine],
    todos: [TodoItem],
    // What a show_* call showed, under the card; the call's caption (several
    // items); files and audio stack instead of a row.
    media: [MediaItem],
    media-caption: string,
    media-stack: bool,
    // A widget_render call's screenshots (2.20).
    shots: [ShotItem],
}

/// A tool card's or group's head clicked (src/app.rs): by the chat, and the
/// entry id or "g:<group>".
/// What the test driver reads of one chat's log (the pane whose key it
/// watches): its distance from the bottom, following it, the jump button.
/// The test driver's view of an open agent panel: how far from its end.
export global SheetProbe {
    in-out property <length> dist;
}

export global LogProbe {
    in-out property <string> watch;
    in-out property <length> dist;
    in-out property <length> over;
    // The jump button's middle, in window coordinates (when shown).
    in-out property <length> jump-x;
    in-out property <length> jump-y;
    in-out property <bool> stick;
    in-out property <bool> jump;
    in-out property <bool> jump-new;
}

export global ToolAct {
    callback toggle(string, string);
    // A link in Claude's reply (2.16): the system browser.
    callback open-link(string);
    // A code block's copy button: its text to the clipboard.
    callback copy(string);
    // A click at a byte offset of a user's message (a URL there opens).
    callback click-at(string, int);
    // Media (2.16m): a picture's viewer (its key); play (chat, stored name,
    // file name); Download (chat, file id, file name); a frame's Open (chat,
    // stored name, url).
    callback view(string);
    // The dock (2.17), by pane key; a side question's × (chat, its id).
    callback sug-send(string);
    callback sug-dismiss(string);
    callback recap-dismiss(string);
    callback aside-close(string, string);
    // An escalated permission's "Carry on without this" (its approval id).
    callback collab-cancel(string);
    // The agent dock (2.18): a badge (pane key, commands?), open a record's
    // panel (chat, toolUseId, from the list?), back, close, dismiss one or all.
    callback agent-badge(string, bool);
    callback agent-open(string, string, bool);
    callback agent-back(string);
    callback agent-close(string);
    callback agent-dismiss(string, string);
    callback agent-dismiss-all(string, bool);
    // The goal and the plan (2.19), by pane key.
    callback plan-toggle(string);
    callback goal-clear(string);
    callback play(string, string, string);
    callback download(string, string, string);
    callback open-frame(string, string, string);
}

/// One choice of a question: its label, description and preview; picked;
/// the note row open under it (with the note's text, and whether it takes
/// the focus when it opens); a counter that asks for the keyboard (an arrow
/// moved the pick here).
export struct QOpt { label: string, desc: string, preview: string, chosen: bool, note-open: bool, note: string, note-focus: bool, focus-gen: int }

/// One question: its chip, text, kind, choices, and Other (what it holds,
/// and a counter that resets the field when a pick clears it).
export struct QView { header: string, question: string, multi: bool, options: [QOpt], other: string, other-gen: int, other-focus: int }

export struct EntryView {
    id: string,
    // user | assistant | code | thinking | tools | permission | question | result | error | notice
    kind: string,
    text: string,
    md: styled-text,
    title: string,
    detail: string,
    status: string,
    error: bool,
    request-id: string,
    options: [string],
    tools: [ToolView],
    // The space after this row (paragraphs, list items, entries: src/app.rs).
    gap: length,
    // A tool group's head open (2.14).
    open: bool,
    // A permission card (F107): the reason, the input as JSON, the closed
    // card's tag and, never answered, what it asked.
    note: string,
    args: string,
    tag: string,
    sub: string,
    // A side question's answer as the reply's blocks (lists hang, F106).
    blocks: [AnsBlock],
    // A question card (2.13): its chat, its questions with the person's
    // picks, and whether it can be answered (pending or orphaned), is
    // orphaned, can be submitted; answered: its tags, note lines, dismissed,
    // by Cru.
    chat: string,
    questions: [QView],
    q-open: bool,
    q-orphaned: bool,
    q-can: bool,
    q-tags: [string],
    q-notes: [string],
    q-dismissed: bool,
    q-by-cru: bool,
    // A factory's result card (2.20).
    fr: FrView,
}

/// What a question card does (src/app.rs): by the chat and the entry; a
/// question and a choice by their index.
export global QAct {
    callback pick(string, string, int, int);
    callback note-open(string, string, int, int);
    callback note-typed(string, string, int, string);
    callback note-remove(string, string, int);
    callback other-typed(string, string, int, string);
    // An arrow in a radio group: from this choice, one up (-1) or down (1).
    callback move(string, string, int, int, int);
    callback submit(string, string);
    callback dismiss(string, string);
}

/// The state dot's colour (header and sidebar agree).
export global PaneState {
    public pure function color(state: string) -> color {
        return state == "working" ? Theme.yellow
            : state == "needs-input" ? Theme.accent
            : state == "waiting" ? Theme.sky
            : state == "exited" ? Theme.text-muted
            : Theme.green;
    }
}

/// A tooltip's box. The web's are the system's own (the title attribute);
/// Slint draws its own, so this is the closest (PLAN.md, Known gaps).
export component TipBox inherits Rectangle {
    in property <string> text;
    background: Theme.bg-tertiary;
    border-radius: Theme.r-chip;
    border-width: 1px;
    border-color: Theme.border;
    width: tt.preferred-width + Theme.sp-16;
    height: tt.preferred-height + Theme.sp-8;
    tt := Text { text: root.text; font-size: Theme.text-12; color: Theme.text-primary; }
}

/// The one tooltip on screen (main.slint draws it, kept inside the window):
/// its text, where the pointer was, which Tip owns it.
export global TipState {
    in-out property <bool> shown;
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <int> owner;
    in-out property <int> count;
}

/// A tooltip for what holds it (a TouchArea: `on: parent.has-hover`): after
/// tip-delay on it, its text shows by the pointer. Slint's own Tooltip opens
/// where the pointer is and runs past the window's edge; this one is drawn
/// by main.slint, flipped and shifted to stay inside.
export component Tip {
    in property <bool> on;
    in property <string> text;
    property <int> id: -1;
    width: 0; height: 0;
    function arm() {
        if root.id < 0 { TipState.count += 1; root.id = TipState.count; }
        wait.running = true;
    }
    function drop() {
        wait.running = false;
        if TipState.owner == root.id { TipState.shown = false; }
    }
    init => { if root.on { root.arm(); } }
    changed on => { if root.on { root.arm(); } else { root.drop(); } }
    changed text => { if TipState.shown && TipState.owner == root.id { TipState.text = root.text; } }
    wait := Timer {
        interval: Theme.tip-delay; running: false;
        triggered => {
            self.running = false;
            if root.on && root.text != "" {
                TipState.text = root.text; TipState.x = Pointer.x; TipState.y = Pointer.y;
                TipState.owner = root.id; TipState.shown = true;
            }
        }
    }
}

/// A pane header button (.term-font-btn and its kin): a border, bg-primary,
/// radius 6, text-secondary; hover: text-primary on an accent border.
/// Its box is given (the spec's measured sizes); the icon or label is centred.
component HeadBtn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon;
    in property <length> icon-size: Theme.icon-sm;
    in property <length> label-size: Theme.text-11;
    in property <string> tip;
    // rest | on (yellow: secrets granted) | pinned (accent fill) | lit (accent: full screen)
    // | armed (red: "Sure?") | close (the ×: red on hover)
    in property <string> look: "rest";
    // A count after the icon (the secrets lock); and a label after that (the
    // lock in the narrow header's menu).
    in property <string> count;
    in property <string> after;
    callback clicked();
    property <bool> hover: ta.has-hover;
    property <color> ink: root.look == "on" ? Theme.yellow
        : root.look == "armed" ? Theme.red
        : root.look == "pinned" || root.look == "lit" ? Theme.accent-hover
        : root.look == "close" && root.hover ? Theme.red
        : root.hover ? Theme.text-primary : Theme.text-secondary;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.look == "on" ? Theme.yellow
        : root.look == "armed" ? Theme.red
        : root.look == "pinned" || root.look == "lit" ? Theme.accent
        : root.look == "close" && root.hover ? Theme.red
        : root.hover ? Theme.accent : Theme.border;
    background: root.look == "armed" ? Theme.red-dim : root.look == "pinned" ? Theme.accent-dim : Theme.bg-primary;
    accessible-role: button;
    accessible-label: root.tip;
    if root.has-icon && root.count == "" && root.after == "": Image {
        source: root.icon;
        width: root.icon-size; height: root.icon-size;
        colorize: root.ink;
    }
    // The lock with its count (and label), side by side.
    if root.has-icon && (root.count != "" || root.after != ""): HorizontalLayout {
        x: Theme.sp-8;
        width: self.preferred-width;
        spacing: Theme.sp-4;
        alignment: start;
        Image {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            width: root.icon-size; height: root.icon-size;
            colorize: root.ink;
        }
        if root.count != "": Text { text: root.count; font-size: Theme.text-11; color: root.ink; vertical-alignment: center; }
        if root.after != "": Text { text: root.after; font-size: Theme.text-11; color: root.ink; vertical-alignment: center; }
    }
    if !root.has-icon: Text { text: root.label; font-size: root.label-size; color: root.ink; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Tip { on: parent.has-hover; text: root.tip; }
    }
}

/// A chat-card button: border, bg-tertiary, radius 6.
/// Primary: the accent gradient (the web UI's global button.primary).
component CardBtn inherits Rectangle {
    in property <string> text;
    // The pane's text size (the web's --cc-fs).
    in property <float> fs: 1;
    in property <bool> primary;
    in property <bool> danger;
    // Disabled (Submit until every question has an answer): dimmed, no
    // hover, no press.
    in property <bool> enabled: true;
    callback clicked();
    // .cc-btn: padding round a line of text at the pane's size.
    height: Theme.sp-12 + Theme.sp-16 * root.fs;
    width: t.preferred-width + Theme.sp-24;
    opacity: root.enabled ? 1 : Theme.o-dim;
    // Primary, hovered: its glow (the web's button.primary:hover).
    if root.primary && root.enabled && ta.has-hover: SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-control; shadow: Theme.glow-accent; }
    border-radius: Theme.r-control;
    border-width: root.primary ? 0px : 1px;
    // Hovered (.cc-btn:hover): an accent border on accent-dim; danger red.
    border-color: root.danger && ta.has-hover && root.enabled ? Theme.red : ta.has-hover && root.enabled ? Theme.accent : Theme.border;
    background: root.primary ? transparent
        : root.danger && ta.has-hover && root.enabled ? Theme.red-dim
        : ta.has-hover && root.enabled ? Theme.accent-dim : Theme.bg-tertiary;
    // Primary: the accent gradient in its rounded shape (AccentFill).
    if root.primary: AccentFill { width: parent.width; height: parent.height; }
    // (Only the primary one is semibold, as .cc-btn.primary.)
    t := Text { text: root.text; font-size: Theme.text-12 * root.fs; font-weight: root.primary ? Theme.w-semibold : Theme.w-regular; color: root.primary ? Theme.white : root.danger && ta.has-hover ? Theme.red : Theme.text-primary; }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

/// Where a pane's header can be grabbed (its background, the ⋮⋮, the title):
/// a press that moves a little (sp-6) with the left button starts dragging the
/// pane (2.3); the release drops it. A click that didn't move stays a click
/// (`did-drag` says which). Positions are in window coordinates.
component HeadGrab inherits TouchArea {
    in property <bool> can-drag: true;
    in property <MouseCursor> rest-cursor: MouseCursor.default;
    out property <bool> dragging;
    out property <bool> did-drag;
    // Its tooltip may show: not once a button went down (Chromium hides a
    // title tooltip on a press), and not again until the pointer has left
    // and come back.
    out property <bool> tip-ok: true;
    changed has-hover => { if !self.has-hover { self.tip-ok = true; } }
    callback drag(int, length, length);
    mouse-cursor: self.dragging ? MouseCursor.grabbing : self.rest-cursor;
    pointer-event(ev) => {
        if ev.kind == PointerEventKind.down { self.tip-ok = false; }
        if ev.button == PointerEventButton.left {
            if ev.kind == PointerEventKind.down { self.did-drag = false; }
            if ev.kind == PointerEventKind.up && self.dragging {
                self.dragging = false;
                root.drag(2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    moved => {
        if self.pressed && self.can-drag {
            if !self.dragging && (abs(self.mouse-x - self.pressed-x) > Theme.sp-6 || abs(self.mouse-y - self.pressed-y) > Theme.sp-6) {
                self.dragging = true;
                self.did-drag = true;
                root.drag(0, self.absolute-position.x + self.pressed-x, self.absolute-position.y + self.pressed-y);
            }
            if self.dragging { root.drag(1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        }
    }
}

/// The CHAT tag: a small pill, bold upper case.
component KindTag inherits Rectangle {
    in property <string> text;
    height: Theme.sp-16;
    width: tag.preferred-width + Theme.sp-16;
    border-radius: Theme.r-pill;
    border-width: 1px;
    border-color: Theme.border;
    // Slint draws small bold capitals smaller than Chromium: a size up and
    // tight tracking match the web's glyphs (PLAN.md, "Small bold text").
    tag := Text { text: root.text; font-size: Theme.text-11; font-weight: Theme.w-bold; color: Theme.accent-hover; letter-spacing: Theme.track-tight; }
}

/// A factory Manager's tag (.term-factory-tag, 2.20): "Factory", accent
/// text in an accent pill.
component FactoryTag inherits Rectangle {
    height: Theme.sp-16;
    width: ft.preferred-width + Theme.sp-12 + Theme.sp-2;
    border-radius: Theme.r-pill;
    border-width: 1px;
    border-color: Theme.accent;
    ft := Text { text: "Factory"; font-size: Theme.text-10; font-weight: Theme.w-bold; color: Theme.accent; letter-spacing: Theme.track-tight; }
    ta := TouchArea { Tip { on: parent.has-hover; text: "The Manager of a factory run. It stays open while the run is going: stop the factory to close it."; } }
}

/// The header's PLANNING tag (.term-plan-tag): a chat in Plan mode with no
/// plan of its own yet. Sky text in a sky pill; not clickable.
component PlanTag inherits Rectangle {
    // With a plan (2.19): PLAN, proposed (yellow), executing (green) or
    // rejected (muted); a click toggles the plan panel.
    in property <string> status;
    callback clicked();
    property <color> c: root.status == "proposed" ? Theme.yellow : root.status == "executing" ? Theme.green : root.status == "rejected" ? Theme.text-muted : Theme.sky;
    height: Theme.sp-16;
    width: pt.preferred-width + 2 * Theme.sp-6;
    border-radius: Theme.r-pill;
    border-width: 1px;
    border-color: root.status == "rejected" ? Theme.border : root.c;
    background: root.status != "" && pa.has-hover ? Theme.bg-hover : transparent;
    pt := Text { text: root.status != "" ? "PLAN" : "PLANNING"; font-size: Theme.text-10; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide; color: root.c; }
    pa := TouchArea {
        mouse-cursor: root.status != "" ? pointer : default;
        clicked => { if root.status != "" { root.clicked(); } }
        Tip { on: parent.has-hover; text: root.status == "proposed" ? "Plan awaiting your approval — click to read it" : root.status == "executing" ? "Approved plan — click to read it" : root.status == "rejected" ? "Plan sent back for revision — click to read it" : "Plan mode — Claude is working one out"; }
    }
}

/// The pane header (.term-head): bg-secondary, a line under it, its items
/// in a row (specs/pane-header-wide.md). Narrow (2.2,
/// specs/pane-header-narrow.md): the tools fold into "…", the header is
/// lower (pane-head-narrow) and every item stays centred.
export component PaneHead inherits Rectangle {
    // The title shown (the long form on a wide header), its cap, and the
    // short title a rename starts from.
    in property <string> title;
    in property <length> title-max: Theme.title-cap;
    in property <string> short-title;
    in property <string> state;
    in property <string> kind-tag;
    // Plan mode, no plan yet: the PLANNING tag before CHAT (2.6); a plan's PLAN (2.19).
    in property <bool> planning;
    in property <string> plan-status;
    callback plan-clicked();
    in property <bool> chat;
    // A parked chat (2.23): the grey dot ("Closed"), the title (its tooltip
    // the whole title, no rename), the kind tag, pin and × only.
    in property <bool> parked;
    // A factory's Manager chat: the Factory tag before CHAT (2.20).
    in property <bool> factory;
    // The header's content box is under pane-fold: src/head.rs.
    in property <bool> narrow;
    // The fold-out menu is open (src/app.rs: one at a time).
    in property <bool> menu-open;
    // The secrets lock: shown when the server can (chat-secret-preauth); the
    // number of grants, and its tooltip.
    in property <bool> secrets;
    in property <int> secrets-n;
    in property <string> secrets-tip;
    in property <bool> pinned;
    in property <bool> full;
    // The × was clicked once: "Sure?" (src/app.rs disarms it after 3 s).
    in property <bool> armed;
    // No pin button (the drag's clone).
    in property <bool> no-pin;
    // Where "…" sits (from the header's left), for the menu's outside-press test.
    out property <length> more-left: self.width - Theme.sp-4 - (root.armed ? sure-m.preferred-width + Theme.sp-12 : Theme.sp-24) - Theme.sp-4 - Theme.sp-24;
    out property <length> more-top: (self.height - 1px - Theme.sp-20) / 2;
    callback close();
    callback full-screen();
    callback font(int);
    callback font-reset();
    callback pin();
    callback open-secrets();
    callback rename(string);
    callback maximize();
    callback more();
    // The header dragged (HeadGrab): 0 start, 1 move, 2 release.
    callback drag(int, length, length);
    property <bool> renaming;
    // The agent badge's text, upper case (none for idle and exited).
    property <string> badge: !root.chat ? "" : root.state == "working" ? "WORKING" : root.state == "needs-input" ? "NEEDS INPUT" : root.state == "waiting" ? "WAITING" : "";
    badge-m := Text { visible: false; text: root.badge; font-size: Theme.text-11; font-weight: Theme.w-bold; letter-spacing: Theme.track-tight; }
    height: root.narrow ? Theme.pane-head-narrow : Theme.pane-head;
    background: Theme.bg-secondary;
    sure-m := Text { visible: false; text: "Sure?"; font-size: Theme.text-11; }
    kind-m := Text { visible: false; text: root.kind-tag; font-size: Theme.text-11; font-weight: Theme.w-bold; letter-spacing: Theme.track-tight; }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    // Double-click the header (its background, handle, dot, tag: not the
    // buttons) to maximise the pane in its split. The whole header is the
    // drag handle (not in full screen).
    HeadGrab {
        can-drag: !root.full;
        double-clicked => { root.maximize(); }
        drag(k, x, y) => { root.drag(k, x, y); }
    }
    HorizontalLayout {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height - 1px;
        padding-left: Theme.sp-2;
        padding-right: Theme.sp-4;
        spacing: Theme.sp-4;
        // The drag handle "⋮⋮", packed tight.
        // Hidden in full screen.
        if !root.full: Rectangle {
            y: (parent.height - self.height) / 2; width: Theme.sp-24; height: Theme.sp-12;
            Text { x: Theme.sp-4; text: "⋮⋮"; font-size: Theme.text-12; letter-spacing: Theme.track-tight; color: Theme.text-muted; vertical-alignment: center; height: parent.height; }
            dh := HeadGrab {
                rest-cursor: MouseCursor.grab;
                double-clicked => { root.maximize(); }
                drag(k, x, y) => { root.drag(k, x, y); }
                if dh.tip-ok && !dh.pressed && !dh.dragging: Tip { on: parent.has-hover; text: "Drag to reorder"; }
            }
        }
        // The state dot (2.4): green idle, yellow working, accent needs
        // input (with an accent-dim ring), sky waiting, muted exited.
        // Its tooltip is the raw state.
        if root.chat || root.parked: Rectangle {
            y: (parent.height - self.height) / 2; width: Theme.sp-8; height: Theme.sp-8;
            if root.state == "needs-input": Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: Theme.sp-12; height: Theme.sp-12; border-radius: Theme.r-pill; background: Theme.accent-dim; }
            Rectangle { border-radius: Theme.r-chip; background: PaneState.color(root.state); }
            dt := TouchArea {
                Tip { on: parent.has-hover; text: root.parked ? "Closed" : root.state == "" ? "idle" : root.state; }
            }
        }
        // The title: semibold, radius 6.
        // Never wider than its cap (title-cap, the long form's, or none when
        // narrow), nor than the row leaves it: the spacer goes to 0 first, but
        // its two gaps stay.
        if !root.renaming: Rectangle {
            property <length> room: root.width - Theme.sp-2 - (root.full ? 0px : Theme.sp-24 + Theme.sp-4) - (root.chat || root.parked ? Theme.sp-12 : 0px) - Theme.sp-8 - tools.preferred-width - Theme.sp-4
                - (root.badge != "" ? badge-m.preferred-width + Theme.sp-12 + Theme.sp-4 : 0px)
                - (root.parked && root.kind-tag != "" ? kind-m.preferred-width + Theme.sp-16 + Theme.sp-4 : 0px);
            y: (parent.height - self.height) / 2; height: Theme.sp-16;
            width: max(0px, min(tt.preferred-width + Theme.sp-12, root.title-max, self.room));
            border-radius: Theme.r-control;
            background: th.has-hover ? Theme.bg-tertiary : transparent;
            tt := Text {
                x: Theme.sp-6; width: parent.width - Theme.sp-12;
                text: root.title; font-size: Theme.text-12; font-weight: Theme.w-semibold; color: Theme.text-primary;
                vertical-alignment: center; height: parent.height;
                overflow: elide; wrap: no-wrap;
            }
            th := HeadGrab {
                can-drag: !root.full;
                rest-cursor: root.parked ? MouseCursor.default : MouseCursor.text;
                clicked => { if !self.did-drag && !root.parked { root.renaming = true; } }
                double-clicked => { root.maximize(); }
                drag(k, x, y) => { root.drag(k, x, y); }
                if th.tip-ok && !th.pressed && !th.dragging: Tip { on: parent.has-hover; text: root.parked ? root.short-title : "Click to rename"; }
            }
        }
        // Renaming: an input title-cap wide, the short title all
        // selected; an accent border and a ring. Enter or leaving it
        // saves; Esc puts the title back.
        if root.renaming: ri := Rectangle {
            y: (parent.height - self.height) / 2; width: Theme.title-cap; height: Theme.sp-20;
            // A press anywhere outside the input saves it, as the web's blur.
            property <int> presses: Pointer.presses;
            changed presses => {
                if root.renaming && (Pointer.press-x < self.absolute-position.x || Pointer.press-x > self.absolute-position.x + self.width
                        || Pointer.press-y < self.absolute-position.y || Pointer.press-y > self.absolute-position.y + self.height) {
                    root.renaming = false;
                    root.rename(ti.text);
                }
            }
            // The focus ring.
            Rectangle { x: -Theme.sp-4; y: -Theme.sp-4; width: parent.width + 2 * Theme.sp-4; height: parent.height + 2 * Theme.sp-4; border-radius: Theme.r-field; background: Theme.accent-ring; }
            Rectangle {
                border-radius: Theme.r-control; border-width: 1px; border-color: Theme.accent;
                background: Theme.bg-primary;
            }
            FocusScope {
                key-pressed(ev) => {
                    if ev.text == Key.Escape { root.renaming = false; return accept; }
                    return reject;
                }
                // The text box (inside the padding and the border), clipped;
                // the text scrolls to keep the caret in view, as a browser's
                // input does (it opens scrolled to the end, all selected).
                // As std LineEdit (lineedit-base.slint), but with the room a
                // browser keeps for its caret, not Slint's caret width.
                Rectangle {
                    x: Theme.sp-8; width: parent.width - Theme.sp-12;
                    clip: true;
                    ti := TextInput {
                        property <length> scroll;
                        // A browser keeps a hairline caret in view at the end, none
                        // while text is selected (the caret isn't drawn).
                        property <length> caret-room: self.anchor-position-byte-offset != self.cursor-position-byte-offset ? 0px : 1px;
                        x: min(0px, max(parent.width - self.width - self.caret-room, self.scroll));
                        width: max(parent.width - self.caret-room, self.preferred-width);
                        font-size: Theme.text-12; font-weight: Theme.w-semibold; color: Theme.text-primary;
                        vertical-alignment: center; height: parent.height;
                        single-line: true;
                        selection-background-color: Theme.selection;
                        selection-foreground-color: Theme.white;
                        init => { self.text = root.short-title; self.focus(); self.select-all(); }
                        cursor-position-changed(at) => {
                            if at.x + self.scroll < 0 {
                                self.scroll = - at.x;
                            } else if at.x + self.scroll > parent.width - self.caret-room {
                                self.scroll = parent.width - at.x - self.caret-room;
                            }
                        }
                        accepted => { if root.renaming { root.renaming = false; root.rename(self.text); } }
                        changed has-focus => { if !self.has-focus && root.renaming { root.renaming = false; root.rename(self.text); } }
                    }
                }
            }
        }
        // The agent badge (2.4), after the title: WORKING, NEEDS INPUT,
        // WAITING; a small pill, bold upper case.
        // It never hides: the title elides first.
        if root.badge != "": Rectangle {
            y: (parent.height - self.height) / 2; height: Theme.sp-12;
            width: badge-m.preferred-width + Theme.sp-12;
            border-radius: Theme.r-pill;
            background: root.state == "working" ? Theme.yellow-dim : root.state == "waiting" ? Theme.sky-dim : Theme.accent-dim;
            // As the CHAT tag: a size up and tight tracking match the web's
            // glyphs (PLAN.md, "Small bold text").
            Text {
                text: root.badge; font-size: Theme.text-11; font-weight: Theme.w-bold; letter-spacing: Theme.track-tight;
                color: root.state == "working" ? Theme.yellow : root.state == "waiting" ? Theme.sky : Theme.accent-hover;
            }
        }
        // A parked chat's kind tag comes right after the title (the web's
        // headHtmlParked), not with the tools.
        if root.parked && root.kind-tag != "" && !root.renaming: KindTag { y: (parent.height - self.height) / 2; text: root.kind-tag; }
        // The rest is pushed right (the spacer can shrink to 0).
        Rectangle { horizontal-stretch: 1; min-width: 0; }
        // The tools: inline when wide; folded into "…" when narrow, leaving full
        // screen, "…" and ×. (Each is centred on the row.)
        tools := HorizontalLayout {
            spacing: Theme.sp-4;
            if (root.planning || root.plan-status != "") && !root.narrow: PlanTag { y: (parent.height - self.height) / 2; status: root.plan-status; clicked => { root.plan-clicked(); } }
            if root.factory && !root.narrow: FactoryTag { y: (parent.height - self.height) / 2; }
            if root.kind-tag != "" && !root.narrow && !root.parked: KindTag { y: (parent.height - self.height) / 2; text: root.kind-tag; }
            // The secrets lock (wider with a count); yellow with grants.
            if root.chat && root.secrets && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20;
                width: root.secrets-n > 0 ? Theme.sp-24 + Theme.sp-12 : Theme.sp-24;
                has-icon: true; icon: Icons.lock; icon-size: Theme.icon-sm;
                look: root.secrets-n > 0 ? "on" : "rest";
                count: root.secrets-n > 0 ? "" + root.secrets-n : "";
                tip: root.secrets-tip;
                clicked => { root.open-secrets(); }
            }
            // A- / reset / A+ (A+ a step wider, as the web's).
            if root.chat && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-24;
                label: "A-"; tip: "Smaller text";
                am := Text { visible: false; text: "A-"; font-size: Theme.text-11; }
                clicked => { root.font(-1); }
            }
            if root.chat && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-24;
                has-icon: true; icon: Icons.rotate-ccw; icon-size: Theme.icon-sm;
                tip: "Reset text size";
                clicked => { root.font-reset(); }
            }
            if root.chat && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-32;
                label: "A+"; tip: "Larger text";
                ap := Text { visible: false; text: "A+"; font-size: Theme.text-11; }
                clicked => { root.font(1); }
            }
            // Pin; pinned: accent on accent-dim, the pin turned.
            if !root.narrow && !root.no-pin: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-24;
                // Pinned, the icon is turned (drawn turned: pin-turned).
                has-icon: true; icon: root.pinned ? Icons.pin-turned : Icons.pin; icon-size: Theme.icon-md;
                look: root.pinned ? "pinned" : "rest";
                tip: root.pinned ? "Unpin (size and position are locked)" : "Pin size and position";
                clicked => { root.pin(); }
            }
            // Full screen; accent while on.
            if root.chat: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-24;
                has-icon: true; icon: Icons.maximize; icon-size: Theme.icon-sm;
                look: root.full ? "lit" : "rest";
                tip: "Full screen";
                clicked => { root.full-screen(); }
            }
            // "…"; accent while its menu is open, hovered or not.
            if root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-24;
                has-icon: true; icon: Icons.more; icon-size: Theme.icon-sm;
                look: root.menu-open ? "lit" : "rest";
                tip: "More";
                clicked => { root.more(); }
            }
            // Close takes two clicks: "×", then armed: "Sure?", red.
            // Hidden in full screen.
            if !root.full: HeadBtn {
                y: (parent.height - self.height) / 2;
                height: Theme.sp-16;
                width: root.armed ? sure.preferred-width + Theme.sp-12 : Theme.sp-24;
                label: root.armed ? "Sure?" : "×";
                label-size: root.armed ? Theme.text-11 : Theme.text-14;
                look: root.armed ? "armed" : "close";
                tip: root.armed ? "Click again to close" : root.parked ? "Close this pane for good" : "Close chat";
                sure := Text { visible: false; text: "Sure?"; font-size: Theme.text-11; }
                clicked => { root.close(); }
            }
        }
    }
}

/// The narrow header's menu (.term-head.tools-open .term-head-tools): the
/// folded tools in a wrapping row, right-aligned; bg-secondary, a border,
/// radius 6, a soft shadow. At most `max-w` wide (the header, less its insets).
/// A-, reset, A+ and pin act and leave it open; the lock closes it. A press
/// outside it (but on "…", which toggles it) closes it and still acts; Esc
/// closes it (the web has no Esc here: DESIGN rule 5, as the brief asks).
export component HeadMenu inherits Rectangle {
    in property <length> max-w;
    in property <string> kind-tag;
    // Plan mode, no plan yet: the PLANNING tag before CHAT (2.6); a plan's PLAN (2.19).
    in property <bool> planning;
    in property <string> plan-status;
    callback plan-clicked();
    in property <bool> secrets;
    in property <int> secrets-n;
    in property <string> secrets-tip;
    in property <bool> pinned;
    // "…" in window coordinates: a press there is its own toggle.
    in property <length> more-x;
    in property <length> more-y;
    callback font(int);
    callback font-reset();
    callback pin();
    callback open-secrets();
    callback dismiss();
    // As wide as its items on one line, but no wider than `max-w`: then it
    // wraps.
    property <length> lock-w: Theme.sp-8 + Theme.sp-12 + Theme.sp-4 + (root.secrets-n > 0 ? cnt-m.preferred-width + Theme.sp-4 : 0px) + lbl-m.preferred-width + Theme.sp-8;
    property <length> natural: Theme.sp-16 + (root.kind-tag != "" ? tag-m.preferred-width + Theme.sp-16 + Theme.sp-6 : 0px)
        + (root.planning || root.plan-status != "" ? plan-m.preferred-width + 2 * Theme.sp-6 + Theme.sp-6 : 0px)
        + (root.secrets ? self.lock-w + Theme.sp-6 : 0px)
        + Theme.sp-24 + Theme.sp-6 + Theme.sp-24 + Theme.sp-6 + Theme.sp-32 + Theme.sp-6 + Theme.sp-24;
    width: min(root.max-w, self.natural + Theme.sp-2);
    height: fl.preferred-height + Theme.sp-2;
    plan-m := Text { visible: false; text: "PLANNING"; font-size: Theme.text-10; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide; }
    tag-m := Text { visible: false; text: root.kind-tag; font-size: Theme.text-11; font-weight: Theme.w-bold; letter-spacing: Theme.track-tight; }
    cnt-m := Text { visible: false; text: root.secrets-n; font-size: Theme.text-11; }
    lbl-m := Text { visible: false; text: "Secrets for this chat"; font-size: Theme.text-11; }
    // A soft shadow (the software renderer has no blur: SoftShadow).
    SoftShadow { width: root.width; height: root.height; radius: Theme.r-control; shadow: Theme.shadow-menu; }
    Rectangle {
        background: Theme.bg-secondary;
        border-radius: Theme.r-control;
        border-width: 1px;
        border-color: Theme.border;
    }
    property <int> presses: Pointer.presses;
    changed presses => {
        let ax = self.absolute-position.x;
        let ay = self.absolute-position.y;
        let inside = Pointer.press-x >= ax && Pointer.press-x <= ax + self.width && Pointer.press-y >= ay && Pointer.press-y <= ay + self.height;
        let on-more = Pointer.press-x >= root.more-x && Pointer.press-x <= root.more-x + Theme.sp-24 && Pointer.press-y >= root.more-y && Pointer.press-y <= root.more-y + Theme.sp-20;
        if !inside && !on-more { root.dismiss(); }
    }
    // Clicks on the menu's own padding stay in it.
    TouchArea { }
    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(ev) => {
            if ev.text == Key.Escape { root.dismiss(); return accept; }
            return reject;
        }
        fl := FlexboxLayout {
            x: 1px; y: 1px;
            width: parent.width - Theme.sp-2;
            // Its own height, and lines packed at the top: a stretched line
            // would push the items down.
            height: self.preferred-height;
            cross-axis-line-alignment: start;
            padding: Theme.sp-8;
            spacing: Theme.sp-6;
            flex-wrap: wrap;
            alignment: end;
            cross-axis-alignment: center;
            if root.planning || root.plan-status != "": PlanTag { status: root.plan-status; clicked => { root.plan-clicked(); } }
            if root.kind-tag != "": KindTag { text: root.kind-tag; }
            // The lock with its label: icon, the count if any, "Secrets for
            // this chat".
            if root.secrets: HeadBtn {
                height: Theme.sp-20;
                width: root.lock-w;
                has-icon: true; icon: Icons.lock; icon-size: Theme.icon-sm;
                look: root.secrets-n > 0 ? "on" : "rest";
                count: root.secrets-n > 0 ? "" + root.secrets-n : "";
                after: "Secrets for this chat";
                tip: root.secrets-tip;
                clicked => { root.open-secrets(); }
            }
            HeadBtn {
                height: Theme.sp-20; width: Theme.sp-24;
                label: "A-"; tip: "Smaller text";
                am := Text { visible: false; text: "A-"; font-size: Theme.text-11; }
                clicked => { root.font(-1); }
            }
            HeadBtn {
                height: Theme.sp-20; width: Theme.sp-24;
                has-icon: true; icon: Icons.rotate-ccw; icon-size: Theme.icon-sm;
                tip: "Reset text size";
                clicked => { root.font-reset(); }
            }
            HeadBtn {
                height: Theme.sp-20; width: Theme.sp-32;
                label: "A+"; tip: "Larger text";
                ap := Text { visible: false; text: "A+"; font-size: Theme.text-11; }
                clicked => { root.font(1); }
            }
            HeadBtn {
                height: Theme.sp-20; width: Theme.sp-24;
                has-icon: true; icon: root.pinned ? Icons.pin-turned : Icons.pin; icon-size: Theme.icon-md;
                look: root.pinned ? "pinned" : "rest";
                tip: root.pinned ? "Unpin (size and position are locked)" : "Pin size and position";
                clicked => { root.pin(); }
            }
        }
    }
}

/// Text that can be selected and copied.
component Prose inherits TextInput {
    // The pane's text size, a scale of the base size (the web's --cc-fs).
    in property <float> fs: 1;
    read-only: true;
    wrap: word-wrap;
    line-height-factor: Theme.lh-chat;
    color: Theme.text-primary;
    font-size: Theme.text-13 * root.fs;
    selection-background-color: Theme.accent-dim;
}

/// The running spinner (.cc-spin): a ring in border with a quarter in
/// accent, turning once every Theme.spin. (Drawn as paths: the software
/// renderer cannot turn an image.)
export component Spinner inherits Rectangle {
    in property <brush> ring: Theme.border;
    in property <brush> arc: Theme.accent;
    in property <length> stroke: Theme.spin-stroke;
    width: Theme.icon-sm; height: Theme.icon-sm;
    property <float> u: self.width / 1px;
    property <float> r: (self.width - root.stroke) / 2 / 1px;
    property <angle> a: mod(animation-tick() / Theme.spin, 1) * Theme.turn;
    // The ring.
    Rectangle {
        border-radius: self.width / 2;
        border-width: root.stroke; border-color: root.ring;
    }
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: root.u; viewbox-height: root.u;
        stroke: root.arc; stroke-width: root.stroke;
        commands: "M " + (root.u / 2 + root.r * sin(root.a)) + " " + (root.u / 2 - root.r * cos(root.a))
            + " A " + root.r + " " + root.r + " 0 0 1 " + (root.u / 2 + root.r * sin(root.a + 90deg)) + " " + (root.u / 2 - root.r * cos(root.a + 90deg));
    }
}

/// A tool's status: the spinner while running, else a dot (red: failed).
component StatusMark inherits Rectangle {
    in property <bool> running;
    in property <bool> failed;
    // The row's height (a layout sets it): the mark centred on it at any
    // text size.
    width: Theme.icon-sm;
    if root.running: Spinner { y: (parent.height - self.height) / 2; }
    if !root.running: Rectangle {
        y: (parent.height - self.height) / 2;
        width: Theme.sp-6; height: Theme.sp-6; border-radius: Theme.sp-6 / 2;
        background: root.failed ? Theme.red : Theme.green;
    }
}

/// The body's text: mono, keeps its lines, wraps, selectable.
component BodyText inherits TextInput {
    in property <float> fs: 1;
    read-only: true;
    wrap: word-wrap;
    font-family: Theme.mono;
    font-size: Theme.text-12 * root.fs;
    line-height-factor: Theme.lh-chat;
    color: Theme.text-secondary;
}

/// A band of the body (a Write's content, a diff line): its colour on its
/// fill, the full width.
component Band inherits Rectangle {
    in property <float> fs: 1;
    in property <string> text;
    in property <bool> add;
    background: root.add ? Theme.green-dim : Theme.red-dim;
    height: bt.preferred-height;
    bt := BodyText { width: parent.width; fs: root.fs; text: root.text; color: root.add ? Theme.green : Theme.red; }
}

/// A to-do: its mark (a box, ticked when done; ▸ while in progress) and the
/// text beside it, wrapping in its own column; done ones struck through.
component TodoRow inherits Rectangle {
    in property <float> fs: 1;
    in property <TodoItem> t;
    property <color> c: root.t.state == "completed" ? Theme.text-muted : root.t.state == "in_progress" ? Theme.accent-hover : Theme.text-secondary;
    height: tl.preferred-height;
    tl := HorizontalLayout {
        spacing: Theme.sp-8;
        Rectangle {
            width: Theme.icon-sm;
            Icon {
                y: (one.preferred-height - self.height) / 2; width: Theme.icon-sm; height: Theme.icon-sm;
                source: root.t.state == "in_progress" ? Icons.play : Icons.square; tint: root.c;
            }
            if root.t.state == "completed": Icon {
                x: (Theme.icon-sm - self.width) / 2; y: (one.preferred-height - self.height) / 2;
                width: Theme.icon-sm - Theme.sp-4; height: Theme.icon-sm - Theme.sp-4; source: Icons.check; tint: root.c;
            }
        }
        col := Rectangle {
            horizontal-stretch: 1; min-width: 0;
            height: tx.preferred-height;
            tx := BodyText { width: parent.width; fs: root.fs; text: root.t.text; color: root.c; }
            // Struck through, line by line (Slint's text has no strike): a
            // one-line item as wide as its text; a wrapped one across the
            // column (its lines' own widths are not known).
            property <int> lines: round(tx.preferred-height / max(1px, one.preferred-height));
            if root.t.state == "completed": Rectangle {
                for i in col.lines: Rectangle {
                    x: 0; width: col.lines == 1 ? min(col.width, whole.preferred-width) : col.width;
                    y: i * one.preferred-height + one.preferred-height / 2; height: 1px; background: root.c;
                }
            }
            whole := Text { visible: false; text: root.t.text; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; }
        }
    }
    one := Text { visible: false; text: "x"; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; }
}

/// The 34 ring that turns while a picture or a frame loads.
component LoadRing inherits Rectangle {
    width: Theme.sp-32 + Theme.sp-2; height: self.width;
    property <angle> a: mod(animation-tick() / Theme.spin, 1) * Theme.turn;
    property <float> u: self.width / 1px;
    property <float> r: (self.width - Theme.sp-4) / 2 / 1px;
    Rectangle { border-radius: self.width / 2; border-width: Theme.sp-4 - 1px; border-color: Theme.ring-faint; }
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: root.u; viewbox-height: root.u;
        stroke: Theme.accent; stroke-width: Theme.sp-4 - 1px;
        commands: "M " + (root.u / 2 + root.r * sin(root.a)) + " " + (root.u / 2 - root.r * cos(root.a))
            + " A " + root.r + " " + root.r + " 0 0 1 " + (root.u / 2 + root.r * sin(root.a + 90deg)) + " " + (root.u / 2 - root.r * cos(root.a + 90deg));
    }
}

/// A live frame (2.16f): the page of a show_embed item inside its box (the
/// box less its 1px edge), painted by its own off-screen view; the ring
/// until its first paint. While it is on the log it reports itself (the
/// view lives as long as that, src/frames.rs). A press gives it the
/// keyboard (the composer then gets none, Esc included); a press anywhere
/// else takes it back. The wheel over it is its page's.
component LiveFrame inherits Rectangle {
    in property <string> fkey;
    in property <string> chat;
    in property <string> target;
    property <bool> shown: FrameUi.shown && (FrameUi.full-key == "" || FrameUi.full-key == "live:" + root.chat);
    property <bool> painted: FrameUi.painted(root.fkey, FrameUi.gen);
    property <int> cur: FrameUi.cursor(root.fkey, FrameUi.gen);
    function report() { if root.shown { FrameUi.seen(root.fkey, root.chat, root.target, root.width, root.height, self.absolute-position.x, self.absolute-position.y); } }
    init => { root.report(); }
    Timer { interval: Theme.frame-seen; running: root.shown; triggered => { root.report(); } }
    if !root.painted: LoadRing { }
    if root.painted: Image { width: parent.width; height: parent.height; source: FrameUi.image(root.fkey, FrameUi.gen); image-fit: fill; }
    // A press outside the frame takes the keyboard back.
    property <int> presses: Pointer.presses;
    changed presses => {
        let px = Pointer.press-x - self.absolute-position.x;
        let py = Pointer.press-y - self.absolute-position.y;
        if fs.has-focus && (px < 0 || py < 0 || px > self.width || py > self.height) { fs.clear-focus(); }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(ev) => { FrameUi.key(root.fkey, ev.text, true, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt, ev.modifiers.meta); accept }
        key-released(ev) => { FrameUi.key(root.fkey, ev.text, false, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt, ev.modifiers.meta); accept }
        changed has-focus => { FrameUi.focus(root.fkey, self.has-focus); }
        ta := TouchArea {
            mouse-cursor: root.cur == 1 ? MouseCursor.pointer : root.cur == 2 ? MouseCursor.text : root.cur == 3 ? MouseCursor.crosshair
                : root.cur == 4 ? MouseCursor.move : root.cur == 6 ? MouseCursor.not-allowed : root.cur == 11 ? MouseCursor.grab
                : root.cur == 12 ? MouseCursor.grabbing : MouseCursor.default;
            pointer-event(e) => {
                let b = e.button == PointerEventButton.middle ? 1 : e.button == PointerEventButton.right ? 2 : 0;
                if e.kind == PointerEventKind.down { fs.focus(); FrameUi.pointer(root.fkey, 1, self.mouse-x, self.mouse-y, b); }
                if e.kind == PointerEventKind.up { FrameUi.pointer(root.fkey, 2, self.mouse-x, self.mouse-y, b); }
            }
            moved => { FrameUi.pointer(root.fkey, 0, self.mouse-x, self.mouse-y, 0); }
            changed has-hover => {
                if self.has-hover { FrameUi.pointer(root.fkey, 0, self.mouse-x, self.mouse-y, 0); }
                else { FrameUi.pointer(root.fkey, 3, self.mouse-x, self.mouse-y, 0); }
            }
            // The page's while it can scroll that way; at its end (or a page
            // that does not scroll) the log's.
            scroll-event(e) => {
                if FrameUi.wheel-takes(root.fkey, e.delta-x, e.delta-y) { FrameUi.wheel(root.fkey, self.mouse-x, self.mouse-y, e.delta-x, e.delta-y); return accept; }
                reject
            }
        }
    }
}

/// A picture's, a video's or a frame's box: its size known before anything
/// loads (never wider than `avail`), the picture fitted inside; loading:
/// the ring; gone: a dashed edge and the words.
component MediaBox inherits Rectangle {
    in property <MediaItem> m;
    in property <length> avail;
    in property <string> gone-text: "This image is no longer stored.";
    property <float> k: min(1, root.avail / max(1px, root.m.w * 1px));
    width: root.m.w * 1px * self.k;
    // (A frame with a fixed height keeps it when narrower; aspect boxes follow.)
    height: root.m.fixed-h ? root.m.h * 1px : root.m.h * 1px * self.k;
    border-radius: Theme.r-field;
    clip: true;
    background: root.m.state == "gone" ? transparent : root.m.kind == "embed" ? Theme.frame-bg : Theme.bg-secondary;
    if root.m.state == "gone": DashedBox { width: parent.width; height: parent.height; corner: Theme.r-field; }
    if root.m.state == "gone": Text { text: root.gone-text; font-size: Theme.text-12; color: Theme.text-muted; }
    if root.m.state == "loading": LoadRing { }
    if root.m.state == "ready" && root.m.image.width > 0: Image {
        x: 1px; y: 1px; width: parent.width - Theme.sp-2; height: parent.height - Theme.sp-2;
        source: root.m.image; image-fit: contain;
        opacity: 0; init => { self.opacity = 1; }
        animate opacity { duration: Theme.motion-fast; }
    }
    // (What the box holds: a live frame, Open: under its corners and edge.)
    @children
    // Round corners: the software renderer's clip has no radius, so the
    // corners outside it are covered in the log's colour, then the edge.
    if root.m.state != "gone": Image { x: 0; y: 0; width: Theme.r-field; height: Theme.r-field; source: @image-url("shapes/corner-tl.svg"); colorize: Theme.bg-primary; }
    if root.m.state != "gone": Image { x: parent.width - self.width; y: 0; width: Theme.r-field; height: Theme.r-field; source: @image-url("shapes/corner-tr.svg"); colorize: Theme.bg-primary; }
    if root.m.state != "gone": Image { x: 0; y: parent.height - self.height; width: Theme.r-field; height: Theme.r-field; source: @image-url("shapes/corner-bl.svg"); colorize: Theme.bg-primary; }
    if root.m.state != "gone": Image { x: parent.width - self.width; y: parent.height - self.height; width: Theme.r-field; height: Theme.r-field; source: @image-url("shapes/corner-br.svg"); colorize: Theme.bg-primary; }
    if root.m.state != "gone": Rectangle { border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border; }
}

/// A caption under an item (or under a row: the call's).
component MediaCap inherits Text {
    font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap;
}

/// One medium: a picture (click: the viewer), a video (its poster and the
/// play button: the system's player), an audio pill, a file card
/// (Download), a frame (caption and Open).
component MediaView inherits VerticalLayout {
    in property <MediaItem> m;
    in property <length> avail;
    spacing: Theme.sp-4;
    if root.m.kind == "image": HorizontalLayout {
        alignment: start;
        MediaBox {
            m: root.m; avail: root.avail;
            TouchArea { mouse-cursor: pointer; clicked => { ToolAct.view(root.m.key); } }
        }
    }
    if root.m.kind == "video": HorizontalLayout {
        alignment: start;
        MediaBox {
            m: root.m; avail: root.avail;
            Rectangle {
                width: Theme.sp-48 + Theme.sp-8; height: self.width; border-radius: self.width / 2;
                background: Theme.play-bg; border-width: 1px; border-color: Theme.play-edge;
                if !root.m.fetching: Icon { source: @image-url("shapes/play-fill.svg"); width: Theme.icon-xl + Theme.sp-4; height: self.width; tint: Theme.white; }
                if root.m.fetching: LoadRing { }
                TouchArea { mouse-cursor: pointer; clicked => { ToolAct.play(root.m.chat, root.m.name, root.m.filename); } }
            }
        }
    }
    if root.m.kind == "audio": HorizontalLayout {
        alignment: start;
        Rectangle {
            width: min(Theme.file-max-w - Theme.sp-20, root.avail); height: Theme.sp-48 + Theme.sp-2;
            border-radius: self.height / 2; background: Theme.bg-card; border-width: 1px; border-color: Theme.border;
            HorizontalLayout {
                padding-left: Theme.sp-6; spacing: Theme.sp-10; alignment: start;
                Rectangle {
                    y: (parent.height - self.height) / 2; width: Theme.sp-40 - Theme.sp-2; height: self.width; border-radius: self.width / 2;
                    background: Theme.accent;
                    if !root.m.fetching: Icon { source: @image-url("shapes/play-fill.svg"); width: Theme.icon-lg; height: Theme.icon-lg; tint: Theme.white; }
                    if root.m.fetching: Text { text: "…"; color: Theme.white; }
                    TouchArea { mouse-cursor: pointer; clicked => { ToolAct.play(root.m.chat, root.m.name, root.m.filename); } }
                }
                Text { vertical-alignment: center; text: "0:00 / " + (root.m.duration != "" ? root.m.duration : "0:00"); font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-secondary; }
            }
        }
    }
    if root.m.kind == "file": HorizontalLayout {
        alignment: start;
        Rectangle {
            width: min(Theme.file-max-w, root.avail); height: fl.preferred-height;
            border-radius: Theme.r-card; background: Theme.bg-card; border-width: 1px; border-color: Theme.border;
            fl := HorizontalLayout {
                padding-top: Theme.sp-10 - 1px; padding-bottom: Theme.sp-10 - 1px; padding-left: Theme.sp-10; padding-right: Theme.sp-10;
                spacing: Theme.sp-10;
                Rectangle {
                    width: Theme.sp-32 + Theme.sp-2; height: self.width; y: (parent.height - self.height) / 2;
                    border-radius: Theme.r-field; background: Theme.bg-primary; border-width: 1px; border-color: Theme.border;
                    Icon { source: Icons.file; width: Theme.icon-md; height: Theme.icon-md; tint: Theme.text-secondary; }
                }
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 0; alignment: center; spacing: Theme.sp-2;
                    Text { text: root.m.filename; font-size: Theme.text-13; font-weight: Theme.w-semibold; color: Theme.text-primary; overflow: elide; }
                    Text { text: root.m.line; font-size: Theme.text-12; color: Theme.text-secondary; overflow: elide; }
                }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: dl.preferred-width; height: Theme.control-sm;
                    border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border;
                    background: da.has-hover ? Theme.bg-hover : Theme.bg-tertiary;
                    dl := HorizontalLayout {
                        padding-left: Theme.sp-10; padding-right: Theme.sp-10; spacing: Theme.sp-6;
                        Icon { y: (parent.height - self.height) / 2; source: Icons.download; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.text-primary; }
                        Text { vertical-alignment: center; text: "Download"; font-size: Theme.text-12; color: Theme.text-primary; }
                    }
                    da := TouchArea { mouse-cursor: pointer; clicked => { ToolAct.download(root.m.chat, root.m.id, root.m.filename); } }
                }
            }
        }
    }
    // A frame: its box with its live page (2.16f), then the caption and Open.
    if root.m.kind == "embed": HorizontalLayout {
        alignment: start;
        MediaBox {
            m: root.m; avail: root.avail; gone-text: "This embed is no longer stored.";
            if root.m.state == "ready" && root.m.frame != "": LiveFrame {
                x: 1px; y: 1px; width: parent.width - Theme.sp-2; height: parent.height - Theme.sp-2;
                fkey: root.m.chat + "|" + root.m.frame; chat: root.m.chat; target: root.m.frame;
            }
        }
    }
    if root.m.kind != "file" && (root.m.caption != "" || root.m.link != ""): HorizontalLayout {
        alignment: start;
        spacing: Theme.sp-4;
        MediaCap { text: root.m.caption + (root.m.link != "" ? " ·" : ""); max-width: Theme.file-max-w - Theme.sp-20; }
        // The Open link: accent-hover, underlined.
        if root.m.link != "": Rectangle {
            width: lk.preferred-width; height: lk.preferred-height;
            lk := Text { text: root.m.link; font-size: Theme.text-12; color: Theme.accent-hover; }
            Rectangle { y: lk.preferred-height - 1px; height: 1px; background: Theme.accent-hover; }
            TouchArea { mouse-cursor: pointer; clicked => { ToolAct.open-link(root.m.url); } }
        }
    }
}

/// The media under a show_* call's card: one, a row (8 apart), or files and
/// audio stacked; the call's caption under several.
component MediaBlock inherits VerticalLayout {
    in property <ToolView> t;
    in property <length> avail;
    padding-top: Theme.sp-6; padding-bottom: Theme.sp-2;
    spacing: Theme.sp-4;
    if root.t.media-stack: VerticalLayout {
        spacing: Theme.sp-8;
        for m in root.t.media: MediaView { m: m; avail: root.avail; }
    }
    if !root.t.media-stack: Flickable {
        height: mr.preferred-height;
        content-width: max(self.width, mr.preferred-width);
        content-height: self.height;
        mr := HorizontalLayout {
            spacing: Theme.sp-8;
            alignment: start;
            // Several side by side keep their sizes (the row scrolls); one is
            // never wider than the pane.
            for m in root.t.media: MediaView { m: m; avail: root.t.media.length > 1 ? m.w * 1px : root.avail; }
        }
    }
    if root.t.media-caption != "": MediaCap { text: root.t.media-caption; }
}

/// A tool card (.cc-tool): the head (status, the tool's name, the summary,
/// the caret) opens the body: the arguments by tool, then the result under
/// a hairline. The body stops at composer-max * 2 and scrolls.
component ToolCard inherits Rectangle {
    // The pane's text size, a scale of the base size (the web's --cc-fs).
    in property <float> fs: 1;
    in property <ToolView> t;
    in property <string> chat;
    background: Theme.bg-secondary;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;
    height: col.preferred-height;
    col := VerticalLayout {
        Rectangle {
            height: hd.preferred-height;
            hd := HorizontalLayout {
                padding-top: Theme.sp-6; padding-bottom: Theme.sp-6; padding-left: Theme.sp-10; padding-right: Theme.sp-10;
                spacing: Theme.sp-8;
                StatusMark { running: root.t.status == "running"; failed: root.t.error; }
                Text { text: root.t.title; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; font-weight: Theme.w-semibold; color: root.t.error ? Theme.red : Theme.accent-hover; vertical-alignment: center; }
                Text { text: root.t.detail; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; overflow: elide; wrap: no-wrap; horizontal-stretch: 1; min-width: 0; vertical-alignment: center; }
                Text { text: root.t.open ? "▾" : "▸"; font-size: Theme.text-13 * root.fs; color: Theme.text-muted; vertical-alignment: center; }
            }
            TouchArea { mouse-cursor: pointer; clicked => { ToolAct.toggle(root.chat, root.t.id); } }
        }
        if root.t.open: Rectangle {
            property <length> content-h: body.preferred-height;
            height: min(self.content-h, Theme.composer-max * 2) + 1px;
            Rectangle { y: 0; height: 1px; background: Theme.border-subtle; }
            fl := Flickable {
                y: 1px; height: parent.height - 1px;
                content-height: parent.content-h;
                body := VerticalLayout {
                    width: fl.width;
                    padding-top: Theme.sp-8; padding-bottom: Theme.sp-8; padding-left: Theme.sp-10; padding-right: Theme.sp-10;
                    if root.t.kind == "bash": BodyText { fs: root.fs; text: root.t.args; }
                    if root.t.kind == "bash" && root.t.note != "": Rectangle {
                        height: nt.preferred-height + Theme.sp-6;
                        nt := BodyText { y: Theme.sp-6; width: parent.width; fs: root.fs; text: root.t.note; color: Theme.text-muted; }
                    }
                    if root.t.kind == "json": BodyText { fs: root.fs; text: root.t.args; }
                    if root.t.kind == "write": Band { fs: root.fs; text: root.t.args; add: true; }
                    if root.t.kind == "diff": Rectangle {
                        height: dl.preferred-height;
                        dl := VerticalLayout {
                            for l in root.t.lines: Band { fs: root.fs; text: l.text; add: l.add; }
                        }
                    }
                    if root.t.kind == "todos": Rectangle {
                        height: tdl.preferred-height;
                        tdl := VerticalLayout {
                            spacing: Theme.sp-4;
                            for td in root.t.todos: TodoRow { fs: root.fs; t: td; }
                        }
                    }
                    // The result, under a hairline: muted, red when it failed.
                    if root.t.text != "": Rectangle {
                        height: rt.preferred-height + 2 * Theme.sp-8 + 1px;
                        Rectangle { y: Theme.sp-8; height: 1px; background: Theme.border-subtle; }
                        rt := BodyText {
                            y: 2 * Theme.sp-8 + 1px; width: parent.width;
                            fs: root.fs; text: root.t.text; color: root.t.error ? Theme.red : Theme.text-muted;
                        }
                    }
                }
            }
            ScrollThumb {
                y: 1px; height: parent.height - 1px;
                view-h: fl.height; content-h: fl.content-height; offset: -fl.content-y;
            }
        }
    }
}

/// An answered card's tag (.cc-tag): ok (green), no (red) or neutral.
component Tag inherits Rectangle {
    in property <float> fs: 1;
    in property <string> text;
    in property <string> tone;
    height: tt.preferred-height + Theme.sp-2 * 2;
    width: tt.preferred-width + 2 * Theme.sp-8;
    border-radius: self.height / 2; border-width: 1px;
    border-color: root.tone == "ok" ? Theme.green : root.tone == "no" ? Theme.red : Theme.border-subtle;
    background: Theme.bg-tertiary;
    tt := Text { text: root.text; font-size: Theme.text-11 * root.fs; color: root.tone == "ok" ? Theme.green : root.tone == "no" ? Theme.red : Theme.text-secondary; }
}

/// A field of the question card (Other, a note): bg-primary, a border, the
/// accent border and ring when focused, its placeholder.
component QField inherits Rectangle {
    in property <float> fs: 1;
    in property <string> placeholder;
    // What it starts with, and a counter that sets it again.
    in property <string> start;
    in property <int> gen;
    in property <length> pad-y: Theme.sp-6;
    in property <length> pad-x: Theme.sp-10;
    // Takes the keyboard when it appears; a counter asks for it again.
    in property <bool> grab;
    in property <int> focus-gen;
    callback edited(string);
    callback accepted();
    height: ti.preferred-height + 2 * root.pad-y + Theme.sp-2;
    if ti.has-focus: Rectangle {
        x: -Theme.sp-4; y: -Theme.sp-4; width: parent.width + 2 * Theme.sp-4; height: parent.height + 2 * Theme.sp-4;
        border-radius: Theme.r-card; background: Theme.accent-ring;
    }
    Rectangle {
        border-radius: Theme.r-control; border-width: 1px;
        border-color: ti.has-focus ? Theme.accent : Theme.border;
        background: Theme.bg-primary;
    }
    ti := TextInput {
        x: root.pad-x + 1px; y: root.pad-y + 1px; width: parent.width - 2 * root.pad-x - Theme.sp-2;
        height: self.preferred-height;
        single-line: true; vertical-alignment: center;
        font-size: Theme.text-12 * root.fs; color: Theme.text-primary;
        init => { self.text = root.start; if root.grab { self.focus(); } }
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }
    if ti.text == "": Text {
        x: ti.x; y: ti.y; width: ti.width; height: ti.height;
        vertical-alignment: center; overflow: elide;
        text: root.placeholder; font-size: Theme.text-12 * root.fs; color: Theme.text-muted;
    }
    property <int> g: root.gen;
    changed g => { ti.text = root.start; }
    property <int> fg: root.focus-gen;
    changed fg => { ti.focus(); }
}

/// One choice (.cc-opt): the radio or checkbox, the label, its description
/// and preview, the note row when open, and the note button at the top
/// right. A press anywhere on the row picks it (a tick toggles).
component QOptRow inherits Rectangle {
    in property <float> fs: 1;
    in property <QOpt> o;
    in property <bool> multi;
    // A single choice's radio is one Tab stop per question: the picked one,
    // or the first when none is.
    in property <bool> tab-stop;
    callback pick();
    callback note-open();
    callback note-typed(string);
    callback note-remove();
    callback move(int);
    height: lay.preferred-height + Theme.sp-2;
    border-radius: Theme.r-control; border-width: 1px;
    // The pointer anywhere in the row (its note button and ✕ too).
    border-color: root.o.chosen ? Theme.accent : ta.has-hover || nb.has-hover || root.x-hover ? Theme.accent-hover : Theme.border;
    property <bool> x-hover;
    background: root.o.chosen ? Theme.accent-dim : Theme.bg-primary;
    // Picked: the ring round the row.
    if root.o.chosen: Rectangle {
        x: -Theme.sp-4; y: -Theme.sp-4; width: parent.width + 2 * Theme.sp-4; height: parent.height + 2 * Theme.sp-4;
        border-radius: Theme.r-card; background: Theme.accent-ring;
    }
    if root.o.chosen: Rectangle { border-radius: Theme.r-control; border-width: 1px; border-color: Theme.accent; background: Theme.accent-dim; }
    // A press picks the choice; the app then gives it the keyboard (its
    // focus-gen: the radio may only become a Tab stop once picked).
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(); } }
    // The keyboard: Space picks (or toggles); in a radio group the arrows
    // move to and pick the next choice.
    fs-key := FocusScope {
        x: 0; y: 0; width: 0; height: 0;
        enabled: root.multi || root.tab-stop || self.has-focus;
        focus-on-click: false;
        key-pressed(ev) => {
            if ev.text == " " { root.pick(); return accept; }
            if !root.multi && (ev.text == Key.DownArrow || ev.text == Key.RightArrow) { root.move(1); return accept; }
            if !root.multi && (ev.text == Key.UpArrow || ev.text == Key.LeftArrow) { root.move(-1); return accept; }
            reject
        }
    }
    property <int> fg: root.o.focus-gen;
    changed fg => { fs-key.focus(); }
    lay := HorizontalLayout {
        x: 1px; y: 1px; width: parent.width - Theme.sp-2;
        padding-top: Theme.sp-8; padding-bottom: Theme.sp-8; padding-left: Theme.sp-10;
        // Room for the note button.
        padding-right: Theme.sp-32 + Theme.sp-4;
        spacing: Theme.sp-8;
        // The radio (round) or the checkbox (square), sp-2 down to sit on the label.
        Rectangle {
            width: Theme.icon-sm;
            Rectangle {
                y: Theme.sp-2; width: Theme.icon-sm; height: Theme.icon-sm;
                // The keyboard's focus: the ring round the radio itself.
                if fs-key.has-focus: Rectangle {
                    x: -Theme.sp-4; y: -Theme.sp-4; width: parent.width + 2 * Theme.sp-4; height: parent.height + 2 * Theme.sp-4;
                    border-radius: root.multi ? Theme.r-control : self.width / 2; background: Theme.accent-ring;
                }
                Rectangle {
                    border-radius: root.multi ? Theme.r-chip : self.width / 2; border-width: 1px;
                    border-color: root.o.chosen ? Theme.accent : Theme.text-muted;
                    background: root.o.chosen && root.multi ? Theme.accent : Theme.bg-primary;
                }
                if root.o.chosen && !root.multi: Rectangle { width: Theme.sp-6; height: Theme.sp-6; border-radius: Theme.sp-6 / 2; background: Theme.accent; }
                if root.o.chosen && root.multi: Icon { source: Icons.check; width: Theme.icon-sm - Theme.sp-2; height: Theme.icon-sm - Theme.sp-2; tint: Theme.white; }
            }
        }
        // The text: label, description, preview, the note row.
        Rectangle {
            horizontal-stretch: 1; min-width: 0;
            height: col.preferred-height;
            col := VerticalLayout {
                Text { text: root.o.label; font-size: Theme.text-13 * root.fs; font-weight: Theme.w-semibold; color: Theme.text-primary; wrap: word-wrap; }
                if root.o.desc != "": Text { text: root.o.desc; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; wrap: word-wrap; }
                if root.o.preview != "": Rectangle {
                    height: pv.preferred-height + Theme.sp-6;
                    Rectangle {
                        y: Theme.sp-6; height: parent.height - Theme.sp-6;
                        background: Theme.bg-secondary; border-width: 1px; border-color: Theme.border-subtle; border-radius: Theme.r-chip;
                    }
                    pv := VerticalLayout {
                        y: Theme.sp-6;
                        padding-top: Theme.sp-6; padding-bottom: Theme.sp-6; padding-left: Theme.sp-8; padding-right: Theme.sp-8;
                        Text { text: root.o.preview; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; color: Theme.text-secondary; wrap: word-wrap; }
                    }
                }
                // The note (one per question, under its choice): a field and ✕.
                if root.o.note-open: Rectangle {
                    height: nr.preferred-height + Theme.sp-8;
                    nr := HorizontalLayout {
                        y: Theme.sp-8;
                        spacing: Theme.sp-6;
                        QField {
                            horizontal-stretch: 1;
                            fs: root.fs; pad-y: Theme.sp-4; pad-x: Theme.sp-8;
                            placeholder: "Note for Claude about this choice";
                            start: root.o.note; grab: root.o.note-focus;
                            edited(t) => { root.note-typed(t); }
                        }
                        Rectangle {
                            width: Theme.control-sm - Theme.sp-4; height: Theme.control-sm - Theme.sp-4;
                            y: (parent.height - self.height) / 2;
                            border-radius: Theme.r-control;
                            background: xa.has-hover ? Theme.bg-hover : transparent;
                            Icon { source: Icons.x; width: Theme.icon-sm; height: Theme.icon-sm; tint: xa.has-hover ? Theme.text-primary : Theme.text-muted; }
                            xa := TouchArea {
                                mouse-cursor: pointer; clicked => { root.note-remove(); }
                                changed has-hover => { root.x-hover = self.has-hover; }
                            }
                        }
                    }
                }
            }
        }
    }
    // The note button ("Add a note to this choice"): top right, sp-4 in.
    Rectangle {
        x: parent.width - self.width - Theme.sp-4; y: Theme.sp-4;
        width: Theme.control-sm - Theme.sp-2; height: Theme.control-sm - Theme.sp-2;
        border-radius: Theme.r-control; border-width: 1px;
        border-color: nb.has-hover ? Theme.border : transparent;
        background: nb.has-hover ? Theme.bg-tertiary : transparent;
        Icon { source: Icons.note; width: Theme.icon-md; height: Theme.icon-md; tint: root.o.note-open ? Theme.accent-hover : nb.has-hover ? Theme.text-primary : Theme.text-muted; }
        nb := TouchArea { mouse-cursor: pointer; clicked => { root.note-open(); } }
    }
}

/// A widget check's screenshots (2.20, the web's .wg-shots): shot-h tall
/// pictures on bg-primary with a border, each with its caption; the row
/// scrolls sideways; a click opens the picture in the viewer.
component ShotsRow inherits Rectangle {
    in property <[ShotItem]> shots;
    height: Theme.sp-8 + Theme.shot-h + Theme.sp-4 + cm.preferred-height;
    cm := Text { visible: false; text: "X"; font-family: Theme.mono; font-size: Theme.text-10; }
    Flickable {
        y: Theme.sp-8; width: parent.width; height: parent.height - Theme.sp-8;
        content-width: row.preferred-width;
        row := HorizontalLayout {
            alignment: start;
            spacing: Theme.sp-8;
            for x in root.shots: VerticalLayout {
                spacing: Theme.sp-4;
                Rectangle {
                    width: Theme.shot-h * x.ratio; height: Theme.shot-h;
                    border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border;
                    background: Theme.bg-primary;
                    if x.state == "ready": Image { x: 1px; y: 1px; width: parent.width - Theme.sp-2; height: parent.height - Theme.sp-2; source: x.image; image-fit: contain; }
                    TouchArea { mouse-cursor: x.state == "ready" ? pointer : default; clicked => { if x.state == "ready" { ToolAct.view(x.key); } } }
                }
                Text { text: x.caption; font-family: Theme.mono; font-size: Theme.text-10; color: Theme.text-muted; }
            }
        }
    }
}

/// The note of Request changes (.cc-fr-note): three lines tall, growing to
/// six, then it scrolls; Enter is a new line, Ctrl/Cmd+Enter sends (a named
/// addition). It takes the keyboard when it appears.
component NoteBox inherits Rectangle {
    in property <float> fs: 1;
    in property <string> start;
    in property <int> gen;
    in property <int> focus-gen;
    callback edited(string);
    callback send();
    property <length> line: lm.preferred-height;
    lm := Text { visible: false; text: "X"; font-size: Theme.text-12 * root.fs; }
    height: max(Theme.note-rows * root.line, min(Theme.note-rows-max * root.line, te.preferred-height)) + 2 * Theme.sp-6 + Theme.sp-2;
    if te.has-focus: Rectangle {
        x: -Theme.sp-4; y: -Theme.sp-4; width: parent.width + 2 * Theme.sp-4; height: parent.height + 2 * Theme.sp-4;
        border-radius: Theme.r-card; background: Theme.accent-ring;
    }
    Rectangle {
        border-radius: Theme.r-control; border-width: 1px;
        border-color: te.has-focus ? Theme.accent : Theme.border;
        background: Theme.bg-primary;
    }
    fl := Flickable {
        x: Theme.sp-8 + 1px; y: Theme.sp-6 + 1px;
        width: parent.width - 2 * Theme.sp-8 - Theme.sp-2; height: parent.height - 2 * Theme.sp-6 - Theme.sp-2;
        content-height: max(self.height, te.preferred-height);
        FocusScope {
            capture-key-pressed(ev) => {
                if ev.text == Key.Return && (ev.modifiers.control || ev.modifiers.meta) { root.send(); return accept; }
                return reject;
            }
            te := TextInput {
                width: fl.width;
                height: max(fl.height, self.preferred-height);
                single-line: false; wrap: word-wrap;
                font-size: Theme.text-12 * root.fs; color: Theme.text-primary;
                selection-background-color: Theme.accent-dim;
                init => { self.text = root.start; self.focus(); }
                edited => { root.edited(self.text); }
                cursor-position-changed(at) => {
                    if at.y + fl.content-y < 0 { fl.content-y = -at.y; }
                    else if at.y + root.line + fl.content-y > fl.height { fl.content-y = min(0px, fl.height - at.y - root.line); }
                }
            }
        }
    }
    ScrollThumb { width: parent.width; height: parent.height; view-h: fl.height; content-h: te.preferred-height; offset: -fl.content-y; }
    if te.text == "": Text {
        x: fl.x; y: fl.y; width: fl.width;
        text: "What should change?"; font-size: Theme.text-12 * root.fs; color: Theme.text-muted; overflow: elide;
    }
    property <int> g: root.gen;
    changed g => { te.text = root.start; }
    property <int> fg: root.focus-gen;
    changed fg => { te.focus(); }
}

/// A disclosure line of the card (files, follow-ups): the chevron, then
/// its text; the whole line toggles.
component FrLine inherits Rectangle {
    in property <float> fs: 1;
    in property <bool> open;
    in property <styled-text> text;
    in property <length> w;
    callback toggled();
    height: max(Theme.icon-sm, st.preferred-height);
    Icon { x: 0; y: (parent.height - self.height) / 2; source: root.open ? @image-url("shapes/chevron-down.svg") : Icons.chevron-right; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.text-secondary; }
    st := StyledText { default-font-family: Theme.chat-font;
        x: Theme.icon-sm + Theme.sp-4; y: 0; width: root.w - Theme.icon-sm - Theme.sp-4;
        text: root.text; default-color: Theme.text-secondary; default-font-size: Theme.text-12 * root.fs;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

/// A factory's result card (2.20, .cc-ask.cc-fr): the question card's box;
/// the title, the summary, the files (and the full diff), the state's
/// message, the usage, the follow-ups, the server's error, the buttons, the
/// note of Request changes, and the error of a choice.
component FactoryCard inherits Rectangle {
    in property <float> fs: 1;
    in property <EntryView> e;
    property <FrView> f: root.e.fr;
    property <length> inner: self.width - 2 * Theme.sp-12 - Theme.sp-2;
    background: Theme.accent-dim;
    border-width: 1px; border-color: Theme.accent;
    border-radius: Theme.r-card;
    height: card.preferred-height;
    cw := Text { visible: false; text: "M"; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; }
    card := VerticalLayout {
        x: Theme.sp-12 + 1px; width: root.inner;
        padding-top: Theme.sp-12; padding-bottom: Theme.sp-12;
        Text { text: root.f.title; font-size: Theme.text-13 * root.fs; font-weight: Theme.w-semibold; color: Theme.text-primary; wrap: word-wrap; }
        // The summary: the reply's blocks.
        Rectangle {
            height: root.f.blocks.length > 0 ? sum.preferred-height + Theme.sp-6 + Theme.sp-8 : Theme.sp-4;
            sum := VerticalLayout {
                y: Theme.sp-6; height: self.preferred-height;
                spacing: Theme.sp-4;
                for b in root.f.blocks: Rectangle {
                    height: bl.preferred-height;
                    bl := HorizontalLayout {
                        if b.kind == "li": Text { width: Theme.sp-20; font-family: Theme.chat-font; text: b.marker; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; horizontal-alignment: center; }
                        if b.kind != "code": StyledText { default-font-family: Theme.chat-font;
                            width: root.inner - (b.kind == "li" ? Theme.sp-20 : 0px);
                            text: b.md;
                            default-color: Theme.chip-key;
                            default-font-size: (b.kind == "h" ? Theme.text-14 : Theme.text-13) * root.fs;
                            link-color: Theme.accent-hover;
                            link-clicked(url) => { ToolAct.open-link(url); }
                        }
                        if b.kind == "code": Text { width: root.inner; text: b.text; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; color: Theme.text-primary; wrap: word-wrap; }
                    }
                }
            }
        }
        // The files: "+A −R in N files on <branch>", a disclosure.
        FrLine {
            fs: root.fs; w: root.inner; open: root.f.files-open;
            text: root.f.branch != ""
                ? @markdown("<font color=\"\{Theme.green}\">\{root.f.add}</font> <font color=\"\{Theme.red}\">\{root.f.del}</font> \{root.f.n}<font color=\"\{Theme.text-muted}\"> on \{root.f.branch}</font>")
                : @markdown("<font color=\"\{Theme.green}\">\{root.f.add}</font> <font color=\"\{Theme.red}\">\{root.f.del}</font> \{root.f.n}");
            toggled => { FrAct.toggle(root.e.chat, root.e.id, "files"); }
        }
        if root.f.files-open: VerticalLayout {
            padding-top: Theme.sp-6;
            spacing: Theme.sp-2;
            for x in root.f.files: HorizontalLayout {
                spacing: Theme.sp-10;
                Text { horizontal-stretch: 1; min-width: 0; text: x.name; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; color: Theme.text-primary; overflow: elide; }
                HorizontalLayout {
                    spacing: Theme.sp-4;
                    Text { text: x.add; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; color: Theme.green; }
                    Text { text: x.del; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; color: Theme.red; }
                }
            }
            if root.f.more != "": Text { text: root.f.more; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; }
            if root.f.can-diff && !root.f.diff-on: Rectangle {
                height: db.height + Theme.sp-4;
                db := CardBtn {
                    y: Theme.sp-4; width: parent.width;
                    fs: root.fs; text: "Show the full diff"; enabled: !root.f.diff-loading;
                    clicked => { FrAct.diff(root.e.chat, root.e.id); }
                }
            }
            // The full diff: plain mono lines, no wrap, at most half the
            // window tall; a list, so a long diff draws only what shows.
            if root.f.diff-on && root.f.diff-err != "": Text { text: root.f.diff-err; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; wrap: word-wrap; }
            if root.f.diff-on && root.f.diff-err == "": Rectangle {
                height: min(Win.height / 2, root.f.diff.length * cw.preferred-height + Theme.sp-6) + Theme.sp-6;
                ListView {
                    y: Theme.sp-6; width: parent.width; height: parent.height - Theme.sp-6;
                    content-width: max(self.width, root.f.diff-cols * cw.preferred-width + Theme.sp-12);
                    for l in root.f.diff: Text {
                        height: cw.preferred-height; text: l; wrap: no-wrap;
                        font-family: Theme.mono; font-size: Theme.text-11 * root.fs; color: Theme.text-primary;
                    }
                }
            }
        }
        Rectangle { height: Theme.sp-8; }
        if root.f.msg-on: Rectangle {
            height: mt.preferred-height + Theme.sp-8;
            mt := StyledText { default-font-family: Theme.chat-font; y: 0; width: root.inner; text: root.f.msg; default-color: Theme.chip-key; default-font-size: Theme.text-12 * root.fs; }
        }
        if root.f.usage != "": Rectangle {
            height: ut.preferred-height + Theme.sp-2 + Theme.sp-6;
            ut := Text { y: Theme.sp-2; width: root.inner; text: root.f.usage; font-size: Theme.text-11 * root.fs; color: Theme.text-secondary; wrap: word-wrap; }
        }
        // The follow-ups from review, a disclosure.
        if root.f.fus.length > 0: FrLine {
            fs: root.fs; w: root.inner; open: root.f.fu-open; text: @markdown("\{root.f.fu-line}");
            toggled => { FrAct.toggle(root.e.chat, root.e.id, "fu"); }
        }
        if root.f.fus.length > 0 && root.f.fu-open: VerticalLayout {
            padding-top: Theme.sp-6;
            spacing: Theme.sp-2;
            for x in root.f.fus: Rectangle {
                height: ft.preferred-height;
                ft := StyledText { default-font-family: Theme.chat-font;
                    y: 0; width: root.inner;
                    text: x.blocking
                        ? (x.place != "" ? @markdown("**\{x.id}** <font color=\"\{Theme.red}\">blocking</font> \{x.text}<font color=\"\{Theme.text-muted}\"> (\{x.place})</font>") : @markdown("**\{x.id}** <font color=\"\{Theme.red}\">blocking</font> \{x.text}"))
                        : (x.place != "" ? @markdown("**\{x.id}** \{x.text}<font color=\"\{Theme.text-muted}\"> (\{x.place})</font>") : @markdown("**\{x.id}** \{x.text}"));
                    default-color: Theme.text-primary; default-font-size: Theme.text-11 * root.fs;
                }
            }
        }
        if root.f.fus.length > 0: Rectangle { height: Theme.sp-8; }
        if root.f.error != "": Rectangle {
            height: et.preferred-height + Theme.sp-8;
            et := Text { y: 0; width: root.inner; text: root.f.error; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; wrap: word-wrap; }
        }
        if root.f.btns.length > 0: Rectangle {
            height: bw.preferred-height;
            bw := FlexboxLayout {
                width: root.inner;
                flex-wrap: wrap;
                spacing: Theme.sp-8;
                for b in root.f.btns: CardBtn {
                    fs: root.fs; text: b.label; primary: b.primary; danger: b.danger; enabled: !root.f.busy;
                    clicked => { FrAct.press(root.e.chat, root.e.id, b.key); }
                }
            }
        }
        // Request changes: the note and Send to the Manager.
        if root.f.note-open: VerticalLayout {
            padding-top: Theme.sp-8;
            spacing: Theme.sp-6;
            NoteBox {
                fs: root.fs; start: root.f.note; gen: root.f.note-gen; focus-gen: root.f.note-focus;
                edited(t) => { FrAct.note(root.e.chat, root.e.id, t); }
                send => { FrAct.send(root.e.chat, root.e.id); }
            }
            CardBtn {
                width: root.inner;
                fs: root.fs; text: "Send to the Manager"; primary: true; enabled: !root.f.busy;
                clicked => { FrAct.send(root.e.chat, root.e.id); }
            }
        }
        if root.f.act-err != "": Rectangle {
            height: ae.preferred-height + Theme.sp-8;
            ae := Text { y: Theme.sp-8; width: root.inner; text: root.f.act-err; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; wrap: word-wrap; }
        }
    }
}

/// A question card (2.13, .cc-ask): one to four questions, each with its
/// chip, text, choices and Other; Submit and Dismiss. Answered: its tags.
component QuestionCard inherits Rectangle {
    in property <float> fs: 1;
    in property <EntryView> e;
    background: Theme.accent-dim;
    border-width: 1px; border-color: Theme.accent;
    border-radius: Theme.r-card;
    height: card.preferred-height;
    card := VerticalLayout {
        padding: Theme.sp-12;
        spacing: Theme.sp-12;
        // Orphaned: why the buttons send a message instead.
        if root.e.q-open && root.e.q-orphaned: Text {
            text: "This question outlived the session that asked it. Answering sends your choice as a message.";
            font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; wrap: word-wrap;
        }
        if root.e.q-open: Rectangle {
            height: qs.preferred-height;
            qs := VerticalLayout {
                spacing: Theme.sp-12;
                for q[qi] in root.e.questions: Rectangle {
                    height: ql.preferred-height;
                    ql := VerticalLayout {
                        if q.header != "": HorizontalLayout {
                            alignment: start;
                            padding-bottom: Theme.sp-4;
                            Rectangle {
                                width: chip.preferred-width + 2 * Theme.sp-6; height: chip.preferred-height + Theme.sp-2;
                                border-radius: self.height / 2; background: Theme.accent;
                                chip := Text { text: q.header; font-size: Theme.text-10 * root.fs; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide; color: Theme.white; }
                            }
                        }
                        Text { text: q.question; font-size: Theme.text-13 * root.fs; font-weight: Theme.w-semibold; color: Theme.text-primary; wrap: word-wrap; }
                        Rectangle {
                            height: os.preferred-height + Theme.sp-8;
                            os := VerticalLayout {
                                y: Theme.sp-8;
                                spacing: Theme.sp-6;
                                for o[oi] in q.options: QOptRow {
                                    fs: root.fs; o: o; multi: q.multi;
                                    tab-stop: o.chosen || (oi == 0 && !root.any-chosen(q));
                                    pick => { QAct.pick(root.e.chat, root.e.id, qi, oi); }
                                    note-open => { QAct.note-open(root.e.chat, root.e.id, qi, oi); }
                                    note-typed(t) => { QAct.note-typed(root.e.chat, root.e.id, qi, t); }
                                    note-remove => { QAct.note-remove(root.e.chat, root.e.id, qi); }
                                    move(d) => { QAct.move(root.e.chat, root.e.id, qi, oi, d); }
                                }
                            }
                        }
                        // Other: the question's own answer, typed.
                        Rectangle {
                            height: of.height + Theme.sp-4;
                            of := QField {
                                y: Theme.sp-4;
                                fs: root.fs;
                                placeholder: "Other (type your own answer)…";
                                start: q.other; gen: q.other-gen; focus-gen: q.other-focus;
                                edited(t) => { QAct.other-typed(root.e.chat, root.e.id, qi, t); }
                                // Enter submits when every question has an answer
                                // (the web does nothing: a named difference).
                                accepted => { QAct.submit(root.e.chat, root.e.id); }
                            }
                        }
                    }
                }
            }
        }
        if root.e.q-open: HorizontalLayout {
            alignment: start;
            spacing: Theme.sp-8;
            CardBtn { fs: root.fs; text: "Submit"; primary: true; enabled: root.e.q-can; clicked => { QAct.submit(root.e.chat, root.e.id); } }
            CardBtn { fs: root.fs; text: "Dismiss"; danger: true; clicked => { QAct.dismiss(root.e.chat, root.e.id); } }
        }
        // Answered: a tag per answer (or dismissed, or answered), by Cru,
        // each note on its own line.
        if !root.e.q-open: Rectangle {
            height: tags.preferred-height;
            tags := FlexboxLayout {
                flex-wrap: wrap;
                spacing: Theme.sp-6;
                if root.e.q-dismissed: Tag { fs: root.fs; text: "dismissed"; tone: "no"; }
                if !root.e.q-dismissed && root.e.q-tags.length == 0: Tag { fs: root.fs; text: "answered"; }
                for t in root.e.q-tags: Tag { fs: root.fs; text: t; tone: "ok"; }
                if root.e.q-by-cru: Tag { fs: root.fs; text: "by Cru"; }
            }
        }
        if !root.e.q-open && root.e.q-notes.length > 0: VerticalLayout {
            for n in root.e.q-notes: Text { text: n; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; wrap: word-wrap; }
        }
    }
    pure function any-chosen(q: QView) -> bool {
        // A radio group's Tab stop: is anything picked? (Up to four choices.)
        return (q.options.length > 0 && q.options[0].chosen) || (q.options.length > 1 && q.options[1].chosen)
            || (q.options.length > 2 && q.options[2].chosen) || (q.options.length > 3 && q.options[3].chosen);
    }
}

/// Thinking (2.15, .cc-think / .cc-thought). With text: a bar at the left,
/// the head "▾ Thinking" (it shimmers while live; a click opens or folds
/// it) and the reasoning in muted italics, at most composer-max × 1.5 then
/// scrolling (kept at the newest line while it streams, a caret blinking at
/// its end). Without text: the "Thought" line.
component ThinkBlock inherits Rectangle {
    in property <float> fs: 1;
    in property <EntryView> e;
    property <bool> live: root.e.status == "streaming";
    property <length> body-max: Theme.composer-max + Theme.composer-max / 2;
    height: root.e.text == "" ? tl.preferred-height : lay.preferred-height;
    // The "Thought" line: a dot and the wording; nothing to open.
    tl := HorizontalLayout {
        visible: root.e.text == "";
        spacing: Theme.sp-6;
        alignment: start;
        Rectangle {
            width: Theme.sp-6;
            Rectangle {
                y: (parent.height - self.height) / 2; width: Theme.sp-6; height: Theme.sp-6; border-radius: Theme.sp-6 / 2;
                background: Theme.text-muted; opacity: Theme.o-caret;
            }
        }
        Text { text: root.e.detail; font-size: Theme.text-12 * root.fs; font-italic: true; color: Theme.text-muted; line-height-factor: Theme.lh-chat; }
    }
    if root.e.text != "": Rectangle { x: 0; width: Theme.sp-2; background: Theme.border; }
    lay := VerticalLayout {
        visible: root.e.text != "";
        x: Theme.sp-10; width: parent.width - Theme.sp-10;
        // The head: the caret and the label.
        Rectangle {
            height: hd.preferred-height;
            hd := HorizontalLayout {
                spacing: Theme.sp-6;
                alignment: start;
                Text { text: root.e.open ? "▾" : "▸"; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; line-height-factor: Theme.lh-chat; }
                Rectangle {
                    width: lbl.preferred-width; height: lbl.preferred-height;
                    lbl := Text { text: "Thinking"; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; line-height-factor: Theme.lh-chat; }
                    // Live: a brighter band slides over the label, right to
                    // left (the web's gradient; a band here: the software
                    // renderer fills text in one colour).
                    if root.live: Rectangle {
                        property <float> p: mod(animation-tick() / Theme.shimmer, 1);
                        x: parent.width - self.p * 2 * parent.width - parent.width / 2 / 2;
                        width: parent.width / 2;
                        clip: true;
                        Text { x: -parent.x; text: "Thinking"; font-size: Theme.text-12 * root.fs; color: Theme.text-primary; line-height-factor: Theme.lh-chat; }
                    }
                }
            }
            TouchArea { mouse-cursor: pointer; clicked => { ToolAct.toggle(root.e.chat, root.e.id); } }
        }
        // The body: folds to nothing (motion), at most body-max, scrolls.
        Rectangle {
            property <length> want: min(bt.preferred-height, root.body-max);
            height: root.e.open ? self.want + Theme.sp-4 : 0px;
            animate height { duration: Theme.motion; easing: ease-out; }
            clip: true;
            fl := Flickable {
                y: Theme.sp-4; height: parent.height - Theme.sp-4;
                content-height: bt.preferred-height;
                // While live: kept at its newest line.
                property <length> ch: bt.preferred-height;
                changed ch => { if root.live { self.content-y = min(0px, self.height - self.content-height); } }
                bt := TextInput {
                    width: fl.width;
                    read-only: true; wrap: word-wrap;
                    // Live: a caret blinks after the text (a glyph: the end of
                    // a wrapped text has no position to draw one at).
                    property <bool> on: mod(animation-tick() / Theme.blink * 2, 2) < 1;
                    text: root.e.text + (root.live && self.on ? " ▎" : "");
                    font-size: Theme.text-12 * root.fs; font-italic: true; color: Theme.text-muted;
                    line-height-factor: Theme.lh-chat;
                }
            }
            ScrollThumb {
                y: Theme.sp-4; height: parent.height - Theme.sp-4;
                view-h: fl.height; content-h: fl.content-height; offset: -fl.content-y;
            }
        }
    }
}

/// An agent dock badge (2.18): a pill with the kind's icon, the count and a
/// spinner (any running) or a green dot; open: accent edge.
component AgentBadge inherits Rectangle {
    in property <float> fs: 1;
    in property <image> icon;
    in property <int> n;
    in property <bool> run;
    in property <bool> open;
    in property <string> tip;
    callback clicked();
    width: bl.preferred-width; height: max(Theme.control-sm + Theme.sp-2, bl.preferred-height);
    SoftShadow { width: parent.width; height: parent.height; radius: self.height / 2; shadow: Theme.shadow-menu; }
    Rectangle { border-radius: self.height / 2; background: Theme.bg-secondary; border-width: 1px; border-color: ba.has-hover || root.open ? Theme.accent : Theme.border; }
    bl := HorizontalLayout {
        padding-top: Theme.sp-4; padding-bottom: Theme.sp-4; padding-left: Theme.sp-8; padding-right: Theme.sp-10;
        spacing: Theme.sp-6;
        Icon { y: (parent.height - self.height) / 2; source: root.icon; width: Theme.icon-md * root.fs; height: self.width; tint: root.run ? Theme.accent-hover : ba.has-hover || root.open ? Theme.text-primary : Theme.text-secondary; }
        Text { vertical-alignment: center; text: root.n; font-family: Theme.mono; font-weight: Theme.w-semibold; font-size: Theme.text-12 * root.fs; color: Theme.text-primary; }
        StatusMark { running: root.run; }
    }
    ba := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } Tip { on: parent.has-hover; text: root.tip; } }
}

/// The dock's × (and a side question's): the x icon, a hover fill.
component DockX inherits Rectangle {
    in property <float> fs: 1;
    in property <string> tip;
    out property <bool> hovered: xa.has-hover;
    // The sheet's own × (the web's 15).
    in property <bool> big;
    callback clicked();
    width: Theme.control-sm - Theme.sp-6; height: self.width;
    border-radius: Theme.r-control;
    background: xa.has-hover ? Theme.slate-dim : transparent;
    Icon { source: Icons.x; width: root.big ? Theme.icon-md : Theme.icon-sm; height: self.width; tint: xa.has-hover ? Theme.text-primary : Theme.text-muted; }
    xa := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } Tip { on: parent.has-hover; text: root.tip; } }
}

component EntryRow inherits VerticalLayout {
    // The pane's text size, a scale of the base size (the web's --cc-fs).
    in property <float> fs: 1;
    in property <EntryView> e;
    // The width rows can use (from the list, not from the row: no loop).
    in property <length> avail;
    callback respond(string, string, bool);
    callback answer(string, string);
    property <bool> open;
    property <string> picked;
    padding-bottom: e.gap;

    if e.kind == "user": HorizontalLayout {
        alignment: end;
        Rectangle {
            width: min(ub-measure.preferred-width + Theme.sp-24, root.avail * Theme.bubble-share);
            background: Theme.accent-dim;
            border-width: 1px;
            border-color: Theme.accent-edge;
            border-top-left-radius: Theme.r-bubble;
            border-top-right-radius: Theme.r-bubble;
            border-bottom-right-radius: Theme.r-chip;
            border-bottom-left-radius: Theme.r-bubble;
            // Its height is the drawn text's (F122: the copy below once set
            // it, at the chat's line height, so a long message got a tall
            // empty bubble).
            height: ust.preferred-height + Theme.sp-16;
            property <length> drawn: ust.preferred-height;
            property <length> copy: ub.preferred-height;
            init => { BubbleProbe.drawn = self.drawn; BubbleProbe.copy = self.copy; BubbleProbe.box = self.height; }
            changed drawn => { BubbleProbe.drawn = self.drawn; BubbleProbe.box = self.height; }
            changed copy => { BubbleProbe.copy = self.copy; }
            ub-measure := Text { visible: false; text: e.text; font-size: Theme.text-13 * root.fs; }
            // Drawn as StyledText (its URLs links in the bubble's colour,
            // underlined); a transparent copy of the text over it keeps the
            // selection, and a click on a URL opens it.
            ust := StyledText { default-font-family: Theme.chat-font;
                x: Theme.sp-12; y: Theme.sp-8; width: parent.width - Theme.sp-20;
                text: e.md;
                default-color: Theme.text-primary;
                default-font-size: Theme.text-13 * root.fs;
                link-color: Theme.text-primary;
            }
            // (At the font's own line, as the StyledText it lies over.)
            ub := Prose {
                line-height-factor: Theme.lh-plain;
                font-family: Theme.chat-font;
                fs: root.fs; x: Theme.sp-12; y: Theme.sp-8; width: parent.width - Theme.sp-20; text: e.text;
                color: transparent; selection-foreground-color: transparent;
                changed cursor-position-byte-offset => {
                    if self.anchor-position-byte-offset == self.cursor-position-byte-offset { ToolAct.click-at(e.text, self.cursor-position-byte-offset); }
                }
            }
        }
    }

    // Claude's reply (2.16): paragraphs, headings, quotes at 13 × fs (a `#`
    // heading 14, semibold, 12 above). The web's line box is line-chat × the
    // text size; StyledText has no line height, so its one line is padded
    // to that box: half the difference above and below.
    if e.kind == "assistant" && (e.status == "p" || e.status == "h" || e.status == "h4"): pl := VerticalLayout {
        property <length> size: (e.status == "h" ? Theme.text-14 : Theme.text-13) * root.fs;
        // (With the chat font (K1) its own line is the web's: no padding.)
        property <length> pad: Theme.chat-font != "" ? 0px : max(0px, (self.size * Theme.line-chat - pm.preferred-height) / 2);
        padding-top: self.pad + (e.status == "h" ? Theme.sp-4 : 0px);
        padding-bottom: self.pad;
        Rectangle { height: 0; pm := Text { visible: false; text: "X"; font-size: pl.size; } }
        // Its width given, so its wrapped height is measured at the width it
        // is drawn at (F24: a long inline code token wrapped differently).
        StyledText { default-font-family: Theme.chat-font;
            width: root.avail;
            text: e.md;
            default-color: Theme.chip-key;
            default-font-size: pl.size;
            link-color: Theme.accent-hover;
            link-clicked(url) => { ToolAct.open-link(url); }
        }
    }
    // A quote line: a bar, then the text in text-secondary.
    if e.kind == "assistant" && e.status == "quote": HorizontalLayout {
        padding-top: Theme.chat-font != "" ? 0px : max(0px, (Theme.text-13 * root.fs * Theme.line-chat - qm.preferred-height) / 2);
        padding-bottom: self.padding-top;
        spacing: Theme.sp-10 - Theme.sp-2;
        Rectangle { width: Theme.sp-2; background: Theme.border; qm := Text { visible: false; text: "X"; font-size: Theme.text-13 * root.fs; } }
        StyledText { default-font-family: Theme.chat-font;
            width: root.avail - Theme.sp-10;
            text: e.md;
            default-color: Theme.chip-key;
            default-font-size: Theme.text-13 * root.fs;
            link-color: Theme.accent-hover;
            link-clicked(url) => { ToolAct.open-link(url); }
        }
    }
    // A rule: a light line, the full width.
    // A rule: the browser's 2px light line.
    if e.kind == "assistant" && e.status == "hr": Rectangle {
        height: Theme.sp-2;
        Rectangle { y: 0; height: 1px; background: Theme.rule-dark; }
        Rectangle { y: 1px; height: 1px; background: Theme.rule-light; }
    }
    if e.kind == "assistant" && (e.status == "li" || e.status == "lie"): HorizontalLayout {
        padding-top: Theme.chat-font != "" ? 0px : max(0px, (Theme.text-13 * root.fs * Theme.line-chat - lm.preferred-height) / 2);
        padding-bottom: self.padding-top;
        Rectangle { width: 0; lm := Text { visible: false; text: "X"; font-size: Theme.text-13 * root.fs; } }
        // (The marker in the chat font too: on the item's first line.)
        Text { width: Theme.sp-20; text: e.title; font-family: Theme.chat-font; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; horizontal-alignment: center; }
        StyledText { default-font-family: Theme.chat-font;
            width: root.avail - Theme.sp-20;
            text: e.md;
            default-color: Theme.chip-key;
            default-font-size: Theme.text-13 * root.fs;
            link-color: Theme.accent-hover;
            link-clicked(url) => { ToolAct.open-link(url); }
        }
    }

    // A code block (pre): its lines kept whole, scrolling sideways; the copy
    // button inside its top-right corner while the pointer is over it.
    if e.kind == "code": cblk := Rectangle {
        background: Theme.bg-secondary;
        border-width: 1px;
        border-color: Theme.border-subtle;
        border-radius: Theme.r-control;
        clip: true;
        height: code.preferred-height + 2 * Theme.sp-10;
        property <bool> over: !Pointer.modal && Pointer.x >= self.absolute-position.x && Pointer.x < self.absolute-position.x + self.width
            && Pointer.y >= self.absolute-position.y && Pointer.y < self.absolute-position.y + self.height;
        // Shown while over it, and a moment after (the pointer on its way to
        // the button); the tick until it goes.
        property <bool> shown;
        property <bool> copied;
        changed over => { if self.over { self.shown = true; linger.running = false; } else { linger.running = true; } }
        linger := Timer { interval: Theme.motion; running: false; triggered => { self.running = false; cblk.shown = false; cblk.copied = false; } }
        cf := Flickable {
            x: 1px; y: 1px; width: parent.width - Theme.sp-2; height: parent.height - Theme.sp-2;
            content-width: max(self.width, code.preferred-width + 2 * Theme.sp-12);
            content-height: self.height;
            code := TextInput {
                x: Theme.sp-12; y: Theme.sp-10 - 1px;
                read-only: true; single-line: false; wrap: no-wrap;
                text: e.text;
                font-family: Theme.mono; font-size: Theme.text-12 * root.fs;
                color: Theme.text-primary;
            }
        }
        if cblk.shown: Rectangle {
            x: parent.width - self.width - Theme.sp-6; y: Theme.sp-6;
            width: Theme.sp-24; height: Theme.sp-20 + Theme.sp-2;
            SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-control; shadow: Theme.shadow-menu; }
            Rectangle { border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border; background: cb.has-hover ? Theme.bg-hover : Theme.bg-secondary; }
            Icon {
                source: cblk.copied ? Icons.check : Icons.copy; width: Theme.icon-md; height: Theme.icon-md;
                tint: cblk.copied ? Theme.green : cb.has-hover ? Theme.text-primary : Theme.text-secondary;
            }
            cb := TouchArea {
                mouse-cursor: pointer;
                clicked => { ToolAct.copy(e.text); cblk.copied = true; }
                Tip { on: parent.has-hover; text: "Copy code"; }
            }
        }
    }

    if e.kind == "thinking": ThinkBlock { fs: root.fs; e: e; }

    // A goal check that said "not yet" (2.19): an accent bar, the head, the reason.
    if e.kind == "goal-verdict": Rectangle {
        height: gv.preferred-height + Theme.sp-12;
        background: Theme.bg-secondary;
        border-top-right-radius: Theme.r-control; border-bottom-right-radius: Theme.r-control;
        Rectangle { x: 0; width: Theme.sp-2; background: Theme.accent; }
        gv := VerticalLayout {
            x: Theme.sp-10; y: Theme.sp-6; width: parent.width - Theme.sp-20; height: self.preferred-height;
            spacing: Theme.sp-2;
            HorizontalLayout {
                spacing: Theme.sp-6; alignment: start;
                Rectangle { width: Theme.sp-6; Rectangle { y: (parent.height - self.height) / 2; width: Theme.sp-6; height: Theme.sp-6; border-radius: Theme.sp-6 / 2; background: Theme.accent; } }
                Text { text: e.detail; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold; color: Theme.accent-hover; }
            }
            Text { text: e.text; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; wrap: word-wrap; }
        }
    }

    // A side question (2.21): "On the side", the question, then "Asking…",
    // the answer (markdown, text-secondary) or the error box; the note.
    if e.kind == "aside": Rectangle {
        height: al.preferred-height + Theme.sp-16;
        background: Theme.bg-secondary;
        border-radius: Theme.r-control;
        DashedBox { width: parent.width; height: parent.height; corner: Theme.r-control; }
        al := VerticalLayout {
            x: Theme.sp-10; y: Theme.sp-8; width: parent.width - Theme.sp-20;
            height: self.preferred-height;
            HorizontalLayout {
                spacing: Theme.sp-8;
                Text { horizontal-stretch: 1; vertical-alignment: center; text: "ON THE SIDE"; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold; letter-spacing: Theme.track-wide; color: Theme.text-muted; }
                DockX { fs: root.fs; tip: "Close"; clicked => { ToolAct.aside-close(e.chat, e.request-id); } }
            }
            Rectangle {
                height: aq.preferred-height + Theme.sp-4 + Theme.sp-6;
                aq := Text { y: Theme.sp-4; width: parent.width; text: e.text; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; wrap: word-wrap; }
            }
            if e.status == "pending": HorizontalLayout {
                spacing: Theme.sp-6;
                alignment: start;
                StatusMark { running: true; }
                Text { vertical-alignment: center; text: "Asking…"; font-size: Theme.text-13 * root.fs; color: Theme.text-secondary; }
            }
            // The answer: the reply's blocks in text-secondary; a list's
            // items hang from their markers.
            if e.status == "done": VerticalLayout {
                spacing: Theme.sp-4;
                for b in e.blocks: Rectangle {
                    height: bl.preferred-height;
                    bl := HorizontalLayout {
                        if b.kind == "li": Text { width: Theme.sp-20; font-family: Theme.chat-font; text: b.marker; font-size: Theme.text-13 * root.fs; color: Theme.text-secondary; horizontal-alignment: center; }
                        if b.kind != "code": StyledText { default-font-family: Theme.chat-font;
                            width: al.width - (b.kind == "li" ? Theme.sp-20 : 0px);
                            text: b.md;
                            default-color: Theme.chip-key;
                            default-font-size: Theme.text-13 * root.fs;
                            link-color: Theme.accent-hover;
                            link-clicked(url) => { ToolAct.open-link(url); }
                        }
                        if b.kind == "code": Text { width: al.width; text: b.text; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; wrap: word-wrap; }
                    }
                }
            }
            if e.status == "error": Rectangle {
                height: aet.preferred-height + Theme.sp-6 + Theme.sp-8;
                background: Theme.red-dim; border-width: 1px; border-color: Theme.red; border-radius: Theme.r-control;
                aet := Text { x: Theme.sp-10; y: Theme.sp-6 + 1px; width: parent.width - Theme.sp-20; text: e.detail; color: Theme.red; wrap: word-wrap; font-size: Theme.text-12 * root.fs; }
            }
            Rectangle {
                height: an.preferred-height + Theme.sp-6;
                an := Text { x: 0; y: Theme.sp-6; text: "Not added to the conversation."; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; }
            }
        }
    }

    if e.kind == "tool": VerticalLayout {
        for t in e.tools: VerticalLayout {
            ToolCard { t: t; fs: root.fs; chat: e.chat; }
            if t.media.length > 0: MediaBlock { t: t; avail: root.avail; }
            if t.shots.length > 0: ShotsRow { shots: t.shots; }
        }
    }

    // A batch Claude Code summed up (.cc-tgroup): its head (the members'
    // status, the summary, "N tools", the caret) opens its calls' cards.
    if e.kind == "tools": VerticalLayout {
        Rectangle {
            height: gh.preferred-height;
            background: Theme.bg-secondary;
            border-radius: Theme.r-control;
            border-width: 1px;
            border-color: Theme.border-subtle;
            gh := HorizontalLayout {
                padding-top: Theme.sp-6; padding-bottom: Theme.sp-6; padding-left: Theme.sp-10; padding-right: Theme.sp-10;
                spacing: Theme.sp-8;
                StatusMark { running: e.status == "running"; failed: e.error; }
                Text { text: e.title; font-size: Theme.text-12 * root.fs; color: Theme.text-primary; overflow: elide; wrap: no-wrap; horizontal-stretch: 1; min-width: 0; vertical-alignment: center; }
                Text { text: e.detail; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; vertical-alignment: center; }
                Text { text: e.open ? "▾" : "▸"; font-size: Theme.text-13 * root.fs; color: Theme.text-muted; vertical-alignment: center; }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { ToolAct.toggle(e.chat, e.id); }
                Tip { on: parent.has-hover; text: e.open ? "Fold these tool calls" : "Show each tool call"; }
            }
        }
        if e.open: Rectangle {
            height: gm.preferred-height + Theme.sp-4;
            gm := VerticalLayout {
                y: Theme.sp-4;
                spacing: Theme.sp-10;
                for t in e.tools: VerticalLayout {
                    ToolCard { t: t; fs: root.fs; chat: e.chat; }
                    if t.media.length > 0: MediaBlock { t: t; avail: root.avail; }
                }
            }
        }
    }

    // A call that started a sub-agent (.cc-agentrow): its status, the
    // agent's type and description, "transcript ›". (Padded as a card's
    // head: the web's row has none, an accident. Its panel is 2.18.)
    if e.kind == "agent": Rectangle {
        height: ah.preferred-height;
        background: Theme.bg-secondary;
        border-radius: Theme.r-control;
        border-width: 1px;
        border-color: aa.has-hover ? Theme.accent : Theme.border-subtle;
        ah := HorizontalLayout {
            padding-top: Theme.sp-6; padding-bottom: Theme.sp-6; padding-left: Theme.sp-10; padding-right: Theme.sp-10;
            spacing: Theme.sp-8;
            StatusMark { running: e.status == "running"; failed: e.status == "failed"; }
            Text { text: e.title; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; font-weight: Theme.w-semibold; color: Theme.accent-hover; vertical-alignment: center; }
            Text { text: e.detail; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; overflow: elide; wrap: no-wrap; horizontal-stretch: 1; min-width: 0; vertical-alignment: center; }
            Text { text: "transcript ›"; font-size: Theme.text-11 * root.fs; color: Theme.accent-hover; vertical-alignment: center; }
        }
        aa := TouchArea { mouse-cursor: pointer; clicked => { ToolAct.agent-open(e.chat, e.request-id, false); } }
    }

    // A permission card (the web's permissionNode): yellow while pending
    // and after; pending: its title, description, reason, the input, then
    // Allow / Allow always / Deny; answered: the tool's name and its tag.
    if e.kind == "permission": Rectangle {
        background: Theme.yellow-dim;
        border-width: 1px;
        border-color: Theme.yellow;
        border-radius: Theme.r-card;
        height: perm.preferred-height;
        perm := VerticalLayout {
            padding-top: Theme.sp-12 - 1px; padding-bottom: Theme.sp-12 - 1px; padding-left: Theme.sp-12; padding-right: Theme.sp-12;
            if e.status == "pending": Text { text: e.title; font-weight: Theme.w-semibold; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; wrap: word-wrap; }
            if e.status == "pending" && e.detail != "": Rectangle {
                height: pdsc.preferred-height + Theme.sp-2;
                pdsc := Text { y: Theme.sp-2; width: parent.width; text: e.detail; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; wrap: word-wrap; }
            }
            if e.status == "pending" && e.note != "": Rectangle {
                height: prs.preferred-height + Theme.sp-8;
                prs := Text { y: Theme.sp-8; width: parent.width; text: e.note; font-size: Theme.text-12 * root.fs; color: Theme.text-muted; wrap: word-wrap; }
            }
            // The input (cc-ask-pre): mono on bg-primary, at most 200 tall, scrolling.
            if e.status == "pending": Rectangle {
                height: min(pre.preferred-height + Theme.sp-16, Theme.pre-max-h) + Theme.sp-8 + Theme.sp-10;
                Rectangle {
                    y: Theme.sp-8; height: parent.height - Theme.sp-8 - Theme.sp-10;
                    background: Theme.bg-primary; border-width: 1px; border-color: Theme.border-subtle; border-radius: Theme.r-control;
                    clip: true;
                    pf := Flickable {
                        x: 1px; y: 1px; width: parent.width - Theme.sp-2; height: parent.height - Theme.sp-2;
                        content-height: pre.preferred-height + Theme.sp-16 - Theme.sp-2;
                        pre := TextInput {
                            x: Theme.sp-10 - 1px; y: Theme.sp-8 - 1px; width: pf.width - Theme.sp-20 + Theme.sp-2;
                            read-only: true; wrap: word-wrap; text: e.args;
                            font-family: Theme.mono; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary;
                        }
                    }
                }
            }
            // Escalated: sent to the project owner (one button: carry on
            // without it) or to a factory's Manager (no button).
            if e.status == "pending" && e.tag != "": Rectangle {
                height: esc-t.preferred-height + Theme.sp-8;
                esc-t := Text { y: 0; width: parent.width; text: e.tag == "manager" ? "Sent to the Manager of this factory, who decides. You will see the answer here." : "Sent to the project owner. You will see the answer here."; font-size: Theme.text-12 * root.fs; color: Theme.text-muted; wrap: word-wrap; }
            }
            if e.status == "pending" && e.tag == "escalated": HorizontalLayout {
                alignment: start;
                CardBtn { fs: root.fs; text: "Carry on without this"; clicked => { ToolAct.collab-cancel(e.sub); } }
            }
            if e.status == "pending" && e.tag == "": HorizontalLayout {
                spacing: Theme.sp-8;
                alignment: start;
                CardBtn { fs: root.fs; text: "Allow"; primary: true; clicked => { root.respond(e.request-id, "allow", false); } }
                // Only with the CLI's suggestions (and no suppressAlwaysAllow).
                if e.options.length > 0: CardBtn { fs: root.fs; text: "Allow always"; clicked => { root.respond(e.request-id, "allow", true); } }
                CardBtn { fs: root.fs; text: "Deny"; danger: true; clicked => { root.respond(e.request-id, "deny", false); } }
            }
            if e.status != "pending": HorizontalLayout {
                spacing: Theme.sp-6;
                alignment: start;
                Text { vertical-alignment: center; text: e.text; font-weight: Theme.w-bold; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; }
                Tag { y: (parent.height - self.height) / 2; fs: root.fs; text: e.tag; tone: e.error ? "no" : "ok"; }
            }
            if e.status != "pending" && e.sub != "": Rectangle {
                height: psub.preferred-height + Theme.sp-6;
                psub := Text { y: Theme.sp-6; width: parent.width; text: e.sub; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; wrap: word-wrap; }
            }
        }
    }

    if e.kind == "question": QuestionCard { fs: root.fs; e: e; }
    if e.kind == "factory-result": FactoryCard { fs: root.fs; e: e; }

    // The end of a turn: centred, small, a line above.
    if e.kind == "result" && !e.error: VerticalLayout {
        Rectangle {
            height: 1px;
            for i in ceil(self.width / Theme.sp-6): Rectangle { x: i * Theme.sp-6; width: Theme.sp-4; height: 1px; background: Theme.border-subtle; }
        }
        Text {
            text: e.error ? (e.text != "" ? e.text : "Error") : e.detail;
            height: Theme.sp-24 + (root.fs - 1) * Theme.sp-16;
            font-size: Theme.text-11 * root.fs;
            color: e.error ? Theme.red : Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // An error (.cc-error), and a failed turn's end: a red box.
    if e.kind == "error" || (e.kind == "result" && e.error): Rectangle {
        background: Theme.red-dim;
        border-width: 1px;
        border-color: Theme.red;
        border-radius: Theme.r-control;
        height: et.preferred-height + Theme.sp-6 + Theme.sp-8;
        et := Text {
            x: Theme.sp-10; y: Theme.sp-6 + 1px; width: parent.width - Theme.sp-20;
            text: e.kind == "result" ? (e.text != "" ? e.text : "Error") : e.text;
            color: Theme.red; wrap: word-wrap; font-size: Theme.text-12 * root.fs;
        }
    }

    // A notice (.cc-notice): centred, muted italics.
    if e.kind == "notice": Text { text: e.text; color: Theme.text-muted; font-size: Theme.text-12 * root.fs; font-italic: true; horizontal-alignment: center; wrap: word-wrap; }
}

/// A queued-messages drawer (2.9, .cc-queue): held (dashed accent edge,
/// accent tint; hover brighter) or handed over (solid slate edge, slate
/// tint, quieter text; no hover change). Its head (label and note), its text
/// (at most four rows, "…" at the cut) and a hint. A click takes it back.
component QueueDrawer inherits Rectangle {
    in property <float> fs: 1;
    in property <bool> sent;
    in property <bool> recallable;
    in property <string> label;
    in property <string> note;
    in property <string> hint;
    in property <string> tip;
    in property <string> body;
    callback clicked();
    property <bool> hot: !root.sent && ta.has-hover;
    property <length> line: bm.preferred-height;
    property <bool> trimmed: full-m.preferred-height > Theme.queue-rows * self.line + 1px;
    height: col.preferred-height;
    border-radius: Theme.r-card;
    background: root.sent ? Theme.slate-haze : root.hot ? Theme.accent-dim : Theme.accent-haze;
    border-width: root.sent ? 1px : 0px;
    border-color: Theme.slate-edge;
    if !root.sent: DashedBox {
        width: parent.width; height: parent.height;
        thick: 1px; dash: Theme.sp-4; gap: Theme.sp-2; corner: Theme.r-card;
        line: root.hot ? Theme.accent : Theme.accent-line;
    }
    // One line of the body's text, and all of it at the body's width (for the
    // four-row clamp).
    bm := Text { visible: false; text: "X"; font-size: Theme.text-12 * root.fs; }
    full-m := Text { visible: false; width: col.width - 2 * Theme.sp-12; text: root.body; font-size: Theme.text-12 * root.fs; wrap: word-wrap; }
    col := VerticalLayout {
        padding-top: Theme.sp-8; padding-bottom: Theme.sp-8; padding-left: Theme.sp-12; padding-right: Theme.sp-12;
        HorizontalLayout {
            spacing: Theme.sp-6;
            padding-bottom: Theme.sp-2;
            Text {
                vertical-alignment: center;
                text: root.label; font-size: Theme.text-10 * root.fs; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide;
                color: root.sent ? Theme.text-muted : Theme.accent-hover;
            }
            // The note: the label's colour, quieter; it wraps in its own box.
            Text {
                horizontal-stretch: 1; min-width: 0; preferred-width: 0;
                vertical-alignment: center; wrap: word-wrap;
                text: root.note; font-size: Theme.text-10 * root.fs; font-weight: Theme.w-medium;
                color: root.sent ? Theme.text-muted : Theme.accent-hover; opacity: Theme.o-usage;
            }
        }
        // At most queue-rows rows: clipped there, "…" on the last (and
        // "Shown trimmed · " before the hint), so a long batch never pushes
        // the box out of a short pane.
        Rectangle {
            height: min(full-m.preferred-height, Theme.queue-rows * root.line);
            clip: true;
            Text {
                width: parent.width; height: parent.height;
                text: root.body; font-size: Theme.text-12 * root.fs; wrap: word-wrap;
                color: root.sent ? Theme.text-secondary : Theme.text-primary;
                overflow: elide;
            }
        }
        Rectangle { height: Theme.sp-4; }
        Text {
            text: (root.trimmed ? "Shown trimmed · " : "") + root.hint;
            font-size: Theme.text-10 * root.fs; color: Theme.text-muted; wrap: word-wrap;
        }
    }
    ta := TouchArea {
        mouse-cursor: root.recallable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
        Tip { on: parent.has-hover; text: root.tip; }
    }
}

/// A slash command in the menu (2.11): "/name" and its description (empty
/// for a names-only command).
export struct SlashItem { name: string, desc: string }

/// One command: the name (mono, semibold, accent-hover; never wrapped), its
/// description (muted, one line, elided); selected: accent-dim. Hover changes
/// nothing but the pointer; a press chooses it.
component SlashRow inherits Rectangle {
    in property <float> fs: 1;
    in property <SlashItem> it;
    in property <bool> on;
    callback chosen();
    // Selected: keep it in view (the web doesn't: a named difference).
    callback reveal(length, length);
    changed on => { if self.on { root.reveal(self.y, self.y + self.height); } }
    height: row.preferred-height;
    background: root.on ? Theme.accent-dim : transparent;
    row := HorizontalLayout {
        padding-top: Theme.sp-4; padding-bottom: Theme.sp-4; padding-left: Theme.sp-10; padding-right: Theme.sp-10;
        spacing: Theme.sp-8;
        Text {
            horizontal-stretch: 0;
            text: root.it.name; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; font-weight: Theme.w-semibold;
            color: Theme.accent-hover; line-height-factor: Theme.lh-ui; wrap: no-wrap;
        }
        Text {
            horizontal-stretch: 1; min-width: 0; preferred-width: 0;
            text: root.it.desc; font-size: Theme.text-12 * root.fs; color: Theme.text-muted;
            line-height-factor: Theme.lh-ui; overflow: elide; wrap: no-wrap;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.chosen(); } }
    }
}

/// What every composer shares with the app (src/app.rs): the Enter mode
/// (one setting for every chat, saved), a request to focus a chat's box,
/// and the controls whose screens come later (attach 2.7, the clock 2.10,
/// the mode chooser 2.6).
/// Voice input (2.24), kept by src/app.rs at frame rate: the chat that is
/// recording (or in voice mode), a hold, the chat paused for a hold
/// elsewhere, Claude speaking; the box's words, the strip's time, status
/// and bars (px); cancelling (a hold over ×); where × is (window).
export global VoiceUi {
    in-out property <string> key;
    in-out property <bool> hold;
    in-out property <string> away-key;
    in-out property <bool> speaking;
    in-out property <string> text;
    in-out property <string> time;
    in-out property <string> status;
    in-out property <length> b0;
    in-out property <length> b1;
    in-out property <length> b2;
    in-out property <length> b3;
    in-out property <length> b4;
    in-out property <bool> cancelling;
    in-out property <length> x-x;
    in-out property <length> x-y;
    // For the test driver: the recording box's and the strip's widths.
    in-out property <length> box-w;
    in-out property <length> strip-w;
}

export global Composer {
    // Voice input (2.24), by pane key: the mic pressed and let go (over ×?),
    // a hold moving near × or away, ×, a click on the voice line.
    callback mic-press(string);
    callback mic-release(string, bool);
    callback mic-near(string, bool);
    callback voice-cancel(string);
    callback vline-click(string);
    // Ctrl+Enter sends (Enter makes a newline); otherwise Enter sends.
    in-out property <bool> ctrl-enter;
    callback set-ctrl-enter(bool);
    // Focus this pane's box (its key); counted, so asking again refocuses.
    in-out property <string> focus-key;
    in-out property <int> focus-gen;
    // The session id was copied (its full uuid): the app toasts it.
    callback copied(string);
    callback attach(string);
    callback schedule(string);
    callback mode(string);
    // A pane's caret moved (its key, the caret and the selection's other
    // end, byte offsets): where an attached path will go (2.7).
    callback caret(string, int, int);
    // Ctrl+V (or Shift+Insert) in a pane's box: true when the clipboard held a
    // picture or a file, which the app uploads (the key is then taken).
    callback paste(string, bool) -> bool;
    // Take back what is queued (2.9: a click on a drawer, or ↑ on the box's
    // first row): false when there is nothing to take back.
    callback take-back(string) -> bool;
    // The schedule panel (2.10), by pane key: ×, a trigger, its message box's
    // and time field's text as typed, Schedule, an item's ✕, a date and time
    // picked in the popups.
    callback sched-close(string);
    // The slash menu (2.11), by pane key: ↑ ↓, choose (an index; -1 the
    // selected), close.
    callback slash-move(string, int);
    callback slash-choose(string, int);
    callback slash-close(string);
    callback sched-trigger(string, string);
    callback sched-text(string, string);
    callback sched-at(string, string);
    callback sched-save(string);
    callback sched-delete(string, string);
    callback sched-pick(string, int, int, int, int, int);
    // The app put text into a pane's box (an attached path): its whole new
    // text and the caret; counted.
    in-out property <string> insert-key;
    in-out property <string> insert-text;
    in-out property <int> insert-caret;
    // ...and whether the box takes the focus (not for a give-back).
    in-out property <bool> insert-focus;
    in-out property <int> insert-gen;
}

/// The message box (.cc-input): one line at least (`control`), growing with
/// its text (wrapped lines too) to `composer-max`, then scrolling inside.
/// Enter, or Ctrl+Enter when switched, sends.
component InputBox inherits Rectangle {
    // The pane's text size, a scale of the base size (the web's --cc-fs).
    in property <float> fs: 1;
    in-out property <string> draft;
    in property <bool> ctrl-enter;
    in property <bool> enabled: true;
    in property <string> placeholder;
    callback send();
    // The caret moved: the caret and the selection's other end (byte offsets).
    callback caret(int, int);
    // ↑ on the box's first row, nothing selected: true when the app took
    // back what was queued (the key is then taken).
    callback up() -> bool;
    // The caret's row: its top, in the text.
    property <length> caret-y;
    // The slash menu is open (2.11): ↑ ↓ Enter Tab Esc go to it first.
    in property <bool> slash-open;
    callback slash-move(int);
    callback slash-choose();
    callback slash-close();
    // Ctrl+V / Shift+Insert (true): true when the app took it (a picture, a
    // file; Shift+Insert's text too: Slint's input knows only Ctrl+V).
    callback paste(bool) -> bool;
    public function focus-box() { te.focus(); }
    // The app's text and caret (an attached path put in): the box takes the
    // focus with the caret there.
    public function put(text: string, caret: int, focus: bool) {
        root.draft = text;
        te.set-selection-offsets(caret, caret);
        if focus { te.focus(); }
    }
    out property <bool> focused: te.has-focus && root.enabled;
    property <length> line: Theme.text-13 * root.fs * Theme.line-composer;
    // Dimmed while it can't take text (an exited chat).
    opacity: root.enabled ? 1 : Theme.o-soft;
    height: max(Theme.control, min(Theme.composer-max, te.preferred-height + 2 * Theme.sp-8));
    // The focus ring, outside the border.
    if root.focused: Rectangle {
        x: -Theme.sp-4; y: -Theme.sp-4; width: parent.width + 2 * Theme.sp-4; height: parent.height + 2 * Theme.sp-4;
        border-radius: Theme.r-card; background: Theme.accent-ring;
    }
    Rectangle {
        border-radius: Theme.r-control;
        border-width: 1px;
        border-color: root.focused ? Theme.accent : Theme.border;
        background: Theme.bg-primary;
    }
    Rectangle {
        fl := Flickable {
            x: Theme.sp-10; y: Theme.sp-8;
            width: parent.width - 2 * Theme.sp-10; height: parent.height - 2 * Theme.sp-8;
            content-height: max(self.height, te.preferred-height);
            FocusScope {
                capture-key-pressed(ev) => {
                    if root.slash-open {
                        if ev.text == Key.UpArrow { root.slash-move(-1); return accept; }
                        if ev.text == Key.DownArrow { root.slash-move(1); return accept; }
                        if (ev.text == Key.Return && !ev.modifiers.shift) || ev.text == Key.Tab { root.slash-choose(); return accept; }
                        if ev.text == Key.Escape { root.slash-close(); return accept; }
                    }
                    if ((ev.modifiers.control || ev.modifiers.meta) && (ev.text == "v" || ev.text == "V")) || (ev.modifiers.shift && ev.text == Key.Insert) {
                        if root.paste(ev.modifiers.shift && ev.text == Key.Insert) { return accept; }
                        return reject;
                    }
                    if ev.text == Key.UpArrow && !ev.modifiers.shift && !ev.modifiers.control && !ev.modifiers.alt && !ev.modifiers.meta
                            && te.cursor-position-byte-offset == te.anchor-position-byte-offset && root.caret-y < root.line / 2 {
                        if root.up() { return accept; }
                        return reject;
                    }
                    if ev.text == Key.Return {
                        if root.ctrl-enter ? (ev.modifiers.control || ev.modifiers.meta) : (!ev.modifiers.shift && !ev.modifiers.control && !ev.modifiers.meta) {
                            root.send();
                            return accept;
                        }
                    }
                    return reject;
                }
                te := TextInput {
                    width: fl.width;
                    height: max(fl.height, self.preferred-height);
                    // The web's .cc-input line, 1.45 (K5).
                    line-height-factor: Theme.lh-composer;
                    text <=> root.draft;
                    enabled: root.enabled;
                    single-line: false;
                    wrap: word-wrap;
                    font-size: Theme.text-13 * root.fs;
                    color: Theme.text-primary;
                    selection-background-color: Theme.accent-dim;
                    // Past composer-max it scrolls: keep the caret in view.
                    cursor-position-changed(at) => {
                        root.caret(self.cursor-position-byte-offset, self.anchor-position-byte-offset);
                        root.caret-y = at.y;
                        if at.y + fl.content-y < 0 {
                            fl.content-y = -at.y;
                        } else if at.y + root.line + fl.content-y > fl.height {
                            fl.content-y = min(0px, fl.height - at.y - root.line);
                        }
                    }
                }
            }
        }
        // Past composer-max: a scroll thumb on the right, so more text above
        // or below shows (the web's textarea scrollbar).
        ScrollThumb {
            width: parent.width; height: parent.height;
            view-h: fl.height; content-h: te.preferred-height; offset: -fl.content-y;
        }
        if root.draft == "": Text {
            x: Theme.sp-10; y: Theme.sp-8;
            width: parent.width - 2 * Theme.sp-10;
            text: root.placeholder;
            font-size: Theme.text-13 * root.fs;
            color: Theme.text-muted;
            overflow: elide;
        }
    }
}

/// A square bordered button of the composer (attach; the clock in a narrow
/// pane): bg-primary, hover an accent border and icon.
component SquareBtn inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: Theme.icon-lg;
    in property <string> tip;
    in property <bool> fill: true;
    in property <color> ink: Theme.text-secondary;
    // Busy (attach while a file uploads): faint and inert.
    in property <bool> busy;
    callback clicked();
    opacity: root.busy ? Theme.o-soft : 1;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: ta.has-hover && !root.busy ? Theme.accent : Theme.border;
    background: root.fill ? Theme.bg-primary : transparent;
    Icon { source: root.icon; width: root.icon-size; height: root.icon-size; tint: ta.has-hover && !root.busy ? Theme.accent-hover : root.ink; }
    ta := TouchArea {
        enabled: !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Tip { on: parent.has-hover; text: root.tip; }
    }
}

/// Stop (.cc-stop): a red square; armed (one click), red-dim with "Sure?"
/// sliding in beside it. The app arms and disarms it (src/app.rs).
component StopBtn inherits Rectangle {
    in property <float> fs: 1;
    in property <bool> armed;
    callback clicked();
    property <length> sure-w: root.armed ? sure-m.preferred-width + Theme.sp-4 : 0px;
    animate sure-w { duration: Theme.motion; }
    height: Theme.control;
    width: max(Theme.control, Theme.sp-8 + Theme.icon-md + self.sure-w + Theme.sp-8);
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.armed || ta.has-hover ? Theme.red : Theme.border;
    background: root.armed ? Theme.red-dim : Theme.bg-primary;
    sure-m := Text { visible: false; text: "Sure?"; font-size: Theme.text-11 * root.fs; }
    HorizontalLayout {
        alignment: center;
        Icon { y: (parent.height - self.height) / 2; source: Icons.square; width: Theme.icon-md; height: Theme.icon-md; tint: Theme.red; }
        Rectangle {
            width: root.sure-w;
            clip: true;
            Text { x: Theme.sp-4; text: "Sure?"; font-size: Theme.text-11 * root.fs; color: Theme.red; vertical-alignment: center; height: parent.height; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Tip { on: parent.has-hover; text: root.armed ? "Click again to interrupt" : "Stop this turn (click twice)"; }
    }
}

/// The mic (.cc-mic, 2.24): a control square. Idle: the mic in
/// text-secondary (hover: accent-hover on an accent edge). On (recording):
/// accent, the send icon in white, a pulsing ring (a still sky ring while
/// Claude speaks). Away (paused for a hold elsewhere): the accent outline.
/// A press and its release go to the app (a tap or a hold); while held,
/// coming within sp-8 of × or leaving it is told too.
component MicBtn inherits Rectangle {
    in property <string> key;
    in property <bool> on;
    in property <bool> away;
    in property <bool> speaking;
    in property <string> tip;
    width: Theme.control; height: Theme.control;
    property <bool> near;
    property <float> ph: mod(animation-tick() / Theme.shimmer, 1);
    if root.on && !root.speaking: Rectangle {
        property <length> ring: Theme.sp-2 + Theme.sp-4 * abs(sin(root.ph * 180deg));
        x: -self.ring; y: -self.ring; width: parent.width + 2 * self.ring; height: parent.height + 2 * self.ring;
        border-radius: Theme.r-control + self.ring; background: Theme.accent-dim;
    }
    if root.on && root.speaking: Rectangle {
        x: -Theme.sp-2 - 1px; y: self.x; width: parent.width - 2 * self.x; height: self.width;
        border-radius: Theme.r-control - self.x; background: Theme.sky-ring-voice;
    }
    Rectangle {
        border-radius: Theme.r-control; border-width: 1px;
        border-color: root.on || root.away || ta.has-hover ? Theme.accent : Theme.border;
        background: root.on ? Theme.accent : Theme.bg-primary;
        Icon {
            source: root.on ? Icons.send : Icons.mic; width: Theme.icon-lg; height: Theme.icon-lg;
            tint: root.on ? Theme.white : root.away || ta.has-hover ? Theme.accent-hover : Theme.text-secondary;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down { root.near = false; Composer.mic-press(root.key); }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up { Composer.mic-release(root.key, root.near); root.near = false; }
        }
        moved => {
            if VoiceUi.hold && VoiceUi.key == root.key {
                let px = self.absolute-position.x + self.mouse-x;
                let py = self.absolute-position.y + self.mouse-y;
                let n = px >= VoiceUi.x-x - Theme.sp-8 && px <= VoiceUi.x-x + Theme.control + Theme.sp-8
                    && py >= VoiceUi.x-y - Theme.sp-8 && py <= VoiceUi.x-y + Theme.control + Theme.sp-8;
                if n != root.near { root.near = n; Composer.mic-near(root.key, n); }
            }
        }
        Tip { on: parent.has-hover && !parent.pressed; text: root.tip; }
    }
}

/// The recording strip (.cc-rec, 2.24) in Send's place: Send's look, with a
/// blinking dot, five level bars, the time and the status. Cancelling (a
/// hold over ×): red-dim on a red edge, red text and bars.
component RecStrip inherits Rectangle {
    in property <float> fs: 1;
    // Wide: its contents, at least Send's width (F127); narrow: the rest of
    // the row (the layout gives it).
    in property <length> least;
    property <bool> c: VoiceUi.cancelling;
    changed width => { VoiceUi.strip-w = self.width; }
    init => { VoiceUi.strip-w = self.width; }
    property <color> ink: root.c ? Theme.red : Theme.white;
    // (Narrow: it takes what the row leaves; the status elides first.)
    min-width: max(Theme.control, root.least);
    preferred-width: max(lay.preferred-width, root.least);
    border-radius: Theme.r-control;
    border-width: root.c ? 1px : 0px; border-color: Theme.red;
    background: root.c ? Theme.red-dim : transparent;
    if !root.c: AccentFill { width: parent.width; height: parent.height; }
    lay := HorizontalLayout {
        alignment: center;
        spacing: Theme.sp-6;
        padding-left: Theme.sp-12; padding-right: Theme.sp-12;
        Rectangle {
            y: (parent.height - self.height) / 2; width: Theme.sp-6 + 1px; height: self.width;
            border-radius: self.width / 2; background: root.ink;
            // (On for the first half of each blink.)
            property <bool> lit: mod(animation-tick() / Theme.rec-blink, 1) * 2 < 1;
            opacity: self.lit ? 1 : Theme.o-dim;
        }
        HorizontalLayout {
            spacing: Theme.sp-2;
            for b in [VoiceUi.b0, VoiceUi.b1, VoiceUi.b2, VoiceUi.b3, VoiceUi.b4]: Rectangle {
                y: (parent.height - self.height) / 2; width: Theme.sp-2 + 1px; height: b;
                border-radius: Theme.r-chip / 2; background: root.ink;
            }
        }
        Text { vertical-alignment: center; text: VoiceUi.time; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold; color: root.ink; }
        Text { min-width: 0; overflow: elide; vertical-alignment: center; text: VoiceUi.status; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-medium; color: root.ink; }
    }
}

/// The cancel × (.cc-rec-x, 2.24): a control square; hover (or a hold over
/// it) solid red with a white ✕; a hold over it also grows it.
component CancelX inherits Rectangle {
    callback clicked();
    width: Theme.control; height: Theme.control;
    property <bool> hot: VoiceUi.cancelling;
    property <bool> lit: ta.has-hover || root.hot;
    // Where it is, for the hold's slide (VoiceUi).
    property <length> ax: self.absolute-position.x;
    property <length> ay: self.absolute-position.y;
    changed ax => { VoiceUi.x-x = self.ax; }
    changed ay => { VoiceUi.x-y = self.ay; }
    init => { VoiceUi.x-x = self.ax; VoiceUi.x-y = self.ay; }
    Rectangle {
        x: root.hot ? -Theme.sp-2 : 0; y: self.x; width: parent.width - 2 * self.x; height: self.width;
        border-radius: Theme.r-control; border-width: 1px;
        border-color: root.lit ? Theme.red : Theme.border;
        background: root.lit ? Theme.red : Theme.bg-primary;
        Icon { source: Icons.x; width: Theme.icon-lg; height: Theme.icon-lg; tint: root.lit ? Theme.white : Theme.text-secondary; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Tip { on: parent.has-hover; text: "Cancel: drop what was heard (when holding, slide here and let go)"; }
    }
}

/// The box while recording (2.24): read only, accent-dim on an accent edge,
/// the words heard (or "Listening…", italic), growing to composer-max and
/// following the newest words.
component RecBox inherits Rectangle {
    in property <float> fs: 1;
    in property <string> text;
    changed width => { VoiceUi.box-w = self.width; }
    init => { VoiceUi.box-w = self.width; }
    property <length> want: rt.preferred-height + 2 * Theme.sp-8 + Theme.sp-2;
    height: max(Theme.control, min(Theme.composer-max, self.want));
    border-radius: Theme.r-control; border-width: 1px; border-color: Theme.accent;
    background: Theme.accent-dim;
    fl := Flickable {
        x: Theme.sp-10; y: Theme.sp-8 + 1px; width: parent.width - 2 * Theme.sp-10; height: parent.height - 2 * Theme.sp-8 - Theme.sp-2;
        content-height: max(self.height, rt.preferred-height);
        property <length> ch: rt.preferred-height;
        changed ch => { self.content-y = min(0px, self.height - self.ch); }
        rt := Text { width: fl.width; text: root.text; wrap: word-wrap; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; }
    }
    if root.text == "": Text {
        x: Theme.sp-10; y: Theme.sp-8 + 1px; text: "Listening…"; font-italic: true;
        font-size: Theme.text-13 * root.fs; color: Theme.text-secondary;
    }
}

/// The voice line above the box (.cc-vline, 2.24): a dot (speaking sky;
/// a note or paused for another chat yellow; none for an error), the text
/// (an error red; "Speaking…"/"Paused" italic muted). A click goes to the
/// app (it stops a reply being said).
component VoiceLine inherits Rectangle {
    in property <float> fs: 1;
    in property <string> kind;
    in property <string> text;
    callback clicked();
    height: lay.preferred-height;
    lay := HorizontalLayout {
        spacing: Theme.sp-6;
        padding-left: Theme.sp-2; padding-right: Theme.sp-2;
        if root.kind != "error": Rectangle {
            y: (parent.height - self.height) / 2; width: Theme.sp-8; height: Theme.sp-8; border-radius: Theme.sp-4;
            background: root.kind == "speaking" || root.kind == "paused" ? Theme.sky : Theme.yellow;
        }
        Text {
            horizontal-stretch: 1; overflow: elide; vertical-alignment: center;
            text: root.text; font-size: Theme.text-12 * root.fs;
            font-italic: root.kind == "speaking" || root.kind == "paused";
            color: root.kind == "error" ? Theme.red : root.kind == "speaking" || root.kind == "paused" ? Theme.text-muted : Theme.text-secondary;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}


/// A permission mode's look (the mode button, the picker's tiles): its
/// icon and its colour, as the web chat's.
export global ModeLook {
    public pure function ink(key: string) -> color {
        return key == "acceptEdits" || key == "auto" ? Theme.accent-hover
            : key == "plan" ? Theme.sky
            : key == "dontAsk" ? Theme.yellow
            : key == "bypassPermissions" ? Theme.red
            : Theme.text-secondary;
    }
    public pure function icon(key: string) -> image {
        return key == "acceptEdits" ? Icons.mode-accept-edits : key == "auto" ? Icons.mode-auto
            : key == "plan" ? Icons.mode-plan : key == "dontAsk" ? Icons.mode-dont-ask
            : key == "bypassPermissions" ? Icons.mode-bypass-permissions : Icons.mode-default;
    }
}

/// The permission mode (.cc-mode): its icon and name in the mode's colour
/// (narrow: the icon only, finger-sized). Plan mode and Bypass all wear a
/// tinted border, which hover keeps. A click opens the picker (2.6).
component ModeBtn inherits Rectangle {
    in property <float> fs: 1;
    in property <string> mode-key;
    in property <string> name;
    in property <bool> icon-only;
    callback clicked();
    property <bool> own-edge: root.mode-key == "plan" || root.mode-key == "bypassPermissions";
    property <color> ink: root.mode-key == "default" || root.mode-key == "" ? (ta.has-hover ? Theme.text-primary : Theme.text-secondary) : ModeLook.ink(root.mode-key);
    height: root.icon-only ? Theme.control-sm * root.fs : Theme.sp-24 * root.fs;
    width: root.icon-only ? Theme.control * root.fs : max(Theme.control-sm * root.fs, row.preferred-width + 2 * Theme.sp-6);
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.mode-key == "plan" ? Theme.sky-edge : root.mode-key == "bypassPermissions" ? Theme.error-edge : ta.has-hover ? Theme.accent : Theme.border;
    background: Theme.bg-primary;
    row := HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        width: self.preferred-width;
        spacing: Theme.sp-4;
        Icon {
            y: (parent.height - self.height) / 2;
            width: Theme.icon-md * root.fs; height: Theme.icon-md * root.fs; tint: root.ink;
            source: ModeLook.icon(root.mode-key);
        }
        if !root.icon-only: Text { text: root.name; font-size: Theme.text-11 * root.fs; color: root.ink; vertical-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Tip { on: parent.has-hover; text: "Permission mode: " + root.name + ". Click to change."; }
    }
}

/// Which key sends (.cc-sw): a pill holding ⏎ and ⌃⏎, a thumb under the live
/// one, then "sends". A click swaps them.
component EnterSwitch inherits Rectangle {
    in property <float> fs: 1;
    in property <bool> ctrl;
    callback toggle();
    property <length> w1: g1.preferred-width + 2 * Theme.sp-8;
    property <length> w2: g2.preferred-width + 2 * Theme.sp-8;
    property <length> cell-h: g1.preferred-height + 2 * Theme.sp-2;
    width: self.w1 + self.w2 + 2 * Theme.sp-2 + Theme.sp-4 + sends.preferred-width;
    height: self.cell-h + 2 * Theme.sp-2;
    g1 := Text { visible: false; text: "⏎"; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold; }
    g2 := Text { visible: false; text: "⌃⏎"; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold; }
    Rectangle {
        x: 0; width: root.w1 + root.w2 + 2 * Theme.sp-2;
        border-radius: Theme.r-pill;
        background: Theme.bg-tertiary;
        Rectangle {
            x: Theme.sp-2 + (root.ctrl ? root.w1 : 0px); y: Theme.sp-2;
            width: root.ctrl ? root.w2 : root.w1; height: root.cell-h;
            animate x, width { duration: Theme.motion; }
            border-radius: Theme.r-pill; border-width: 1px; border-color: Theme.accent;
            background: Theme.accent-dim;
        }
        Text {
            x: Theme.sp-2; width: root.w1; height: parent.height; horizontal-alignment: center; vertical-alignment: center;
            text: "⏎"; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold;
            color: root.ctrl ? Theme.text-secondary : Theme.accent-hover; opacity: root.ctrl ? Theme.o-dim : 1;
        }
        Text {
            x: Theme.sp-2 + root.w1; width: root.w2; height: parent.height; horizontal-alignment: center; vertical-alignment: center;
            text: "⌃⏎"; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold;
            color: root.ctrl ? Theme.accent-hover : Theme.text-secondary; opacity: root.ctrl ? 1 : Theme.o-dim;
        }
    }
    sends := Text {
        x: root.w1 + root.w2 + 2 * Theme.sp-2 + Theme.sp-4; height: parent.height; vertical-alignment: center;
        text: "sends"; font-size: Theme.text-11 * root.fs; color: ta.has-hover ? Theme.text-primary : Theme.text-secondary;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
        Tip { on: parent.has-hover; text: root.ctrl ? "Enter makes a newline, Ctrl+Enter sends — click to swap" : "Enter sends, Shift+Enter makes a newline — click to swap"; }
    }
}

/// A scheduled message in the panel's list (src/sched.rs when_label).
export struct SchedItem { id: string, when: string, text: string, next: bool }

/// A trigger button: one of three; on: accent-dim, accent edge, text-primary;
/// disabled: dim, inert, its reason as the tooltip.
component TrigBtn inherits Rectangle {
    in property <float> fs: 1;
    in property <string> label;
    in property <bool> on;
    in property <bool> disabled;
    in property <string> tip;
    callback clicked();
    height: Theme.control-sm;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.on ? Theme.accent : Theme.border;
    background: root.on ? Theme.accent-dim : Theme.bg-secondary;
    opacity: root.disabled ? Theme.o-dim : 1;
    Text { text: root.label; font-size: Theme.text-12 * root.fs; color: root.on ? Theme.text-primary : Theme.text-secondary; }
    ta := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? MouseCursor.default : MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    // (A disabled button takes no hover, so its tooltip rides its own area.)
    if root.tip != "": TouchArea { Tip { on: parent.has-hover; text: root.tip; } }
}

/// One scheduled message: when (and "next ·" for the first, its edge accent),
/// its text cut at sched-rows rows, ✕ in the corner.
component SchedRow inherits Rectangle {
    in property <float> fs: 1;
    in property <SchedItem> it;
    callback delete();
    property <length> line: lm.preferred-height;
    height: col.preferred-height;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.it.next ? Theme.accent : Theme.border-subtle;
    background: Theme.bg-secondary;
    lm := Text { visible: false; text: "X"; font-size: Theme.text-12 * root.fs; line-height-factor: Theme.lh-chat; }
    full := Text { visible: false; width: col.width - Theme.sp-10 - Theme.sp-24; text: root.it.text; font-size: Theme.text-12 * root.fs; wrap: word-wrap; line-height-factor: Theme.lh-chat; }
    col := VerticalLayout {
        padding-top: Theme.sp-6; padding-bottom: Theme.sp-6; padding-left: Theme.sp-10; padding-right: Theme.sp-24;
        spacing: Theme.sp-2;
        HorizontalLayout {
            alignment: start;
            if root.it.next: Text { text: "next"; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-bold; color: Theme.accent-hover; }
            if root.it.next: Text { text: " · "; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; }
            Text { text: root.it.when; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; }
        }
        // At most sched-rows rows, cut there (no ellipsis, as the web).
        Rectangle {
            height: min(full.preferred-height, Theme.sched-rows * root.line);
            clip: true;
            Text { y: 0; width: parent.width; text: root.it.text; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; wrap: word-wrap; line-height-factor: Theme.lh-chat; }
        }
    }
    Rectangle {
        x: parent.width - Theme.sp-4 - self.width; y: Theme.sp-4;
        width: Theme.icon-sm + Theme.sp-8; height: Theme.icon-sm + Theme.sp-4;
        Icon { source: Icons.x; width: Theme.icon-sm; height: Theme.icon-sm; tint: xa.has-hover ? Theme.red : Theme.text-muted; }
        xa := TouchArea { mouse-cursor: pointer; clicked => { root.delete(); } Tip { on: parent.has-hover; text: "Cancel this message"; } }
    }
}

/// The schedule panel (.cc-schedpanel, 2.10): over the bottom of the chat, not
/// modal; a fixed head ("Schedule a message", ×), then the form and the list
/// scrolling as one. The app (src/app.rs) holds its state; this draws it and
/// hands back what is typed.
component SchedPanel inherits Rectangle {
    in property <string> key;
    in property <float> fs: 1;
    in property <string> text-in;
    in property <int> text-gen;
    in property <string> trigger;
    in property <string> at-in;
    in property <int> at-gen;
    in property <string> note;
    in property <[SchedItem]> items;
    in property <bool> limit-off;
    in property <string> list;
    in property <bool> unsupported;
    // The tallest it may grow (a share of the chat).
    in property <length> max-h;
    property <string> text;
    property <string> at;
    property <Date> pick-date;
    property <length> line: Theme.text-13 * root.fs * Theme.line-chat;
    // The box takes the focus with the caret after the carried text.
    init => { root.text = root.text-in; root.at = root.at-in; msg.focus(); msg.select-all(); msg.clear-selection(); }
    changed text-gen => { root.text = root.text-in; }
    changed at-gen => { root.at = root.at-in; }
    changed text => { Composer.sched-text(root.key, root.text); }
    changed at => { Composer.sched-at(root.key, root.at); }
    height: min(head.preferred-height + 1px + body.preferred-height + Theme.sp-2, root.max-h);
    SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-card; shadow: Theme.shadow-menu; }
    Rectangle { background: Theme.bg-primary; border-radius: Theme.r-card; border-width: 1px; border-color: Theme.border; }
    // Clicks inside stay here (the panel is over the composer).
    TouchArea { }
    // Where the focus goes from the message box when a trigger or Schedule
    // is clicked (a button takes it in the web).
    sink := FocusScope { width: 0; height: 0; }
    head := HorizontalLayout {
        x: 1px; y: 1px; width: parent.width - Theme.sp-2; height: self.preferred-height;
        padding-top: Theme.sp-8; padding-bottom: Theme.sp-8; padding-left: Theme.sp-10; padding-right: Theme.sp-10;
        Text { horizontal-stretch: 1; vertical-alignment: center; text: "Schedule a message"; font-size: Theme.text-13 * root.fs; font-weight: Theme.w-semibold; color: Theme.text-primary; }
        Rectangle {
            width: Theme.icon-md + Theme.sp-8; height: Theme.icon-md + Theme.sp-4;
            Icon { source: Icons.x; width: Theme.icon-md; height: Theme.icon-md; tint: xh.has-hover ? Theme.text-primary : Theme.text-muted; }
            xh := TouchArea { mouse-cursor: pointer; clicked => { Composer.sched-close(root.key); } }
        }
    }
    // The date, then the time (Slint's std popups; PLAN.md, Known gaps).
    dp := DatePickerPopup {
        accepted(d) => { root.pick-date = d; dp.close(); tp.show(); }
        canceled => { dp.close(); }
    }
    tp := TimePickerPopup {
        accepted(t) => { tp.close(); Composer.sched-pick(root.key, root.pick-date.year, root.pick-date.month, root.pick-date.day, t.hour, t.minute); }
        canceled => { tp.close(); }
    }
    Rectangle { x: 1px; y: head.y + head.height; width: parent.width - Theme.sp-2; height: 1px; background: Theme.border-subtle; }
    fl := RevealFlickable {
        x: 1px; y: head.y + head.height + 1px;
        width: parent.width - Theme.sp-2; height: parent.height - self.y - 1px;
        content-height: body.preferred-height;
        body := VerticalLayout {
            width: fl.width;
            padding: Theme.sp-10;
            spacing: Theme.sp-8;
            // The message: sched-rows rows (the composer's field look, 2.5).
            Rectangle {
                height: Theme.sched-rows * root.line + 2 * Theme.sp-8;
                if msg.has-focus: Rectangle {
                    x: -Theme.sp-4; y: -Theme.sp-4; width: parent.width + 2 * Theme.sp-4; height: parent.height + 2 * Theme.sp-4;
                    border-radius: Theme.r-card; background: Theme.accent-ring;
                }
                Rectangle {
                    border-radius: Theme.r-control; border-width: 1px;
                    border-color: msg.has-focus ? Theme.accent : Theme.border;
                    background: Theme.bg-secondary;
                }
                mf := Flickable {
                    x: Theme.sp-8; y: Theme.sp-8; width: parent.width - 2 * Theme.sp-8; height: parent.height - 2 * Theme.sp-8;
                    content-height: max(self.height, msg.preferred-height);
                    msg := TextInput {
                        width: mf.width; height: max(mf.height, self.preferred-height);
                        text <=> root.text;
                        single-line: false; wrap: word-wrap;
                        line-height-factor: Theme.lh-chat;
                        font-size: Theme.text-13 * root.fs; color: Theme.text-primary;
                        selection-background-color: Theme.accent-dim;
                        cursor-position-changed(at) => {
                            if at.y + mf.content-y < 0 { mf.content-y = -at.y; }
                            else if at.y + root.line + mf.content-y > mf.height { mf.content-y = min(0px, mf.height - at.y - root.line); }
                        }
                    }
                }
                if root.text == "": Text {
                    x: Theme.sp-8; y: Theme.sp-8;
                    text: "Message to send later…"; font-size: Theme.text-13 * root.fs; color: Theme.text-muted;
                }
            }
            HorizontalLayout {
                spacing: Theme.sp-6;
                TrigBtn { horizontal-stretch: 1; fs: root.fs; label: "At a time"; on: root.trigger == "time"; clicked => { sink.focus(); Composer.sched-trigger(root.key, "time"); } }
                TrigBtn { horizontal-stretch: 1; fs: root.fs; label: "Turn ends"; on: root.trigger == "turn-end"; clicked => { sink.focus(); Composer.sched-trigger(root.key, "turn-end"); } }
                TrigBtn {
                    horizontal-stretch: 1; fs: root.fs; label: "Limit resets"; on: root.trigger == "limit-reset";
                    disabled: root.limit-off; tip: root.limit-off ? "Needs the limit warmer, which is off" : "";
                    clicked => { sink.focus(); Composer.sched-trigger(root.key, "limit-reset"); }
                }
            }
            // The time: typed, or picked (a date, then a time: Slint's std
            // popups; PLAN.md, Known gaps).
            if root.trigger == "time": Rectangle {
                height: Theme.control-lg;
                border-radius: Theme.r-control; border-width: 1px;
                border-color: atin.has-focus ? Theme.accent : Theme.border;
                background: Theme.bg-secondary;
                atin := TextInput {
                    x: Theme.sp-8; width: parent.width - Theme.sp-8 - Theme.sp-32;
                    vertical-alignment: center; single-line: true;
                    text <=> root.at;
                    font-size: Theme.text-13 * root.fs; color: Theme.text-primary;
                }
                // Empty: the format to type (as the web's datetime-local shows).
                if root.at == "": Text {
                    x: Theme.sp-8; height: parent.height; vertical-alignment: center;
                    text: "mm/dd/yyyy, --:-- --"; font-size: Theme.text-13 * root.fs; color: Theme.text-muted;
                }
                Rectangle {
                    x: parent.width - Theme.sp-32; width: Theme.sp-32;
                    Icon { source: Icons.calendar; width: Theme.icon-md; height: Theme.icon-md; tint: ca.has-hover ? Theme.text-primary : Theme.text-muted; }
                    ca := TouchArea { mouse-cursor: pointer; clicked => { dp.show(); } }
                }
            }
            if root.note != "": Text { text: root.note; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; wrap: word-wrap; }
            SendBtn {
                fs: root.fs; label: "Schedule";
                height: Theme.control-sm;
                opacity: root.unsupported ? Theme.o-dim : 1;
                clicked => { sink.focus(); if !root.unsupported { Composer.sched-save(root.key); } }
            }
            // The list: a hairline, then this chat's messages to come.
            Rectangle { height: 1px; background: Theme.border-subtle; }
            VerticalLayout {
                spacing: Theme.sp-6;
                if root.list != "": Text { text: root.list; font-size: Theme.text-12 * root.fs; font-italic: true; color: Theme.text-muted; wrap: word-wrap; }
                for it in root.items: SchedRow { fs: root.fs; it: it; delete => { Composer.sched-delete(root.key, it.id); } }
            }
        }
    }
}

/// The chat inside a pane: the log, then the composer (specs/composer.md).
export component ChatPane inherits Rectangle {
    // The pane's full-screen copy (main.slint); a copy under another chat
    // in full screen is covered: the wheel there is not its (F131).
    in property <bool> in-full;
    property <bool> covered: FrameUi.full-key != "" && !root.in-full;
    // Voice input (2.24): the mic shows (the server can listen); the voice
    // line's kind (error | note | away | speaking | paused) and text.
    in property <bool> mic;
    in property <string> vline-kind;
    in property <string> vline-text;
    property <bool> rec: VoiceUi.key == root.key && VoiceUi.key != "" && VoiceUi.away-key != root.key;
    // Send's width (its label at the pane's size): the strip's least (F127).
    send-m := Text { visible: false; text: root.busy ? "Queue" : "Send"; font-size: Theme.text-12 * root.fs; font-weight: Theme.w-semibold; }
    property <string> mic-tip: VoiceUi.speaking && VoiceUi.key == root.key ? "Pause what Claude is saying"
        : root.rec && VoiceUi.hold && VoiceUi.cancelling ? "Let go to cancel"
        : root.rec && VoiceUi.hold ? "Let go to send (slide to cancel to drop it)"
        : root.rec ? (VoiceUi.text != "" ? "Send what was heard now" : "Voice mode is on: tap to turn it off")
        : "Voice input (tap: voice mode, hold: push to talk)";
    // The pane's key (src/app.rs), for the shared controls (Composer).
    in property <string> key;
    // The pane's text size, a scale of the base size (the web's --cc-fs).
    in property <float> fs: 1;
    in property <[EntryView]> entries;
    // idle | working | needs-input | waiting | exited
    in property <string> state;
    // The permission mode: its key and its name.
    in property <string> mode-key;
    in property <string> mode;
    // Claude's session id: the first 8 characters, and the whole.
    in property <string> session;
    in property <string> session-full;
    in property <string> model;
    in property <string> cost;
    in property <string> error;
    // Narrower than composer-stack: the composer stacks.
    in property <bool> narrow;
    // Stop was clicked once (src/app.rs disarms it after 3 s).
    in property <bool> stop-armed;
    // Uploading (2.7): the bar (shown, the file's name, "42%" or "saving",
    // the share sent) and attach busy; a file dragged over the chat.
    in property <bool> up-on;
    in property <string> up-name;
    in property <string> up-label;
    in property <float> up-frac;
    in property <bool> up-busy;
    in property <bool> file-over;
    // Queued messages (2.9): the held lines (joined) and how many sends; the
    // handed-over ones (joined) and what their drawer says.
    in property <string> q-held;
    in property <int> q-held-n;
    in property <string> q-sent;
    in property <string> q-sent-kind;
    // The schedule panel (2.10): open, the form (text, trigger, time, each
    // with a count of the app's changes), the note, the list.
    in property <bool> s-open;
    in property <string> s-text;
    in property <int> s-text-gen;
    in property <string> s-trigger;
    in property <string> s-at;
    in property <int> s-at-gen;
    in property <string> s-note;
    in property <[SchedItem]> s-items;
    in property <bool> s-limit-off;
    in property <string> s-list;
    in property <bool> s-unsupported;
    // The slash menu (2.11): open, its items, the selected one.
    in property <bool> slash-open;
    in property <[SlashItem]> slash-items;
    in property <int> slash-sel;
    // The box losing focus closes it a moment later (a press on an item lands first).
    property <bool> box-focus: ib.focused;
    changed box-focus => { if !self.box-focus && root.slash-open { blur-close.running = true; } }
    blur-close := Timer { interval: Theme.motion-fast; running: false; triggered => { self.running = false; if !ib.focused { Composer.slash-close(root.key); } } }
    callback send(string);
    callback stop();
    callback respond(string, string, bool);
    callback answer(string, string);
    // The draft as the app holds it (src/app.rs): taken at start and whenever
    // the app changed it (another view of this chat, a send, a refused send);
    // every change is handed back.
    in property <string> saved-draft;
    callback draft-changed(string);
    property <string> draft;
    init => { self.draft = root.saved-draft; }
    changed saved-draft => { if self.draft != root.saved-draft { self.draft = root.saved-draft; } }
    in property <int> draft-gen;
    changed draft-gen => { self.draft = root.saved-draft; }
    changed draft => { root.draft-changed(self.draft); }
    // Following the newest message (2.16, the web's one model): `stick` is
    // true only while the reader is at the bottom. Any scroll of theirs away
    // from it (a wheel notch, a drag, a key) turns it off at once; coming
    // back within stick-within turns it on. While it is on, ANY change of
    // the content's or the view's size (an arrival, a block folding or
    // opening, rewrapping at a new width, the list's estimate settling)
    // keeps the bottom pinned. Off, nothing moves the log.
    property <bool> stick: true;
    in property <int> content-gen;
    // The dock (2.17).
    in property <string> sug-text;
    in property <string> recap-text;
    in property <string> recap-caption;
    // The agent dock (2.18).
    in property <int> ag-n; in property <bool> ag-run; in property <string> ag-tip;
    in property <int> cmd-n; in property <bool> cmd-run; in property <string> cmd-tip;
    in property <string> sheet; in property <string> sheet-title; in property <string> sheet-sub; in property <string> sheet-back;
    in property <[AgentRow]> sheet-rows;
    in property <string> panel-prompt; in property <styled-text> panel-summary; in property <bool> panel-has-summary;
    in property <[EntryView]> panel-entries; in property <string> panel-empty;
    property <bool> badges-on: root.ag-n > 0 || root.cmd-n > 0;
    // The agent panel follows its end (F113); reset when a panel opens.
    property <bool> pfollow: true;
    changed sheet => { if root.sheet == "panel" { root.pfollow = true; } }
    // The goal and the plan (2.19).
    in property <bool> goal-on; in property <string> goal-cond; in property <string> goal-count;
    in property <bool> goal-looping; in property <bool> goal-stopped;
    in property <string> plan-status; in property <bool> plan-open; in property <string> plan-state;
    in property <[AnsBlock]> plan-blocks;
    property <bool> dock-on: root.sug-text != "" || root.recap-text != "" || root.badges-on;
    // A suggestion or a recap appearing while following keeps the end in view.
    changed dock-on => { if root.stick { root.to-bottom(); } }
    // How far the view is from the end, and past it (a blank band).
    property <length> max-y: min(0px, list.visible-height - list.content-height);
    property <length> dist: max(0px, list.content-height + list.content-y - list.visible-height);
    property <length> over: max(0px, list.visible-height - list.content-height - list.content-y);
    property <length> last-dist;
    function to-bottom() { list.content-y = root.max-y; root.last-dist = 0px; }
    property <length> pin-h: list.content-height;
    changed pin-h => { if root.stick { root.to-bottom(); } }
    property <length> pin-vh: list.visible-height;
    changed pin-vh => { if root.stick { root.to-bottom(); } }
    property <length> pin-vw: list.visible-width;
    changed pin-vw => { if root.stick { root.to-bottom(); } }
    changed content-gen => {
        if root.stick { root.to-bottom(); }
        else { root.jump-new = true; }
    }
    // A wheel step up over this log (seen before Slint scrolls, src/main.rs):
    // following stops at once, whatever the scroll's own animation does.
    property <int> wheel-up: Pointer.wheel-up;
    changed wheel-up => {
        if !root.covered && Pointer.x >= list.absolute-position.x && Pointer.x < list.absolute-position.x + list.width
            && Pointer.y >= list.absolute-position.y && Pointer.y < list.absolute-position.y + list.height {
            root.stick = false; glide.running = false; root.last-dist = root.dist;
        }
    }
    // Reaching the very end by scrolling down follows again (an animated
    // scroll ends with no `scrolled` of its own).
    property <length> prev-dist;
    changed dist => {
        if !root.stick && root.dist < 1px && root.prev-dist >= 1px && !glide.running { root.stick = true; root.jump-new = false; }
        root.prev-dist = root.dist;
    }
    // The jump button: past the larger of jump-at and a third of the log;
    // new content below while reading up gives it a dot.
    property <bool> jump-on: root.dist > max(Theme.jump-at, list.visible-height * Theme.jump-share);
    property <bool> jump-new;
    // For the test driver (LogProbe), when watched.
    property <bool> watched: LogProbe.watch == root.key;
    property <string> probe: root.watched ? root.dist / 1px + "|" + root.over / 1px + "|" + (root.stick ? "s" : "") + "|" + (root.jump-on ? "j" : "") + "|" + (root.jump-new ? "n" : "") : "";
    changed probe => { if root.watched { LogProbe.dist = root.dist; LogProbe.over = root.over; LogProbe.stick = root.stick; LogProbe.jump = root.jump-on; LogProbe.jump-new = root.jump-new; } }
    // Its click: down to the end (exactly the last scroll position) in eased
    // frames; it stops there, or after its frames, or when the reader scrolls.
    property <int> glide-n;
    glide := Timer {
        interval: Theme.frame; running: false;
        triggered => {
            root.glide-n += 1;
            if abs(list.content-y - root.max-y) < Theme.sp-2 || root.glide-n >= Theme.glide-frames {
                root.stick = true; root.to-bottom(); self.running = false;
            } else {
                list.content-y = list.content-y + (root.max-y - list.content-y) / 2;
            }
        }
    }
    property <bool> exited: root.state == "exited";
    property <bool> busy: root.state == "working" || root.state == "needs-input";
    // The app put text in this pane's box (an attached path).
    property <int> insert-gen: Composer.insert-gen;
    changed insert-gen => { if Composer.insert-key == root.key { ib.put(Composer.insert-text, Composer.insert-caret, Composer.insert-focus); } }
    // The app asks for this pane's box to take the focus.
    property <int> focus-gen: Composer.focus-gen;
    changed focus-gen => { if Composer.focus-key == root.key { ib.focus-box(); } }
    function do-send() {
        root.stick = true;
        root.to-bottom();
        root.send(root.draft);
    }
    background: Theme.bg-primary;

    VerticalLayout {
        list := ListView {
            vertical-stretch: 1;
            for e[i] in root.entries: HorizontalLayout {
                padding-left: Theme.sp-12;
                padding-right: Theme.sp-12;
                // Room under the newest entry for the dock (the suggestion
                // and, unlike the web, the recap too: a named difference).
                padding-bottom: i == root.entries.length - 1 && root.dock-on ? dock.height + Theme.sp-12 : 0px;
                EntryRow {
                    e: e;
                    fs: root.fs;
                    avail: list.visible-width - Theme.sp-24;
                    respond(id, b, a) => { root.respond(id, b, a); }
                    answer(id, o) => { root.answer(id, o); }
                }
            }
            // The reader's own scroll: away from the bottom turns following
            // off at once; back within stick-within turns it on.
            scrolled => {
                glide.running = false;
                // Down toward the end (or a drag there) follows again; up
                // never does (a wheel step up is caught above).
                if root.dist < Theme.stick-within && root.dist < root.last-dist { root.stick = true; root.jump-new = false; }
                else if root.dist > root.last-dist { root.stick = false; }
                root.last-dist = root.dist;
            }
        }
        if root.error != "": Rectangle {
            background: Theme.red-dim;
            height: errt.preferred-height + Theme.sp-10;
            errt := Text { x: Theme.sp-12; width: parent.width - Theme.sp-24; text: root.error; color: Theme.error-text; wrap: word-wrap; font-size: Theme.text-11 * root.fs; }
        }
        // The goal bar (2.19): between the log and the composer.
        if root.goal-on: Rectangle {
            height: gb.preferred-height;
            background: Theme.accent-dim;
            Rectangle { y: 0; height: 1px; background: Theme.border-subtle; }
            gb := VerticalLayout {
                padding-top: Theme.sp-6; padding-bottom: Theme.sp-6; padding-left: Theme.sp-10; padding-right: Theme.sp-10;
                spacing: Theme.sp-4;
                HorizontalLayout {
                    spacing: Theme.sp-8;
                    HorizontalLayout {
                        spacing: Theme.sp-4;
                        if root.goal-looping: StatusMark { running: true; }
                        Text { vertical-alignment: center; text: "GOAL"; font-family: Theme.mono; font-size: Theme.text-10 * root.fs; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide; color: Theme.accent-hover; }
                    }
                    Text { vertical-alignment: center; text: root.goal-cond; font-size: Theme.text-12 * root.fs; color: Theme.text-primary; overflow: elide; horizontal-stretch: 1; min-width: 0; }
                    Text { vertical-alignment: center; text: root.goal-count; font-family: Theme.mono; font-size: Theme.text-10 * root.fs; color: Theme.text-muted; }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: gct.preferred-width + Theme.sp-12 + Theme.sp-2; height: gct.preferred-height + Theme.sp-2;
                        border-radius: Theme.r-control; border-width: 1px; border-color: gca.has-hover ? Theme.red : Theme.border;
                        gct := Text { text: "clear"; font-size: Theme.text-11 * root.fs; color: gca.has-hover ? Theme.red : Theme.text-muted; }
                        gca := TouchArea { mouse-cursor: pointer; clicked => { ToolAct.goal-clear(root.key); } Tip { on: parent.has-hover; text: "Stop working towards this goal (/goal clear)"; } }
                    }
                }
                if root.goal-stopped: Text { text: "The goal loop has stopped. Send /goal to ask for its current verdict."; font-size: Theme.text-12 * root.fs; color: Theme.text-muted; wrap: word-wrap; }
            }
        }
        // The composer: bg-secondary, a line above.
        Rectangle {
            background: Theme.bg-secondary;
            height: comp.preferred-height;
            // Along its top edge (a hairline with no y would be centred).
            Rectangle { y: 0; height: 1px; background: Theme.border; }
            comp := VerticalLayout {
                padding: Theme.sp-8;
                spacing: Theme.sp-6;
                // The drawers (2.9): handed over on top, held under it.
                if root.q-sent != "": QueueDrawer {
                    fs: root.fs; sent: true;
                    recallable: root.q-sent-kind == "recallable";
                    label: root.q-sent-kind == "recallable" ? "SENDING" : "SENT";
                    note: root.q-sent-kind == "recallable" ? "not read yet" : root.q-sent-kind == "started" ? "Claude is reading it" : "waiting for Claude to pick it up";
                    hint: root.q-sent-kind == "recallable" ? "Click or press ↑ to take it back" : root.q-sent-kind == "started" ? "Claude is reading this one — too late to edit" : "Waiting for the session to confirm";
                    tip: root.q-sent-kind == "recallable" ? "Click to edit — brings it back to the message box" : "Claude has this one; it joins the conversation as it is read";
                    body: root.q-sent;
                    clicked => { Composer.take-back(root.key); }
                }
                if root.q-held != "": QueueDrawer {
                    fs: root.fs; sent: false; recallable: true;
                    label: "SENDING";
                    note: root.q-held-n + (root.q-held-n == 1 ? " line" : " lines") + " · as one message, at the next tool call";
                    hint: "Click or press ↑ to take it back";
                    tip: "Click to edit — brings every queued line back to the message box";
                    body: root.q-held;
                    clicked => { Composer.take-back(root.key); }
                }
                // The voice line (2.24): above the box.
                if root.vline-kind != "": VoiceLine {
                    fs: root.fs; kind: root.vline-kind; text: root.vline-text;
                    clicked => { Composer.vline-click(root.key); }
                }
                // The box; wide, the buttons beside it on its bottom line.
                boxrow := HorizontalLayout {
                    spacing: Theme.sp-8;
                    // Recording (2.24): the words heard, in the box's place;
                    // the draft waits under it and comes back after.
                    Rectangle {
                    horizontal-stretch: 1;
                    height: root.rec ? rb.height : ib.height;
                    rb := RecBox { y: 0; width: parent.width; visible: root.rec; fs: root.fs; text: VoiceUi.text; }
                    ib := InputBox {
                        visible: !root.rec;
                        y: 0; width: parent.width;
                        slash-open: root.slash-open;
                        slash-move(by) => { Composer.slash-move(root.key, by); }
                        slash-choose => { Composer.slash-choose(root.key, -1); }
                        slash-close => { Composer.slash-close(root.key); }
                        horizontal-stretch: 1;
                        fs: root.fs;
                        draft <=> root.draft;
                        ctrl-enter: Composer.ctrl-enter;
                        enabled: !root.exited;
                        placeholder: root.exited ? "Session ended." : root.narrow ? "Message Claude…"
                            : Composer.ctrl-enter ? "Message Claude…  (Ctrl+Enter to send, Enter for newline)"
                            : "Message Claude…  (Enter to send, Shift+Enter for newline)";
                        send => { root.do-send(); }
                        caret(c, a) => { Composer.caret(root.key, c, a); }
                        up => { return Composer.take-back(root.key); }
                        paste(si) => { return Composer.paste(root.key, si); }
                    }
                    }
                    if !root.narrow: VerticalLayout {
                        alignment: end;
                        SquareBtn {
                            width: Theme.control; height: Theme.control;
                            icon: Icons.paperclip; tip: "Attach a file (uploads to crundi_attachments)";
                            busy: root.up-busy;
                            clicked => { Composer.attach(root.key); }
                        }
                    }
                    if !root.narrow && root.state == "working": VerticalLayout {
                        alignment: end;
                        StopBtn { fs: root.fs; armed: root.stop-armed; clicked => { root.stop(); } }
                    }
                    if !root.narrow && root.mic: VerticalLayout {
                        alignment: end;
                        MicBtn { key: root.key; on: root.rec; away: VoiceUi.away-key == root.key; speaking: VoiceUi.speaking; tip: root.mic-tip; }
                    }
                    if !root.narrow && !root.rec: VerticalLayout {
                        alignment: end;
                        SendBtn {
                            fs: root.fs;
                            label: root.busy ? "Queue" : "Send";
                            width: self.text-w + 2 * Theme.sp-12;
                            height: Theme.sp-12 + Theme.sp-16 * root.fs;
                            clicked => { root.do-send(); }
                        }
                    }
                    if !root.narrow && root.rec: VerticalLayout {
                        alignment: end;
                        horizontal-stretch: 0;
                        RecStrip {
                            horizontal-stretch: 0;
                            width: self.preferred-width;
                            least: send-m.preferred-width + 2 * Theme.sp-12;
                            fs: root.fs; height: Theme.sp-12 + Theme.sp-16 * root.fs;
                        }
                    }
                    if !root.narrow && root.rec: VerticalLayout {
                        alignment: end;
                        CancelX { clicked => { Composer.voice-cancel(root.key); } }
                    }
                }
                // Narrow: the buttons on their own row, Send filling the rest.
                if root.narrow: HorizontalLayout {
                    spacing: Theme.sp-8;
                    SquareBtn {
                        width: Theme.control; height: Theme.control;
                        icon: Icons.paperclip; tip: "Attach a file (uploads to crundi_attachments)";
                        busy: root.up-busy;
                        clicked => { Composer.attach(root.key); }
                    }
                    SquareBtn {
                        width: Theme.icon-lg + 2 * Theme.sp-10; height: Theme.control;
                        icon: Icons.clock; icon-size: Theme.icon-lg; ink: Theme.text-muted; fill: false;
                        tip: "Schedule this message";
                        clicked => { Composer.schedule(root.key); }
                    }
                    if root.state == "working": StopBtn { fs: root.fs; armed: root.stop-armed; clicked => { root.stop(); } }
                    if root.mic: MicBtn { key: root.key; on: root.rec; away: VoiceUi.away-key == root.key; speaking: VoiceUi.speaking; tip: root.mic-tip; }
                    if !root.rec: SendBtn {
                        horizontal-stretch: 1;
                        fs: root.fs;
                        label: root.busy ? "Queue" : "Send";
                        height: Theme.control;
                        clicked => { root.do-send(); }
                    }
                    if root.rec: RecStrip { horizontal-stretch: 1; fs: root.fs; height: Theme.control; }
                    if root.rec: CancelX { clicked => { Composer.voice-cancel(root.key); } }
                }
                // The upload bar (.cc-up), while a file uploads (and a moment
                // after): its name, the share sent, the number or "saving".
                if root.up-on: UploadStrip { name: root.up-name; frac: root.up-frac; label: root.up-label; }
                // The meta row (.cc-meta): the state, the mode, the switch (and
                // the clock), then the id, the model and the cost on the right.
                // What doesn't fit wraps to a second line, in order.
                meta := Rectangle {
                    property <length> gap: root.narrow ? Theme.sp-6 : Theme.sp-8;
                    property <length> size: (root.narrow ? Theme.text-10 : Theme.text-11) * root.fs;
                    property <length> avail: self.width - left.preferred-width;
                    property <bool> id-on: !root.narrow && root.session != "";
                    property <length> used-a: self.id-on ? self.gap + id-m.preferred-width : 0px;
                    property <bool> id-fit: !self.id-on || self.used-a <= self.avail;
                    property <length> used-b: self.used-a + (root.model != "" ? self.gap + model-m.preferred-width : 0px);
                    property <bool> model-fit: self.id-fit && (root.model == "" || self.used-b <= self.avail);
                    property <length> used-c: self.used-b + (root.cost != "" ? self.gap + cost-m.preferred-width : 0px);
                    property <bool> cost-fit: self.model-fit && (root.cost == "" || self.used-c <= self.avail);
                    property <bool> wraps: (self.id-on && !self.id-fit) || (root.model != "" && !self.model-fit) || (root.cost != "" && !self.cost-fit);
                    height: lines.preferred-height;
                    id-m := Text { visible: false; text: root.session; font-family: Theme.mono; font-size: meta.size; }
                    model-m := Text { visible: false; text: root.model; font-size: meta.size; }
                    cost-m := Text { visible: false; text: root.cost; font-size: meta.size; }
                    lines := VerticalLayout {
                        spacing: Theme.sp-4;
                        HorizontalLayout {
                            spacing: meta.gap;
                            left := HorizontalLayout {
                                horizontal-stretch: 0;
                                spacing: meta.gap;
                                Text {
                                    text: root.state == "working" ? "working…" : root.state == "needs-input" ? "needs your input" : root.exited ? "exited" : "idle";
                                    font-size: meta.size; vertical-alignment: center;
                                    color: root.busy ? Theme.accent-hover : Theme.text-muted;
                                }
                                ModeBtn {
                                    y: (parent.height - self.height) / 2;
                                    fs: root.fs; mode-key: root.mode-key; name: root.mode; icon-only: root.narrow;
                                    clicked => { Composer.mode(root.key); }
                                }
                                EnterSwitch {
                                    y: (parent.height - self.height) / 2;
                                    fs: root.fs; ctrl: Composer.ctrl-enter;
                                    toggle => { Composer.set-ctrl-enter(!Composer.ctrl-enter); ib.focus-box(); }
                                }
                                if !root.narrow: SquareBtn {
                                    y: (parent.height - self.height) / 2;
                                    width: Theme.icon-md + 2 * Theme.sp-6; height: Theme.icon-md + 2 * Theme.sp-4;
                                    icon: Icons.clock; icon-size: Theme.icon-md; ink: Theme.text-muted; fill: false;
                                    tip: "Schedule this message";
                                    clicked => { Composer.schedule(root.key); }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; min-width: 0; }
                            // The session id: the first 8 characters, a dotted
                            // line under it; a click copies the whole id.
                            if meta.id-on && meta.id-fit: sid := Rectangle {
                                width: sidt.preferred-width;
                                sidt := Text {
                                    text: root.session; font-family: Theme.mono; font-size: meta.size;
                                    color: sh.has-hover ? Theme.text-secondary : Theme.text-muted;
                                    vertical-alignment: center; height: parent.height;
                                }
                                // Slint has no dotted line: hairline dots (PLAN.md, Known gaps).
                                for i in ceil(sidt.preferred-width / Theme.sp-4): Rectangle {
                                    x: i * Theme.sp-4; y: (parent.height + sidt.preferred-height) / 2; width: Theme.sp-2; height: 1px; background: Theme.border;
                                }
                                sh := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { clip.select-all(); clip.copy(); clip.clear-selection(); Composer.copied(root.session-full); }
                                    Tip { on: parent.has-hover; text: "Claude session " + root.session-full + "  — click to copy (use it to resume this conversation)"; }
                                }
                            }
                            if root.model != "" && meta.model-fit: Text { text: root.model; font-size: meta.size; color: Theme.text-muted; vertical-alignment: center; }
                            if root.cost != "" && meta.cost-fit: Text { text: root.cost; font-size: meta.size; color: Theme.text-muted; vertical-alignment: center; }
                        }
                        if meta.wraps: HorizontalLayout {
                            spacing: meta.gap;
                            alignment: start;
                            if meta.id-on && !meta.id-fit: Text { text: root.session; font-family: Theme.mono; font-size: meta.size; color: Theme.text-muted; }
                            if root.model != "" && !meta.model-fit: Text { text: root.model; font-size: meta.size; color: Theme.text-muted; }
                            if root.cost != "" && !meta.cost-fit: Text { text: root.cost; font-size: meta.size; color: Theme.text-muted; }
                        }
                    }
                }
            }
        }
    }
    // The dock (2.17): over the log at its bottom right: the recap, then the
    // suggestion (always last), right-aligned.
    dock := VerticalLayout {
        visible: root.dock-on;
        property <length> w: min(Theme.chat-dock-w, list.width - Theme.sp-20);
        x: list.x + list.width - self.w - Theme.sp-10;
        y: list.y + list.height - self.preferred-height - Theme.sp-8;
        width: self.w;
        height: self.preferred-height;
        spacing: Theme.sp-4;
        alignment: end;
        // The badges (2.18): commands, then agents; right-aligned.
        if root.badges-on: HorizontalLayout {
            alignment: end;
            spacing: Theme.sp-6;
            if root.cmd-n > 0: AgentBadge { fs: root.fs; icon: Icons.terminal; n: root.cmd-n; run: root.cmd-run; open: root.sheet == "commands"; tip: root.cmd-tip; clicked => { ToolAct.agent-badge(root.key, true); } }
            if root.ag-n > 0: AgentBadge { fs: root.fs; icon: @image-url("shapes/bot.svg"); n: root.ag-n; run: root.ag-run; open: root.sheet == "agents"; tip: root.ag-tip; clicked => { ToolAct.agent-badge(root.key, false); } }
        }
        if root.recap-text != "": Rectangle {
            height: rl.preferred-height + Theme.sp-16;
            SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-field; shadow: Theme.shadow-menu; }
            Rectangle { border-radius: Theme.r-field; background: Theme.bg-secondary; border-width: 1px; border-color: Theme.border-subtle; }
            Rectangle { x: 0; width: Theme.sp-2 + 1px; border-top-left-radius: Theme.r-field; border-bottom-left-radius: Theme.r-field; background: Theme.accent; }
            rl := VerticalLayout {
                x: Theme.sp-12; y: Theme.sp-8; width: parent.width - Theme.sp-12 - Theme.sp-24 - Theme.sp-6;
                height: self.preferred-height;
                spacing: Theme.sp-2;
                Text { text: root.recap-caption; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold; letter-spacing: Theme.track-wide; color: Theme.text-muted; }
                Text { text: root.recap-text; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; wrap: word-wrap; line-height-factor: Theme.lh-composer; }  // (.cc-recap: 1.45)
            }
            DockX { x: parent.width - self.width - Theme.sp-4; y: Theme.sp-4; fs: root.fs; tip: "Dismiss"; clicked => { ToolAct.recap-dismiss(root.key); } }
        }
        if root.sug-text != "": VerticalLayout {
            spacing: Theme.sp-2;
            padding-top: Theme.sp-4;
            alignment: end;
            HorizontalLayout {
                alignment: end;
                padding-right: Theme.sp-4;
                Rectangle {
                    width: cap.preferred-width + Theme.sp-8; height: cap.preferred-height;
                    border-radius: Theme.r-chip; background: Theme.bg-primary;
                    cap := Text { text: "Suggested, tap to send"; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; }
                }
            }
            HorizontalLayout {
                alignment: end;
                sb := Rectangle {
                    // The hover look also while the × is hovered (it is in the bubble).
                    property <bool> on: sa.has-hover || sk.has-focus || sx.hovered;
                    width: min(dock.w, sm.preferred-width + Theme.sp-12 + Theme.sp-24 + Theme.sp-6);
                    height: st.preferred-height + Theme.sp-8 + Theme.sp-6;
                    SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-bubble; shadow: Theme.shadow-menu; }
                    Rectangle {
                        background: sb.on ? Theme.accent-dim : Theme.bg-secondary;
                        border-top-left-radius: Theme.r-bubble; border-top-right-radius: Theme.r-bubble;
                        border-bottom-left-radius: Theme.r-bubble; border-bottom-right-radius: Theme.r-chip;
                        border-width: sb.on ? 1px : 0px; border-color: Theme.sug-edge-on;
                        animate background { duration: Theme.motion-fast; }
                    }
                    if !sb.on: DashedBox { width: parent.width; height: parent.height; line: Theme.sug-edge; corner: Theme.r-bubble; square-br: true; }
                    sm := Text { visible: false; text: root.sug-text; font-size: Theme.text-13 * root.fs; }
                    st := Text {
                        x: Theme.sp-12; y: Theme.sp-8 - 1px; width: parent.width - Theme.sp-12 - Theme.sp-24 - Theme.sp-6;
                        text: root.sug-text; font-size: Theme.text-13 * root.fs; color: sb.on ? Theme.text-primary : Theme.text-secondary; wrap: word-wrap;
                    }
                    // Enter or Space sends (the web's role=button has no key:
                    // a named difference).
                    sk := FocusScope {
                        key-pressed(ev) => { if ev.text == Key.Return || ev.text == " " { ToolAct.sug-send(root.key); return accept; } reject }
                    }
                    sa := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.stick = true; root.to-bottom(); ToolAct.sug-send(root.key); }
                        Tip { on: parent.has-hover; text: "Tap to send"; }
                    }
                    sx := DockX { x: parent.width - self.width - Theme.sp-4; y: Theme.sp-4; fs: root.fs; tip: "Dismiss"; clicked => { ToolAct.sug-dismiss(root.key); } }
                }
            }
        }
    }

    // The plan panel (2.19): over the log (inset 0), under the agent sheets.
    if root.plan-open && root.plan-status != "": Rectangle {
        x: list.x; y: list.y; width: list.width; height: list.height;
        background: Theme.bg-primary;
        TouchArea { }
        VerticalLayout {
            Rectangle {
                height: pph.preferred-height;
                background: Theme.bg-secondary;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                pph := HorizontalLayout {
                    padding-top: Theme.sp-6; padding-bottom: Theme.sp-6; padding-left: Theme.sp-10; padding-right: Theme.sp-10;
                    spacing: Theme.sp-8;
                    Text { vertical-alignment: center; text: "PLAN"; font-family: Theme.mono; font-size: Theme.text-10 * root.fs; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide; color: Theme.accent-hover; }
                    Text { vertical-alignment: center; text: root.plan-state; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; overflow: elide; horizontal-stretch: 1; min-width: 0; }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: pct.preferred-width + Theme.sp-12 + Theme.sp-2; height: pct.preferred-height + Theme.sp-2;
                        border-radius: Theme.r-control; border-width: 1px; border-color: pca.has-hover ? Theme.accent : Theme.border;
                        pct := Text { text: "Close"; font-size: Theme.text-11 * root.fs; color: pca.has-hover ? Theme.text-primary : Theme.text-muted; }
                        pca := TouchArea { mouse-cursor: pointer; clicked => { ToolAct.plan-toggle(root.key); } }
                    }
                }
            }
            Flickable {
                vertical-stretch: 1;
                content-height: pbody.preferred-height;
                pbody := VerticalLayout {
                    padding-top: Theme.sp-12; padding-bottom: Theme.sp-12; padding-left: Theme.sp-16; padding-right: Theme.sp-16;
                    spacing: Theme.sp-8;
                    for b in root.plan-blocks: Rectangle {
                        height: pbl.preferred-height;
                        pbl := HorizontalLayout {
                            if b.kind == "li": Text { width: Theme.sp-20; font-family: Theme.chat-font; text: b.marker; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; horizontal-alignment: center; }
                            if b.kind != "code": StyledText { default-font-family: Theme.chat-font;
                                width: list.width - Theme.sp-32 - (b.kind == "li" ? Theme.sp-20 : 0px);
                                text: b.md; default-color: Theme.chip-key; default-font-size: Theme.text-13 * root.fs; link-color: Theme.accent-hover;
                                link-clicked(url) => { ToolAct.open-link(url); }
                            }
                            if b.kind == "code": Text { width: list.width - Theme.sp-32; text: b.text; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; color: Theme.text-primary; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }

    // The agent dock's sheet (2.18): over the log only (inset sp-8): a list
    // of one kind, or one record's panel.
    if root.sheet != "": Rectangle {
        x: list.x + Theme.sp-8; y: list.y + Theme.sp-8;
        width: list.width - Theme.sp-16; height: list.height - Theme.sp-16;
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-card; shadow: Theme.shadow-menu; }
        Rectangle { border-radius: Theme.r-card; background: Theme.bg-primary; border-width: 1px; border-color: Theme.border; }
        TouchArea { }
        VerticalLayout {
            x: 1px; y: 1px; width: parent.width - Theme.sp-2; height: parent.height - Theme.sp-2;
            // The head: back (from the list), title, sub, Dismiss all (lists), ✕.
            Rectangle {
                height: shd.preferred-height;
                shd := HorizontalLayout {
                    padding-top: Theme.sp-8; padding-bottom: Theme.sp-8; padding-left: Theme.sp-10; padding-right: Theme.sp-10;
                    spacing: Theme.sp-8;
                    if root.sheet-back != "": Text {
                        vertical-alignment: center; text: root.sheet-back; font-size: Theme.text-12 * root.fs; color: ba.has-hover ? Theme.text-primary : Theme.text-muted;
                        ba := TouchArea { mouse-cursor: pointer; clicked => { ToolAct.agent-back(root.key); } Tip { on: parent.has-hover; text: "Back to the list"; } }
                    }
                    // A panel: the title fills, the sub sits at the right and gives
                    // way first; a list: the sub fills after the title.
                    Text { vertical-alignment: center; text: root.sheet-title; font-size: Theme.text-13 * root.fs; font-weight: Theme.w-semibold; color: Theme.text-primary; overflow: elide; horizontal-stretch: root.sheet == "panel" ? 1 : 0; min-width: root.sheet == "panel" ? min(self.preferred-width, shd.width / 2) : 0px; }
                    Text { vertical-alignment: center; text: root.sheet-sub; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; overflow: elide; horizontal-stretch: root.sheet == "panel" ? 0 : 1; min-width: 0; horizontal-alignment: root.sheet == "panel" ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
                    if root.sheet != "panel": Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: dat.preferred-width + Theme.sp-16 + Theme.sp-2; height: dat.preferred-height + Theme.sp-6;
                        border-radius: self.height / 2; border-width: 1px; border-color: daa.has-hover ? Theme.red : Theme.border;
                        dat := Text { text: "Dismiss all"; font-size: Theme.text-11 * root.fs; color: daa.has-hover ? Theme.red : Theme.text-secondary; }
                        daa := TouchArea { mouse-cursor: pointer; clicked => { ToolAct.agent-dismiss-all(root.key, root.sheet == "commands"); } }
                    }
                    DockX { y: (parent.height - self.height) / 2; fs: root.fs; big: true; tip: "Close"; clicked => { ToolAct.agent-close(root.key); } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
            }
            // A list: its rows, then the foot.
            // (The body fills the sheet, so the foot sits at its bottom edge.)
            if root.sheet != "panel": Rectangle {
              vertical-stretch: 1;
              Flickable {
                width: parent.width; height: parent.height;
                content-height: rows.preferred-height;
                rows := VerticalLayout {
                    padding: Theme.sp-6;
                    for r in root.sheet-rows: Rectangle {
                        height: rr.preferred-height;
                        border-radius: Theme.r-control;
                        background: ra.has-hover || rx.has-hover ? Theme.bg-hover : transparent;
                        ra := TouchArea { mouse-cursor: pointer; clicked => { ToolAct.agent-open(root.key, r.id, true); } }
                        rr := HorizontalLayout {
                            padding: Theme.sp-8;
                            spacing: Theme.sp-8;
                            Rectangle { width: Theme.sp-12; StatusMark { x: 0; height: parent.height; running: r.state == "running"; failed: r.state == "failed"; } }
                            VerticalLayout {
                                horizontal-stretch: 1; min-width: 0; spacing: Theme.sp-2;
                                Text { text: r.title; font-size: Theme.text-13 * root.fs; color: r.state == "running" ? Theme.text-primary : Theme.text-secondary; overflow: elide; }
                                Text { text: r.sub; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; overflow: elide; }
                            }
                            VerticalLayout { alignment: center; Icon { source: Icons.chevron-right; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.text-muted; } }
                            VerticalLayout { alignment: center; Rectangle {
                                width: Theme.control-sm; height: Theme.control-sm; border-radius: Theme.r-control;
                                Icon { source: Icons.x; width: Theme.icon-sm; height: Theme.icon-sm; tint: rx.has-hover ? Theme.red : Theme.text-muted; }
                                rx := TouchArea { mouse-cursor: pointer; clicked => { ToolAct.agent-dismiss(root.key, r.id); } Tip { on: parent.has-hover; text: "Dismiss"; } }
                            } }
                        }
                    }
                }
              }
            }
            if root.sheet != "panel": Rectangle {
                height: ft.preferred-height + Theme.sp-16;
                Rectangle { y: 0; height: 1px; background: Theme.border-subtle; }
                ft := Text {
                    x: Theme.sp-12; y: Theme.sp-8; width: parent.width - Theme.sp-24;
                    text: root.sheet == "commands" ? "A finished command leaves this list after 5 minutes. Its output stays on its row in the chat. Dismissing one does not stop it." : "A finished agent leaves this list after 5 minutes. Its transcript stays on its Agent row in the chat.";
                    font-size: Theme.text-11 * root.fs; color: Theme.text-muted; wrap: word-wrap;
                }
            }
            // A panel: the prompt, the summary, the transcript (or its empty
            // line). It opens at its end and follows it while the reader is
            // within sp-40 of it (the log's model).
            if root.sheet == "panel": Rectangle {
              vertical-stretch: 1;
              pfl := Flickable {
                width: parent.width; height: parent.height;
                content-height: pb.preferred-height;
                property <length> pdist: max(0px, self.content-height + self.content-y - self.height);
                property <length> pch: self.content-height;
                changed pch => { if root.pfollow { self.content-y = min(0px, self.height - self.content-height); } }
                changed pdist => { SheetProbe.dist = self.pdist; }
                flicked => { root.pfollow = self.pdist < Theme.sp-40; }
                // Opened: at its end once the rows are laid out.
                Timer {
                    property <int> n;
                    interval: Theme.frame; running: true;
                    triggered => { pfl.content-y = min(0px, pfl.height - pfl.content-height); self.n += 1; SheetProbe.dist = pfl.pdist; if self.n >= 4 { self.running = false; } }
                }
                pb := VerticalLayout {
                    padding-top: Theme.sp-10; padding-bottom: Theme.sp-10; padding-left: Theme.sp-12; padding-right: Theme.sp-12;
                    // The prompt: at most cmd-max-h, then it scrolls.
                    if root.panel-prompt != "": Rectangle {
                        height: min(pp.preferred-height + Theme.sp-16, Theme.cmd-max-h) + Theme.sp-10;
                        Rectangle {
                            height: parent.height - Theme.sp-10; y: 0;
                            background: Theme.bg-secondary; border-width: 1px; border-color: Theme.border-subtle; border-radius: Theme.r-control;
                            ppf := RevealFlickable {
                                x: 1px; y: 1px; width: parent.width - Theme.sp-2; height: parent.height - Theme.sp-2;
                                content-height: pp.preferred-height + Theme.sp-16 - Theme.sp-2;
                                pp := Text { x: Theme.sp-10 - 1px; y: Theme.sp-8 - 1px; width: ppf.width - Theme.sp-20 + Theme.sp-2; text: root.panel-prompt; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; wrap: word-wrap; }
                            }
                        }
                    }
                    if root.panel-has-summary: Rectangle {
                        height: psm.preferred-height + Theme.sp-10;
                        psm := StyledText { default-font-family: Theme.chat-font; y: 0; width: list.width - Theme.sp-16 - Theme.sp-24 - Theme.sp-2; text: root.panel-summary; default-color: Theme.chip-key; default-font-size: Theme.text-13 * root.fs; link-color: Theme.accent-hover; }
                    }
                    // The transcript, spaced as the log (each row's own gap).
                    for pe in root.panel-entries: EntryRow { e: pe; fs: root.fs; avail: list.width - Theme.sp-16 - Theme.sp-24 - Theme.sp-2; }
                    if root.panel-empty != "": Text { text: root.panel-empty; font-size: Theme.text-12 * root.fs; font-italic: true; color: Theme.text-muted; wrap: word-wrap; }
                }
              }
            }
        }
    }

    // The jump button (.cc-jump): over the log, at its bottom centre (above
    // the dock while it shows).
    if root.jump-on: Rectangle {
        width: Theme.sp-40; height: Theme.sp-40;
        init => { if root.watched { LogProbe.jump-x = self.absolute-position.x + self.width / 2; LogProbe.jump-y = self.absolute-position.y + self.height / 2; } }
        x: list.x + (list.width - self.width) / 2;
        y: list.y + list.height - self.height - (root.dock-on ? dock.height + Theme.sp-16 : Theme.sp-10);
        SoftShadow { width: parent.width; height: parent.height; radius: self.width / 2; shadow: Theme.shadow-menu; }
        Rectangle {
            border-radius: self.width / 2; border-width: 1px;
            border-color: jt.has-hover || root.jump-new ? Theme.accent : Theme.border;
            background: jt.has-hover ? Theme.accent-dim : Theme.bg-secondary;
        }
        Icon {
            // New below: the arrow nudges down now and then.
            property <bool> nudge: root.jump-new && mod(animation-tick() / Theme.shimmer, 1) < 1 / 2 / 2 / 2;
            y: (parent.height - self.height) / 2 + (self.nudge ? Theme.sp-2 : 0px);
            source: @image-url("shapes/arrow-down.svg"); width: Theme.icon-lg; height: Theme.icon-lg; tint: Theme.text-primary;
        }
        if root.jump-new: Rectangle {
            x: parent.width - self.width + Theme.sp-2; y: -Theme.sp-2;
            width: Theme.sp-10 + Theme.sp-4; height: self.width; border-radius: self.width / 2;
            background: Theme.bg-primary;
            Rectangle { width: Theme.sp-10; height: Theme.sp-10; border-radius: self.width / 2; background: Theme.accent; }
        }
        jt := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.jump-new = false; root.glide-n = 0; glide.running = true; }
            Tip { on: parent.has-hover; text: "Go to the newest message"; }
        }
    }
    // The slash menu (2.11): over the box's row (wide: box, attach, Send;
    // narrow: the box), sp-4 above it, as wide; up to slash-max-h, scrolling.
    if root.slash-open: Rectangle {
        property <length> row-x: boxrow.absolute-position.x - root.absolute-position.x;
        property <length> row-y: boxrow.absolute-position.y - root.absolute-position.y;
        x: self.row-x; width: boxrow.width;
        height: min(sl.preferred-height + Theme.sp-2, Theme.slash-max-h);
        y: self.row-y - Theme.sp-4 - self.height;
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-control; shadow: Theme.shadow-menu; }
        Rectangle { background: Theme.bg-secondary; border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border; }
        TouchArea { }
        sf := RevealFlickable {
            x: 1px; y: 1px; width: parent.width - Theme.sp-2; height: parent.height - Theme.sp-2;
            content-height: sl.preferred-height;
            sl := VerticalLayout {
                width: sf.width;
                for it[i] in root.slash-items: SlashRow {
                    fs: root.fs; it: it; on: i == root.slash-sel;
                    reveal(top, bottom) => { sf.reveal(top, bottom); }
                    chosen => { Composer.slash-choose(root.key, i); }
                }
            }
        }
    }
    // The schedule panel (2.10): at the chat's foot, over the composer, inset
    // sp-8, growing upward to sched-share of the chat. Not modal.
    if root.s-open: SchedPanel {
        x: Theme.sp-8; width: parent.width - 2 * Theme.sp-8;
        y: parent.height - Theme.sp-8 - self.height;
        max-h: parent.height * Theme.sched-share;
        key: root.key; fs: root.fs;
        text-in: root.s-text; text-gen: root.s-text-gen;
        trigger: root.s-trigger;
        at-in: root.s-at; at-gen: root.s-at-gen;
        note: root.s-note; items: root.s-items; limit-off: root.s-limit-off;
        list: root.s-list; unsupported: root.s-unsupported;
    }
    // A file dragged over the chat (2.7): a dashed accent outline just inside
    // it, over the log and the composer.
    if root.file-over: DashedBox {
        width: parent.width; height: parent.height;
        thick: Theme.sp-2; dash: Theme.sp-6; gap: Theme.sp-4; line: Theme.accent;
    }
    // Copies the whole session id (a hidden input: Slint's clipboard is a
    // text input's).
    clip := TextInput { visible: false; width: 0; height: 0; text: root.session-full; read-only: true; }
}
