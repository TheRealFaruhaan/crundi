// A chat pane, as the web UI's chat (app/vendor/claude-chat.js) draws it:
// the pane header, the log, and the composer. Sizes and colours are its CSS.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Pointer, AccentFill } from "widgets.slint";
import { ListView } from "std-widgets.slint";

export struct ToolView {
    title: string,
    detail: string,
    text: string,
    // running | done
    status: string,
    error: bool,
}

export struct EntryView {
    id: string,
    // user | assistant | code | thinking | tools | permission | question | result | error | notice
    kind: string,
    text: string,
    md: styled-text,
    title: string,
    detail: string,
    status: string,
    error: bool,
    request-id: string,
    options: [string],
    tools: [ToolView],
    // The space after this row (paragraphs 8px, list items 4px, entries 10px).
    gap: length,
}

/// The state dot's colour (header and sidebar agree).
export global PaneState {
    public pure function color(state: string) -> color {
        return state == "working" ? Theme.yellow
            : state == "needs-input" ? Theme.accent
            : state == "waiting" ? Theme.sky
            : state == "exited" ? Theme.text-muted
            : Theme.green;
    }
}

/// A tooltip's box. The web's are the system's own (the title attribute);
/// Slint draws its own, so this is the closest (PLAN.md, Known gaps).
export component TipBox inherits Rectangle {
    in property <string> text;
    background: Theme.bg-tertiary;
    border-radius: Theme.r-chip;
    border-width: 1px;
    border-color: Theme.border;
    width: tt.preferred-width + Theme.sp-16;
    height: tt.preferred-height + Theme.sp-8;
    tt := Text { text: root.text; font-size: Theme.text-12; color: Theme.text-primary; }
}

/// A pane header button (.term-font-btn and its kin): 1px border, bg-primary,
/// radius 6, text-secondary; hover: text-primary on an accent border.
/// Its box is given (the spec's measured sizes); the icon or label is centred.
component HeadBtn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon;
    in property <length> icon-size: Theme.icon-sm;
    in property <length> label-size: Theme.text-11;
    in property <string> tip;
    // rest | on (yellow: secrets granted) | pinned (accent fill) | lit (accent: full screen)
    // | armed (red: "Sure?") | close (the ×: red on hover)
    in property <string> look: "rest";
    // A count after the icon (the secrets lock), 4px after it; and a label
    // after that (the lock in the narrow header's menu), 4px after.
    in property <string> count;
    in property <string> after;
    callback clicked();
    property <bool> hover: ta.has-hover;
    property <color> ink: root.look == "on" ? Theme.yellow
        : root.look == "armed" ? Theme.red
        : root.look == "pinned" || root.look == "lit" ? Theme.accent-hover
        : root.look == "close" && root.hover ? Theme.red
        : root.hover ? Theme.text-primary : Theme.text-secondary;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.look == "on" ? Theme.yellow
        : root.look == "armed" ? Theme.red
        : root.look == "pinned" || root.look == "lit" ? Theme.accent
        : root.look == "close" && root.hover ? Theme.red
        : root.hover ? Theme.accent : Theme.border;
    background: root.look == "armed" ? Theme.red-dim : root.look == "pinned" ? Theme.accent-dim : Theme.bg-primary;
    accessible-role: button;
    accessible-label: root.tip;
    if root.has-icon && root.count == "" && root.after == "": Image {
        source: root.icon;
        width: root.icon-size; height: root.icon-size;
        colorize: root.ink;
    }
    // The lock with its count (and label): icon at 7px, then each 4px apart.
    if root.has-icon && (root.count != "" || root.after != ""): HorizontalLayout {
        x: Theme.sp-8;
        width: self.preferred-width;
        spacing: Theme.sp-4;
        alignment: start;
        Image {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            width: root.icon-size; height: root.icon-size;
            colorize: root.ink;
        }
        if root.count != "": Text { text: root.count; font-size: Theme.text-11; color: root.ink; vertical-alignment: center; }
        if root.after != "": Text { text: root.after; font-size: Theme.text-11; color: root.ink; vertical-alignment: center; }
    }
    if !root.has-icon: Text { text: root.label; font-size: root.label-size; color: root.ink; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Tooltip { TipBox { text: root.tip; } }
    }
}

/// A chat-card button: border, bg-tertiary, 6px 12px, radius 6, 12px.
/// Primary: the accent gradient (the web UI's global button.primary).
component CardBtn inherits Rectangle {
    in property <string> text;
    // The pane's text size (the web's --cc-fs).
    in property <float> fs: 1;
    in property <bool> primary;
    in property <bool> danger;
    callback clicked();
    // .cc-btn: padding 6px 12px and a 1px border round a 12px × fs line.
    height: Theme.sz-14 + Theme.sz-14 * root.fs;
    width: t.preferred-width + Theme.sp-24;
    border-radius: Theme.r-control;
    border-width: root.primary ? 0px : 1px;
    border-color: root.danger && ta.has-hover ? Theme.red : Theme.border;
    background: root.primary ? transparent
        : root.danger && ta.has-hover ? Theme.red-dim
        : ta.has-hover ? Theme.bg-hover : Theme.bg-tertiary;
    // Primary: the accent gradient in its rounded shape (AccentFill).
    if root.primary: AccentFill { width: parent.width; height: parent.height; }
    t := Text { text: root.text; font-size: Theme.text-12 * root.fs; font-weight: Theme.w-semibold; color: root.primary ? white : root.danger && ta.has-hover ? Theme.red : Theme.text-primary; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// Where a pane's header can be grabbed (its background, the ⋮⋮, the title):
/// a press that moves more than 6px with the left button starts dragging the
/// pane (2.3); the release drops it. A click that didn't move stays a click
/// (`did-drag` says which). Positions are in window coordinates.
component HeadGrab inherits TouchArea {
    in property <bool> can-drag: true;
    in property <MouseCursor> rest-cursor: MouseCursor.default;
    out property <bool> dragging;
    out property <bool> did-drag;
    // Its tooltip may show: not once a button went down (Chromium hides a
    // title tooltip on a press), and not again until the pointer has left
    // and come back.
    out property <bool> tip-ok: true;
    changed has-hover => { if !self.has-hover { self.tip-ok = true; } }
    callback drag(int, length, length);
    mouse-cursor: self.dragging ? MouseCursor.grabbing : self.rest-cursor;
    pointer-event(ev) => {
        if ev.kind == PointerEventKind.down { self.tip-ok = false; }
        if ev.button == PointerEventButton.left {
            if ev.kind == PointerEventKind.down { self.did-drag = false; }
            if ev.kind == PointerEventKind.up && self.dragging {
                self.dragging = false;
                root.drag(2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    moved => {
        if self.pressed && self.can-drag {
            if !self.dragging && (abs(self.mouse-x - self.pressed-x) > Theme.sp-6 || abs(self.mouse-y - self.pressed-y) > Theme.sp-6) {
                self.dragging = true;
                self.did-drag = true;
                root.drag(0, self.absolute-position.x + self.pressed-x, self.absolute-position.y + self.pressed-y);
            }
            if self.dragging { root.drag(1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        }
    }
}

/// The CHAT tag: a 15px pill, 9.92px/700 upper case, .6px tracking, padding 1px 7px.
component KindTag inherits Rectangle {
    in property <string> text;
    height: Theme.sp-16;
    width: tag.preferred-width + Theme.sp-16;
    border-radius: Theme.r-pill;
    border-width: 1px;
    border-color: Theme.border;
    // The web asks for 9.92px/700 with .6px tracking; Chromium's hinting
    // draws DejaVu Sans Bold's capitals 8px tall and 29.2px across.
    // Slint draws 9.92px at 7px, so the size is what matches the glyphs
    // (caps 8px, C 6px wide) and the tracking keeps the text 31.6px.
    tag := Text { text: root.text; font-size: Theme.text-11; font-weight: Theme.w-bold; color: Theme.accent-hover; letter-spacing: Theme.track-tag; }
}

/// The pane header (.term-head): 28px (27 and a 1px line), bg-secondary;
/// padding 3/4/3/2, items 4px apart. specs/pane-header-wide.md has every
/// measurement used here (y: from the header's top). Narrow (2.2,
/// specs/pane-header-narrow.md): the tools fold into "…", the header is
/// 26px (the pin, its tallest item, is gone) and every item sits 1px higher.
export component PaneHead inherits Rectangle {
    // The title shown (the long form on a wide header), its cap, and the
    // short title a rename starts from.
    in property <string> title;
    in property <length> title-max: Theme.title-cap;
    in property <string> short-title;
    in property <string> state;
    in property <string> kind-tag;
    in property <bool> chat;
    // The header's content box is under 560px (the pane ≤ 567): src/head.rs.
    in property <bool> narrow;
    // The fold-out menu is open (src/app.rs: one at a time).
    in property <bool> menu-open;
    // The secrets lock: shown when the server can (chat-secret-preauth); the
    // number of grants, and its tooltip.
    in property <bool> secrets;
    in property <int> secrets-n;
    in property <string> secrets-tip;
    in property <bool> pinned;
    in property <bool> full;
    // The × was clicked once: "Sure?" (src/app.rs disarms it after 3 s).
    in property <bool> armed;
    // No pin button (the drag's clone).
    in property <bool> no-pin;
    // Where "…" sits (from the header's left), for the menu's outside-press test.
    out property <length> more-left: self.width - Theme.sp-4 - (root.armed ? sure-m.preferred-width + Theme.sz-14 : Theme.sz-28) - Theme.sp-4 - Theme.sz-26;
    out property <length> more-top: (self.height - 1px - Theme.sp-20) / 2;
    callback close();
    callback full-screen();
    callback font(int);
    callback font-reset();
    callback pin();
    callback open-secrets();
    callback rename(string);
    callback maximize();
    callback more();
    // The header dragged (HeadGrab): 0 start, 1 move, 2 release.
    callback drag(int, length, length);
    property <bool> renaming;
    // Items are centred on the row, so a narrow (26px) header has them 1px higher.
    // The agent badge's text, upper case (none for idle and exited).
    property <string> badge: !root.chat ? "" : root.state == "working" ? "WORKING" : root.state == "needs-input" ? "NEEDS INPUT" : root.state == "waiting" ? "WAITING" : "";
    badge-m := Text { visible: false; text: root.badge; font-size: Theme.text-11; font-weight: Theme.w-bold; letter-spacing: Theme.track-badge; }
    height: root.narrow ? Theme.sz-26 : Theme.sz-28;
    background: Theme.bg-secondary;
    sure-m := Text { visible: false; text: "Sure?"; font-size: Theme.text-11; }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    // Double-click the header (its background, handle, dot, tag: not the
    // buttons) to maximise the pane in its split. The whole header is the
    // drag handle (not in full screen).
    HeadGrab {
        can-drag: !root.full;
        double-clicked => { root.maximize(); }
        drag(k, x, y) => { root.drag(k, x, y); }
    }
    HorizontalLayout {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height - 1px;
        padding-left: Theme.sp-2;
        padding-right: Theme.sp-4;
        spacing: Theme.sp-4;
        // The drag handle "⋮⋮": 12px, -2px tracking, padding 0 3px; 26×12 at y 7.5.
        // Hidden in full screen.
        if !root.full: Rectangle {
            y: (parent.height - self.height) / 2; width: Theme.sz-26; height: Theme.sp-12;
            Text { x: Theme.sp-4; text: "⋮⋮"; font-size: Theme.text-12; letter-spacing: Theme.track-grip; color: Theme.text-muted; vertical-alignment: center; height: parent.height; }
            dh := HeadGrab {
                rest-cursor: MouseCursor.grab;
                double-clicked => { root.maximize(); }
                drag(k, x, y) => { root.drag(k, x, y); }
                if dh.tip-ok && !dh.pressed && !dh.dragging: Tooltip { TipBox { text: "Drag to reorder"; } }
            }
        }
        // The state dot: 7px at y 10 (2.4): green idle, yellow working, accent
        // needs input (with a 3px accent-dim ring), sky waiting, muted exited.
        // Its tooltip is the raw state.
        if root.chat: Rectangle {
            y: (parent.height - self.height) / 2; width: Theme.sp-8; height: Theme.sp-8;
            if root.state == "needs-input": Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: Theme.sz-14; height: Theme.sz-14; border-radius: Theme.r-pill; background: Theme.accent-dim; }
            Rectangle { border-radius: Theme.r-chip; background: PaneState.color(root.state); }
            dt := TouchArea {
                Tooltip { TipBox { text: root.state == "" ? "idle" : root.state; } }
            }
        }
        // The title: 12px/600, padding 2px 6px, radius 6; 18px at y 4.5.
        // Never wider than its cap (160px, the long form's, or none when
        // narrow), nor than the row leaves it: the spacer goes to 0 first, but
        // its two 4px gaps stay.
        if !root.renaming: Rectangle {
            property <length> room: root.width - Theme.sp-2 - (root.full ? 0px : Theme.sz-30) - (root.chat ? Theme.sp-12 : 0px) - Theme.sp-8 - tools.preferred-width - Theme.sp-4
                - (root.badge != "" ? badge-m.preferred-width + Theme.sz-14 + Theme.sp-4 : 0px);
            y: (parent.height - self.height) / 2; height: Theme.sz-18;
            width: max(0px, min(tt.preferred-width + Theme.sp-12, root.title-max, self.room));
            border-radius: Theme.r-control;
            background: th.has-hover ? Theme.bg-tertiary : transparent;
            tt := Text {
                x: Theme.sp-6; width: parent.width - Theme.sp-12;
                text: root.title; font-size: Theme.text-12; font-weight: Theme.w-semibold; color: Theme.text-primary;
                vertical-alignment: center; height: parent.height;
                overflow: elide; wrap: no-wrap;
            }
            th := HeadGrab {
                rest-cursor: MouseCursor.text;
                can-drag: !root.full;
                clicked => { if !self.did-drag { root.renaming = true; } }
                double-clicked => { root.maximize(); }
                drag(k, x, y) => { root.drag(k, x, y); }
                if th.tip-ok && !th.pressed && !th.dragging: Tooltip { TipBox { text: "Click to rename"; } }
            }
        }
        // Renaming: an input 160 wide, 20 high at y 3.5, the short title all
        // selected; an accent border and a 3px ring. Enter or leaving it
        // saves; Esc puts the title back.
        if root.renaming: ri := Rectangle {
            y: (parent.height - self.height) / 2; width: Theme.title-cap; height: Theme.sp-20;
            // A press anywhere outside the input saves it, as the web's blur.
            property <int> presses: Pointer.presses;
            changed presses => {
                if root.renaming && (Pointer.press-x < self.absolute-position.x || Pointer.press-x > self.absolute-position.x + self.width
                        || Pointer.press-y < self.absolute-position.y || Pointer.press-y > self.absolute-position.y + self.height) {
                    root.renaming = false;
                    root.rename(ti.text);
                }
            }
            // The ring: 0 0 0 3px rgba(99,102,241,.28).
            Rectangle { x: -Theme.sp-4; y: -Theme.sp-4; width: parent.width + 2 * Theme.sp-4; height: parent.height + 2 * Theme.sp-4; border-radius: Theme.r-field; background: Theme.accent-ring; }
            Rectangle {
                border-radius: Theme.r-control; border-width: 1px; border-color: Theme.accent;
                background: Theme.bg-primary;
            }
            FocusScope {
                key-pressed(ev) => {
                    if ev.text == Key.Escape { root.renaming = false; return accept; }
                    return reject;
                }
                // The 146px text box (padding 6px and the 1px border), clipped;
                // the text scrolls to keep the caret in view, as a browser's
                // input does (it opens scrolled to the end, all selected).
                // As std LineEdit (lineedit-base.slint), but with the room a
                // browser keeps for its caret, not Slint's caret width.
                Rectangle {
                    x: Theme.sp-8; width: parent.width - Theme.sz-14;
                    clip: true;
                    ti := TextInput {
                        property <length> scroll;
                        // A browser keeps a 1px caret in view at the end, none
                        // while text is selected (the caret isn't drawn).
                        property <length> caret-room: self.anchor-position-byte-offset != self.cursor-position-byte-offset ? 0px : 1px;
                        x: min(0px, max(parent.width - self.width - self.caret-room, self.scroll));
                        width: max(parent.width - self.caret-room, self.preferred-width);
                        font-size: Theme.text-12; font-weight: Theme.w-semibold; color: Theme.text-primary;
                        vertical-alignment: center; height: parent.height;
                        single-line: true;
                        selection-background-color: Theme.selection;
                        selection-foreground-color: white;
                        init => { self.text = root.short-title; self.focus(); self.select-all(); }
                        cursor-position-changed(at) => {
                            if at.x + self.scroll < 0 {
                                self.scroll = - at.x;
                            } else if at.x + self.scroll > parent.width - self.caret-room {
                                self.scroll = parent.width - at.x - self.caret-room;
                            }
                        }
                        accepted => { if root.renaming { root.renaming = false; root.rename(self.text); } }
                        changed has-focus => { if !self.has-focus && root.renaming { root.renaming = false; root.rename(self.text); } }
                    }
                }
            }
        }
        // The agent badge (2.4), 4px after the title: WORKING, NEEDS INPUT,
        // WAITING; a 13px pill, 9.6px/700, .384px tracking, padding 1px 7px.
        // It never hides: the title elides first.
        if root.badge != "": Rectangle {
            y: (parent.height - self.height) / 2; height: Theme.sz-14;
            width: badge-m.preferred-width + Theme.sz-14;
            border-radius: Theme.r-pill;
            background: root.state == "working" ? Theme.yellow-dim : root.state == "waiting" ? Theme.sky-dim : Theme.accent-dim;
            // The web's 9.6px/700 with .384px tracking comes out with 8px
            // capitals in Chromium (its hinting); Slint draws them 6px. As the
            // CHAT tag: the size that matches the glyphs, the tracking that
            // keeps the width (PLAN.md, "Small bold text").
            Text {
                text: root.badge; font-size: Theme.text-11; font-weight: Theme.w-bold; letter-spacing: Theme.track-badge;
                color: root.state == "working" ? Theme.yellow : root.state == "waiting" ? Theme.sky : Theme.accent-hover;
            }
        }
        // The rest is pushed right (the spacer can shrink to 0).
        Rectangle { horizontal-stretch: 1; min-width: 0; }
        // The tools: inline when wide; folded into "…" when narrow, leaving full
        // screen, "…" and ×. (Each is centred on the row.)
        tools := HorizontalLayout {
            spacing: Theme.sp-4;
            if root.kind-tag != "" && !root.narrow: KindTag { y: (parent.height - self.height) / 2; text: root.kind-tag; }
            // The secrets lock: 26×20 (37×20 with a count) at y 3.5; yellow with grants.
            if root.chat && root.secrets && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20;
                width: root.secrets-n > 0 ? Theme.sz-38 : Theme.sz-26;
                has-icon: true; icon: Icons.lock; icon-size: Theme.icon-sm;
                look: root.secrets-n > 0 ? "on" : "rest";
                count: root.secrets-n > 0 ? "" + root.secrets-n : "";
                tip: root.secrets-tip;
                clicked => { root.open-secrets(); }
            }
            // A- / reset / A+: 11px, padding 3px 6px; 19px high (reset 19.6).
            // A- and A+ at the web's measured widths (25.3, 30.8): its buttons
            // are Arial, a hair narrower than the UI sans.
            if root.chat && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sz-26;
                label: "A-"; tip: "Smaller text";
                am := Text { visible: false; text: "A-"; font-size: Theme.text-11; }
                clicked => { root.font(-1); }
            }
            if root.chat && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sz-26;
                has-icon: true; icon: Icons.rotate-ccw; icon-size: Theme.icon-sm;
                tip: "Reset text size";
                clicked => { root.font-reset(); }
            }
            if root.chat && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sz-30;
                label: "A+"; tip: "Larger text";
                ap := Text { visible: false; text: "A+"; font-size: Theme.text-11; }
                clicked => { root.font(1); }
            }
            // Pin: 27×21 at y 3, a 13px icon; pinned: accent on accent-dim, turned −30°.
            if !root.narrow && !root.no-pin: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sz-22; width: Theme.sz-28;
                // Pinned, the icon is turned −30° (drawn turned: pin-turned).
                has-icon: true; icon: root.pinned ? Icons.pin-turned : Icons.pin; icon-size: Theme.icon-md;
                look: root.pinned ? "pinned" : "rest";
                tip: root.pinned ? "Unpin (size and position are locked)" : "Pin size and position";
                clicked => { root.pin(); }
            }
            // Full screen: 25×19 at y 4, an 11px maximize; accent while on.
            if root.chat: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sz-26;
                has-icon: true; icon: Icons.maximize; icon-size: Theme.icon-sm;
                look: root.full ? "lit" : "rest";
                tip: "Full screen";
                clicked => { root.full-screen(); }
            }
            // "…": 25×19, an 11px "more"; accent while its menu is open, hovered or not.
            if root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sz-26;
                has-icon: true; icon: Icons.more; icon-size: Theme.icon-sm;
                look: root.menu-open ? "lit" : "rest";
                tip: "More";
                clicked => { root.more(); }
            }
            // Close takes two clicks: "×" 14px, padding 1px 7px, 27.7×18 at y 4.5;
            // armed: "Sure?" 11px, padding 1px 6px, 15px high at y 6, red.
            // Hidden in full screen.
            if !root.full: HeadBtn {
                y: (parent.height - self.height) / 2;
                height: root.armed ? Theme.sp-16 : Theme.sz-18;
                width: root.armed ? sure.preferred-width + Theme.sz-14 : Theme.sz-28;
                label: root.armed ? "Sure?" : "×";
                label-size: root.armed ? Theme.text-11 : Theme.sz-14;
                look: root.armed ? "armed" : "close";
                tip: root.armed ? "Click again to close" : "Close chat";
                sure := Text { visible: false; text: "Sure?"; font-size: Theme.text-11; }
                clicked => { root.close(); }
            }
        }
    }
}

/// The narrow header's menu (.term-head.tools-open .term-head-tools): the
/// folded tools in a wrapping row, right-aligned, padding 8, gap 6; bg-secondary,
/// 1px border, radius 6, shadow-md. At most `max-w` wide (the header − 8).
/// A-, reset, A+ and pin act and leave it open; the lock closes it. A press
/// outside it (but on "…", which toggles it) closes it and still acts; Esc
/// closes it (the web has no Esc here: DESIGN rule 5, as the brief asks).
export component HeadMenu inherits Rectangle {
    in property <length> max-w;
    in property <string> kind-tag;
    in property <bool> secrets;
    in property <int> secrets-n;
    in property <string> secrets-tip;
    in property <bool> pinned;
    // "…" in window coordinates: a press there is its own toggle.
    in property <length> more-x;
    in property <length> more-y;
    callback font(int);
    callback font-reset();
    callback pin();
    callback open-secrets();
    callback dismiss();
    // As wide as its items on one line (padding 8 and 6 between), but no
    // wider than the header − 8: then it wraps.
    property <length> lock-w: Theme.sp-8 + Theme.sp-12 + Theme.sp-4 + (root.secrets-n > 0 ? cnt-m.preferred-width + Theme.sp-4 : 0px) + lbl-m.preferred-width + Theme.sp-8;
    property <length> natural: Theme.sp-16 + (root.kind-tag != "" ? tag-m.preferred-width + Theme.sp-16 + Theme.sp-6 : 0px)
        + (root.secrets ? self.lock-w + Theme.sp-6 : 0px)
        + Theme.sz-26 + Theme.sp-6 + Theme.sz-26 + Theme.sp-6 + Theme.sz-30 + Theme.sp-6 + Theme.sz-28;
    width: min(root.max-w, self.natural + Theme.sp-2);
    height: fl.preferred-height + Theme.sp-2;
    tag-m := Text { visible: false; text: root.kind-tag; font-size: Theme.text-11; font-weight: Theme.w-bold; letter-spacing: Theme.track-tag; }
    cnt-m := Text { visible: false; text: root.secrets-n; font-size: Theme.text-11; }
    lbl-m := Text { visible: false; text: "Secrets for this chat"; font-size: Theme.text-11; }
    // shadow-md (0 6px 20px rgba(0,0,0,.5)) in soft layers: the software
    // renderer drops drop-shadow-blur (PLAN.md, Known gaps). Each is the box
    // moved 6px down and grown, fainter as it grows.
    for l in Theme.shadow-head-menu: Rectangle {
        x: -l.e; y: l.y - l.e;
        width: root.width + 2 * l.e; height: root.height + 2 * l.e;
        border-radius: Theme.r-control + l.e;
        background: l.c;
    }
    Rectangle {
        background: Theme.bg-secondary;
        border-radius: Theme.r-control;
        border-width: 1px;
        border-color: Theme.border;
    }
    property <int> presses: Pointer.presses;
    changed presses => {
        let ax = self.absolute-position.x;
        let ay = self.absolute-position.y;
        let inside = Pointer.press-x >= ax && Pointer.press-x <= ax + self.width && Pointer.press-y >= ay && Pointer.press-y <= ay + self.height;
        let on-more = Pointer.press-x >= root.more-x && Pointer.press-x <= root.more-x + Theme.sz-26 && Pointer.press-y >= root.more-y && Pointer.press-y <= root.more-y + Theme.sp-20;
        if !inside && !on-more { root.dismiss(); }
    }
    // Clicks on the menu's own padding stay in it.
    TouchArea { }
    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(ev) => {
            if ev.text == Key.Escape { root.dismiss(); return accept; }
            return reject;
        }
        fl := FlexboxLayout {
            x: 1px; y: 1px;
            width: parent.width - Theme.sp-2;
            // Its own height, and lines packed at the top: a stretched line
            // would push the items down.
            height: self.preferred-height;
            cross-axis-line-alignment: start;
            padding: Theme.sp-8;
            spacing: Theme.sp-6;
            flex-wrap: wrap;
            alignment: end;
            cross-axis-alignment: center;
            if root.kind-tag != "": KindTag { text: root.kind-tag; }
            // The lock with its label: icon 12, the count if any, "Secrets for
            // this chat"; gap 4, padding 3px 6px; 20px high.
            if root.secrets: HeadBtn {
                height: Theme.sp-20;
                width: root.lock-w;
                has-icon: true; icon: Icons.lock; icon-size: Theme.icon-sm;
                look: root.secrets-n > 0 ? "on" : "rest";
                count: root.secrets-n > 0 ? "" + root.secrets-n : "";
                after: "Secrets for this chat";
                tip: root.secrets-tip;
                clicked => { root.open-secrets(); }
            }
            HeadBtn {
                height: Theme.sp-20; width: Theme.sz-26;
                label: "A-"; tip: "Smaller text";
                am := Text { visible: false; text: "A-"; font-size: Theme.text-11; }
                clicked => { root.font(-1); }
            }
            HeadBtn {
                height: Theme.sp-20; width: Theme.sz-26;
                has-icon: true; icon: Icons.rotate-ccw; icon-size: Theme.icon-sm;
                tip: "Reset text size";
                clicked => { root.font-reset(); }
            }
            HeadBtn {
                height: Theme.sp-20; width: Theme.sz-30;
                label: "A+"; tip: "Larger text";
                ap := Text { visible: false; text: "A+"; font-size: Theme.text-11; }
                clicked => { root.font(1); }
            }
            HeadBtn {
                height: Theme.sz-22; width: Theme.sz-28;
                has-icon: true; icon: root.pinned ? Icons.pin-turned : Icons.pin; icon-size: Theme.icon-md;
                look: root.pinned ? "pinned" : "rest";
                tip: root.pinned ? "Unpin (size and position are locked)" : "Pin size and position";
                clicked => { root.pin(); }
            }
        }
    }
}

/// Text that can be selected and copied.
component Prose inherits TextInput {
    // The pane's text size: px / 13 (the web's --cc-fs).
    in property <float> fs: 1;
    read-only: true;
    wrap: word-wrap;
    line-height-factor: Theme.lh-chat;
    color: Theme.text-primary;
    font-size: Theme.text-13 * root.fs;
    selection-background-color: Theme.accent-dim;
}

component ToolRow inherits Rectangle {
    // The pane's text size: px / 13 (the web's --cc-fs).
    in property <float> fs: 1;
    in property <ToolView> t;
    property <bool> open;
    background: Theme.bg-secondary;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: Theme.border-subtle;
    height: col.preferred-height;
    col := VerticalLayout {
        Rectangle {
            height: Theme.sp-32 + (root.fs - 1) * Theme.sz-18;
            HorizontalLayout {
                padding-left: Theme.sp-10;
                padding-right: Theme.sp-10;
                spacing: Theme.sp-8;
                Rectangle {
                    width: Theme.sp-6; height: Theme.sp-6; y: (parent.height - self.height) / 2; border-radius: Theme.r-chip;
                    background: t.status == "running" ? Theme.yellow : t.error ? Theme.red : Theme.green;
                }
                Text { text: t.title; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; font-weight: Theme.w-semibold; color: t.error ? Theme.red : Theme.accent-hover; vertical-alignment: center; }
                Text { text: t.detail; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: root.open ? "▾" : "▸"; font-size: Theme.text-10 * root.fs; color: Theme.text-muted; vertical-alignment: center; }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
        }
        if root.open && t.text != "": Rectangle {
            height: min(out.preferred-height + Theme.sz-14, Theme.tool-max);
            Rectangle { height: 1px; background: Theme.border-subtle; }
            Flickable {
                y: 1px;
                height: parent.height - 1px;
                content-height: out.preferred-height + Theme.sz-14;
                out := TextInput {
                    x: Theme.sp-10; y: Theme.sp-8; width: parent.width - Theme.sz-18;
                    read-only: true; wrap: word-wrap;
                    text: t.text;
                    font-family: Theme.mono; font-size: Theme.text-12 * root.fs;
                    color: Theme.text-secondary;
                }
            }
        }
    }
}

component EntryRow inherits VerticalLayout {
    // The pane's text size: px / 13 (the web's --cc-fs).
    in property <float> fs: 1;
    in property <EntryView> e;
    // The width rows can use (from the list, not from the row: no loop).
    in property <length> avail;
    callback respond(string, string, bool);
    callback answer(string, string);
    property <bool> open;
    property <string> picked;
    padding-bottom: e.gap;

    if e.kind == "user": HorizontalLayout {
        alignment: end;
        Rectangle {
            width: min(ub-measure.preferred-width + Theme.sp-24, root.avail * Theme.bubble-share);
            background: Theme.accent-dim;
            border-width: 1px;
            border-color: Theme.accent-edge;
            border-top-left-radius: Theme.r-bubble;
            border-top-right-radius: Theme.r-bubble;
            border-bottom-right-radius: Theme.r-chip;
            border-bottom-left-radius: Theme.r-bubble;
            height: ub.preferred-height + Theme.sp-16;
            ub-measure := Text { visible: false; text: e.text; font-size: Theme.text-13 * root.fs; }
            ub := Prose { fs: root.fs; x: Theme.sp-12; y: Theme.sp-8; width: parent.width - Theme.sz-22; text: e.text; }
        }
    }

    // The web's line box is 1.55 × the text size; StyledText has no line
    // height, so its one line is padded to that box: half the difference
    // above and below (the font's own line measured, so any system font fits).
    if e.kind == "assistant" && e.status != "li": pl := VerticalLayout {
        property <length> size: (e.status == "h" ? Theme.sz-14 : Theme.sz-14) * root.fs;
        padding-top: max(0px, (self.size * Theme.line-chat - pm.preferred-height) / 2);
        padding-bottom: self.padding-top;
        Rectangle { height: 0; pm := Text { visible: false; text: "X"; font-size: pl.size; } }
        // Its width given, so its wrapped height is measured at the width it
        // is drawn at (F24: a long inline code token wrapped differently).
        StyledText {
            width: root.avail;
            text: e.md;
            default-color: Theme.text-primary;
            default-font-size: (e.status == "h" ? Theme.text-14 : Theme.sz-14) * root.fs;
            link-color: Theme.accent-hover;
        }
    }
    if e.kind == "assistant" && e.status == "li": HorizontalLayout {
        padding-top: max(0px, (Theme.text-13 * root.fs * Theme.line-chat - lm.preferred-height) / 2);
        padding-bottom: self.padding-top;
        Rectangle { width: 0; lm := Text { visible: false; text: "X"; font-size: Theme.text-13 * root.fs; } }
        Text { width: Theme.sp-20; text: e.title; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; horizontal-alignment: center; }
        StyledText {
            width: root.avail - Theme.sp-20;
            text: e.md;
            default-color: Theme.text-primary;
            default-font-size: Theme.text-13 * root.fs;
            link-color: Theme.accent-hover;
        }
    }

    if e.kind == "code": Rectangle {
        background: Theme.bg-secondary;
        border-width: 1px;
        border-color: Theme.border-subtle;
        border-radius: Theme.r-control;
        height: code.preferred-height + Theme.sz-18;
        code := TextInput {
            x: Theme.sp-12; y: Theme.sp-10; width: parent.width - Theme.sz-22;
            read-only: true; wrap: word-wrap;
            text: e.text;
            font-family: Theme.mono; font-size: Theme.text-12 * root.fs;
            color: Theme.text-primary;
        }
    }

    if e.kind == "thinking": HorizontalLayout {
        spacing: Theme.sp-6;
        Rectangle { width: Theme.sp-6; height: Theme.sp-6; border-radius: Theme.r-chip; y: Theme.sp-8; background: Theme.text-muted; }
        VerticalLayout {
            Text {
                text: "Thought";
                font-size: Theme.text-12 * root.fs; font-italic: true; color: Theme.text-muted;
                TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
            }
            if root.open: Text { text: e.text; font-size: Theme.text-12 * root.fs; font-italic: true; color: Theme.text-muted; wrap: word-wrap; }
        }
    }

    if e.kind == "tool": VerticalLayout {
        for t in e.tools: ToolRow { t: t; fs: root.fs; }
    }

    if e.kind == "tools": VerticalLayout {
        spacing: Theme.sp-6;
        Rectangle {
            height: Theme.sz-34 + (root.fs - 1) * Theme.sz-18;
            background: Theme.bg-secondary;
            border-radius: Theme.r-control;
            border-width: 1px;
            border-color: Theme.border-subtle;
            HorizontalLayout {
                padding-left: Theme.sp-10;
                padding-right: Theme.sp-10;
                spacing: Theme.sp-8;
                Rectangle {
                    width: Theme.sp-6; height: Theme.sp-6; y: (parent.height - self.height) / 2; border-radius: Theme.r-chip;
                    background: e.status == "running" ? Theme.yellow : e.error ? Theme.red : Theme.green;
                }
                Text { text: e.title; font-size: Theme.text-12 * root.fs; color: Theme.text-primary; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: e.detail + (root.open ? "  ▾" : "  ▸"); font-size: Theme.text-11 * root.fs; color: Theme.text-muted; vertical-alignment: center; }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
        }
        if root.open: VerticalLayout {
            spacing: Theme.sp-6;
            for t in e.tools: ToolRow { t: t; fs: root.fs; }
        }
    }

    if e.kind == "permission": Rectangle {
        background: e.status == "pending" ? Theme.yellow-dim : Theme.bg-secondary;
        border-width: 1px;
        border-color: e.status == "pending" ? Theme.yellow : Theme.border-subtle;
        border-radius: Theme.r-card;
        height: perm.preferred-height;
        perm := VerticalLayout {
            padding-top: Theme.sp-12; padding-bottom: Theme.sp-12; padding-left: Theme.sp-12; padding-right: Theme.sp-12;
            spacing: Theme.sp-8;
            Text { text: e.title; font-weight: Theme.w-semibold; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; wrap: word-wrap; }
            if e.detail != "": Rectangle {
                background: Theme.bg-primary;
                border-radius: Theme.r-control;
                height: pd.preferred-height + Theme.sz-14;
                pd := Text { x: Theme.sp-10; width: parent.width - Theme.sz-18; text: e.detail; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; wrap: word-wrap; }
            }
            if e.status == "pending": HorizontalLayout {
                spacing: Theme.sp-8;
                alignment: start;
                CardBtn { fs: root.fs; text: "Allow"; primary: true; clicked => { root.respond(e.request-id, "allow", false); } }
                CardBtn { fs: root.fs; text: "Allow always"; clicked => { root.respond(e.request-id, "allow", true); } }
                CardBtn { fs: root.fs; text: "Deny"; danger: true; clicked => { root.respond(e.request-id, "deny", false); } }
            }
            if e.status != "pending": Text { text: e.status == "allowed" ? "Allowed" : e.status == "denied" ? "Denied" : e.status; font-size: Theme.text-12 * root.fs; color: Theme.text-muted; }
        }
    }

    if e.kind == "question": Rectangle {
        background: e.status == "pending" ? Theme.accent-dim : Theme.bg-secondary;
        border-width: 1px;
        border-color: e.status == "pending" ? Theme.accent : Theme.border-subtle;
        border-radius: Theme.r-card;
        height: q.preferred-height;
        q := VerticalLayout {
            padding-top: Theme.sp-12; padding-bottom: Theme.sp-12; padding-left: Theme.sp-12; padding-right: Theme.sp-12;
            spacing: Theme.sp-8;
            if e.title != "": Text { text: e.title; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-bold; color: Theme.accent-hover; letter-spacing: Theme.track-caps; }
            Text { text: e.text; font-weight: Theme.w-semibold; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; wrap: word-wrap; }
            if e.status == "pending": VerticalLayout {
                spacing: Theme.sp-6;
                for o in e.options: Rectangle {
                    height: Theme.sp-32 + (root.fs - 1) * Theme.sp-20;
                    border-radius: Theme.r-control;
                    border-width: 1px;
                    border-color: root.picked == o ? Theme.accent : Theme.border;
                    background: root.picked == o ? Theme.accent-dim : oh.has-hover ? Theme.bg-hover : Theme.bg-primary;
                    HorizontalLayout {
                        padding-left: Theme.sp-10;
                        spacing: Theme.sp-8;
                        Rectangle {
                            width: Theme.sp-12; height: Theme.sp-12; y: (parent.height - self.height) / 2; border-radius: Theme.r-control;
                            border-width: 1px; border-color: root.picked == o ? Theme.accent : Theme.text-muted;
                            Rectangle { width: Theme.sp-6; height: Theme.sp-6; border-radius: Theme.r-chip; background: root.picked == o ? Theme.accent : transparent; }
                        }
                        Text { text: o; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; vertical-alignment: center; }
                    }
                    oh := TouchArea { mouse-cursor: pointer; clicked => { root.picked = o; } }
                }
                HorizontalLayout {
                    spacing: Theme.sp-8;
                    alignment: start;
                    CardBtn { fs: root.fs; text: "Submit"; primary: true; clicked => { if root.picked != "" { root.answer(e.id, root.picked); } } }
                    CardBtn { fs: root.fs; text: "Dismiss"; danger: true; clicked => { root.respond(e.request-id, "deny", false); } }
                }
            }
            if e.status != "pending": Text { text: "Answered"; font-size: Theme.text-12 * root.fs; color: Theme.text-muted; }
        }
    }

    // The end of a turn: centred, 11px, a line above.
    if e.kind == "result": VerticalLayout {
        Rectangle {
            height: 1px;
            for i in ceil(self.width / Theme.sp-6): Rectangle { x: i * Theme.sp-6; width: Theme.sp-4; height: 1px; background: Theme.border-subtle; }
        }
        Text {
            text: e.error ? (e.text != "" ? e.text : "Error") : e.detail;
            height: Theme.sp-24 + (root.fs - 1) * Theme.sz-18;
            font-size: Theme.text-11 * root.fs;
            color: e.error ? Theme.red : Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if e.kind == "error": Rectangle {
        background: Theme.red-dim;
        border-width: 1px;
        border-color: Theme.error-edge;
        border-radius: Theme.r-control;
        height: et.preferred-height + Theme.sp-16;
        et := Text { x: Theme.sp-10; width: parent.width - Theme.sp-20; text: e.text; color: Theme.error-text; wrap: word-wrap; font-size: Theme.text-12 * root.fs; }
    }

    if e.kind == "notice": Text { text: e.text; color: Theme.text-muted; font-size: Theme.text-11 * root.fs; horizontal-alignment: center; wrap: word-wrap; }
}

/// The message box: grows with its text (34–180px); Enter sends.
component InputBox inherits Rectangle {
    // The pane's text size: px / 13 (the web's --cc-fs).
    in property <float> fs: 1;
    in-out property <string> draft;
    // Ctrl+Enter sends (Enter makes a newline), when switched.
    in property <bool> ctrl-enter;
    callback send(string);
    // At least one line (the web's 1.45 line height, scaled) and 18px of padding.
    height: max(Theme.sz-18 + Theme.sz-18 * root.fs, min(Theme.composer-max, te.preferred-height + Theme.sz-18));
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: te.has-focus ? Theme.accent : Theme.border;
    background: Theme.bg-primary;
    FocusScope {
        capture-key-pressed(ev) => {
            if (ev.text == Key.Return && !ev.modifiers.shift && !ev.modifiers.alt && ev.modifiers.control == root.ctrl-enter) {
                if (root.draft != "") { root.send(root.draft); root.draft = ""; }
                return accept;
            }
            return reject;
        }
        te := TextInput {
            line-height-factor: Theme.lh-chat;
            x: Theme.sp-10; y: Theme.sp-10;
            width: parent.width - Theme.sp-20;
            height: parent.height - Theme.sz-18;
            text <=> root.draft;
            wrap: word-wrap;
            font-size: Theme.text-13 * root.fs;
            color: Theme.text-primary;
            selection-background-color: Theme.accent-dim;
        }
    }
    if root.draft == "": Text {
        x: Theme.sp-10; y: Theme.sp-10;
        width: parent.width - Theme.sp-20;
        text: root.ctrl-enter ? "Message Claude…  (Ctrl+Enter to send, Enter for newline)" : "Message Claude…  (Enter to send, Shift+Enter for newline)";
        font-size: Theme.text-13 * root.fs;
        color: Theme.text-muted;
        overflow: elide;
    }
}

/// The chat inside a pane: the log, then the composer.
export component ChatPane inherits Rectangle {
    // The pane's text size: px / 13 (the web's --cc-fs).
    in property <float> fs: 1;
    in property <[EntryView]> entries;
    in property <string> state;
    in property <string> mode;
    in property <string> session;
    in property <string> model;
    in property <string> cost;
    in property <string> error;
    in property <bool> narrow;
    callback send(string);
    callback stop();
    callback respond(string, string, bool);
    callback answer(string, string);
    // The draft as the app holds it (src/app.rs): taken at start and whenever
    // another view of this chat changed it (the full-screen pane); every
    // change is handed back.
    in property <string> saved-draft;
    callback draft-changed(string);
    property <string> draft;
    init => { self.draft = root.saved-draft; }
    changed saved-draft => { if self.draft != root.saved-draft { self.draft = root.saved-draft; } }
    changed draft => { root.draft-changed(self.draft); }
    property <bool> ctrl-enter;
    property <bool> stick: true;
    background: Theme.bg-primary;

    VerticalLayout {
        list := ListView {
            vertical-stretch: 1;
            for e in root.entries: HorizontalLayout {
                padding-left: Theme.sp-12;
                padding-right: Theme.sp-12;
                EntryRow {
                    e: e;
                    fs: root.fs;
                    avail: list.visible-width - Theme.sp-24;
                    respond(id, b, a) => { root.respond(id, b, a); }
                    answer(id, o) => { root.answer(id, o); }
                }
            }
            changed content-height => {
                if root.stick { self.content-y = min(0px, self.visible-height - self.content-height - Theme.sp-4); }
            }
            scrolled => { root.stick = self.content-y <= self.visible-height - self.content-height + Theme.stick-zone; }
        }
        if root.error != "": Rectangle {
            background: Theme.red-dim;
            height: errt.preferred-height + Theme.sp-10;
            errt := Text { x: Theme.sp-12; width: parent.width - Theme.sp-24; text: root.error; color: Theme.error-text; wrap: word-wrap; font-size: Theme.text-11 * root.fs; }
        }
        // The composer: bg-secondary, a line above, padding 8.
        Rectangle {
            background: Theme.bg-secondary;
            height: comp.preferred-height;
            Rectangle { height: 1px; background: Theme.border; }
            comp := VerticalLayout {
                padding: Theme.sp-8;
                spacing: Theme.sp-6;
                if !root.narrow: HorizontalLayout {
                    spacing: Theme.sp-8;
                    InputBox { fs: root.fs; horizontal-stretch: 1; draft <=> root.draft; ctrl-enter: root.ctrl-enter; send(t) => { root.send(t); } }
                    VerticalLayout {
                        alignment: end;
                        Rectangle {
                            width: Theme.sz-34; height: Theme.sz-34;
                            border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border;
                            background: at.has-hover ? Theme.bg-hover : Theme.bg-primary;
                            Icon { source: Icons.paperclip; width: Theme.icon-lg; height: Theme.icon-lg; tint: Theme.text-secondary; }
                            at := TouchArea { mouse-cursor: pointer; }
                        }
                    }
                    if root.state == "working": VerticalLayout {
                        alignment: end;
                        Rectangle {
                            width: Theme.sz-34; height: Theme.sz-34;
                            border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border;
                            background: sp.has-hover ? Theme.red-dim : Theme.bg-primary;
                            Rectangle { width: Theme.sp-12; height: Theme.sp-12; border-radius: Theme.r-chip; background: Theme.red; }
                            sp := TouchArea { mouse-cursor: pointer; clicked => { root.stop(); } }
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        padding-bottom: Theme.sp-4;
                        // Send is a .cc-btn: padding 6px 12px, a 1px border, 12px × the text size.
                        Rectangle {
                            width: st.preferred-width + Theme.sz-26; height: Theme.sz-14 + Theme.sz-14 * root.fs;
                            // The glow (0 2px 12px rgba(99,102,241,.35)), in soft layers.
                            for l in Theme.glow-send: Rectangle { x: -l.e; y: l.y - l.e; width: parent.width + 2 * l.e; height: parent.height + 2 * l.e; border-radius: Theme.r-control + l.e; background: l.c; }
                            Rectangle {
                            border-radius: Theme.r-control;
                            // The accent gradient in its rounded shape (AccentFill).
                            AccentFill { width: parent.width; height: parent.height; }
                            st := Text { text: "Send"; font-size: Theme.text-12 * root.fs; font-weight: Theme.w-semibold; color: white; }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { if root.draft != "" { root.send(root.draft); root.draft = ""; } }
                            }
                            }
                        }
                    }
                }
                // A narrow pane: the box on its own row, the buttons under it.
                if root.narrow: InputBox { fs: root.fs; draft <=> root.draft; ctrl-enter: root.ctrl-enter; send(t) => { root.send(t); } }
                if root.narrow: HorizontalLayout {
                    spacing: Theme.sp-8;
                    alignment: end;
                    VerticalLayout {
                        alignment: end;
                        Rectangle {
                            width: Theme.sz-34; height: Theme.sz-34;
                            border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border;
                            background: at2.has-hover ? Theme.bg-hover : Theme.bg-primary;
                            Icon { source: Icons.paperclip; width: Theme.icon-lg; height: Theme.icon-lg; tint: Theme.text-secondary; }
                            at2 := TouchArea { mouse-cursor: pointer; }
                        }
                    }
                    if root.state == "working": VerticalLayout {
                        alignment: end;
                        Rectangle {
                            width: Theme.sz-34; height: Theme.sz-34;
                            border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border;
                            background: sp2.has-hover ? Theme.red-dim : Theme.bg-primary;
                            Rectangle { width: Theme.sp-12; height: Theme.sp-12; border-radius: Theme.r-chip; background: Theme.red; }
                            sp2 := TouchArea { mouse-cursor: pointer; clicked => { root.stop(); } }
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        padding-bottom: Theme.sp-4;
                        Rectangle {
                            width: st2.preferred-width + Theme.sz-26; height: Theme.sz-14 + Theme.sz-14 * root.fs;
                            // The glow (0 2px 12px rgba(99,102,241,.35)), in soft layers.
                            for l in Theme.glow-send: Rectangle { x: -l.e; y: l.y - l.e; width: parent.width + 2 * l.e; height: parent.height + 2 * l.e; border-radius: Theme.r-control + l.e; background: l.c; }
                            Rectangle {
                            border-radius: Theme.r-control;
                            // The accent gradient in its rounded shape (AccentFill).
                            AccentFill { width: parent.width; height: parent.height; }
                            st2 := Text { text: "Send"; font-size: Theme.text-12 * root.fs; font-weight: Theme.w-semibold; color: white; }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { if root.draft != "" { root.send(root.draft); root.draft = ""; } }
                            }
                            }
                        }
                    }
                }
                // The meta row: 22px, gap 7, 11px muted (the web chat's .cc-meta).
                HorizontalLayout {
                    height: max(Theme.sz-22, Theme.sz-22 * root.fs);
                    spacing: Theme.sp-8;
                    Text { text: root.state == "" ? "idle" : root.state; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; vertical-alignment: center; }
                    // The permission mode: 22px, 0 6px, gap 5, radius 5.
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: Theme.sz-22 * root.fs;
                        width: max(Theme.sz-26 * root.fs, mr.preferred-width + Theme.sp-12);
                        border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border;
                        background: Theme.bg-primary;
                        mr := HorizontalLayout {
                            x: Theme.sp-6;
                            spacing: Theme.sp-6;
                            Icon { source: Icons.shield-alert; width: Theme.icon-md * root.fs; height: Theme.icon-md * root.fs; y: (parent.height - self.height) / 2; tint: Theme.text-secondary; }
                            Text { text: root.mode; font-size: Theme.text-11 * root.fs; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                    }
                    // Which key sends: a 56×19 switch, then "sends".
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: Theme.sp-6;
                        Rectangle {
                            y: Theme.sp-2; width: Theme.switch-w; height: Theme.sp-20;
                            border-radius: Theme.r-pill;
                            background: Theme.bg-tertiary;
                            Rectangle {
                                x: root.ctrl-enter ? Theme.sp-24 : Theme.sp-2; y: Theme.sp-2;
                                width: root.ctrl-enter ? Theme.sz-30 : Theme.sp-24; height: Theme.sp-16;
                                border-radius: Theme.r-pill; border-width: 1px; border-color: Theme.accent;
                                background: Theme.accent-dim;
                            }
                            Text { x: Theme.sp-10; text: "⏎"; font-size: Theme.text-11; font-weight: Theme.w-bold; color: root.ctrl-enter ? Theme.text-secondary : Theme.accent-hover; vertical-alignment: center; height: parent.height; }
                            Text { x: Theme.sp-32; text: "⌃⏎"; font-size: Theme.text-11; font-weight: Theme.w-bold; color: root.ctrl-enter ? Theme.accent-hover : Theme.text-secondary; vertical-alignment: center; height: parent.height; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.ctrl-enter = !root.ctrl-enter; } }
                        }
                        Text { text: "sends"; font-size: Theme.text-11 * root.fs; color: Theme.text-secondary; vertical-alignment: center; }
                    }
                    // Schedule this message: 25×21, 3px 5px, border, radius 6.
                    Rectangle {
                        y: Theme.sp-2; width: Theme.sz-26; height: Theme.sz-22;
                        border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border;
                        Icon { source: Icons.clock; width: Theme.icon-md; height: Theme.icon-md; tint: Theme.text-secondary; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // The session id: mono 10.5px, a dotted line under it.
                    Rectangle {
                        width: sid.preferred-width;
                        sid := Text { text: root.session; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; vertical-alignment: center; height: parent.height; }
                        for i in ceil(sid.preferred-width / Theme.sp-4): Rectangle { x: i * Theme.sp-4; y: parent.height - Theme.sp-4; width: 1px; height: 1px; background: Theme.border; }
                    }
                    Text { text: root.model; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; vertical-alignment: center; }
                    Text { text: root.cost; font-size: Theme.text-11 * root.fs; color: Theme.text-muted; vertical-alignment: center; }
                }
            }
        }
    }
}
