// A chat pane, as the web UI's chat (app/vendor/claude-chat.js) draws it:
// the pane header, the log, and the composer. Sizes and colours are its CSS.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Pointer, AccentFill, SoftShadow, ScrollThumb, DashedBox } from "widgets.slint";
import { ListView } from "std-widgets.slint";

export struct ToolView {
    title: string,
    detail: string,
    text: string,
    // running | done
    status: string,
    error: bool,
}

export struct EntryView {
    id: string,
    // user | assistant | code | thinking | tools | permission | question | result | error | notice
    kind: string,
    text: string,
    md: styled-text,
    title: string,
    detail: string,
    status: string,
    error: bool,
    request-id: string,
    options: [string],
    tools: [ToolView],
    // The space after this row (paragraphs, list items, entries: src/app.rs).
    gap: length,
}

/// The state dot's colour (header and sidebar agree).
export global PaneState {
    public pure function color(state: string) -> color {
        return state == "working" ? Theme.yellow
            : state == "needs-input" ? Theme.accent
            : state == "waiting" ? Theme.sky
            : state == "exited" ? Theme.text-muted
            : Theme.green;
    }
}

/// A tooltip's box. The web's are the system's own (the title attribute);
/// Slint draws its own, so this is the closest (PLAN.md, Known gaps).
export component TipBox inherits Rectangle {
    in property <string> text;
    background: Theme.bg-tertiary;
    border-radius: Theme.r-chip;
    border-width: 1px;
    border-color: Theme.border;
    width: tt.preferred-width + Theme.sp-16;
    height: tt.preferred-height + Theme.sp-8;
    tt := Text { text: root.text; font-size: Theme.text-12; color: Theme.text-primary; }
}

/// A pane header button (.term-font-btn and its kin): a border, bg-primary,
/// radius 6, text-secondary; hover: text-primary on an accent border.
/// Its box is given (the spec's measured sizes); the icon or label is centred.
component HeadBtn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon;
    in property <length> icon-size: Theme.icon-sm;
    in property <length> label-size: Theme.text-11;
    in property <string> tip;
    // rest | on (yellow: secrets granted) | pinned (accent fill) | lit (accent: full screen)
    // | armed (red: "Sure?") | close (the ×: red on hover)
    in property <string> look: "rest";
    // A count after the icon (the secrets lock); and a label after that (the
    // lock in the narrow header's menu).
    in property <string> count;
    in property <string> after;
    callback clicked();
    property <bool> hover: ta.has-hover;
    property <color> ink: root.look == "on" ? Theme.yellow
        : root.look == "armed" ? Theme.red
        : root.look == "pinned" || root.look == "lit" ? Theme.accent-hover
        : root.look == "close" && root.hover ? Theme.red
        : root.hover ? Theme.text-primary : Theme.text-secondary;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.look == "on" ? Theme.yellow
        : root.look == "armed" ? Theme.red
        : root.look == "pinned" || root.look == "lit" ? Theme.accent
        : root.look == "close" && root.hover ? Theme.red
        : root.hover ? Theme.accent : Theme.border;
    background: root.look == "armed" ? Theme.red-dim : root.look == "pinned" ? Theme.accent-dim : Theme.bg-primary;
    accessible-role: button;
    accessible-label: root.tip;
    if root.has-icon && root.count == "" && root.after == "": Image {
        source: root.icon;
        width: root.icon-size; height: root.icon-size;
        colorize: root.ink;
    }
    // The lock with its count (and label), side by side.
    if root.has-icon && (root.count != "" || root.after != ""): HorizontalLayout {
        x: Theme.sp-8;
        width: self.preferred-width;
        spacing: Theme.sp-4;
        alignment: start;
        Image {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            width: root.icon-size; height: root.icon-size;
            colorize: root.ink;
        }
        if root.count != "": Text { text: root.count; font-size: Theme.text-11; color: root.ink; vertical-alignment: center; }
        if root.after != "": Text { text: root.after; font-size: Theme.text-11; color: root.ink; vertical-alignment: center; }
    }
    if !root.has-icon: Text { text: root.label; font-size: root.label-size; color: root.ink; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Tooltip { TipBox { text: root.tip; } }
    }
}

/// A chat-card button: border, bg-tertiary, radius 6.
/// Primary: the accent gradient (the web UI's global button.primary).
component CardBtn inherits Rectangle {
    in property <string> text;
    // The pane's text size (the web's --cc-fs).
    in property <float> fs: 1;
    in property <bool> primary;
    in property <bool> danger;
    callback clicked();
    // .cc-btn: padding round a line of text at the pane's size.
    height: Theme.sp-12 + Theme.sp-16 * root.fs;
    width: t.preferred-width + Theme.sp-24;
    border-radius: Theme.r-control;
    border-width: root.primary ? 0px : 1px;
    border-color: root.danger && ta.has-hover ? Theme.red : Theme.border;
    background: root.primary ? transparent
        : root.danger && ta.has-hover ? Theme.red-dim
        : ta.has-hover ? Theme.bg-hover : Theme.bg-tertiary;
    // Primary: the accent gradient in its rounded shape (AccentFill).
    if root.primary: AccentFill { width: parent.width; height: parent.height; }
    t := Text { text: root.text; font-size: Theme.text-12 * root.fs; font-weight: Theme.w-semibold; color: root.primary ? Theme.white : root.danger && ta.has-hover ? Theme.red : Theme.text-primary; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// Where a pane's header can be grabbed (its background, the ⋮⋮, the title):
/// a press that moves a little (sp-6) with the left button starts dragging the
/// pane (2.3); the release drops it. A click that didn't move stays a click
/// (`did-drag` says which). Positions are in window coordinates.
component HeadGrab inherits TouchArea {
    in property <bool> can-drag: true;
    in property <MouseCursor> rest-cursor: MouseCursor.default;
    out property <bool> dragging;
    out property <bool> did-drag;
    // Its tooltip may show: not once a button went down (Chromium hides a
    // title tooltip on a press), and not again until the pointer has left
    // and come back.
    out property <bool> tip-ok: true;
    changed has-hover => { if !self.has-hover { self.tip-ok = true; } }
    callback drag(int, length, length);
    mouse-cursor: self.dragging ? MouseCursor.grabbing : self.rest-cursor;
    pointer-event(ev) => {
        if ev.kind == PointerEventKind.down { self.tip-ok = false; }
        if ev.button == PointerEventButton.left {
            if ev.kind == PointerEventKind.down { self.did-drag = false; }
            if ev.kind == PointerEventKind.up && self.dragging {
                self.dragging = false;
                root.drag(2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    moved => {
        if self.pressed && self.can-drag {
            if !self.dragging && (abs(self.mouse-x - self.pressed-x) > Theme.sp-6 || abs(self.mouse-y - self.pressed-y) > Theme.sp-6) {
                self.dragging = true;
                self.did-drag = true;
                root.drag(0, self.absolute-position.x + self.pressed-x, self.absolute-position.y + self.pressed-y);
            }
            if self.dragging { root.drag(1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        }
    }
}

/// The CHAT tag: a small pill, bold upper case.
component KindTag inherits Rectangle {
    in property <string> text;
    height: Theme.sp-16;
    width: tag.preferred-width + Theme.sp-16;
    border-radius: Theme.r-pill;
    border-width: 1px;
    border-color: Theme.border;
    // Slint draws small bold capitals smaller than Chromium: a size up and
    // tight tracking match the web's glyphs (PLAN.md, "Small bold text").
    tag := Text { text: root.text; font-size: Theme.text-11; font-weight: Theme.w-bold; color: Theme.accent-hover; letter-spacing: Theme.track-tight; }
}

/// The header's PLANNING tag (.term-plan-tag): a chat in Plan mode with no
/// plan of its own yet. Sky text in a sky pill; not clickable.
component PlanTag inherits Rectangle {
    height: Theme.sp-16;
    width: pt.preferred-width + 2 * Theme.sp-6;
    border-radius: Theme.r-pill;
    border-width: 1px;
    border-color: Theme.sky;
    pt := Text { text: "PLANNING"; font-size: Theme.text-10; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide; color: Theme.sky; }
    TouchArea { Tooltip { TipBox { text: "Plan mode — Claude is working one out"; } } }
}

/// The pane header (.term-head): bg-secondary, a line under it, its items
/// in a row (specs/pane-header-wide.md). Narrow (2.2,
/// specs/pane-header-narrow.md): the tools fold into "…", the header is
/// lower (pane-head-narrow) and every item stays centred.
export component PaneHead inherits Rectangle {
    // The title shown (the long form on a wide header), its cap, and the
    // short title a rename starts from.
    in property <string> title;
    in property <length> title-max: Theme.title-cap;
    in property <string> short-title;
    in property <string> state;
    in property <string> kind-tag;
    // Plan mode, no plan yet: the PLANNING tag before CHAT (2.6).
    in property <bool> planning;
    in property <bool> chat;
    // The header's content box is under pane-fold: src/head.rs.
    in property <bool> narrow;
    // The fold-out menu is open (src/app.rs: one at a time).
    in property <bool> menu-open;
    // The secrets lock: shown when the server can (chat-secret-preauth); the
    // number of grants, and its tooltip.
    in property <bool> secrets;
    in property <int> secrets-n;
    in property <string> secrets-tip;
    in property <bool> pinned;
    in property <bool> full;
    // The × was clicked once: "Sure?" (src/app.rs disarms it after 3 s).
    in property <bool> armed;
    // No pin button (the drag's clone).
    in property <bool> no-pin;
    // Where "…" sits (from the header's left), for the menu's outside-press test.
    out property <length> more-left: self.width - Theme.sp-4 - (root.armed ? sure-m.preferred-width + Theme.sp-12 : Theme.sp-24) - Theme.sp-4 - Theme.sp-24;
    out property <length> more-top: (self.height - 1px - Theme.sp-20) / 2;
    callback close();
    callback full-screen();
    callback font(int);
    callback font-reset();
    callback pin();
    callback open-secrets();
    callback rename(string);
    callback maximize();
    callback more();
    // The header dragged (HeadGrab): 0 start, 1 move, 2 release.
    callback drag(int, length, length);
    property <bool> renaming;
    // The agent badge's text, upper case (none for idle and exited).
    property <string> badge: !root.chat ? "" : root.state == "working" ? "WORKING" : root.state == "needs-input" ? "NEEDS INPUT" : root.state == "waiting" ? "WAITING" : "";
    badge-m := Text { visible: false; text: root.badge; font-size: Theme.text-11; font-weight: Theme.w-bold; letter-spacing: Theme.track-tight; }
    height: root.narrow ? Theme.pane-head-narrow : Theme.pane-head;
    background: Theme.bg-secondary;
    sure-m := Text { visible: false; text: "Sure?"; font-size: Theme.text-11; }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    // Double-click the header (its background, handle, dot, tag: not the
    // buttons) to maximise the pane in its split. The whole header is the
    // drag handle (not in full screen).
    HeadGrab {
        can-drag: !root.full;
        double-clicked => { root.maximize(); }
        drag(k, x, y) => { root.drag(k, x, y); }
    }
    HorizontalLayout {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height - 1px;
        padding-left: Theme.sp-2;
        padding-right: Theme.sp-4;
        spacing: Theme.sp-4;
        // The drag handle "⋮⋮", packed tight.
        // Hidden in full screen.
        if !root.full: Rectangle {
            y: (parent.height - self.height) / 2; width: Theme.sp-24; height: Theme.sp-12;
            Text { x: Theme.sp-4; text: "⋮⋮"; font-size: Theme.text-12; letter-spacing: Theme.track-tight; color: Theme.text-muted; vertical-alignment: center; height: parent.height; }
            dh := HeadGrab {
                rest-cursor: MouseCursor.grab;
                double-clicked => { root.maximize(); }
                drag(k, x, y) => { root.drag(k, x, y); }
                if dh.tip-ok && !dh.pressed && !dh.dragging: Tooltip { TipBox { text: "Drag to reorder"; } }
            }
        }
        // The state dot (2.4): green idle, yellow working, accent needs
        // input (with an accent-dim ring), sky waiting, muted exited.
        // Its tooltip is the raw state.
        if root.chat: Rectangle {
            y: (parent.height - self.height) / 2; width: Theme.sp-8; height: Theme.sp-8;
            if root.state == "needs-input": Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: Theme.sp-12; height: Theme.sp-12; border-radius: Theme.r-pill; background: Theme.accent-dim; }
            Rectangle { border-radius: Theme.r-chip; background: PaneState.color(root.state); }
            dt := TouchArea {
                Tooltip { TipBox { text: root.state == "" ? "idle" : root.state; } }
            }
        }
        // The title: semibold, radius 6.
        // Never wider than its cap (title-cap, the long form's, or none when
        // narrow), nor than the row leaves it: the spacer goes to 0 first, but
        // its two gaps stay.
        if !root.renaming: Rectangle {
            property <length> room: root.width - Theme.sp-2 - (root.full ? 0px : Theme.sp-24 + Theme.sp-4) - (root.chat ? Theme.sp-12 : 0px) - Theme.sp-8 - tools.preferred-width - Theme.sp-4
                - (root.badge != "" ? badge-m.preferred-width + Theme.sp-12 + Theme.sp-4 : 0px);
            y: (parent.height - self.height) / 2; height: Theme.sp-16;
            width: max(0px, min(tt.preferred-width + Theme.sp-12, root.title-max, self.room));
            border-radius: Theme.r-control;
            background: th.has-hover ? Theme.bg-tertiary : transparent;
            tt := Text {
                x: Theme.sp-6; width: parent.width - Theme.sp-12;
                text: root.title; font-size: Theme.text-12; font-weight: Theme.w-semibold; color: Theme.text-primary;
                vertical-alignment: center; height: parent.height;
                overflow: elide; wrap: no-wrap;
            }
            th := HeadGrab {
                rest-cursor: MouseCursor.text;
                can-drag: !root.full;
                clicked => { if !self.did-drag { root.renaming = true; } }
                double-clicked => { root.maximize(); }
                drag(k, x, y) => { root.drag(k, x, y); }
                if th.tip-ok && !th.pressed && !th.dragging: Tooltip { TipBox { text: "Click to rename"; } }
            }
        }
        // Renaming: an input title-cap wide, the short title all
        // selected; an accent border and a ring. Enter or leaving it
        // saves; Esc puts the title back.
        if root.renaming: ri := Rectangle {
            y: (parent.height - self.height) / 2; width: Theme.title-cap; height: Theme.sp-20;
            // A press anywhere outside the input saves it, as the web's blur.
            property <int> presses: Pointer.presses;
            changed presses => {
                if root.renaming && (Pointer.press-x < self.absolute-position.x || Pointer.press-x > self.absolute-position.x + self.width
                        || Pointer.press-y < self.absolute-position.y || Pointer.press-y > self.absolute-position.y + self.height) {
                    root.renaming = false;
                    root.rename(ti.text);
                }
            }
            // The focus ring.
            Rectangle { x: -Theme.sp-4; y: -Theme.sp-4; width: parent.width + 2 * Theme.sp-4; height: parent.height + 2 * Theme.sp-4; border-radius: Theme.r-field; background: Theme.accent-ring; }
            Rectangle {
                border-radius: Theme.r-control; border-width: 1px; border-color: Theme.accent;
                background: Theme.bg-primary;
            }
            FocusScope {
                key-pressed(ev) => {
                    if ev.text == Key.Escape { root.renaming = false; return accept; }
                    return reject;
                }
                // The text box (inside the padding and the border), clipped;
                // the text scrolls to keep the caret in view, as a browser's
                // input does (it opens scrolled to the end, all selected).
                // As std LineEdit (lineedit-base.slint), but with the room a
                // browser keeps for its caret, not Slint's caret width.
                Rectangle {
                    x: Theme.sp-8; width: parent.width - Theme.sp-12;
                    clip: true;
                    ti := TextInput {
                        property <length> scroll;
                        // A browser keeps a hairline caret in view at the end, none
                        // while text is selected (the caret isn't drawn).
                        property <length> caret-room: self.anchor-position-byte-offset != self.cursor-position-byte-offset ? 0px : 1px;
                        x: min(0px, max(parent.width - self.width - self.caret-room, self.scroll));
                        width: max(parent.width - self.caret-room, self.preferred-width);
                        font-size: Theme.text-12; font-weight: Theme.w-semibold; color: Theme.text-primary;
                        vertical-alignment: center; height: parent.height;
                        single-line: true;
                        selection-background-color: Theme.selection;
                        selection-foreground-color: Theme.white;
                        init => { self.text = root.short-title; self.focus(); self.select-all(); }
                        cursor-position-changed(at) => {
                            if at.x + self.scroll < 0 {
                                self.scroll = - at.x;
                            } else if at.x + self.scroll > parent.width - self.caret-room {
                                self.scroll = parent.width - at.x - self.caret-room;
                            }
                        }
                        accepted => { if root.renaming { root.renaming = false; root.rename(self.text); } }
                        changed has-focus => { if !self.has-focus && root.renaming { root.renaming = false; root.rename(self.text); } }
                    }
                }
            }
        }
        // The agent badge (2.4), after the title: WORKING, NEEDS INPUT,
        // WAITING; a small pill, bold upper case.
        // It never hides: the title elides first.
        if root.badge != "": Rectangle {
            y: (parent.height - self.height) / 2; height: Theme.sp-12;
            width: badge-m.preferred-width + Theme.sp-12;
            border-radius: Theme.r-pill;
            background: root.state == "working" ? Theme.yellow-dim : root.state == "waiting" ? Theme.sky-dim : Theme.accent-dim;
            // As the CHAT tag: a size up and tight tracking match the web's
            // glyphs (PLAN.md, "Small bold text").
            Text {
                text: root.badge; font-size: Theme.text-11; font-weight: Theme.w-bold; letter-spacing: Theme.track-tight;
                color: root.state == "working" ? Theme.yellow : root.state == "waiting" ? Theme.sky : Theme.accent-hover;
            }
        }
        // The rest is pushed right (the spacer can shrink to 0).
        Rectangle { horizontal-stretch: 1; min-width: 0; }
        // The tools: inline when wide; folded into "…" when narrow, leaving full
        // screen, "…" and ×. (Each is centred on the row.)
        tools := HorizontalLayout {
            spacing: Theme.sp-4;
            if root.planning && !root.narrow: PlanTag { y: (parent.height - self.height) / 2; }
            if root.kind-tag != "" && !root.narrow: KindTag { y: (parent.height - self.height) / 2; text: root.kind-tag; }
            // The secrets lock (wider with a count); yellow with grants.
            if root.chat && root.secrets && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20;
                width: root.secrets-n > 0 ? Theme.sp-24 + Theme.sp-12 : Theme.sp-24;
                has-icon: true; icon: Icons.lock; icon-size: Theme.icon-sm;
                look: root.secrets-n > 0 ? "on" : "rest";
                count: root.secrets-n > 0 ? "" + root.secrets-n : "";
                tip: root.secrets-tip;
                clicked => { root.open-secrets(); }
            }
            // A- / reset / A+ (A+ a step wider, as the web's).
            if root.chat && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-24;
                label: "A-"; tip: "Smaller text";
                am := Text { visible: false; text: "A-"; font-size: Theme.text-11; }
                clicked => { root.font(-1); }
            }
            if root.chat && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-24;
                has-icon: true; icon: Icons.rotate-ccw; icon-size: Theme.icon-sm;
                tip: "Reset text size";
                clicked => { root.font-reset(); }
            }
            if root.chat && !root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-32;
                label: "A+"; tip: "Larger text";
                ap := Text { visible: false; text: "A+"; font-size: Theme.text-11; }
                clicked => { root.font(1); }
            }
            // Pin; pinned: accent on accent-dim, the pin turned.
            if !root.narrow && !root.no-pin: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-24;
                // Pinned, the icon is turned (drawn turned: pin-turned).
                has-icon: true; icon: root.pinned ? Icons.pin-turned : Icons.pin; icon-size: Theme.icon-md;
                look: root.pinned ? "pinned" : "rest";
                tip: root.pinned ? "Unpin (size and position are locked)" : "Pin size and position";
                clicked => { root.pin(); }
            }
            // Full screen; accent while on.
            if root.chat: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-24;
                has-icon: true; icon: Icons.maximize; icon-size: Theme.icon-sm;
                look: root.full ? "lit" : "rest";
                tip: "Full screen";
                clicked => { root.full-screen(); }
            }
            // "…"; accent while its menu is open, hovered or not.
            if root.narrow: HeadBtn {
                y: (parent.height - self.height) / 2; height: Theme.sp-20; width: Theme.sp-24;
                has-icon: true; icon: Icons.more; icon-size: Theme.icon-sm;
                look: root.menu-open ? "lit" : "rest";
                tip: "More";
                clicked => { root.more(); }
            }
            // Close takes two clicks: "×", then armed: "Sure?", red.
            // Hidden in full screen.
            if !root.full: HeadBtn {
                y: (parent.height - self.height) / 2;
                height: Theme.sp-16;
                width: root.armed ? sure.preferred-width + Theme.sp-12 : Theme.sp-24;
                label: root.armed ? "Sure?" : "×";
                label-size: root.armed ? Theme.text-11 : Theme.text-14;
                look: root.armed ? "armed" : "close";
                tip: root.armed ? "Click again to close" : "Close chat";
                sure := Text { visible: false; text: "Sure?"; font-size: Theme.text-11; }
                clicked => { root.close(); }
            }
        }
    }
}

/// The narrow header's menu (.term-head.tools-open .term-head-tools): the
/// folded tools in a wrapping row, right-aligned; bg-secondary, a border,
/// radius 6, a soft shadow. At most `max-w` wide (the header, less its insets).
/// A-, reset, A+ and pin act and leave it open; the lock closes it. A press
/// outside it (but on "…", which toggles it) closes it and still acts; Esc
/// closes it (the web has no Esc here: DESIGN rule 5, as the brief asks).
export component HeadMenu inherits Rectangle {
    in property <length> max-w;
    in property <string> kind-tag;
    // Plan mode, no plan yet: the PLANNING tag before CHAT (2.6).
    in property <bool> planning;
    in property <bool> secrets;
    in property <int> secrets-n;
    in property <string> secrets-tip;
    in property <bool> pinned;
    // "…" in window coordinates: a press there is its own toggle.
    in property <length> more-x;
    in property <length> more-y;
    callback font(int);
    callback font-reset();
    callback pin();
    callback open-secrets();
    callback dismiss();
    // As wide as its items on one line, but no wider than `max-w`: then it
    // wraps.
    property <length> lock-w: Theme.sp-8 + Theme.sp-12 + Theme.sp-4 + (root.secrets-n > 0 ? cnt-m.preferred-width + Theme.sp-4 : 0px) + lbl-m.preferred-width + Theme.sp-8;
    property <length> natural: Theme.sp-16 + (root.kind-tag != "" ? tag-m.preferred-width + Theme.sp-16 + Theme.sp-6 : 0px)
        + (root.planning ? plan-m.preferred-width + 2 * Theme.sp-6 + Theme.sp-6 : 0px)
        + (root.secrets ? self.lock-w + Theme.sp-6 : 0px)
        + Theme.sp-24 + Theme.sp-6 + Theme.sp-24 + Theme.sp-6 + Theme.sp-32 + Theme.sp-6 + Theme.sp-24;
    width: min(root.max-w, self.natural + Theme.sp-2);
    height: fl.preferred-height + Theme.sp-2;
    plan-m := Text { visible: false; text: "PLANNING"; font-size: Theme.text-10; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide; }
    tag-m := Text { visible: false; text: root.kind-tag; font-size: Theme.text-11; font-weight: Theme.w-bold; letter-spacing: Theme.track-tight; }
    cnt-m := Text { visible: false; text: root.secrets-n; font-size: Theme.text-11; }
    lbl-m := Text { visible: false; text: "Secrets for this chat"; font-size: Theme.text-11; }
    // A soft shadow (the software renderer has no blur: SoftShadow).
    SoftShadow { width: root.width; height: root.height; radius: Theme.r-control; shadow: Theme.shadow-menu; }
    Rectangle {
        background: Theme.bg-secondary;
        border-radius: Theme.r-control;
        border-width: 1px;
        border-color: Theme.border;
    }
    property <int> presses: Pointer.presses;
    changed presses => {
        let ax = self.absolute-position.x;
        let ay = self.absolute-position.y;
        let inside = Pointer.press-x >= ax && Pointer.press-x <= ax + self.width && Pointer.press-y >= ay && Pointer.press-y <= ay + self.height;
        let on-more = Pointer.press-x >= root.more-x && Pointer.press-x <= root.more-x + Theme.sp-24 && Pointer.press-y >= root.more-y && Pointer.press-y <= root.more-y + Theme.sp-20;
        if !inside && !on-more { root.dismiss(); }
    }
    // Clicks on the menu's own padding stay in it.
    TouchArea { }
    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(ev) => {
            if ev.text == Key.Escape { root.dismiss(); return accept; }
            return reject;
        }
        fl := FlexboxLayout {
            x: 1px; y: 1px;
            width: parent.width - Theme.sp-2;
            // Its own height, and lines packed at the top: a stretched line
            // would push the items down.
            height: self.preferred-height;
            cross-axis-line-alignment: start;
            padding: Theme.sp-8;
            spacing: Theme.sp-6;
            flex-wrap: wrap;
            alignment: end;
            cross-axis-alignment: center;
            if root.planning: PlanTag { }
            if root.kind-tag != "": KindTag { text: root.kind-tag; }
            // The lock with its label: icon, the count if any, "Secrets for
            // this chat".
            if root.secrets: HeadBtn {
                height: Theme.sp-20;
                width: root.lock-w;
                has-icon: true; icon: Icons.lock; icon-size: Theme.icon-sm;
                look: root.secrets-n > 0 ? "on" : "rest";
                count: root.secrets-n > 0 ? "" + root.secrets-n : "";
                after: "Secrets for this chat";
                tip: root.secrets-tip;
                clicked => { root.open-secrets(); }
            }
            HeadBtn {
                height: Theme.sp-20; width: Theme.sp-24;
                label: "A-"; tip: "Smaller text";
                am := Text { visible: false; text: "A-"; font-size: Theme.text-11; }
                clicked => { root.font(-1); }
            }
            HeadBtn {
                height: Theme.sp-20; width: Theme.sp-24;
                has-icon: true; icon: Icons.rotate-ccw; icon-size: Theme.icon-sm;
                tip: "Reset text size";
                clicked => { root.font-reset(); }
            }
            HeadBtn {
                height: Theme.sp-20; width: Theme.sp-32;
                label: "A+"; tip: "Larger text";
                ap := Text { visible: false; text: "A+"; font-size: Theme.text-11; }
                clicked => { root.font(1); }
            }
            HeadBtn {
                height: Theme.sp-20; width: Theme.sp-24;
                has-icon: true; icon: root.pinned ? Icons.pin-turned : Icons.pin; icon-size: Theme.icon-md;
                look: root.pinned ? "pinned" : "rest";
                tip: root.pinned ? "Unpin (size and position are locked)" : "Pin size and position";
                clicked => { root.pin(); }
            }
        }
    }
}

/// Text that can be selected and copied.
component Prose inherits TextInput {
    // The pane's text size, a scale of the base size (the web's --cc-fs).
    in property <float> fs: 1;
    read-only: true;
    wrap: word-wrap;
    line-height-factor: Theme.lh-chat;
    color: Theme.text-primary;
    font-size: Theme.text-13 * root.fs;
    selection-background-color: Theme.accent-dim;
}

component ToolRow inherits Rectangle {
    // The pane's text size, a scale of the base size (the web's --cc-fs).
    in property <float> fs: 1;
    in property <ToolView> t;
    property <bool> open;
    background: Theme.bg-secondary;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: Theme.border-subtle;
    height: col.preferred-height;
    col := VerticalLayout {
        Rectangle {
            height: Theme.sp-32 + (root.fs - 1) * Theme.sp-16;
            HorizontalLayout {
                padding-left: Theme.sp-10;
                padding-right: Theme.sp-10;
                spacing: Theme.sp-8;
                Rectangle {
                    width: Theme.sp-6; height: Theme.sp-6; y: (parent.height - self.height) / 2; border-radius: Theme.r-chip;
                    background: t.status == "running" ? Theme.yellow : t.error ? Theme.red : Theme.green;
                }
                Text { text: t.title; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; font-weight: Theme.w-semibold; color: t.error ? Theme.red : Theme.accent-hover; vertical-alignment: center; }
                Text { text: t.detail; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: root.open ? "▾" : "▸"; font-size: Theme.text-10 * root.fs; color: Theme.text-muted; vertical-alignment: center; }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
        }
        if root.open && t.text != "": Rectangle {
            height: min(out.preferred-height + Theme.sp-12, Theme.composer-max * 2);
            Rectangle { y: 0; height: 1px; background: Theme.border-subtle; }
            Flickable {
                y: 1px;
                height: parent.height - 1px;
                content-height: out.preferred-height + Theme.sp-12;
                out := TextInput {
                    x: Theme.sp-10; y: Theme.sp-8; width: parent.width - Theme.sp-16;
                    read-only: true; wrap: word-wrap;
                    text: t.text;
                    font-family: Theme.mono; font-size: Theme.text-12 * root.fs;
                    color: Theme.text-secondary;
                }
            }
        }
    }
}

component EntryRow inherits VerticalLayout {
    // The pane's text size, a scale of the base size (the web's --cc-fs).
    in property <float> fs: 1;
    in property <EntryView> e;
    // The width rows can use (from the list, not from the row: no loop).
    in property <length> avail;
    callback respond(string, string, bool);
    callback answer(string, string);
    property <bool> open;
    property <string> picked;
    padding-bottom: e.gap;

    if e.kind == "user": HorizontalLayout {
        alignment: end;
        Rectangle {
            width: min(ub-measure.preferred-width + Theme.sp-24, root.avail * Theme.bubble-share);
            background: Theme.accent-dim;
            border-width: 1px;
            border-color: Theme.accent-edge;
            border-top-left-radius: Theme.r-bubble;
            border-top-right-radius: Theme.r-bubble;
            border-bottom-right-radius: Theme.r-chip;
            border-bottom-left-radius: Theme.r-bubble;
            height: ub.preferred-height + Theme.sp-16;
            ub-measure := Text { visible: false; text: e.text; font-size: Theme.text-13 * root.fs; }
            ub := Prose { fs: root.fs; x: Theme.sp-12; y: Theme.sp-8; width: parent.width - Theme.sp-20; text: e.text; }
        }
    }

    // The web's line box is line-chat × the text size; StyledText has no line
    // height, so its one line is padded to that box: half the difference
    // above and below (the font's own line measured, so any system font fits).
    if e.kind == "assistant" && e.status != "li": pl := VerticalLayout {
        property <length> size: Theme.text-14 * root.fs;
        padding-top: max(0px, (self.size * Theme.line-chat - pm.preferred-height) / 2);
        padding-bottom: self.padding-top;
        Rectangle { height: 0; pm := Text { visible: false; text: "X"; font-size: pl.size; } }
        // Its width given, so its wrapped height is measured at the width it
        // is drawn at (F24: a long inline code token wrapped differently).
        StyledText {
            width: root.avail;
            text: e.md;
            default-color: Theme.text-primary;
            default-font-size: Theme.text-14 * root.fs;
            link-color: Theme.accent-hover;
        }
    }
    if e.kind == "assistant" && e.status == "li": HorizontalLayout {
        padding-top: max(0px, (Theme.text-13 * root.fs * Theme.line-chat - lm.preferred-height) / 2);
        padding-bottom: self.padding-top;
        Rectangle { width: 0; lm := Text { visible: false; text: "X"; font-size: Theme.text-13 * root.fs; } }
        Text { width: Theme.sp-20; text: e.title; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; horizontal-alignment: center; }
        StyledText {
            width: root.avail - Theme.sp-20;
            text: e.md;
            default-color: Theme.text-primary;
            default-font-size: Theme.text-13 * root.fs;
            link-color: Theme.accent-hover;
        }
    }

    if e.kind == "code": Rectangle {
        background: Theme.bg-secondary;
        border-width: 1px;
        border-color: Theme.border-subtle;
        border-radius: Theme.r-control;
        height: code.preferred-height + Theme.sp-16;
        code := TextInput {
            x: Theme.sp-12; y: Theme.sp-8; width: parent.width - Theme.sp-20;
            read-only: true; wrap: word-wrap;
            text: e.text;
            font-family: Theme.mono; font-size: Theme.text-12 * root.fs;
            color: Theme.text-primary;
        }
    }

    if e.kind == "thinking": HorizontalLayout {
        spacing: Theme.sp-6;
        Rectangle { width: Theme.sp-6; height: Theme.sp-6; border-radius: Theme.r-chip; y: Theme.sp-8; background: Theme.text-muted; }
        VerticalLayout {
            Text {
                text: "Thought";
                font-size: Theme.text-12 * root.fs; font-italic: true; color: Theme.text-muted;
                TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
            }
            if root.open: Text { text: e.text; font-size: Theme.text-12 * root.fs; font-italic: true; color: Theme.text-muted; wrap: word-wrap; }
        }
    }

    if e.kind == "tool": VerticalLayout {
        for t in e.tools: ToolRow { t: t; fs: root.fs; }
    }

    if e.kind == "tools": VerticalLayout {
        spacing: Theme.sp-6;
        Rectangle {
            height: Theme.control + (root.fs - 1) * Theme.sp-16;
            background: Theme.bg-secondary;
            border-radius: Theme.r-control;
            border-width: 1px;
            border-color: Theme.border-subtle;
            HorizontalLayout {
                padding-left: Theme.sp-10;
                padding-right: Theme.sp-10;
                spacing: Theme.sp-8;
                Rectangle {
                    width: Theme.sp-6; height: Theme.sp-6; y: (parent.height - self.height) / 2; border-radius: Theme.r-chip;
                    background: e.status == "running" ? Theme.yellow : e.error ? Theme.red : Theme.green;
                }
                Text { text: e.title; font-size: Theme.text-12 * root.fs; color: Theme.text-primary; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: e.detail + (root.open ? "  ▾" : "  ▸"); font-size: Theme.text-11 * root.fs; color: Theme.text-muted; vertical-alignment: center; }
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
        }
        if root.open: VerticalLayout {
            spacing: Theme.sp-6;
            for t in e.tools: ToolRow { t: t; fs: root.fs; }
        }
    }

    if e.kind == "permission": Rectangle {
        background: e.status == "pending" ? Theme.yellow-dim : Theme.bg-secondary;
        border-width: 1px;
        border-color: e.status == "pending" ? Theme.yellow : Theme.border-subtle;
        border-radius: Theme.r-card;
        height: perm.preferred-height;
        perm := VerticalLayout {
            padding-top: Theme.sp-12; padding-bottom: Theme.sp-12; padding-left: Theme.sp-12; padding-right: Theme.sp-12;
            spacing: Theme.sp-8;
            Text { text: e.title; font-weight: Theme.w-semibold; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; wrap: word-wrap; }
            if e.detail != "": Rectangle {
                background: Theme.bg-primary;
                border-radius: Theme.r-control;
                height: pd.preferred-height + Theme.sp-12;
                pd := Text { x: Theme.sp-10; width: parent.width - Theme.sp-16; text: e.detail; font-family: Theme.mono; font-size: Theme.text-12 * root.fs; color: Theme.text-secondary; wrap: word-wrap; }
            }
            if e.status == "pending": HorizontalLayout {
                spacing: Theme.sp-8;
                alignment: start;
                CardBtn { fs: root.fs; text: "Allow"; primary: true; clicked => { root.respond(e.request-id, "allow", false); } }
                CardBtn { fs: root.fs; text: "Allow always"; clicked => { root.respond(e.request-id, "allow", true); } }
                CardBtn { fs: root.fs; text: "Deny"; danger: true; clicked => { root.respond(e.request-id, "deny", false); } }
            }
            if e.status != "pending": Text { text: e.status == "allowed" ? "Allowed" : e.status == "denied" ? "Denied" : e.status; font-size: Theme.text-12 * root.fs; color: Theme.text-muted; }
        }
    }

    if e.kind == "question": Rectangle {
        background: e.status == "pending" ? Theme.accent-dim : Theme.bg-secondary;
        border-width: 1px;
        border-color: e.status == "pending" ? Theme.accent : Theme.border-subtle;
        border-radius: Theme.r-card;
        height: q.preferred-height;
        q := VerticalLayout {
            padding-top: Theme.sp-12; padding-bottom: Theme.sp-12; padding-left: Theme.sp-12; padding-right: Theme.sp-12;
            spacing: Theme.sp-8;
            if e.title != "": Text { text: e.title; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-bold; color: Theme.accent-hover; letter-spacing: Theme.track-wide; }
            Text { text: e.text; font-weight: Theme.w-semibold; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; wrap: word-wrap; }
            if e.status == "pending": VerticalLayout {
                spacing: Theme.sp-6;
                for o in e.options: Rectangle {
                    height: Theme.sp-32 + (root.fs - 1) * Theme.sp-20;
                    border-radius: Theme.r-control;
                    border-width: 1px;
                    border-color: root.picked == o ? Theme.accent : Theme.border;
                    background: root.picked == o ? Theme.accent-dim : oh.has-hover ? Theme.bg-hover : Theme.bg-primary;
                    HorizontalLayout {
                        padding-left: Theme.sp-10;
                        spacing: Theme.sp-8;
                        Rectangle {
                            width: Theme.sp-12; height: Theme.sp-12; y: (parent.height - self.height) / 2; border-radius: Theme.r-control;
                            border-width: 1px; border-color: root.picked == o ? Theme.accent : Theme.text-muted;
                            Rectangle { width: Theme.sp-6; height: Theme.sp-6; border-radius: Theme.r-chip; background: root.picked == o ? Theme.accent : transparent; }
                        }
                        Text { text: o; font-size: Theme.text-13 * root.fs; color: Theme.text-primary; vertical-alignment: center; }
                    }
                    oh := TouchArea { mouse-cursor: pointer; clicked => { root.picked = o; } }
                }
                HorizontalLayout {
                    spacing: Theme.sp-8;
                    alignment: start;
                    CardBtn { fs: root.fs; text: "Submit"; primary: true; clicked => { if root.picked != "" { root.answer(e.id, root.picked); } } }
                    CardBtn { fs: root.fs; text: "Dismiss"; danger: true; clicked => { root.respond(e.request-id, "deny", false); } }
                }
            }
            if e.status != "pending": Text { text: "Answered"; font-size: Theme.text-12 * root.fs; color: Theme.text-muted; }
        }
    }

    // The end of a turn: centred, small, a line above.
    if e.kind == "result": VerticalLayout {
        Rectangle {
            height: 1px;
            for i in ceil(self.width / Theme.sp-6): Rectangle { x: i * Theme.sp-6; width: Theme.sp-4; height: 1px; background: Theme.border-subtle; }
        }
        Text {
            text: e.error ? (e.text != "" ? e.text : "Error") : e.detail;
            height: Theme.sp-24 + (root.fs - 1) * Theme.sp-16;
            font-size: Theme.text-11 * root.fs;
            color: e.error ? Theme.red : Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if e.kind == "error": Rectangle {
        background: Theme.red-dim;
        border-width: 1px;
        border-color: Theme.error-edge;
        border-radius: Theme.r-control;
        height: et.preferred-height + Theme.sp-16;
        et := Text { x: Theme.sp-10; width: parent.width - Theme.sp-20; text: e.text; color: Theme.error-text; wrap: word-wrap; font-size: Theme.text-12 * root.fs; }
    }

    if e.kind == "notice": Text { text: e.text; color: Theme.text-muted; font-size: Theme.text-11 * root.fs; horizontal-alignment: center; wrap: word-wrap; }
}

/// A queued-messages drawer (2.9, .cc-queue): held (dashed accent edge,
/// accent tint; hover brighter) or handed over (solid slate edge, slate
/// tint, quieter text; no hover change). Its head (label and note), its text
/// (at most four rows, "…" at the cut) and a hint. A click takes it back.
component QueueDrawer inherits Rectangle {
    in property <float> fs: 1;
    in property <bool> sent;
    in property <bool> recallable;
    in property <string> label;
    in property <string> note;
    in property <string> hint;
    in property <string> tip;
    in property <string> body;
    callback clicked();
    property <bool> hot: !root.sent && ta.has-hover;
    property <length> line: bm.preferred-height;
    property <bool> trimmed: full-m.preferred-height > Theme.queue-rows * self.line + 1px;
    height: col.preferred-height;
    border-radius: Theme.r-card;
    background: root.sent ? Theme.slate-haze : root.hot ? Theme.accent-dim : Theme.accent-haze;
    border-width: root.sent ? 1px : 0px;
    border-color: Theme.slate-edge;
    if !root.sent: DashedBox {
        width: parent.width; height: parent.height;
        thick: 1px; dash: Theme.sp-4; gap: Theme.sp-2; corner: Theme.r-card;
        line: root.hot ? Theme.accent : Theme.accent-line;
    }
    // One line of the body's text, and all of it at the body's width (for the
    // four-row clamp).
    bm := Text { visible: false; text: "X"; font-size: Theme.text-12 * root.fs; }
    full-m := Text { visible: false; width: col.width - 2 * Theme.sp-12; text: root.body; font-size: Theme.text-12 * root.fs; wrap: word-wrap; }
    col := VerticalLayout {
        padding-top: Theme.sp-8; padding-bottom: Theme.sp-8; padding-left: Theme.sp-12; padding-right: Theme.sp-12;
        HorizontalLayout {
            spacing: Theme.sp-6;
            padding-bottom: Theme.sp-2;
            Text {
                vertical-alignment: center;
                text: root.label; font-size: Theme.text-10 * root.fs; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide;
                color: root.sent ? Theme.text-muted : Theme.accent-hover;
            }
            // The note: the label's colour, quieter; it wraps in its own box.
            Text {
                horizontal-stretch: 1; min-width: 0; preferred-width: 0;
                vertical-alignment: center; wrap: word-wrap;
                text: root.note; font-size: Theme.text-10 * root.fs; font-weight: Theme.w-medium;
                color: root.sent ? Theme.text-muted : Theme.accent-hover; opacity: Theme.o-usage;
            }
        }
        Text {
            text: root.body; font-size: Theme.text-12 * root.fs; wrap: word-wrap;
            color: root.sent ? Theme.text-secondary : Theme.text-primary;
            max-height: Theme.queue-rows * root.line;
            overflow: elide;
        }
        Rectangle { height: Theme.sp-4; }
        Text {
            text: (root.trimmed ? "Shown trimmed · " : "") + root.hint;
            font-size: Theme.text-10 * root.fs; color: Theme.text-muted; wrap: word-wrap;
        }
    }
    ta := TouchArea {
        mouse-cursor: root.recallable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
        Tooltip { TipBox { text: root.tip; } }
    }
}

/// What every composer shares with the app (src/app.rs): the Enter mode
/// (one setting for every chat, saved), a request to focus a chat's box,
/// and the controls whose screens come later (attach 2.7, the clock 2.10,
/// the mode chooser 2.6).
export global Composer {
    // Ctrl+Enter sends (Enter makes a newline); otherwise Enter sends.
    in-out property <bool> ctrl-enter;
    callback set-ctrl-enter(bool);
    // Focus this pane's box (its key); counted, so asking again refocuses.
    in-out property <string> focus-key;
    in-out property <int> focus-gen;
    // The session id was copied (its full uuid): the app toasts it.
    callback copied(string);
    callback attach(string);
    callback schedule(string);
    callback mode(string);
    // A pane's caret moved (its key, the caret and the selection's other
    // end, byte offsets): where an attached path will go (2.7).
    callback caret(string, int, int);
    // Ctrl+V (or Shift+Insert) in a pane's box: true when the clipboard held a
    // picture or a file, which the app uploads (the key is then taken).
    callback paste(string, bool) -> bool;
    // Take back what is queued (2.9: a click on a drawer, or ↑ on the box's
    // first row): false when there is nothing to take back.
    callback take-back(string) -> bool;
    // The app put text into a pane's box (an attached path): its whole new
    // text and the caret; counted.
    in-out property <string> insert-key;
    in-out property <string> insert-text;
    in-out property <int> insert-caret;
    in-out property <int> insert-gen;
}

/// The message box (.cc-input): one line at least (`control`), growing with
/// its text (wrapped lines too) to `composer-max`, then scrolling inside.
/// Enter, or Ctrl+Enter when switched, sends.
component InputBox inherits Rectangle {
    // The pane's text size, a scale of the base size (the web's --cc-fs).
    in property <float> fs: 1;
    in-out property <string> draft;
    in property <bool> ctrl-enter;
    in property <bool> enabled: true;
    in property <string> placeholder;
    callback send();
    // The caret moved: the caret and the selection's other end (byte offsets).
    callback caret(int, int);
    // ↑ on the box's first row, nothing selected: true when the app took
    // back what was queued (the key is then taken).
    callback up() -> bool;
    // The caret's row: its top, in the text.
    property <length> caret-y;
    // Ctrl+V / Shift+Insert (true): true when the app took it (a picture, a
    // file; Shift+Insert's text too: Slint's input knows only Ctrl+V).
    callback paste(bool) -> bool;
    public function focus-box() { te.focus(); }
    // The app's text and caret (an attached path put in): the box takes the
    // focus with the caret there.
    public function put(text: string, caret: int) {
        root.draft = text;
        te.set-selection-offsets(caret, caret);
        te.focus();
    }
    out property <bool> focused: te.has-focus && root.enabled;
    property <length> line: Theme.text-13 * root.fs * Theme.line-chat;
    // Dimmed while it can't take text (an exited chat).
    opacity: root.enabled ? 1 : Theme.o-soft;
    height: max(Theme.control, min(Theme.composer-max, te.preferred-height + 2 * Theme.sp-8));
    // The focus ring, outside the border.
    if root.focused: Rectangle {
        x: -Theme.sp-4; y: -Theme.sp-4; width: parent.width + 2 * Theme.sp-4; height: parent.height + 2 * Theme.sp-4;
        border-radius: Theme.r-card; background: Theme.accent-ring;
    }
    Rectangle {
        border-radius: Theme.r-control;
        border-width: 1px;
        border-color: root.focused ? Theme.accent : Theme.border;
        background: Theme.bg-primary;
    }
    Rectangle {
        fl := Flickable {
            x: Theme.sp-10; y: Theme.sp-8;
            width: parent.width - 2 * Theme.sp-10; height: parent.height - 2 * Theme.sp-8;
            content-height: max(self.height, te.preferred-height);
            FocusScope {
                capture-key-pressed(ev) => {
                    if ((ev.modifiers.control || ev.modifiers.meta) && (ev.text == "v" || ev.text == "V")) || (ev.modifiers.shift && ev.text == Key.Insert) {
                        if root.paste(ev.modifiers.shift && ev.text == Key.Insert) { return accept; }
                        return reject;
                    }
                    if ev.text == Key.UpArrow && !ev.modifiers.shift && !ev.modifiers.control && !ev.modifiers.alt && !ev.modifiers.meta
                            && te.cursor-position-byte-offset == te.anchor-position-byte-offset && root.caret-y < root.line / 2 {
                        if root.up() { return accept; }
                        return reject;
                    }
                    if ev.text == Key.Return {
                        if root.ctrl-enter ? (ev.modifiers.control || ev.modifiers.meta) : (!ev.modifiers.shift && !ev.modifiers.control && !ev.modifiers.meta) {
                            root.send();
                            return accept;
                        }
                    }
                    return reject;
                }
                te := TextInput {
                    width: fl.width;
                    height: max(fl.height, self.preferred-height);
                    line-height-factor: Theme.lh-chat;
                    text <=> root.draft;
                    enabled: root.enabled;
                    single-line: false;
                    wrap: word-wrap;
                    font-size: Theme.text-13 * root.fs;
                    color: Theme.text-primary;
                    selection-background-color: Theme.accent-dim;
                    // Past composer-max it scrolls: keep the caret in view.
                    cursor-position-changed(at) => {
                        root.caret(self.cursor-position-byte-offset, self.anchor-position-byte-offset);
                        root.caret-y = at.y;
                        if at.y + fl.content-y < 0 {
                            fl.content-y = -at.y;
                        } else if at.y + root.line + fl.content-y > fl.height {
                            fl.content-y = min(0px, fl.height - at.y - root.line);
                        }
                    }
                }
            }
        }
        // Past composer-max: a scroll thumb on the right, so more text above
        // or below shows (the web's textarea scrollbar).
        ScrollThumb {
            width: parent.width; height: parent.height;
            view-h: fl.height; content-h: te.preferred-height; offset: -fl.content-y;
        }
        if root.draft == "": Text {
            x: Theme.sp-10; y: Theme.sp-8;
            width: parent.width - 2 * Theme.sp-10;
            text: root.placeholder;
            font-size: Theme.text-13 * root.fs;
            color: Theme.text-muted;
            overflow: elide;
        }
    }
}

/// A square bordered button of the composer (attach; the clock in a narrow
/// pane): bg-primary, hover an accent border and icon.
component SquareBtn inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: Theme.icon-lg;
    in property <string> tip;
    in property <bool> fill: true;
    in property <color> ink: Theme.text-secondary;
    // Busy (attach while a file uploads): faint and inert.
    in property <bool> busy;
    callback clicked();
    opacity: root.busy ? Theme.o-soft : 1;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: ta.has-hover && !root.busy ? Theme.accent : Theme.border;
    background: root.fill ? Theme.bg-primary : transparent;
    Icon { source: root.icon; width: root.icon-size; height: root.icon-size; tint: ta.has-hover && !root.busy ? Theme.accent-hover : root.ink; }
    ta := TouchArea {
        enabled: !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Tooltip { TipBox { text: root.tip; } }
    }
}

/// Stop (.cc-stop): a red square; armed (one click), red-dim with "Sure?"
/// sliding in beside it. The app arms and disarms it (src/app.rs).
component StopBtn inherits Rectangle {
    in property <float> fs: 1;
    in property <bool> armed;
    callback clicked();
    property <length> sure-w: root.armed ? sure-m.preferred-width + Theme.sp-4 : 0px;
    animate sure-w { duration: Theme.motion; }
    height: Theme.control;
    width: max(Theme.control, Theme.sp-8 + Theme.icon-md + self.sure-w + Theme.sp-8);
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.armed || ta.has-hover ? Theme.red : Theme.border;
    background: root.armed ? Theme.red-dim : Theme.bg-primary;
    sure-m := Text { visible: false; text: "Sure?"; font-size: Theme.text-11 * root.fs; }
    HorizontalLayout {
        alignment: center;
        Icon { y: (parent.height - self.height) / 2; source: Icons.square; width: Theme.icon-md; height: Theme.icon-md; tint: Theme.red; }
        Rectangle {
            width: root.sure-w;
            clip: true;
            Text { x: Theme.sp-4; text: "Sure?"; font-size: Theme.text-11 * root.fs; color: Theme.red; vertical-alignment: center; height: parent.height; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Tooltip { TipBox { text: root.armed ? "Click again to interrupt" : "Stop this turn (click twice)"; } }
    }
}

/// Send (or Queue while Claude is busy): the accent fill and its glow; never
/// disabled. Narrow, it stretches and is `control` high.
component SendBtn inherits Rectangle {
    in property <float> fs: 1;
    in property <string> label;
    callback clicked();
    border-radius: Theme.r-control;
    SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-control; shadow: Theme.glow-send; }
    AccentFill { width: parent.width; height: parent.height; }
    if ta.has-hover: Rectangle { border-radius: Theme.r-control; background: Theme.accent-hover; }
    st := Text { text: root.label; font-size: Theme.text-12 * root.fs; font-weight: Theme.w-semibold; color: Theme.white; }
    out property <length> text-w: st.preferred-width;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// A permission mode's look (the mode button, the picker's tiles): its
/// icon and its colour, as the web chat's.
export global ModeLook {
    public pure function ink(key: string) -> color {
        return key == "acceptEdits" || key == "auto" ? Theme.accent-hover
            : key == "plan" ? Theme.sky
            : key == "dontAsk" ? Theme.yellow
            : key == "bypassPermissions" ? Theme.red
            : Theme.text-secondary;
    }
    public pure function icon(key: string) -> image {
        return key == "acceptEdits" ? Icons.mode-accept-edits : key == "auto" ? Icons.mode-auto
            : key == "plan" ? Icons.mode-plan : key == "dontAsk" ? Icons.mode-dont-ask
            : key == "bypassPermissions" ? Icons.mode-bypass-permissions : Icons.mode-default;
    }
}

/// The permission mode (.cc-mode): its icon and name in the mode's colour
/// (narrow: the icon only, finger-sized). Plan mode and Bypass all wear a
/// tinted border, which hover keeps. A click opens the picker (2.6).
component ModeBtn inherits Rectangle {
    in property <float> fs: 1;
    in property <string> mode-key;
    in property <string> name;
    in property <bool> icon-only;
    callback clicked();
    property <bool> own-edge: root.mode-key == "plan" || root.mode-key == "bypassPermissions";
    property <color> ink: root.mode-key == "default" || root.mode-key == "" ? (ta.has-hover ? Theme.text-primary : Theme.text-secondary) : ModeLook.ink(root.mode-key);
    height: root.icon-only ? Theme.control-sm * root.fs : Theme.sp-24 * root.fs;
    width: root.icon-only ? Theme.control * root.fs : max(Theme.control-sm * root.fs, row.preferred-width + 2 * Theme.sp-6);
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.mode-key == "plan" ? Theme.sky-edge : root.mode-key == "bypassPermissions" ? Theme.error-edge : ta.has-hover ? Theme.accent : Theme.border;
    background: Theme.bg-primary;
    row := HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        width: self.preferred-width;
        spacing: Theme.sp-4;
        Icon {
            y: (parent.height - self.height) / 2;
            width: Theme.icon-md * root.fs; height: Theme.icon-md * root.fs; tint: root.ink;
            source: ModeLook.icon(root.mode-key);
        }
        if !root.icon-only: Text { text: root.name; font-size: Theme.text-11 * root.fs; color: root.ink; vertical-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        Tooltip { TipBox { text: "Permission mode: " + root.name + ". Click to change."; } }
    }
}

/// Which key sends (.cc-sw): a pill holding ⏎ and ⌃⏎, a thumb under the live
/// one, then "sends". A click swaps them.
component EnterSwitch inherits Rectangle {
    in property <float> fs: 1;
    in property <bool> ctrl;
    callback toggle();
    property <length> w1: g1.preferred-width + 2 * Theme.sp-8;
    property <length> w2: g2.preferred-width + 2 * Theme.sp-8;
    property <length> cell-h: g1.preferred-height + 2 * Theme.sp-2;
    width: self.w1 + self.w2 + 2 * Theme.sp-2 + Theme.sp-4 + sends.preferred-width;
    height: self.cell-h + 2 * Theme.sp-2;
    g1 := Text { visible: false; text: "⏎"; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold; }
    g2 := Text { visible: false; text: "⌃⏎"; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold; }
    Rectangle {
        x: 0; width: root.w1 + root.w2 + 2 * Theme.sp-2;
        border-radius: Theme.r-pill;
        background: Theme.bg-tertiary;
        Rectangle {
            x: Theme.sp-2 + (root.ctrl ? root.w1 : 0px); y: Theme.sp-2;
            width: root.ctrl ? root.w2 : root.w1; height: root.cell-h;
            animate x, width { duration: Theme.motion; }
            border-radius: Theme.r-pill; border-width: 1px; border-color: Theme.accent;
            background: Theme.accent-dim;
        }
        Text {
            x: Theme.sp-2; width: root.w1; height: parent.height; horizontal-alignment: center; vertical-alignment: center;
            text: "⏎"; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold;
            color: root.ctrl ? Theme.text-secondary : Theme.accent-hover; opacity: root.ctrl ? Theme.o-dim : 1;
        }
        Text {
            x: Theme.sp-2 + root.w1; width: root.w2; height: parent.height; horizontal-alignment: center; vertical-alignment: center;
            text: "⌃⏎"; font-family: Theme.mono; font-size: Theme.text-11 * root.fs; font-weight: Theme.w-semibold;
            color: root.ctrl ? Theme.accent-hover : Theme.text-secondary; opacity: root.ctrl ? 1 : Theme.o-dim;
        }
    }
    sends := Text {
        x: root.w1 + root.w2 + 2 * Theme.sp-2 + Theme.sp-4; height: parent.height; vertical-alignment: center;
        text: "sends"; font-size: Theme.text-11 * root.fs; color: ta.has-hover ? Theme.text-primary : Theme.text-secondary;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
        Tooltip { TipBox { text: root.ctrl ? "Enter makes a newline, Ctrl+Enter sends — click to swap" : "Enter sends, Shift+Enter makes a newline — click to swap"; } }
    }
}

/// The chat inside a pane: the log, then the composer (specs/composer.md).
export component ChatPane inherits Rectangle {
    // The pane's key (src/app.rs), for the shared controls (Composer).
    in property <string> key;
    // The pane's text size, a scale of the base size (the web's --cc-fs).
    in property <float> fs: 1;
    in property <[EntryView]> entries;
    // idle | working | needs-input | waiting | exited
    in property <string> state;
    // The permission mode: its key and its name.
    in property <string> mode-key;
    in property <string> mode;
    // Claude's session id: the first 8 characters, and the whole.
    in property <string> session;
    in property <string> session-full;
    in property <string> model;
    in property <string> cost;
    in property <string> error;
    // Narrower than composer-stack: the composer stacks.
    in property <bool> narrow;
    // Stop was clicked once (src/app.rs disarms it after 3 s).
    in property <bool> stop-armed;
    // Uploading (2.7): the bar (shown, the file's name, "42%" or "saving",
    // the share sent) and attach busy; a file dragged over the chat.
    in property <bool> up-on;
    in property <string> up-name;
    in property <string> up-label;
    in property <float> up-frac;
    in property <bool> up-busy;
    in property <bool> file-over;
    // Queued messages (2.9): the held lines (joined) and how many sends; the
    // handed-over ones (joined) and what their drawer says.
    in property <string> q-held;
    in property <int> q-held-n;
    in property <string> q-sent;
    in property <string> q-sent-kind;
    callback send(string);
    callback stop();
    callback respond(string, string, bool);
    callback answer(string, string);
    // The draft as the app holds it (src/app.rs): taken at start and whenever
    // the app changed it (another view of this chat, a send, a refused send);
    // every change is handed back.
    in property <string> saved-draft;
    callback draft-changed(string);
    property <string> draft;
    init => { self.draft = root.saved-draft; }
    changed saved-draft => { if self.draft != root.saved-draft { self.draft = root.saved-draft; } }
    in property <int> draft-gen;
    changed draft-gen => { self.draft = root.saved-draft; }
    changed draft => { root.draft-changed(self.draft); }
    property <bool> stick: true;
    property <bool> exited: root.state == "exited";
    property <bool> busy: root.state == "working" || root.state == "needs-input";
    // The app put text in this pane's box (an attached path).
    property <int> insert-gen: Composer.insert-gen;
    changed insert-gen => { if Composer.insert-key == root.key { ib.put(Composer.insert-text, Composer.insert-caret); } }
    // The app asks for this pane's box to take the focus.
    property <int> focus-gen: Composer.focus-gen;
    changed focus-gen => { if Composer.focus-key == root.key { ib.focus-box(); } }
    function do-send() {
        root.stick = true;
        root.send(root.draft);
    }
    background: Theme.bg-primary;

    VerticalLayout {
        list := ListView {
            vertical-stretch: 1;
            for e in root.entries: HorizontalLayout {
                padding-left: Theme.sp-12;
                padding-right: Theme.sp-12;
                EntryRow {
                    e: e;
                    fs: root.fs;
                    avail: list.visible-width - Theme.sp-24;
                    respond(id, b, a) => { root.respond(id, b, a); }
                    answer(id, o) => { root.answer(id, o); }
                }
            }
            changed content-height => {
                if root.stick { self.content-y = min(0px, self.visible-height - self.content-height - Theme.sp-4); }
            }
            scrolled => { root.stick = self.content-y <= self.visible-height - self.content-height + Theme.sp-48; }
        }
        if root.error != "": Rectangle {
            background: Theme.red-dim;
            height: errt.preferred-height + Theme.sp-10;
            errt := Text { x: Theme.sp-12; width: parent.width - Theme.sp-24; text: root.error; color: Theme.error-text; wrap: word-wrap; font-size: Theme.text-11 * root.fs; }
        }
        // The composer: bg-secondary, a line above.
        Rectangle {
            background: Theme.bg-secondary;
            height: comp.preferred-height;
            // Along its top edge (a hairline with no y would be centred).
            Rectangle { y: 0; height: 1px; background: Theme.border; }
            comp := VerticalLayout {
                padding: Theme.sp-8;
                spacing: Theme.sp-6;
                // The drawers (2.9): handed over on top, held under it.
                if root.q-sent != "": QueueDrawer {
                    fs: root.fs; sent: true;
                    recallable: root.q-sent-kind == "recallable";
                    label: root.q-sent-kind == "recallable" ? "SENDING" : "SENT";
                    note: root.q-sent-kind == "recallable" ? "not read yet" : root.q-sent-kind == "started" ? "Claude is reading it" : "waiting for Claude to pick it up";
                    hint: root.q-sent-kind == "recallable" ? "Click or press ↑ to take it back" : root.q-sent-kind == "started" ? "Claude is reading this one — too late to edit" : "Waiting for the session to confirm";
                    tip: root.q-sent-kind == "recallable" ? "Click to edit — brings it back to the message box" : "Claude has this one; it joins the conversation as it is read";
                    body: root.q-sent;
                    clicked => { Composer.take-back(root.key); }
                }
                if root.q-held != "": QueueDrawer {
                    fs: root.fs; sent: false; recallable: true;
                    label: "SENDING";
                    note: root.q-held-n + (root.q-held-n == 1 ? " line" : " lines") + " · as one message, at the next tool call";
                    hint: "Click or press ↑ to take it back";
                    tip: "Click to edit — brings every queued line back to the message box";
                    body: root.q-held;
                    clicked => { Composer.take-back(root.key); }
                }
                // The box; wide, the buttons beside it on its bottom line.
                HorizontalLayout {
                    spacing: Theme.sp-8;
                    ib := InputBox {
                        horizontal-stretch: 1;
                        fs: root.fs;
                        draft <=> root.draft;
                        ctrl-enter: Composer.ctrl-enter;
                        enabled: !root.exited;
                        placeholder: root.exited ? "Session ended." : root.narrow ? "Message Claude…"
                            : Composer.ctrl-enter ? "Message Claude…  (Ctrl+Enter to send, Enter for newline)"
                            : "Message Claude…  (Enter to send, Shift+Enter for newline)";
                        send => { root.do-send(); }
                        caret(c, a) => { Composer.caret(root.key, c, a); }
                        up => { return Composer.take-back(root.key); }
                        paste(si) => { return Composer.paste(root.key, si); }
                    }
                    if !root.narrow: VerticalLayout {
                        alignment: end;
                        SquareBtn {
                            width: Theme.control; height: Theme.control;
                            icon: Icons.paperclip; tip: "Attach a file (uploads to crundi_attachments)";
                            busy: root.up-busy;
                            clicked => { Composer.attach(root.key); }
                        }
                    }
                    if !root.narrow && root.state == "working": VerticalLayout {
                        alignment: end;
                        StopBtn { fs: root.fs; armed: root.stop-armed; clicked => { root.stop(); } }
                    }
                    if !root.narrow: VerticalLayout {
                        alignment: end;
                        SendBtn {
                            fs: root.fs;
                            label: root.busy ? "Queue" : "Send";
                            width: self.text-w + 2 * Theme.sp-12;
                            height: Theme.sp-12 + Theme.sp-16 * root.fs;
                            clicked => { root.do-send(); }
                        }
                    }
                }
                // Narrow: the buttons on their own row, Send filling the rest.
                if root.narrow: HorizontalLayout {
                    spacing: Theme.sp-8;
                    SquareBtn {
                        width: Theme.control; height: Theme.control;
                        icon: Icons.paperclip; tip: "Attach a file (uploads to crundi_attachments)";
                        busy: root.up-busy;
                        clicked => { Composer.attach(root.key); }
                    }
                    SquareBtn {
                        width: Theme.icon-lg + 2 * Theme.sp-10; height: Theme.control;
                        icon: Icons.clock; icon-size: Theme.icon-lg; ink: Theme.text-muted; fill: false;
                        tip: "Schedule this message";
                        clicked => { Composer.schedule(root.key); }
                    }
                    if root.state == "working": StopBtn { fs: root.fs; armed: root.stop-armed; clicked => { root.stop(); } }
                    SendBtn {
                        horizontal-stretch: 1;
                        fs: root.fs;
                        label: root.busy ? "Queue" : "Send";
                        height: Theme.control;
                        clicked => { root.do-send(); }
                    }
                }
                // The upload bar (.cc-up), while a file uploads (and a moment
                // after): its name, the share sent, the number or "saving".
                if root.up-on: HorizontalLayout {
                    padding-top: Theme.sp-4; padding-left: Theme.sp-2; padding-right: Theme.sp-2;
                    spacing: Theme.sp-8;
                    // Name and track share the room 1:2 whatever the name's
                    // length (no width of their own); a long name elides.
                    Text {
                        horizontal-stretch: 1; min-width: 0; preferred-width: 0;
                        text: root.up-name; font-size: Theme.text-11; color: Theme.text-muted;
                        overflow: elide; vertical-alignment: center;
                    }
                    // The track, centred on the text's line.
                    VerticalLayout {
                        horizontal-stretch: 2; min-width: 0; preferred-width: 0;
                        alignment: center;
                        Rectangle {
                            height: Theme.sp-4;
                            border-radius: Theme.r-pill;
                            background: Theme.bg-tertiary;
                            clip: true;
                            Rectangle {
                                x: 0; width: parent.width * max(0, min(1, root.up-frac));
                                animate width { duration: Theme.motion-fast; }
                                border-radius: Theme.r-pill;
                                background: Theme.accent;
                            }
                        }
                    }
                    Text {
                        min-width: Theme.sp-32 + Theme.sp-2; horizontal-stretch: 0;
                        text: root.up-label; font-size: Theme.text-11; color: Theme.text-muted;
                        horizontal-alignment: right; vertical-alignment: center;
                    }
                }
                // The meta row (.cc-meta): the state, the mode, the switch (and
                // the clock), then the id, the model and the cost on the right.
                // What doesn't fit wraps to a second line, in order.
                meta := Rectangle {
                    property <length> gap: root.narrow ? Theme.sp-6 : Theme.sp-8;
                    property <length> size: (root.narrow ? Theme.text-10 : Theme.text-11) * root.fs;
                    property <length> avail: self.width - left.preferred-width;
                    property <bool> id-on: !root.narrow && root.session != "";
                    property <length> used-a: self.id-on ? self.gap + id-m.preferred-width : 0px;
                    property <bool> id-fit: !self.id-on || self.used-a <= self.avail;
                    property <length> used-b: self.used-a + (root.model != "" ? self.gap + model-m.preferred-width : 0px);
                    property <bool> model-fit: self.id-fit && (root.model == "" || self.used-b <= self.avail);
                    property <length> used-c: self.used-b + (root.cost != "" ? self.gap + cost-m.preferred-width : 0px);
                    property <bool> cost-fit: self.model-fit && (root.cost == "" || self.used-c <= self.avail);
                    property <bool> wraps: (self.id-on && !self.id-fit) || (root.model != "" && !self.model-fit) || (root.cost != "" && !self.cost-fit);
                    height: lines.preferred-height;
                    id-m := Text { visible: false; text: root.session; font-family: Theme.mono; font-size: meta.size; }
                    model-m := Text { visible: false; text: root.model; font-size: meta.size; }
                    cost-m := Text { visible: false; text: root.cost; font-size: meta.size; }
                    lines := VerticalLayout {
                        spacing: Theme.sp-4;
                        HorizontalLayout {
                            spacing: meta.gap;
                            left := HorizontalLayout {
                                horizontal-stretch: 0;
                                spacing: meta.gap;
                                Text {
                                    text: root.state == "working" ? "working…" : root.state == "needs-input" ? "needs your input" : root.exited ? "exited" : "idle";
                                    font-size: meta.size; vertical-alignment: center;
                                    color: root.busy ? Theme.accent-hover : Theme.text-muted;
                                }
                                ModeBtn {
                                    y: (parent.height - self.height) / 2;
                                    fs: root.fs; mode-key: root.mode-key; name: root.mode; icon-only: root.narrow;
                                    clicked => { Composer.mode(root.key); }
                                }
                                EnterSwitch {
                                    y: (parent.height - self.height) / 2;
                                    fs: root.fs; ctrl: Composer.ctrl-enter;
                                    toggle => { Composer.set-ctrl-enter(!Composer.ctrl-enter); ib.focus-box(); }
                                }
                                if !root.narrow: SquareBtn {
                                    y: (parent.height - self.height) / 2;
                                    width: Theme.icon-md + 2 * Theme.sp-6; height: Theme.icon-md + 2 * Theme.sp-4;
                                    icon: Icons.clock; icon-size: Theme.icon-md; ink: Theme.text-muted; fill: false;
                                    tip: "Schedule this message";
                                    clicked => { Composer.schedule(root.key); }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; min-width: 0; }
                            // The session id: the first 8 characters, a dotted
                            // line under it; a click copies the whole id.
                            if meta.id-on && meta.id-fit: sid := Rectangle {
                                width: sidt.preferred-width;
                                sidt := Text {
                                    text: root.session; font-family: Theme.mono; font-size: meta.size;
                                    color: sh.has-hover ? Theme.text-secondary : Theme.text-muted;
                                    vertical-alignment: center; height: parent.height;
                                }
                                // Slint has no dotted line: hairline dots (PLAN.md, Known gaps).
                                for i in ceil(sidt.preferred-width / Theme.sp-4): Rectangle {
                                    x: i * Theme.sp-4; y: (parent.height + sidt.preferred-height) / 2; width: Theme.sp-2; height: 1px; background: Theme.border;
                                }
                                sh := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { clip.select-all(); clip.copy(); clip.clear-selection(); Composer.copied(root.session-full); }
                                    Tooltip { TipBox { text: "Claude session " + root.session-full + "  — click to copy (use it to resume this conversation)"; } }
                                }
                            }
                            if root.model != "" && meta.model-fit: Text { text: root.model; font-size: meta.size; color: Theme.text-muted; vertical-alignment: center; }
                            if root.cost != "" && meta.cost-fit: Text { text: root.cost; font-size: meta.size; color: Theme.text-muted; vertical-alignment: center; }
                        }
                        if meta.wraps: HorizontalLayout {
                            spacing: meta.gap;
                            alignment: start;
                            if meta.id-on && !meta.id-fit: Text { text: root.session; font-family: Theme.mono; font-size: meta.size; color: Theme.text-muted; }
                            if root.model != "" && !meta.model-fit: Text { text: root.model; font-size: meta.size; color: Theme.text-muted; }
                            if root.cost != "" && !meta.cost-fit: Text { text: root.cost; font-size: meta.size; color: Theme.text-muted; }
                        }
                    }
                }
            }
        }
    }
    // A file dragged over the chat (2.7): a dashed accent outline just inside
    // it, over the log and the composer.
    if root.file-over: DashedBox {
        width: parent.width; height: parent.height;
        thick: Theme.sp-2; dash: Theme.sp-6; gap: Theme.sp-4; line: Theme.accent;
    }
    // Copies the whole session id (a hidden input: Slint's clipboard is a
    // text input's).
    clip := TextInput { visible: false; width: 0; height: 0; text: root.session-full; read-only: true; }
}
