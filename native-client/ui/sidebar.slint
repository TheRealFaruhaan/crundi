// The sidebar: projects, the open project's chats, and who is signed in where.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, IconButton, Dot, States } from "widgets.slint";

export struct ProjectItem {
    alias: string,
    name: string,
    // Chats in it, and how many need the person.
    chats: int,
    attention: int,
}

export struct ChatItem {
    id: string,
    title: string,
    // idle | working | waiting | needs-input | exited
    state: string,
    pending: int,
}

component Row inherits Rectangle {
    in property <bool> selected;
    in property <length> indent: 0px;
    callback clicked();
    height: 32px;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.accent-dim : ta.has-hover ? Theme.bg-hover : transparent;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    @children
}

export component Sidebar inherits Rectangle {
    in property <[ProjectItem]> projects;
    in property <string> current-project;
    in property <[ChatItem]> chats;
    in property <string> current-chat;
    in property <string> view;
    in property <string> username;
    in property <string> server;
    in property <bool> online;
    callback select-project(string);
    callback select-chat(string);
    callback new-chat();
    callback show(string);
    callback sign-out();

    width: Theme.sidebar-width;
    background: Theme.bg-secondary;
    border-width: 0px;

    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border-subtle; }

    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        HorizontalLayout {
            height: 36px;
            padding-left: 6px;
            spacing: 8px;
            Text { text: "Crundi"; color: Theme.accent-hover; font-size: 17px; font-weight: 800; vertical-alignment: center; }
            Rectangle {}
            Dot { y: (parent.height - self.height) / 2; fill: root.online ? Theme.green : Theme.red; }
        }
        Rectangle { height: 8px; }
        Text { text: "PROJECTS"; color: Theme.text-muted; font-size: Theme.font-size-xs; font-weight: 700; height: 22px; vertical-alignment: center; x: 6px; }

        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 2px;
                for p in root.projects: VerticalLayout {
                    spacing: 2px;
                    Row {
                        selected: p.alias == root.current-project && root.current-chat == "";
                        clicked => { root.select-project(p.alias); }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Icon { y: (parent.height - self.height) / 2; source: Icons.folder; tint: p.alias == root.current-project ? Theme.accent-hover : Theme.text-secondary; }
                            Text { text: p.name; color: Theme.text-primary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; font-weight: p.alias == root.current-project ? 600 : 400; }
                            if p.attention > 0: Dot { y: (parent.height - self.height) / 2; fill: Theme.amber; }
                            if p.chats > 0: Text { text: p.chats; color: Theme.text-muted; font-size: Theme.font-size-sm; vertical-alignment: center; }
                        }
                    }
                    if p.alias == root.current-project: VerticalLayout {
                        spacing: 2px;
                        for c in root.chats: Row {
                            selected: c.id == root.current-chat && root.view == "chat";
                            clicked => { root.select-chat(c.id); }
                            HorizontalLayout {
                                padding-left: 30px;
                                padding-right: 8px;
                                spacing: 8px;
                                Dot { y: (parent.height - self.height) / 2; fill: States.color(c.state); }
                                Text { text: c.title == "" ? "New chat" : c.title; color: Theme.text-primary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; font-size: 13px; }
                                if c.pending > 0: Text { text: c.pending; color: Theme.amber; font-size: Theme.font-size-sm; vertical-alignment: center; font-weight: 700; }
                            }
                        }
                        Row {
                            clicked => { root.new-chat(); }
                            HorizontalLayout {
                                padding-left: 28px;
                                spacing: 8px;
                                Icon { y: (parent.height - self.height) / 2; source: Icons.plus; tint: Theme.accent-hover; }
                                Text { text: "New chat"; color: Theme.accent-hover; vertical-alignment: center; font-size: 13px; }
                            }
                        }
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border-subtle; }
        Row {
            selected: root.view == "browser";
            clicked => { root.show(root.view == "browser" ? "chat" : "browser"); }
            HorizontalLayout {
                padding-left: 8px;
                spacing: 8px;
                Icon { y: (parent.height - self.height) / 2; source: Icons.globe; }
                Text { text: "Browser panels"; color: Theme.text-primary; vertical-alignment: center; font-size: 13px; }
            }
        }
        HorizontalLayout {
            height: 40px;
            padding-left: 8px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.username == "" ? "Signed in" : root.username; color: Theme.text-primary; font-size: 13px; overflow: elide; }
                Text { text: root.server; color: Theme.text-muted; font-size: Theme.font-size-xs; overflow: elide; }
            }
            IconButton { y: (parent.height - self.height) / 2; icon: Icons.lock; tooltip: "Sign out"; clicked => { root.sign-out(); } }
        }
    }
}
