// The hooks between the window's shell (top bar, sidebar, tab bar, the
// window's overlays) and the areas (AREAS.md). Only the Lead changes this
// file; areas read and set these from their own files and from Rust
// (`w.global::<Shell>()`).

/// What the shell asks of the areas, and what they show in it.
export global Shell {
    // The tab on show ("workbench", "git", …: main.slint's tabs). Areas
    // read it; Rust hears of each change through areas::tab_shown.
    in-out property <string> tab: "workbench";
    // The sidebar's footer and the top bar (each wired to its area in Rust):
    callback add-project();   // ops: the Add project dialog
    callback inbox();         // desktop: the Inbox
    callback cru();           // desktop: Cru on the PC
    // The signed-in server and signing out (Settings, ops).
    in-out property <string> server;
    callback sign-out();
    // A tab's badge: the factories' count (planning), the secrets' (ops),
    // and Settings' update dot (ops). "" hides it.
    in-out property <string> badge-factories;
    in-out property <string> badge-secrets;
    in-out property <bool> update-dot;
    // An area's modal dialog is open: the window's scrim takes the pointer
    // (Pointer.modal). Each area sets only its own.
    in-out property <bool> modal-workspace;
    in-out property <bool> modal-planning;
    in-out property <bool> modal-ops;
    in-out property <bool> modal-desktop;
    // The browser drawer's toggle (the tab bar's Browser): desktop takes
    // it over; until then main.slint opens the drawer itself.
    callback toggle-browser();
    in-out property <bool> browser-hooked;
}
