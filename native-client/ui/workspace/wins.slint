// The file windows (the web's feNewWindow: .fe-window): floating, non-modal
// windows over the app, dragged by the header (snapping to an edge, the
// Arrange bar while moving), resized from the right, the bottom and the
// corner, expanded and back. Each holds the editor (a file, highlighted;
// Save and Ctrl+S), the viewer (a picture) or a Git diff (two columns,
// chunks with Stage, ↑ ↓ between them).

import { Theme, Icons, Icon, SoftShadow, Tip } from "parts.slint";
import { WorkspaceUi, WorkspaceWin, WorkspaceDiffRow } from "api.slint";

/// A header button (.fe-header button): bordered on tertiary; hover accent.
/// Save is green.
component HeadBtn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> save;
    in property <bool> enabled: true;
    in property <string> tip;
    callback clicked();
    height: Theme.sp-24 + Theme.sp-2;
    width: root.has-icon ? Theme.sp-32 : t.preferred-width + Theme.sp-24;
    border-radius: Theme.r-control; border-width: 1px;
    property <bool> hot: ta.has-hover && root.enabled;
    background: root.save ? Theme.green : root.hot ? Theme.accent : Theme.bg-tertiary;
    border-color: root.save ? Theme.green : root.hot ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1 : Theme.o-soft;
    t := Text { visible: !root.has-icon; text: root.text; font-size: Theme.text-12; color: root.save ? Theme.white : Theme.text-primary; }
    if root.has-icon: Icon { source: root.icon; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.text-primary; }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
    Tip { on: ta.has-hover; text: root.tip; }
}

/// The editor (CodeMirror's place): line numbers, the highlighted lines,
/// and over them the text box that edits (its text clear, so the colours
/// show; its caret drawn here).
component Editor inherits Rectangle {
    in property <WorkspaceWin> w;
    background: Theme.ws-editor-bg;
    probe := Text { visible: false; text: "M"; font-family: Theme.mono; font-size: Theme.text-13; }
    nprobe := Text { visible: false; text: root.w.lines.length; font-family: Theme.mono; font-size: Theme.text-13; }
    property <length> lh: probe.preferred-height;
    property <length> gw: max(nprobe.preferred-width, probe.preferred-width * 2) + Theme.sp-24;
    property <length> pad: Theme.sp-4;
    property <bool> plain: root.w.lines.length == 0;
    property <int> tg: root.w.text-gen;
    property <length> caret-x;
    property <length> caret-y;
    changed tg => { ti.text = root.w.text; }
    init => { ti.text = root.w.text; if !root.w.read-only { ti.focus(); } }
    fl := Flickable {
        width: parent.width; height: parent.height;
        content-width: max(self.width, root.gw + ti.preferred-width + Theme.sp-24);
        content-height: max(self.height, ti.preferred-height + 2 * root.pad);
        // The gutter.
        Rectangle {
            x: 0; width: root.gw; height: parent.height;
            background: Theme.ws-editor-bg;
            for l[i] in root.w.lines: Rectangle {
                y: root.pad + i * root.lh; height: root.lh;
                if (self.y + fl.content-y + root.lh >= 0) && (self.y + fl.content-y <= fl.height): Text {
                    x: 0; width: root.gw - Theme.sp-12; horizontal-alignment: right;
                    text: i + 1; font-family: Theme.mono; font-size: Theme.text-13; color: Theme.ws-editor-gutter;
                }
            }
        }
        // The lines, highlighted (only those in view are drawn).
        for l[i] in root.w.lines: Rectangle {
            x: root.gw; y: root.pad + i * root.lh; height: root.lh; width: fl.content-width - root.gw;
            if (self.y + fl.content-y + root.lh >= 0) && (self.y + fl.content-y <= fl.height): StyledText {
                x: 0; y: 0;
                text: l.md;
                default-font-family: Theme.mono; default-font-size: Theme.text-13; default-color: Theme.ws-hl-plain;
            }
        }
        ti := TextInput {
            x: root.gw; y: root.pad;
            width: max(fl.width - root.gw, self.preferred-width + Theme.sp-8);
            single-line: false; wrap: no-wrap;
            read-only: root.w.read-only;
            font-family: Theme.mono; font-size: Theme.text-13;
            color: root.plain ? Theme.ws-hl-plain : transparent;
            selection-background-color: Theme.ws-term-sel;
            selection-foreground-color: root.plain ? Theme.white : transparent;
            text-cursor-width: 0px;
            edited => { WorkspaceUi.win-edited(root.w.id, self.text); }
            cursor-position-changed(p) => {
                root.caret-x = p.x; root.caret-y = p.y;
                // Keep the caret in view.
                if self.x + p.x + fl.content-x < root.gw { fl.content-x = min(0px, root.gw - self.x - p.x); }
                if self.x + p.x + fl.content-x > fl.width - Theme.sp-16 { fl.content-x = fl.width - Theme.sp-16 - self.x - p.x; }
                if self.y + p.y + fl.content-y < 0 { fl.content-y = -(self.y + p.y); }
                if self.y + p.y + root.lh + fl.content-y > fl.height { fl.content-y = fl.height - self.y - p.y - root.lh; }
            }
            key-pressed(ev) => {
                if (ev.modifiers.control || ev.modifiers.meta) && (ev.text == "s" || ev.text == "S") { WorkspaceUi.win-save(root.w.id, self.text); return accept; }
                return reject;
            }
        }
        // The caret (the text box's own is drawn in its clear colour).
        if ti.has-focus && !root.w.read-only: Rectangle {
            x: ti.x + root.caret-x; y: ti.y + root.caret-y;
            width: 1px; height: root.lh;
            background: Theme.text-primary;
            opacity: blink.on ? 1 : 0;
        }
    }
    blink := Timer {
        property <bool> on: true;
        interval: Theme.blink / 2; running: ti.has-focus;
        triggered => { self.on = !self.on; }
    }
}

/// A diff line's half: its number and its text, on the kind's colour.
component DiffHalf inherits Rectangle {
    in property <string> ln;
    in property <styled-text> code;
    in property <string> kind;
    in property <bool> left;
    background: root.kind == "del" ? Theme.ws-diff-del : root.kind == "add" ? Theme.ws-diff-add
        : root.kind == "pad" ? (root.left ? Theme.ws-diff-add-pad : Theme.ws-diff-del-pad) : Theme.bg-primary;
    clip: true;
    Text { x: 0; width: Theme.sp-40 - Theme.sp-8; horizontal-alignment: right; vertical-alignment: center; height: parent.height; text: root.ln; font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-muted; }
    StyledText {
        x: Theme.sp-40 + Theme.sp-6; y: (parent.height - self.preferred-height) / 2;
        text: root.code; default-font-family: Theme.mono; default-font-size: Theme.text-12;
        default-color: root.kind == "del" ? Theme.ws-diff-del-text : root.kind == "add" ? Theme.ws-diff-add-text : Theme.text-primary;
    }
}

component Diff inherits Rectangle {
    in property <WorkspaceWin> w;
    background: Theme.bg-primary;
    property <int> jg: root.w.jump-gen;
    changed jg => { fl.content-y = max(fl.height - fl.content-height, min(0px, -(root.w.jump-row * Theme.sp-20))); }
    VerticalLayout {
        // The head: the file, ↑ n/m ↓.
        Rectangle {
            height: Theme.sp-32; background: Theme.bg-secondary;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-left: Theme.sp-12; padding-right: Theme.sp-12; spacing: Theme.sp-8;
                Text { text: root.w.file; vertical-alignment: center; font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-primary; overflow: elide; horizontal-stretch: 1; }
                Text {
                    text: "↑"; vertical-alignment: center; font-size: Theme.text-14; color: up.has-hover ? Theme.text-primary : Theme.text-secondary;
                    up := TouchArea { mouse-cursor: pointer; clicked => { WorkspaceUi.diff-step(root.w.id, -1); } }
                    Tip { on: up.has-hover; text: "Previous chunk"; }
                }
                Text { text: root.w.counter; vertical-alignment: center; font-family: Theme.mono; font-size: Theme.text-11; color: Theme.text-muted; }
                Text {
                    text: "↓"; vertical-alignment: center; font-size: Theme.text-14; color: dn.has-hover ? Theme.text-primary : Theme.text-secondary;
                    dn := TouchArea { mouse-cursor: pointer; clicked => { WorkspaceUi.diff-step(root.w.id, 1); } }
                    Tip { on: dn.has-hover; text: "Next chunk"; }
                }
            }
        }
        // ORIGINAL | MODIFIED.
        HorizontalLayout {
            height: Theme.sp-20 + Theme.sp-2;
            for t[i] in ["ORIGINAL", "MODIFIED"]: Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg-tertiary;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
                if i == 0: Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
                Text { x: Theme.sp-8; text: t; vertical-alignment: center; height: parent.height; font-size: Theme.text-10; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide; color: Theme.text-muted; }
            }
        }
        // The rows: the two sides scroll as one.
        fl := Flickable {
            vertical-stretch: 1;
            content-height: max(self.height, root.w.rows.length * Theme.sp-20);
            for r[i] in root.w.rows: Rectangle {
                y: i * Theme.sp-20; height: Theme.sp-20; width: fl.width;
                if r.chunk >= 0: Rectangle {
                    background: Theme.ws-diff-chunk;
                    Rectangle { y: 0; height: 1px; background: Theme.border; }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        x: 0; width: parent.width / 2;
                        padding-left: Theme.sp-6; spacing: Theme.sp-6;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: Theme.sp-16; width: st.preferred-width + Theme.sp-16;
                                border-radius: Theme.r-chip; border-width: 1px;
                                border-color: r.staged ? Theme.border : Theme.green;
                                st := Text { text: r.staged ? "Staged" : "Stage"; font-size: Theme.text-10; font-weight: Theme.w-semibold; color: r.staged ? Theme.text-muted : Theme.green; }
                                TouchArea { enabled: !r.staged; mouse-cursor: pointer; clicked => { WorkspaceUi.diff-stage(root.w.id, r.chunk); } }
                            }
                        }
                        Text { text: "Chunk " + (r.chunk + 1); vertical-alignment: center; font-size: Theme.text-10; color: Theme.text-muted; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                if r.chunk < 0: HorizontalLayout {
                    DiffHalf { horizontal-stretch: 1; left: true; ln: r.old-ln; code: r.old; kind: r.old-kind; }
                    Rectangle { width: 1px; background: Theme.border; }
                    DiffHalf { horizontal-stretch: 1; ln: r.new-ln; code: r.new; kind: r.new-kind; }
                }
            }
        }
    }
}

/// One window.
component Win inherits Rectangle {
    in property <WorkspaceWin> w;
    x: root.w.x; y: root.w.y; width: root.w.w; height: root.w.h;
    SoftShadow { width: root.width; height: root.height; radius: Theme.r-card; shadow: Theme.shadow-clone; }
    Rectangle { background: Theme.bg-primary; border-radius: Theme.r-card; }
    // A press anywhere brings it to the front.
    TouchArea { pointer-event(ev) => { if ev.kind == PointerEventKind.down { WorkspaceUi.win-front(root.w.id); } } }
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 1px - 1px; height: parent.height - 1px - 1px;
        border-radius: Theme.r-card; clip: true;
        VerticalLayout {
            // The header: the path, expand, Save, Close; dragged to move.
            Rectangle {
                height: Theme.sp-40 + Theme.sp-2;
                background: Theme.bg-secondary;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                TouchArea {
                    mouse-cursor: MouseCursor.move;
                    pointer-event(ev) => {
                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down { WorkspaceUi.win-front(root.w.id); WorkspaceUi.win-drag(root.w.id, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                        if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up { WorkspaceUi.win-drag(root.w.id, 2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
                    }
                    moved => { if self.pressed { WorkspaceUi.win-drag(root.w.id, 1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
                    double-clicked => { WorkspaceUi.win-expand(root.w.id); }
                }
                HorizontalLayout {
                    padding-left: Theme.sp-12; padding-right: Theme.sp-12; spacing: Theme.sp-8;
                    Text { text: root.w.title; vertical-alignment: center; font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-secondary; overflow: elide; horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; HeadBtn { has-icon: true; icon: Icons.maximize; tip: "Expand / restore"; clicked => { WorkspaceUi.win-expand(root.w.id); } } }
                    if root.w.save-shown: VerticalLayout { alignment: center; HeadBtn { text: root.w.save-label; save: true; enabled: root.w.save-on; clicked => { WorkspaceUi.win-save(root.w.id, ""); } } }
                    VerticalLayout { alignment: center; HeadBtn { text: "Close"; clicked => { WorkspaceUi.win-close(root.w.id); } } }
                }
            }
            // The content.
            Rectangle {
                vertical-stretch: 1;
                if root.w.loading != "": Text { text: root.w.loading; font-size: Theme.text-13; color: Theme.text-muted; }
                if root.w.loading == "" && root.w.kind == "edit": Editor { w: root.w; }
                if root.w.loading == "" && root.w.kind == "diff": Diff { w: root.w; }
                if root.w.loading == "" && root.w.kind == "view" && root.w.has-img: Rectangle {
                    background: Theme.bg-primary;
                    Image {
                        property <float> k: min(parent.width * Theme.ws-view-fit / max(1px, self.source.width * 1px), parent.height * Theme.ws-view-fit / max(1px, self.source.height * 1px), 1);
                        source: root.w.img;
                        width: self.source.width * 1px * self.k; height: self.source.height * 1px * self.k;
                        image-fit: contain;
                    }
                }
            }
        }
    }
    // The resize handles: the right edge, the bottom, the corner (with its mark).
    if !root.w.max: Rectangle {
        x: parent.width - Theme.sp-6; y: 0; width: Theme.sp-8; height: parent.height;
        TouchArea {
            mouse-cursor: MouseCursor.ew-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { WorkspaceUi.win-resize(root.w.id, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
            }
            moved => { if self.pressed { WorkspaceUi.win-resize(root.w.id, 1, self.absolute-position.x + self.mouse-x, -1px); } }
        }
    }
    if !root.w.max: Rectangle {
        x: 0; y: parent.height - Theme.sp-6; width: parent.width; height: Theme.sp-8;
        TouchArea {
            mouse-cursor: MouseCursor.ns-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { WorkspaceUi.win-resize(root.w.id, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
            }
            moved => { if self.pressed { WorkspaceUi.win-resize(root.w.id, 1, -1px, self.absolute-position.y + self.mouse-y); } }
        }
    }
    if !root.w.max: Rectangle {
        x: parent.width - Theme.sp-16 + Theme.sp-2; y: parent.height - Theme.sp-16 + Theme.sp-2; width: Theme.sp-16; height: Theme.sp-16;
        Rectangle { x: parent.width - Theme.sp-10 - Theme.sp-2; y: parent.height - Theme.sp-10 - Theme.sp-2; width: Theme.sp-8; height: Theme.sp-2; background: ct.has-hover ? Theme.accent : Theme.text-muted; }
        Rectangle { x: parent.width - Theme.sp-6; y: parent.height - Theme.sp-16 - Theme.sp-2 + Theme.sp-6; width: Theme.sp-2; height: Theme.sp-8; background: ct.has-hover ? Theme.accent : Theme.text-muted; }
        ct := TouchArea {
            mouse-cursor: MouseCursor.nwse-resize;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down { WorkspaceUi.win-resize(root.w.id, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
            }
            moved => { if self.pressed { WorkspaceUi.win-resize(root.w.id, 1, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
        }
    }
}

/// An Arrange bar button (.fe-arrange button): a pill.
component ArrBtn inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    callback clicked();
    height: Theme.sp-24; width: t.preferred-width + Theme.sp-20;
    border-radius: Theme.r-pill; border-width: 1px;
    border-color: ta.has-hover ? Theme.accent : Theme.border;
    background: ta.has-hover ? Theme.accent : Theme.bg-tertiary;
    t := Text { text: root.text; font-size: Theme.text-12; color: ta.has-hover ? Theme.white : Theme.text-secondary; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Tip { on: ta.has-hover; text: root.tip; }
}

/// The windows' layer: the snap preview, the windows (front last), the
/// Arrange bar. Nothing takes the pointer where no window is.
export component Wins inherits Rectangle {
    if WorkspaceUi.snap.on: Rectangle {
        x: WorkspaceUi.snap.x; y: WorkspaceUi.snap.y; width: WorkspaceUi.snap.w; height: WorkspaceUi.snap.h;
        border-radius: Theme.r-card; border-width: Theme.sp-2; border-color: Theme.accent; background: Theme.accent-dim;
    }
    for w in WorkspaceUi.wins: Win { w: w; }
    if WorkspaceUi.arrange && WorkspaceUi.wins.length > 0: Rectangle {
        y: Theme.topbar-height + Theme.sp-6;
        x: (parent.width - self.width) / 2;
        width: al.preferred-width; height: Theme.sp-32 + Theme.sp-2;
        SoftShadow { width: parent.width; height: parent.height; radius: self.height / 2; shadow: Theme.shadow-menu; }
        Rectangle { border-radius: Theme.r-pill; background: Theme.bg-secondary; border-width: 1px; border-color: Theme.border; }
        ah := TouchArea { changed has-hover => { WorkspaceUi.arrange-hover(self.has-hover); } }
        al := HorizontalLayout {
            padding-left: Theme.sp-8; padding-right: Theme.sp-8; spacing: Theme.sp-6; alignment: center;
            Text { text: "Arrange"; vertical-alignment: center; font-size: Theme.text-11; color: Theme.text-muted; }
            VerticalLayout { alignment: center; ArrBtn { text: "Tile"; tip: "Tile windows side by side"; clicked => { WorkspaceUi.win-arrange("tile"); } } }
            VerticalLayout { alignment: center; ArrBtn { text: "Grid"; tip: "Tile windows in a grid"; clicked => { WorkspaceUi.win-arrange("grid"); } } }
            VerticalLayout { alignment: center; ArrBtn { text: "Cascade"; tip: "Cascade windows"; clicked => { WorkspaceUi.win-arrange("cascade"); } } }
        }
    }
}
