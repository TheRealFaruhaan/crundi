// The Git tab and panel (the web's gitPanelHtml, .git-panel): the branch
// line, the staged and changed files with their actions, and the commit bar.

import { Theme, Icons, Icon, ScrollThumb, Tip } from "parts.slint";
import { WorkspaceUi, WorkspaceGitFile } from "api.slint";

/// A small action (.gs-actions button, .gf-actions button): a glyph or an
/// icon, muted; hover: primary on a fill.
export component GitAct inherits Rectangle {
    in property <string> glyph;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> tip;
    in property <color> hover-fill: Theme.bg-hover;
    callback clicked();
    width: Theme.sp-20; height: Theme.sp-16 + Theme.sp-2;
    border-radius: Theme.r-chip;
    background: ta.has-hover ? root.hover-fill : transparent;
    if !root.has-icon: Text { text: root.glyph; font-size: Theme.text-12; color: ta.has-hover ? Theme.text-primary : Theme.text-muted; }
    if root.has-icon: Icon { source: root.icon; width: Theme.icon-sm; height: Theme.icon-sm; tint: ta.has-hover ? Theme.text-primary : Theme.text-muted; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Tip { on: ta.has-hover; text: root.tip; }
}

component SectionHead inherits Rectangle {
    in property <string> title;
    in property <int> count;
    in property <string> act;
    in property <string> act-tip;
    callback act-clicked();
    height: Theme.sp-24 + Theme.sp-2;
    HorizontalLayout {
        padding-left: Theme.sp-12; padding-right: Theme.sp-12;
        spacing: Theme.sp-6;
        Text { text: root.title; vertical-alignment: center; font-size: Theme.text-10; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide; color: Theme.text-muted; }
        Text { text: "(" + root.count + ")"; vertical-alignment: center; font-size: Theme.text-10; font-weight: Theme.w-bold; color: Theme.text-secondary; }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout { alignment: center; GitAct { glyph: root.act; tip: root.act-tip; clicked => { root.act-clicked(); } } }
    }
}

component FileLine inherits Rectangle {
    in property <WorkspaceGitFile> f;
    height: Theme.sp-24;
    background: ta.has-hover ? Theme.bg-hover : transparent;
    ta := TouchArea { mouse-cursor: pointer; }
    Tip { on: ta.has-hover; text: "Drag onto a terminal to insert its path"; }
    HorizontalLayout {
        padding-left: Theme.sp-20; padding-right: Theme.sp-12;
        spacing: Theme.sp-6;
        Text {
            width: Theme.icon-md; text: root.f.code; horizontal-alignment: center; vertical-alignment: center;
            font-size: Theme.text-11; font-weight: Theme.w-bold; font-family: Theme.mono;
            color: root.f.code == "M" ? Theme.yellow : root.f.code == "A" ? Theme.green : root.f.code == "D" ? Theme.red : root.f.code == "U" ? Theme.accent : Theme.text-primary;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            min-width: 0;
            if root.f.dir != "": Text { text: root.f.dir; vertical-alignment: center; font-size: Theme.text-12; font-family: Theme.mono; color: Theme.text-muted; overflow: elide; min-width: 0; horizontal-stretch: 0; }
            Text { text: root.f.name; vertical-alignment: center; font-size: Theme.text-12; font-family: Theme.mono; color: Theme.text-primary; overflow: elide; horizontal-stretch: 1; min-width: 0; }
        }
        if root.f.add != "" || root.f.del != "": HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Theme.sp-4;
            if root.f.add != "": Text { text: "+" + root.f.add; vertical-alignment: center; font-size: Theme.text-10; font-family: Theme.mono; color: Theme.green; }
            if root.f.del != "": Text { text: "-" + root.f.del; vertical-alignment: center; font-size: Theme.text-10; font-family: Theme.mono; color: Theme.red; }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Theme.sp-2;
            VerticalLayout { alignment: center; GitAct { glyph: "◑"; tip: "View diff"; hover-fill: Theme.bg-tertiary; clicked => { WorkspaceUi.git-diff(root.f.file, root.f.staged); } } }
            if root.f.staged: VerticalLayout { alignment: center; GitAct { glyph: "−"; tip: "Unstage"; hover-fill: Theme.bg-tertiary; clicked => { WorkspaceUi.git-unstage(root.f.file); } } }
            if !root.f.staged: VerticalLayout { alignment: center; GitAct { glyph: "＋"; tip: "Stage"; hover-fill: Theme.bg-tertiary; clicked => { WorkspaceUi.git-stage(root.f.file); } } }
            if !root.f.staged: VerticalLayout { alignment: center; GitAct { has-icon: true; icon: Icons.rotate-ccw; tip: "Discard"; hover-fill: Theme.bg-tertiary; clicked => { WorkspaceUi.git-discard(root.f.file); } } }
        }
    }
}

/// A button of the commit bar (.git-commit-btns button): an equal share.
component BarBtn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: Theme.control-sm;
    horizontal-stretch: 1;
    border-radius: Theme.r-control;
    border-width: 1px;
    property <bool> hot: ta.has-hover && root.enabled;
    background: root.primary ? (root.hot ? Theme.accent-hover : Theme.accent) : (root.hot ? Theme.accent : Theme.bg-tertiary);
    border-color: root.primary || root.hot ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1 : Theme.o-soft;
    Text { text: root.text; font-size: Theme.text-12; color: root.primary ? Theme.white : Theme.text-primary; }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component GitView inherits Rectangle {
    background: Theme.bg-primary;
    property <string> msg;
    VerticalLayout {
        if WorkspaceUi.git-state == "ok": Rectangle {
            height: Theme.sp-32;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
            HorizontalLayout {
                padding-left: Theme.sp-12; padding-right: Theme.sp-12; spacing: Theme.sp-6;
                Text { text: WorkspaceUi.git-branch == "" ? "—" : WorkspaceUi.git-branch; vertical-alignment: center; font-size: Theme.text-12; font-weight: Theme.w-semibold; color: Theme.accent-hover; }
                Text { text: WorkspaceUi.git-sync; vertical-alignment: center; font-size: Theme.text-11; color: Theme.text-muted; }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        // The files.
        Rectangle {
            vertical-stretch: 1;
            if WorkspaceUi.git-state != "ok": Text {
                y: Theme.sp-20; x: Theme.sp-12; width: parent.width - Theme.sp-24;
                horizontal-alignment: center; wrap: word-wrap;
                text: WorkspaceUi.git-state == "not-repo" ? "Not a git repository" : WorkspaceUi.git-state == "error" ? "Error: " + WorkspaceUi.git-error : WorkspaceUi.git-state == "loading" ? "Loading…" : "";
                font-size: Theme.text-12; color: Theme.text-muted;
            }
            if WorkspaceUi.git-state == "ok": fl := Flickable {
                width: parent.width; height: parent.height;
                content-height: max(self.height, col.preferred-height);
                col := VerticalLayout {
                    width: fl.width;
                    padding-top: Theme.sp-4; padding-bottom: Theme.sp-4;
                    if WorkspaceUi.git-staged.length == 0 && WorkspaceUi.git-changes.length == 0: Text {
                        height: Theme.sp-20 * 2 + Theme.sp-16; horizontal-alignment: center; vertical-alignment: center;
                        text: "No changes"; font-size: Theme.text-12; color: Theme.text-muted;
                    }
                    if WorkspaceUi.git-staged.length > 0: SectionHead {
                        title: "STAGED"; count: WorkspaceUi.git-staged.length; act: "−"; act-tip: "Unstage all";
                        act-clicked => { WorkspaceUi.git-unstage-all(); }
                    }
                    for f in WorkspaceUi.git-staged: FileLine { f: f; }
                    if WorkspaceUi.git-changes.length > 0: SectionHead {
                        title: "CHANGES"; count: WorkspaceUi.git-changes.length; act: "＋"; act-tip: "Stage all";
                        act-clicked => { WorkspaceUi.git-stage-all(); }
                    }
                    for f in WorkspaceUi.git-changes: FileLine { f: f; }
                }
            }
        }
        // The commit bar.
        if WorkspaceUi.git-state == "ok": Rectangle {
            height: bar.preferred-height;
            Rectangle { y: 0; height: 1px; background: Theme.border; }
            bar := VerticalLayout {
                padding-left: Theme.sp-12; padding-right: Theme.sp-12; padding-top: Theme.sp-10; padding-bottom: Theme.sp-10;
                spacing: Theme.sp-8;
                Rectangle {
                    height: Theme.sp-48;
                    border-radius: Theme.r-control; border-width: 1px;
                    border-color: ti.has-focus ? Theme.accent : Theme.border;
                    background: Theme.bg-primary;
                    Flickable {
                        x: Theme.sp-10; y: Theme.sp-6; width: parent.width - Theme.sp-20; height: parent.height - Theme.sp-12;
                        content-height: max(self.height, ti.preferred-height);
                        ti := TextInput {
                            // Cleared after a commit.
                            property <int> gen: WorkspaceUi.git-msg-gen;
                            changed gen => { self.text = ""; root.msg = ""; }
                            width: parent.width;
                            wrap: word-wrap; single-line: false;
                            font-size: Theme.text-12; color: Theme.text-primary;
                            selection-background-color: Theme.selection;
                            edited => { root.msg = self.text; }
                        }
                    }
                    if root.msg == "": Text { x: Theme.sp-10; y: Theme.sp-6; text: "Commit message…"; font-size: Theme.text-12; color: Theme.text-muted; }
                }
                HorizontalLayout {
                    spacing: Theme.sp-6;
                    BarBtn { text: WorkspaceUi.git-pulling ? "↓ Pulling…" : "↓ Pull"; enabled: !WorkspaceUi.git-pulling; clicked => { WorkspaceUi.git-pull(); } }
                    BarBtn { text: WorkspaceUi.git-pushing ? "↑ Pushing…" : "↑ Push"; enabled: !WorkspaceUi.git-pushing; clicked => { WorkspaceUi.git-push(); } }
                    BarBtn { text: "Commit"; primary: true; clicked => { WorkspaceUi.git-commit(ti.text); } }
                }
            }
        }
    }
}
