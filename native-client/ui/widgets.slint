// Small building blocks shared by the screens, in Crundi's look (theme.slint).

import { Theme, Shadow } from "theme.slint";

/// Every pointer press in the window, wherever it lands (src/main.rs counts
/// them from the system's events; the test driver from its own). Slint keeps
/// the focus when a click lands on something that can't take it (the chat
/// log, a header), where a browser blurs the field: fields that save on
/// blur (the rename input) watch this to end on a press outside them.
export global Pointer {
    in-out property <int> presses;
    // Where the pointer is now (moves too: hover, the drag's clone).
    in-out property <length> x;
    in-out property <length> y;
    // Where the last press was, and whether the "+" menu was open then (a
    // press on it, or on its backdrop, focuses no pane).
    in-out property <length> press-x;
    in-out property <length> press-y;
    in-out property <bool> press-on-menu;
}

/// The accent gradient (accent to accent-hover) in a round shape,
/// filling what holds it: a circle, or a control's rounded rectangle (radius
/// 6). The software renderer fills a gradient square and ignores a radius on
/// it or on a clip, so the shape is an image (ui/shapes/, in Theme.accent and
/// Theme.accent-hover): the circle an SVG drawn at its size; the control a
/// nine-slice PNG whose corners (r-control) stay round at any size while its middle
/// stretches (PLAN.md, Known gaps).
export component AccentFill inherits Image {
    // Where it is used: width: parent.width; height: parent.height.
    in property <bool> round;
    source: root.round ? @image-url("shapes/accent-round.svg") : @image-url("shapes/accent-control.png", nine-slice(6));
    image-fit: fill;
}

/// A soft shadow or glow under a box, given the box's geometry and corner
/// radius. The software renderer has no blur, so it is drawn as gradients
/// that fade smoothly to nothing: a core under the box, four edge strips
/// (linear) and four corners (radial, centred on the core's corners). The
/// core is the box inset by its radius, so a rounded box gets a rounded
/// shadow. It grows by `shadow.blur` and moves down by `shadow.y`.
export component SoftShadow {
    in property <length> radius;
    in property <Shadow> shadow;
    // Whole pixels for every piece: an edge that falls between pixels is
    // rounded per piece, which left one-pixel seams where they meet. So the
    // pieces sit on whole window pixels (ox, oy) and whole sizes.
    property <length> ox: round(self.absolute-position.x / 1px) * 1px - self.absolute-position.x;
    property <length> oy: round(self.absolute-position.y / 1px) * 1px - self.absolute-position.y;
    property <length> w: round(root.width / 1px) * 1px;
    property <length> h: round(root.height / 1px) * 1px;
    property <length> core: round(min(root.radius, min(self.w, self.h) / 2) / 1px) * 1px;
    property <length> fade: root.shadow.blur + root.core;
    property <length> dy: root.shadow.y;
    property <color> c: root.shadow.c;
    // The same colour, clear: a gradient to `transparent` (black, clear)
    // darkens a coloured glow on its way out.
    property <color> clear: root.c.with-alpha(0);
    // The core: under the box (it shows only past a round corner).
    Rectangle {
        x: root.ox + root.core; y: root.oy + root.core + root.dy;
        width: root.w - 2 * root.core; height: root.h - 2 * root.core;
        background: root.c;
    }
    // Edges: top, bottom, left, right.
    Rectangle {
        x: root.ox + root.core; y: root.oy + root.core - root.fade + root.dy;
        width: root.w - 2 * root.core; height: root.fade;
        background: @linear-gradient(0deg, root.c 0%, root.clear 100%);
    }
    Rectangle {
        x: root.ox + root.core; y: root.oy + root.h - root.core + root.dy;
        width: root.w - 2 * root.core; height: root.fade;
        background: @linear-gradient(180deg, root.c 0%, root.clear 100%);
    }
    Rectangle {
        x: root.ox + root.core - root.fade; y: root.oy + root.core + root.dy;
        width: root.fade; height: root.h - 2 * root.core;
        background: @linear-gradient(270deg, root.c 0%, root.clear 100%);
    }
    Rectangle {
        x: root.ox + root.w - root.core; y: root.oy + root.core + root.dy;
        width: root.fade; height: root.h - 2 * root.core;
        background: @linear-gradient(90deg, root.c 0%, root.clear 100%);
    }
    // Corners: top-left, top-right, bottom-left, bottom-right.
    Rectangle {
        x: root.ox + root.core - root.fade; y: root.oy + root.core - root.fade + root.dy;
        width: root.fade; height: root.fade;
        background: @radial-gradient(circle root.fade at root.fade root.fade, root.c 0%, root.clear 100%);
    }
    Rectangle {
        x: root.ox + root.w - root.core; y: root.oy + root.core - root.fade + root.dy;
        width: root.fade; height: root.fade;
        background: @radial-gradient(circle root.fade at 0px root.fade, root.c 0%, root.clear 100%);
    }
    Rectangle {
        x: root.ox + root.core - root.fade; y: root.oy + root.h - root.core + root.dy;
        width: root.fade; height: root.fade;
        background: @radial-gradient(circle root.fade at root.fade 0px, root.c 0%, root.clear 100%);
    }
    Rectangle {
        x: root.ox + root.w - root.core; y: root.oy + root.h - root.core + root.dy;
        width: root.fade; height: root.fade;
        background: @radial-gradient(circle root.fade at 0px 0px, root.c 0%, root.clear 100%);
    }
}

/// A flat icon from Icons, tinted.
export component Icon inherits Image {
    in property <color> tint: Theme.text-secondary;
    width: Theme.sp-16;
    height: Theme.sp-16;
    colorize: root.tint;
    image-fit: contain;
}

/// A square button with one icon (toolbars, rows).
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <color> tint: Theme.text-secondary;
    in property <length> size: Theme.sp-32;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: Theme.r-control;
    background: ta.has-hover && root.enabled ? Theme.bg-hover : transparent;
    accessible-role: button;
    accessible-label: root.tooltip;
    Icon {
        source: root.icon;
        width: root.size * Theme.icon-share;
        height: root.size * Theme.icon-share;
        tint: root.enabled ? (ta.has-hover ? Theme.text-primary : root.tint) : Theme.text-muted;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// A text button: primary (accent) or quiet.
export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    height: Theme.control;
    min-width: lay.preferred-width;
    border-radius: Theme.r-control;
    background: !root.enabled ? Theme.bg-tertiary
        : root.primary ? (ta.has-hover ? Theme.accent-hover : Theme.accent)
        : root.danger ? (ta.has-hover ? Theme.red : Theme.red-dim)
        : (ta.has-hover ? Theme.bg-hover : Theme.bg-tertiary);
    border-width: root.primary || root.danger ? 0px : 1px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    lay := HorizontalLayout {
        padding-left: Theme.sp-12;
        padding-right: Theme.sp-12;
        spacing: Theme.sp-6;
        alignment: center;
        if root.has-icon: Icon {
            y: (parent.height - self.height) / 2;
            source: root.icon;
            tint: root.primary || root.danger ? Theme.white : Theme.text-primary;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: !root.enabled ? Theme.text-muted : root.primary || root.danger ? Theme.white : Theme.text-primary;
            font-weight: Theme.w-semibold;
            font-size: Theme.text-13;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// A one-line text field.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);
    height: Theme.control-lg;
    border-radius: Theme.r-control;
    background: Theme.bg-tertiary;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    HorizontalLayout {
        padding-left: Theme.sp-12;
        padding-right: Theme.sp-12;
        input := TextInput {
            text <=> root.text;
            enabled: root.enabled;
            vertical-alignment: center;
            color: Theme.text-primary;
            font-size: Theme.text-14;
            selection-background-color: Theme.accent-dim;
            input-type: root.password ? InputType.password : InputType.text;
            single-line: true;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
        }
    }
    if root.text == "" : Text {
        x: Theme.sp-12;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: Theme.text-14;
    }
    public function focus-input() { input.focus(); }
}

/// A small coloured dot (state of a chat, the connection).
export component Dot inherits Rectangle {
    in property <color> fill: Theme.text-muted;
    width: Theme.sp-8;
    height: Theme.sp-8;
    border-radius: Theme.r-chip;
    background: root.fill;
}

/// The colour for a chat's agent state.
export global States {
    public pure function color(state: string) -> color {
        return state == "working" ? Theme.green
            : state == "needs-input" || state == "waiting" ? Theme.amber
            : state == "exited" ? Theme.text-muted
            : Theme.text-secondary;
    }
    public pure function label(state: string) -> string {
        return state == "working" ? "Working"
            : state == "needs-input" ? "Needs you"
            : state == "waiting" ? "Waiting"
            : state == "exited" ? "Ended"
            : state == "idle" ? "Idle"
            : state;
    }
}

/// A dashed outline (Slint has no dashed borders): `thick` px dashes of
/// `dash` px with `gap` px between, along the four edges, inset `inset` px.
/// With a radius (`corner`), as Chromium draws a dashed rounded border: each
/// corner carries one dash on the middle of its arc (30° to 60°), and the
/// straight dashes run from the corner's ends, spaced out so each edge
/// starts and ends on a dash.
export component DashedBox inherits Rectangle {
    in property <color> line: Theme.border;
    in property <length> thick: 1px;
    in property <length> dash: Theme.sp-4;
    in property <length> gap: Theme.sp-2;
    in property <length> inset: 0px;
    in property <length> corner: 0px;
    property <length> w: self.width - 2 * self.inset;
    property <length> h: self.height - 2 * self.inset;
    // Where the straight dashes start (after the corner and its gap), how
    // much edge they share, how many fit, and their spacing.
    property <length> pad: self.corner;
    property <length> run-w: self.w - 2 * self.pad;
    property <length> run-h: self.h - 2 * self.pad;
    property <int> n-w: self.corner > 0 ? max(1, floor((self.run-w + self.gap) / (self.dash + self.gap))) : max(0, ceil(self.run-w / (self.dash + self.gap)));
    property <int> n-h: self.corner > 0 ? max(1, floor((self.run-h + self.gap) / (self.dash + self.gap))) : max(0, ceil(self.run-h / (self.dash + self.gap)));
    property <length> step-w: self.corner > 0 ? (self.n-w > 1 ? (self.run-w - self.dash) / (self.n-w - 1) : 0px) : self.dash + self.gap;
    property <length> step-h: self.corner > 0 ? (self.n-h > 1 ? (self.run-h - self.dash) / (self.n-h - 1) : 0px) : self.dash + self.gap;
    for i in root.n-w: Rectangle {
        x: root.inset + root.pad + i * root.step-w; y: root.inset;
        width: min(root.dash, root.run-w - i * root.step-w); height: root.thick; background: root.line;
    }
    for i in root.n-w: Rectangle {
        x: root.inset + root.pad + i * root.step-w; y: root.inset + root.h - root.thick;
        width: min(root.dash, root.run-w - i * root.step-w); height: root.thick; background: root.line;
    }
    for i in root.n-h: Rectangle {
        x: root.inset; y: root.inset + root.pad + i * root.step-h;
        width: root.thick; height: min(root.dash, root.run-h - i * root.step-h); background: root.line;
    }
    for i in root.n-h: Rectangle {
        x: root.inset + root.w - root.thick; y: root.inset + root.pad + i * root.step-h;
        width: root.thick; height: min(root.dash, root.run-h - i * root.step-h); background: root.line;
    }
    // The four corners: the radius-`corner` ring, clipped to the box between
    // its 30° and 60° points (x and y within half the radius of the corner).
    property <length> cb: root.corner / 2 + root.thick / 2;
    if root.corner > 0: Rectangle {
        x: root.inset; y: root.inset; width: root.cb; height: root.cb; clip: true;
        Rectangle { x: 0; y: 0; width: 2 * root.corner; height: 2 * root.corner; border-radius: root.corner; border-width: root.thick; border-color: root.line; }
    }
    if root.corner > 0: Rectangle {
        x: root.inset + root.w - root.cb; y: root.inset; width: root.cb; height: root.cb; clip: true;
        Rectangle { x: root.cb - 2 * root.corner; y: 0; width: 2 * root.corner; height: 2 * root.corner; border-radius: root.corner; border-width: root.thick; border-color: root.line; }
    }
    if root.corner > 0: Rectangle {
        x: root.inset; y: root.inset + root.h - root.cb; width: root.cb; height: root.cb; clip: true;
        Rectangle { x: 0; y: root.cb - 2 * root.corner; width: 2 * root.corner; height: 2 * root.corner; border-radius: root.corner; border-width: root.thick; border-color: root.line; }
    }
    if root.corner > 0: Rectangle {
        x: root.inset + root.w - root.cb; y: root.inset + root.h - root.cb; width: root.cb; height: root.cb; clip: true;
        Rectangle { x: root.cb - 2 * root.corner; y: root.cb - 2 * root.corner; width: 2 * root.corner; height: 2 * root.corner; border-radius: root.corner; border-width: root.thick; border-color: root.line; }
    }
}

