// The browser drawer (app/vendor/crundi-browser-drawer.js, .brd): a CEF
// browser per tab, rendered off-screen and shown as an image (src/browser.rs),
// with the annotation layer drawn by Slint on top. The drawer's state (tabs
// per project, the bars, popovers and panels) is the desktop area's
// (src/desktop/drawer.rs, global DesktopDrawer); main.slint places the drawer
// and hands it the pages (PanelData, one per browser).

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "widgets.slint";
import { Tip } from "chat.slint";
import { DesktopDrawer, DesktopTab, DesktopPopItem, DesktopHistRow } from "desktop/api.slint";
import { DesktopIcons } from "desktop/icons.slint";
import { DrawerPanels } from "desktop/drawer-panels.slint";

/// A mark on the page, in stage px (src/browser.rs sync): a pin, a box, an
/// element (dashed), a stroke or an arrow (path), with its numbered label.
export struct AnnView {
    kind: string,
    path: string,
    x: float, y: float, w: float, h: float,
    claude: bool,
    num: string,
    label: string,
    sel: string,
    has-label: bool,
    lx: float, ly: float,
}

export struct PanelData {
    frame: image,
    // The page's own size (CSS px) and the scale it is drawn at in the stage.
    view-width: float,
    view-height: float,
    scale: float,
    title: string,
    url: string,
    // Which device it emulates (an index into the device list).
    device: int,
    device-names: [string],
    // The page's mouse cursor (src/browser.rs cursor_index).
    cursor: int,
    driver: string,
    anns: [AnnView],
    // The picker's hover (stage px; x < 0: none) and its selector.
    hover-x: float, hover-y: float, hover-w: float, hover-h: float,
    hover-sel: string,
    // The chat's cursor (browser_mouse), stage px; x < 0: none.
    cur-x: float, cur-y: float,
    can-back: bool,
    can-forward: bool,
    loading: bool,
}

/// The drawer's square button (.brd-ibtn): bordered in the address and
/// annotation bars, bare in the tab strip; `on` filled with the accent.
component BrdBtn inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> on;
    in property <bool> bare;
    // "" or "server" (accent edge), "hp" (green), "bad" (red), "dev" (accent)
    in property <string> tone;
    in property <bool> spin;
    callback clicked();
    property <color> edge: root.tone == "server" || root.tone == "dev" ? Theme.accent : root.tone == "hp" ? Theme.green : root.tone == "bad" ? Theme.red : Theme.border;
    width: root.bare ? Theme.sp-24 + Theme.sp-2 : Theme.control-sm;
    height: self.width;
    border-radius: Theme.r-control;
    border-width: root.bare ? 0px : 1px;
    border-color: root.on ? Theme.accent : ta.has-hover && root.enabled ? Theme.accent : root.edge;
    background: root.on ? Theme.accent : root.bare ? (ta.has-hover && root.enabled ? Theme.bg-tertiary : transparent) : Theme.bg-tertiary;
    opacity: root.enabled ? 1 : Theme.o-dim;
    accessible-role: button;
    accessible-label: root.tip;
    ic := Icon {
        source: root.icon;
        width: Theme.icon-sm; height: Theme.icon-sm;
        tint: root.on ? Theme.white : root.tone == "server" || root.tone == "dev" ? Theme.accent : root.tone == "hp" ? Theme.green : root.tone == "bad" ? Theme.red
            : ta.has-hover && root.enabled ? Theme.text-primary : Theme.text-secondary;
        transform-rotation: root.spin ? Theme.turn * mod(animation-tick(), Theme.spin) / Theme.spin : 0deg;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
    Tip { on: ta.has-hover; text: root.tip; }
}

/// A tab (.brd-tab): network badge, title, ×.
component BrdTab inherits Rectangle {
    in property <DesktopTab> t;
    callback activate();
    callback close();
    height: Theme.control - Theme.sp-4;
    min-width: Theme.sp-48 + Theme.sp-16;
    preferred-width: Theme.drawer-tab-w;
    max-width: Theme.drawer-tab-w;
    horizontal-stretch: 1;
    border-top-left-radius: Theme.r-control; border-top-right-radius: Theme.r-control;
    background: root.t.active ? Theme.bg-secondary : ta.has-hover ? Theme.bg-tertiary : transparent;
    border-width: root.t.active ? 1px : 0px;
    border-color: Theme.border;
    // The tab's lower edge open into the bar under it.
    if root.t.active: Rectangle { y: parent.height - 1px; height: 1px; x: Theme.drawer-tab-inset / 2; width: parent.width - Theme.drawer-tab-inset; background: Theme.bg-secondary; }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.middle { root.close(); }
        }
        clicked => { root.activate(); }
    }
    Tip { on: ta.has-hover; text: root.t.tip; }
    HorizontalLayout {
        padding-left: Theme.sp-10; padding-right: Theme.sp-6;
        spacing: Theme.sp-6;
        alignment: stretch;
        if root.t.badge != "": Rectangle {
            y: (parent.height - self.height) / 2;
            height: bt.preferred-height + Theme.sp-2;
            width: bt.preferred-width + Theme.sp-8;
            border-radius: Theme.r-chip;
            background: root.t.bad ? Theme.red : root.t.badge == "HP" ? Theme.green : Theme.accent;
            bt := Text { text: root.t.badge; color: Theme.white; font-size: Theme.text-10; font-weight: Theme.w-bold; letter-spacing: Theme.track-wide; }
        }
        Text {
            horizontal-stretch: 1;
            text: root.t.title;
            font-size: Theme.text-12;
            font-italic: root.t.sleeping;
            color: root.t.active ? Theme.text-primary : Theme.text-secondary;
            opacity: root.t.sleeping ? Theme.o-soft : 1;
            overflow: elide;
            vertical-alignment: center;
        }
        Rectangle {
            width: Theme.sp-16 + Theme.sp-2; height: self.width;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.r-chip;
            background: xa.has-hover ? Theme.bg-primary : transparent;
            Icon { source: Icons.x; width: Theme.icon-sm; height: Theme.icon-sm; tint: root.t.active ? Theme.text-primary : Theme.text-secondary; opacity: xa.has-hover ? 1 : Theme.o-soft; }
            xa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.close(); } }
            Tip { on: xa.has-hover; text: "Close tab"; }
        }
    }
}

/// One tab's page (the stage): the frame, the marks, the picker's outline,
/// the chat's cursor; pointer, wheel and keys go to the page (or draw).
export component BrowserPanel inherits Rectangle {
    in property <PanelData> data;
    in property <bool> annotating;
    in property <int> index;
    callback pointer(int /* kind: 0 move, 1 down, 2 up, 3 exit */, length, length, int /* button */, length, length);
    callback wheel(length, length, length, length, length, length);
    callback key(string, bool /* down */, bool /* ctrl */, bool /* shift */);
    callback resized(length, length);

    clip: true;
    page := Image {
        source: root.data.frame;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
    }
    changed width => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }
    init => { root.resized(self.width, self.height); }

    fs := FocusScope {
        key-pressed(e) => { root.key(e.text, true, e.modifiers.control, e.modifiers.shift); accept }
        key-released(e) => { root.key(e.text, false, e.modifiers.control, e.modifiers.shift); accept }
        touch := TouchArea {
            mouse-cursor: root.annotating ? (DesktopDrawer.tool == "pick" ? MouseCursor.pointer : MouseCursor.crosshair)
                : root.data.cursor == 1 ? MouseCursor.pointer : root.data.cursor == 2 ? MouseCursor.text : root.data.cursor == 3 ? MouseCursor.crosshair
                : root.data.cursor == 4 ? MouseCursor.move : root.data.cursor == 5 ? MouseCursor.progress : root.data.cursor == 6 ? MouseCursor.not-allowed
                : root.data.cursor == 7 ? MouseCursor.ew-resize : root.data.cursor == 8 ? MouseCursor.ns-resize : root.data.cursor == 9 ? MouseCursor.nesw-resize
                : root.data.cursor == 10 ? MouseCursor.nwse-resize : root.data.cursor == 11 ? MouseCursor.grab : root.data.cursor == 12 ? MouseCursor.grabbing
                : root.data.cursor == 13 ? MouseCursor.help : root.data.cursor == 14 ? MouseCursor.none : MouseCursor.default;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) { fs.focus(); }
                root.pointer(
                    e.kind == PointerEventKind.down ? 1 : e.kind == PointerEventKind.up ? 2 : 0,
                    self.mouse-x, self.mouse-y,
                    e.button == PointerEventButton.right ? 2 : e.button == PointerEventButton.middle ? 1 : 0,
                    root.width, root.height);
            }
            moved => { root.pointer(0, self.mouse-x, self.mouse-y, 0, root.width, root.height); }
            scroll-event(e) => {
                root.wheel(self.mouse-x, self.mouse-y, e.delta-x, e.delta-y, root.width, root.height);
                accept
            }
        }
    }

    // The marks (renderAnn): yours orange, a chat's indigo.
    for a[n] in root.data.anns: Rectangle {
        property <color> c: a.claude ? Theme.accent : Theme.annotate;
        if a.kind == "box" || a.kind == "element": Rectangle {
            x: a.x * 1px; y: a.y * 1px; width: a.w * 1px; height: a.h * 1px;
            border-radius: Theme.r-chip;
            border-width: Theme.sp-2;
            border-color: c;
            background: a.kind == "box" ? c.with-alpha(Theme.o-faint) : c.with-alpha(Theme.o-faint / 2);
        }
        if a.kind == "pen" || a.kind == "arrow": Path {
            x: 0; y: 0;
            width: root.width; height: root.height;
            viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
            commands: a.path;
            stroke: c;
            stroke-width: Theme.sp-2 + 1px;
            fill: transparent;
        }
        if a.kind == "pin": Rectangle {
            x: a.x * 1px - Theme.sp-10 - 1px; y: a.y * 1px - Theme.sp-10 - 1px;
            width: Theme.sp-20 + Theme.sp-2; height: self.width;
            border-radius: self.width / 2;
            background: c;
            border-width: Theme.sp-2; border-color: Theme.white;
            Text { text: n + 1; color: Theme.white; font-size: Theme.text-11; font-weight: Theme.w-bold; horizontal-alignment: center; vertical-alignment: center; }
        }
        if a.has-label: Rectangle {
            x: a.lx * 1px; y: a.ly * 1px;
            width: min(Theme.drawer-label-w, lbl.preferred-width + Theme.sp-12);
            height: lbl.preferred-height + Theme.sp-6;
            border-radius: Theme.r-control;
            background: c;
            lbl := VerticalLayout {
                padding-left: Theme.sp-6; padding-right: Theme.sp-6; padding-top: Theme.sp-2; padding-bottom: Theme.sp-2;
                Text {
                    text: a.num + "  " + a.label;
                    color: Theme.white; font-size: Theme.text-12; wrap: word-wrap;
                }
                if a.sel != "": Text { text: a.sel; color: Theme.white; opacity: Theme.o-soft; font-size: Theme.text-10; font-family: Theme.mono; overflow: elide; }
            }
        }
    }
    // The picker's outline of the element under the pointer, its selector above.
    if root.annotating && root.data.hover-x >= 0: Rectangle {
        x: root.data.hover-x * 1px; y: root.data.hover-y * 1px;
        width: root.data.hover-w * 1px; height: root.data.hover-h * 1px;
        border-width: Theme.sp-2; border-color: Theme.annotate; border-radius: Theme.r-chip;
        background: Theme.annotate.with-alpha(Theme.o-faint);
        Rectangle {
            x: 0; y: - self.height - Theme.sp-2;
            width: min(Theme.drawer-sel-w, hs.preferred-width + Theme.sp-12); height: hs.preferred-height + Theme.sp-2;
            border-radius: Theme.r-chip;
            background: Theme.annotate;
            hs := Text { text: root.data.hover-sel; color: Theme.white; font-size: Theme.text-11; font-family: Theme.mono; overflow: elide; }
        }
    }
    // The chat's cursor (browser_mouse): an indigo arrow tagged "Claude".
    if root.data.cur-x >= 0: Rectangle {
        x: root.data.cur-x * 1px; y: root.data.cur-y * 1px;
        width: Theme.sp-24; height: Theme.sp-24;
        Path {
            x: 0; y: 0; width: Theme.sp-20; height: Theme.sp-20;
            viewbox-width: 24; viewbox-height: 24;
            commands: "M5 2v16.4l4.2-4 2.8 6.4 3-1.3-2.8-6.3h5.9z";
            fill: Theme.accent; stroke: Theme.white; stroke-width: Theme.drawer-cursor-stroke;
        }
        Rectangle {
            x: Theme.sp-16; y: Theme.sp-20;
            width: ct.preferred-width + Theme.sp-8; height: ct.preferred-height + Theme.sp-2;
            border-radius: Theme.r-chip; background: Theme.accent;
            ct := Text { text: "Claude"; color: Theme.white; font-size: Theme.text-10; font-weight: Theme.w-semibold; }
        }
    }
}

/// A popover under a button (.brd-pop): a header, items, notes.
component BrdPop inherits Rectangle {
    in property <string> title;
    in property <[DesktopPopItem]> items;
    callback pick(string);
    width: Theme.drawer-pop-w;
    height: min(col.preferred-height, Theme.drawer-pop-max-h);
    background: Theme.bg-secondary;
    border-width: 1px; border-color: Theme.border;
    border-radius: Theme.r-field;
    drop-shadow-blur: Theme.sp-20; drop-shadow-color: Theme.scrim; drop-shadow-offset-y: Theme.sp-6;
    // Swallow clicks on the card itself.
    TouchArea {}
    Flickable {
        content-height: col.preferred-height;
        col := VerticalLayout {
            padding: Theme.sp-4;
            Text { text: root.title; color: Theme.text-muted; font-size: Theme.text-11; letter-spacing: Theme.track-wide; vertical-alignment: center; height: self.preferred-height + Theme.sp-8; x: Theme.sp-10; }
            for it in root.items: Rectangle {
                height: it.kind == "item" ? Theme.control-sm : itx.preferred-height + Theme.sp-8;
                border-radius: Theme.r-control;
                background: it.kind == "item" && ia.has-hover ? Theme.bg-tertiary : transparent;
                if it.has-icon: Icon { x: Theme.sp-10; source: it.icon; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.text-secondary; }
                itx := Text {
                    x: it.has-icon ? Theme.sp-10 + Theme.icon-sm + Theme.sp-8 : Theme.sp-10; width: parent.width - self.x - Theme.sp-10;
                    text: it.label;
                    color: it.kind == "item" ? (it.on ? Theme.accent : Theme.text-primary) : Theme.text-muted;
                    font-weight: it.on ? Theme.w-semibold : Theme.w-regular;
                    font-size: it.kind == "group" ? Theme.text-11 : it.kind == "note" ? Theme.text-12 : Theme.text-12;
                    letter-spacing: it.kind == "group" ? Theme.track-wide : 0;
                    wrap: it.kind == "note" ? word-wrap : no-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                }
                ia := TouchArea { enabled: it.kind == "item"; mouse-cursor: MouseCursor.pointer; clicked => { root.pick(it.id); } }
            }
        }
    }
}

/// The browser drawer (.brd): its tab strip, the address bar, the
/// annotation bar, then the page of the open tab.
export component BrowserDrawer inherits Rectangle {
    in property <[PanelData]> panels;
    in-out property <int> active;
    in-out property <bool> annotating;
    callback pointer(int, int, length, length, int, length, length);
    callback wheel(int, length, length, length, length, length, length);
    callback key(int, string, bool, bool, bool);
    callback resized(int, length, length);
    callback navigate(int, string);
    callback set-device(int, int);
    callback clear-marks(int);
    callback history(int, int);
    callback hide();
    callback close-all();
    callback drag-width(length);

    property <bool> has-tab: DesktopDrawer.hooked ? DesktopDrawer.has-tab : root.panels.length > 0;
    property <PanelData> cur: root.active >= 0 && root.active < root.panels.length ? root.panels[root.active] : { };
    property <bool> url-focus: url-edit.has-focus;
    changed url-focus => { if !self.url-focus { url-edit.text = DesktopDrawer.hooked ? DesktopDrawer.url : root.cur.url; } }

    background: Theme.bg-secondary;
    HorizontalLayout {
        // The splitter (.brd-split), accent while used; a double click resets.
        Rectangle {
            width: Theme.sp-6;
            background: sp.has-hover || sp.pressed ? Theme.accent : Theme.border;
            sp := TouchArea {
                mouse-cursor: col-resize;
                moved => { if self.pressed { root.drag-width(self.pressed-x - self.mouse-x); } }
                double-clicked => { DesktopDrawer.reset-width(); }
                pointer-event(e) => { if e.kind == PointerEventKind.up { DesktopDrawer.width-done(); } }
            }
            Tip { on: sp.has-hover && !sp.pressed; text: "Drag to resize; double-click to reset"; }
        }
        VerticalLayout {
            // The tab strip (.brd-tabs).
            Rectangle {
                height: Theme.control;
                background: Theme.bg-primary;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding-top: Theme.sp-4; padding-left: Theme.sp-6; padding-right: Theme.sp-6;
                    spacing: Theme.sp-2;
                    alignment: start;
                    for t in DesktopDrawer.tabs: BrdTab {
                        t: t;
                        activate => { DesktopDrawer.activate(t.id); }
                        close => { DesktopDrawer.close-tab(t.id); }
                    }
                    if DesktopDrawer.hooked: BrdBtn { bare: true; icon: Icons.plus; tip: "New tab"; clicked => { DesktopDrawer.new-tab(); } }
                    Rectangle { horizontal-stretch: 1; min-width: 0; }
                    if DesktopDrawer.hooked: BrdBtn { bare: true; icon: Icons.more; tip: "History and browsing data"; clicked => { DesktopDrawer.pop-open("menu"); } }
                    BrdBtn {
                        bare: true;
                        icon: DesktopDrawer.side == "left" ? Icons.chevron-left : Icons.chevron-right;
                        tip: "Hide the browser (pages keep running)";
                        clicked => { DesktopDrawer.hidden(); root.hide(); }
                    }
                    BrdBtn {
                        bare: true; icon: Icons.x; tip: "Close the browser: every tab in this project";
                        clicked => { DesktopDrawer.close-all(); root.close-all(); }
                    }
                }
            }
            // The address bar (.brd-bar).
            Rectangle {
                height: Theme.control-sm + Theme.sp-12 + 1px;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding-top: Theme.sp-6; padding-bottom: Theme.sp-6 + 1px; padding-left: Theme.sp-8; padding-right: Theme.sp-8;
                    spacing: Theme.sp-4;
                    BrdBtn { icon: Icons.chevron-left; tip: "Back"; enabled: root.has-tab && root.cur.can-back; clicked => { root.history(root.active, -1); } }
                    BrdBtn { icon: Icons.chevron-right; tip: "Forward"; enabled: root.has-tab && root.cur.can-forward; clicked => { root.history(root.active, 1); } }
                    BrdBtn { icon: Icons.refresh; tip: "Reload"; enabled: root.has-tab; spin: root.cur.loading; clicked => { root.history(root.active, 0); } }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: Theme.sp-48 + Theme.sp-12;
                        height: Theme.control-sm;
                        border-radius: Theme.r-pill;
                        background: Theme.bg-primary;
                        border-width: 1px;
                        border-color: url-edit.has-focus ? Theme.accent : Theme.border;
                        opacity: root.has-tab ? 1 : Theme.o-dim;
                        if url-edit.text == "": Text {
                            x: Theme.sp-12; width: parent.width - Theme.sp-24;
                            text: "Enter URL or search"; color: Theme.placeholder; font-size: Theme.text-12; font-family: Theme.mono; vertical-alignment: center; overflow: elide;
                        }
                        url-edit := TextInput {
                            x: Theme.sp-12; width: parent.width - Theme.sp-24;
                            vertical-alignment: center;
                            single-line: true;
                            enabled: root.has-tab;
                            text: DesktopDrawer.hooked ? DesktopDrawer.url : root.cur.url;
                            font-family: Theme.mono;
                            font-size: Theme.text-12;
                            color: Theme.text-primary;
                            selection-background-color: Theme.selection;
                            accepted => { if DesktopDrawer.hooked { DesktopDrawer.go(self.text); } else { root.navigate(root.active, self.text); } self.clear-focus(); }
                            edited => { DesktopDrawer.url-typed(self.text); }
                            key-pressed(e) => {
                                if e.text == Key.Escape { self.text = DesktopDrawer.url; self.clear-focus(); DesktopDrawer.url-typed(""); return accept; }
                                if e.text == Key.DownArrow && DesktopDrawer.suggest.length > 0 { DesktopDrawer.suggest-pick = min(DesktopDrawer.suggest-pick + 1, DesktopDrawer.suggest.length - 1); return accept; }
                                if e.text == Key.UpArrow && DesktopDrawer.suggest.length > 0 { DesktopDrawer.suggest-pick = max(-1, DesktopDrawer.suggest-pick - 1); return accept; }
                                if e.text == Key.Return && DesktopDrawer.suggest-pick >= 0 && DesktopDrawer.suggest-pick < DesktopDrawer.suggest.length {
                                    DesktopDrawer.go(DesktopDrawer.suggest[DesktopDrawer.suggest-pick].url); self.clear-focus(); return accept;
                                }
                                reject
                            }
                        }
                    }
                    if DesktopDrawer.logins > 0: BrdBtn {
                        icon: Icons.lock; tone: "server";
                        tip: DesktopDrawer.logins == 1 ? "A saved login for this site" : DesktopDrawer.logins + " saved logins for this site";
                        clicked => { DesktopDrawer.pop-open("passwords"); }
                    }
                    if DesktopDrawer.hooked: BrdBtn { icon: Icons.network; tip: DesktopDrawer.net-tip; tone: DesktopDrawer.net-tone; enabled: root.has-tab; clicked => { DesktopDrawer.pop-open("net"); } }
                    if DesktopDrawer.hooked: BrdBtn { icon: DesktopIcons.smartphone; tip: DesktopDrawer.dev-tip; tone: DesktopDrawer.dev-on ? "dev" : ""; enabled: root.has-tab; clicked => { DesktopDrawer.pop-open("dev"); } }
                    BrdBtn {
                        icon: Icons.message-square; tip: "Annotate the page"; on: root.annotating; enabled: root.has-tab;
                        clicked => { root.annotating = !root.annotating; DesktopDrawer.annotate(root.annotating); }
                    }
                    if DesktopDrawer.hooked: BrdBtn { icon: Icons.terminal; tip: "DevTools"; enabled: root.has-tab; clicked => { DesktopDrawer.devtools(); } }
                }
            }
            // The annotation bar (.brd-annbar), while annotating.
            if root.annotating: Rectangle {
                height: Theme.control-sm + Theme.sp-12 + 1px;
                background: Theme.bg-tertiary;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding-top: Theme.sp-6; padding-bottom: Theme.sp-6 + 1px; padding-left: Theme.sp-8; padding-right: Theme.sp-8;
                    spacing: Theme.sp-4;
                    BrdBtn { icon: Icons.layers; on: DesktopDrawer.tool == "pick"; tip: "Select an element and annotate it (its CSS selector goes with the note)"; clicked => { DesktopDrawer.set-tool("pick"); } }
                    Rectangle { width: 1px; height: Theme.sp-20; y: (parent.height - self.height) / 2; background: Theme.border; }
                    BrdBtn { icon: Icons.pin; on: DesktopDrawer.tool == "pin"; tip: "Draw: a pin with a note"; clicked => { DesktopDrawer.set-tool("pin"); } }
                    BrdBtn { icon: Icons.square; on: DesktopDrawer.tool == "box"; tip: "Draw: a box"; clicked => { DesktopDrawer.set-tool("box"); } }
                    BrdBtn { icon: Icons.pencil; on: DesktopDrawer.tool == "pen"; tip: "Draw: freehand"; clicked => { DesktopDrawer.set-tool("pen"); } }
                    Text { text: DesktopDrawer.count-text; color: Theme.text-secondary; font-size: Theme.text-12; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; min-width: 0; }
                    Rectangle {
                        width: min(Theme.drawer-chat-w, chat-t.preferred-width + Theme.sp-24);
                        height: Theme.control-sm;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.r-control; border-width: 1px; border-color: Theme.border; background: Theme.bg-tertiary;
                        chat-t := Text {
                            x: Theme.sp-6; width: parent.width - Theme.sp-20;
                            text: DesktopDrawer.chat >= 0 && DesktopDrawer.chat < DesktopDrawer.chats.length ? DesktopDrawer.chats[DesktopDrawer.chat] : "No chat open in this project";
                            color: Theme.text-secondary; font-size: Theme.text-12; overflow: elide; vertical-alignment: center;
                        }
                        Icon { x: parent.width - Theme.sp-16; source: Icons.chevron-right; transform-rotation: 90deg; width: Theme.icon-sm * Theme.drawer-chevron-k; height: self.width; tint: Theme.text-muted; }
                        ca := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { DesktopDrawer.pop-open("chat"); } }
                        Tip { on: ca.has-hover; text: "Chat to send to"; }
                    }
                    Text { text: "Send"; color: Theme.text-muted; font-size: Theme.text-12; vertical-alignment: center; }
                    BrdBtn { icon: Icons.file-text; enabled: DesktopDrawer.css-ok; tone: DesktopDrawer.css-ok ? "server" : ""; tip: DesktopDrawer.css-tip; clicked => { DesktopDrawer.send(false); } }
                    BrdBtn { icon: Icons.image; enabled: DesktopDrawer.shot-ok; tone: DesktopDrawer.shot-ok ? "server" : ""; tip: DesktopDrawer.shot-tip; clicked => { DesktopDrawer.send(true); } }
                    Rectangle { width: 1px; height: Theme.sp-20; y: (parent.height - self.height) / 2; background: Theme.border; }
                    BrdBtn { icon: Icons.trash; tip: "Remove your marks"; clicked => { root.clear-marks(root.active); } }
                    BrdBtn { icon: Icons.check; tip: "Done annotating"; clicked => { root.annotating = false; DesktopDrawer.annotate(false); } }
                }
            }
            // The password bar (save / update / fill), under the bars.
            if DesktopDrawer.pw-bar != "": Rectangle {
                height: pwl.preferred-height;
                background: Theme.bg-tertiary;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                pwl := HorizontalLayout {
                    padding: Theme.sp-8; spacing: Theme.sp-6;
                    Icon { source: Icons.lock; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.accent; y: (parent.height - self.height) / 2; }
                    Text { text: DesktopDrawer.pw-text; color: Theme.text-primary; font-size: Theme.text-12; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                    for b in DesktopDrawer.pw-buttons: Rectangle {
                        height: Theme.control-sm - Theme.sp-2; y: (parent.height - self.height) / 2;
                        width: pbt.preferred-width + Theme.sp-20;
                        border-radius: Theme.r-control; border-width: 1px;
                        border-color: b.on ? Theme.accent : Theme.border;
                        background: b.on ? Theme.accent : pba.has-hover ? Theme.bg-hover : Theme.bg-primary;
                        pbt := Text { text: b.label; color: b.on ? Theme.white : Theme.text-primary; font-size: Theme.text-12; }
                        pba := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { DesktopDrawer.pw-act(b.id); } }
                    }
                }
            }
            // The stage (.brd-stage): a dotted ground, the open tab's page.
            stage := Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-primary;
                clip: true;
                for p[i] in root.panels: BrowserPanel {
                    visible: i == root.active && root.has-tab;
                    width: parent.width;
                    height: parent.height;
                    data: p;
                    index: i;
                    annotating: root.annotating;
                    pointer(k, x, y, b, w, h) => { root.pointer(i, k, x, y, b, w, h); }
                    wheel(x, y, dx, dy, w, h) => { root.wheel(i, x, y, dx, dy, w, h); }
                    key(t, d, c, s) => { root.key(i, t, d, c, s); }
                    resized(w, h) => { root.resized(i, w, h); }
                }
                // Why the tab shows nothing (load failed, crashed, could not start).
                if DesktopDrawer.diag != "": Text {
                    width: parent.width - Theme.sp-48; x: Theme.sp-24;
                    text: DesktopDrawer.diag; color: Theme.text-muted; font-size: Theme.text-13;
                    horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
                }
                // No tabs in this project yet.
                if !root.has-tab: VerticalLayout {
                    alignment: center;
                    spacing: Theme.sp-10;
                    Text { text: "No browser tabs in this project yet."; color: Theme.text-muted; font-size: Theme.text-13; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            height: Theme.control-sm + Theme.sp-2; width: ot.preferred-width + Theme.sp-24 + Theme.sp-4;
                            border-radius: Theme.r-control; background: oa.has-hover ? Theme.accent-hover : Theme.accent;
                            ot := Text { text: "Open a tab"; color: Theme.white; font-size: Theme.text-13; }
                            oa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { DesktopDrawer.new-tab(); } }
                        }
                    }
                }
                // A mark's note (.brd-note): Enter keeps, Esc skips.
                if DesktopDrawer.note-open: Rectangle {
                    x: max(0px, min(DesktopDrawer.note-x * 1px, parent.width - self.width));
                    y: max(0px, min(DesktopDrawer.note-y * 1px + Theme.sp-6, parent.height - self.height));
                    width: Theme.drawer-note-w; height: Theme.control-sm + Theme.sp-8;
                    background: Theme.bg-secondary; border-width: 1px; border-color: Theme.accent; border-radius: Theme.r-field;
                    drop-shadow-blur: Theme.sp-12; drop-shadow-color: Theme.scrim; drop-shadow-offset-y: Theme.sp-4;
                    Rectangle {
                        x: Theme.sp-4; y: Theme.sp-4; width: parent.width - Theme.sp-8; height: parent.height - Theme.sp-8;
                        border-radius: Theme.r-control; background: Theme.bg-primary; border-width: 1px; border-color: Theme.border;
                        if note.text == "": Text { x: Theme.sp-8; text: "Note (Enter to keep, Esc to skip)"; color: Theme.placeholder; font-size: Theme.text-12; vertical-alignment: center; }
                        note := TextInput {
                            x: Theme.sp-8; width: parent.width - Theme.sp-16;
                            single-line: true; vertical-alignment: center;
                            font-size: Theme.text-12; color: Theme.text-primary;
                            init => { self.focus(); }
                            accepted => { DesktopDrawer.note(self.text, true); }
                            key-pressed(e) => { if e.text == Key.Escape { DesktopDrawer.note("", false); return accept; } reject }
                            changed has-focus => { if !self.has-focus && DesktopDrawer.note-open { DesktopDrawer.note(self.text, self.text != ""); } }
                        }
                    }
                }
                // The full-cover panels: History, Clear browsing data, Passwords, Homepool.
                if DesktopDrawer.panel != "": DrawerPanels { width: parent.width; height: parent.height; }
            }
        }
    }

    // The address field's suggestions (from the history), under it.
    if url-edit.has-focus && DesktopDrawer.suggest.length > 0: Rectangle {
        x: Theme.sp-6 + Theme.sp-8 + Theme.drawer-nav-buttons * (Theme.control-sm + Theme.sp-4);
        y: Theme.control + Theme.control-sm + Theme.sp-12;
        width: root.width - self.x - Theme.sp-48 * Theme.drawer-tool-buttons;
        height: sug.preferred-height;
        background: Theme.bg-secondary; border-width: 1px; border-color: Theme.border; border-radius: Theme.r-field;
        drop-shadow-blur: Theme.sp-20; drop-shadow-color: Theme.scrim; drop-shadow-offset-y: Theme.sp-6;
        sug := VerticalLayout {
            padding: Theme.sp-4;
            for h[i] in DesktopDrawer.suggest: Rectangle {
                height: Theme.control-sm + Theme.sp-8;
                border-radius: Theme.r-control;
                background: i == DesktopDrawer.suggest-pick || sa.has-hover ? Theme.bg-tertiary : transparent;
                VerticalLayout {
                    padding-left: Theme.sp-8; padding-right: Theme.sp-8; alignment: center;
                    Text { text: h.url; font-family: Theme.mono; font-size: Theme.text-12; color: Theme.text-primary; overflow: elide; }
                    if h.title != "": Text { text: h.title; font-size: Theme.text-11; color: Theme.text-muted; overflow: elide; }
                }
                sa := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { DesktopDrawer.go(h.url); } }
            }
        }
    }

    // A popover (network, device, the "…" menu, the chat picker): a click
    // outside closes it.
    if DesktopDrawer.pop != "": TouchArea {
        clicked => { DesktopDrawer.pop-pick(""); }
    }
    if DesktopDrawer.pop != "": BrdPop {
        x: DesktopDrawer.pop == "menu" ? root.width - self.width - Theme.sp-32 - Theme.sp-4
            : DesktopDrawer.pop == "chat" ? root.width - self.width - Theme.sp-48 * 2
            : root.width - self.width - Theme.sp-48 - Theme.sp-8;
        y: DesktopDrawer.pop == "menu" ? Theme.control : DesktopDrawer.pop == "chat" ? Theme.control + 2 * (Theme.control-sm + Theme.sp-12) : Theme.control + Theme.control-sm + Theme.sp-12;
        title: DesktopDrawer.pop-title;
        items: DesktopDrawer.pop-items;
        pick(id) => { DesktopDrawer.pop-pick(id); }
    }
}
