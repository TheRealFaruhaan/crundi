// The browser panels: a CEF browser per panel, rendered off-screen and shown
// as an image (src/browser.rs), with an annotation layer drawn by Slint on top.

import { ComboBox, CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon } from "widgets.slint";

export struct PanelData {
    frame: image,
    // The page's own size (CSS px) and how it sits in the panel (image-fit: contain).
    view-width: float,
    view-height: float,
    title: string,
    url: string,
    // Which device it emulates (an index into the device list), and who drives it.
    device: int,
    // The device list for this panel: the named devices, plus "Custom WxH" when the server set a size.
    device-names: [string],
    // The page's mouse cursor (src/browser.rs cursor_index).
    cursor: int,
    driver: string,
    // Annotation strokes, as SVG path commands in panel pixels.
    strokes: [string],
    // A pin dropped by a chat (browserPoint), in panel pixels; -1 when none.
    pin-x: float,
    pin-y: float,
    pin-label: string,
}

export component BrowserPanel inherits Rectangle {
    in property <PanelData> data;
    in property <bool> annotating;
    in property <int> index;
    callback pointer(int /* kind: 0 move, 1 down, 2 up, 3 exit */, length, length, int /* button */, length, length);
    callback wheel(length, length, length, length, length, length);
    callback key(string, bool /* down */, bool /* ctrl */, bool /* shift */);
    callback resized(length, length);
    callback navigate(string);
    callback set-device(int);
    callback clear-marks();
    callback history(int /* -1 back, 1 forward, 0 reload */);
    callback toggle-annotate();

    // The dropdown follows the panel's device (set from here, not bound: the
    // ComboBox assigns its own index when someone picks, which would drop a binding).
    property <int> shown-device: root.data.device;
    changed shown-device => { device-box.current-index = self.shown-device; }

    background: Theme.bg-primary;
    clip: true;

    VerticalLayout {
        // The address bar (.brd-bar): back, forward, reload, the URL pill, device, annotate.
        Rectangle {
            height: Theme.sp-40;
            background: Theme.bg-secondary;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-top: Theme.sp-6; padding-bottom: Theme.sp-6; padding-left: Theme.sp-8; padding-right: Theme.sp-8;
                spacing: Theme.sp-6;
                for b[i] in [Icons.chevron-left, Icons.chevron-right, Icons.refresh]: Rectangle {
                    width: Theme.control-sm; height: Theme.control-sm;
                    border-radius: Theme.r-control;
                    background: nb.has-hover ? Theme.bg-hover : Theme.bg-tertiary;
                    Icon { source: b; width: Theme.icon-md; height: Theme.icon-md; tint: Theme.text-secondary; }
                    nb := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.history(i == 0 ? -1 : i == 1 ? 1 : 0); } }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: Theme.control-sm;
                    border-radius: Theme.r-bubble;
                    background: Theme.bg-primary;
                    border-width: 1px;
                    border-color: url-edit.has-focus ? Theme.accent : Theme.border;
                    url-edit := TextInput {
                        x: Theme.sp-12; width: parent.width - Theme.sp-24;
                        vertical-alignment: center;
                        single-line: true;
                        text: root.data.url;
                        font-family: Theme.mono;
                        font-size: Theme.text-13;
                        color: Theme.text-primary;
                        accepted => { root.navigate(self.text); }
                    }
                }
                device-box := ComboBox {
                    width: Theme.title-cap;
                    height: Theme.control-sm;
                    model: root.data.device-names;
                    selected(v) => { root.set-device(self.current-index); }
                }
                Rectangle {
                    width: Theme.control-sm; height: Theme.control-sm;
                    border-radius: Theme.r-control;
                    background: root.annotating ? Theme.accent : an.has-hover ? Theme.bg-hover : Theme.bg-tertiary;
                    Icon { source: Icons.message-square; width: Theme.icon-md; height: Theme.icon-md; tint: root.annotating ? Theme.white : Theme.text-secondary; }
                    an := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.toggle-annotate(); } }
                }
                if root.annotating: Rectangle {
                    width: Theme.control-sm; height: Theme.control-sm;
                    border-radius: Theme.r-control;
                    background: cm.has-hover ? Theme.bg-hover : Theme.bg-tertiary;
                    Icon { source: Icons.trash; width: Theme.icon-md; height: Theme.icon-md; tint: Theme.text-secondary; }
                    cm := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clear-marks(); } }
                }
            }
        }
        stage := Rectangle {
            background: Theme.bg-primary;
            // The page, scaled to fit the stage when it emulates a device bigger than the panel.
            page := Image {
                source: root.data.frame;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }
            // The annotation layer: Slint draws over the browser.
            for s in root.data.strokes: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                commands: s;
                stroke: Theme.annotate;
                stroke-width: Theme.sp-4;
                fill: transparent;
            }
            if root.data.pin-x >= 0: Rectangle {
                x: root.data.pin-x * 1px - self.width / 2;
                y: root.data.pin-y * 1px - self.height / 2;
                width: Theme.sp-20; height: Theme.sp-20; border-radius: Theme.r-pill;
                background: Theme.accent; border-color: Theme.white; border-width: Theme.sp-2;
            }
            if root.data.pin-x >= 0 && root.data.pin-label != "": Rectangle {
                x: root.data.pin-x * 1px + Theme.sp-16;
                y: root.data.pin-y * 1px - Theme.sp-10;
                height: Theme.sp-20;
                width: pin-text.preferred-width + Theme.sp-12;
                border-radius: Theme.r-control;
                background: Theme.accent;
                pin-text := Text { text: root.data.pin-label; color: Theme.white; font-size: Theme.text-12; }
            }
            changed width => { root.resized(self.width, self.height); }
            changed height => { root.resized(self.width, self.height); }
            init => { root.resized(self.width, self.height); }

            fs := FocusScope {
                key-pressed(e) => { root.key(e.text, true, e.modifiers.control, e.modifiers.shift); accept }
                key-released(e) => { root.key(e.text, false, e.modifiers.control, e.modifiers.shift); accept }
                touch := TouchArea {
                    mouse-cursor: root.annotating ? MouseCursor.crosshair
                        : root.data.cursor == 1 ? MouseCursor.pointer : root.data.cursor == 2 ? MouseCursor.text : root.data.cursor == 3 ? MouseCursor.crosshair
                        : root.data.cursor == 4 ? MouseCursor.move : root.data.cursor == 5 ? MouseCursor.progress : root.data.cursor == 6 ? MouseCursor.not-allowed
                        : root.data.cursor == 7 ? MouseCursor.ew-resize : root.data.cursor == 8 ? MouseCursor.ns-resize : root.data.cursor == 9 ? MouseCursor.nesw-resize
                        : root.data.cursor == 10 ? MouseCursor.nwse-resize : root.data.cursor == 11 ? MouseCursor.grab : root.data.cursor == 12 ? MouseCursor.grabbing
                        : root.data.cursor == 13 ? MouseCursor.help : root.data.cursor == 14 ? MouseCursor.none : MouseCursor.default;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) { fs.focus(); }
                        root.pointer(
                            e.kind == PointerEventKind.down ? 1 : e.kind == PointerEventKind.up ? 2 : 0,
                            self.mouse-x, self.mouse-y,
                            e.button == PointerEventButton.right ? 2 : e.button == PointerEventButton.middle ? 1 : 0,
                            stage.width, stage.height);
                    }
                    moved => { root.pointer(0, self.mouse-x, self.mouse-y, 0, stage.width, stage.height); }
                    scroll-event(e) => {
                        root.wheel(self.mouse-x, self.mouse-y, e.delta-x, e.delta-y, stage.width, stage.height);
                        accept
                    }
                }
            }
        }
    }
}


/// The browser drawer (.brd): beside the project area, on the right, with
/// its tab strip, and the page of the open tab under its address bar.
export component BrowserDrawer inherits Rectangle {
    in property <[PanelData]> panels;
    in-out property <int> active;
    in-out property <bool> annotating;
    callback pointer(int, int, length, length, int, length, length);
    callback wheel(int, length, length, length, length, length, length);
    callback key(int, string, bool, bool, bool);
    callback resized(int, length, length);
    callback navigate(int, string);
    callback set-device(int, int);
    callback clear-marks(int);
    callback history(int, int);
    callback hide();
    callback close-all();
    callback drag-width(length);

    background: Theme.bg-primary;
    HorizontalLayout {
        // The splitter, accent while used.
        Rectangle {
            width: Theme.sp-6;
            background: sp.has-hover || sp.pressed ? Theme.accent : Theme.border;
            sp := TouchArea {
                mouse-cursor: col-resize;
                moved => { if self.pressed { root.drag-width(self.pressed-x - self.mouse-x); } }
            }
        }
        VerticalLayout {
            // The tab strip (.brd-tabs).
            Rectangle {
                height: Theme.control;
                background: Theme.bg-primary;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                HorizontalLayout {
                    padding-top: Theme.sp-4; padding-left: Theme.sp-6; padding-right: Theme.sp-6;
                    spacing: Theme.sp-2;
                    for p[i] in root.panels: Rectangle {
                        height: Theme.control - Theme.sp-4;
                        width: min(Theme.sidebar-width, max(Theme.sp-48, tt.preferred-width + Theme.sp-32));
                        border-top-left-radius: Theme.r-control; border-top-right-radius: Theme.r-control;
                        background: i == root.active ? Theme.bg-secondary : th.has-hover ? Theme.bg-hover : transparent;
                        border-width: i == root.active ? 1px : 0px;
                        border-color: Theme.border;
                        tt := Text {
                            x: Theme.sp-10; width: parent.width - Theme.sp-32;
                            text: p.title == "" ? "New tab" : p.title;
                            font-size: Theme.text-12;
                            color: i == root.active ? Theme.text-primary : Theme.text-secondary;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        th := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.active = i; } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    for b[i] in [Icons.more, Icons.chevron-right, Icons.x]: Rectangle {
                        width: Theme.sp-24; height: Theme.sp-24;
                        border-radius: Theme.r-control;
                        background: tb.has-hover ? Theme.bg-hover : transparent;
                        Icon { source: b; width: Theme.icon-md; height: Theme.icon-md; tint: Theme.text-secondary; }
                        tb := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { if i == 1 { root.hide(); } else if i == 2 { root.close-all(); } } }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                for p[i] in root.panels: BrowserPanel {
                    visible: i == root.active;
                    width: parent.width;
                    height: parent.height;
                    data: p;
                    index: i;
                    annotating: root.annotating;
                    pointer(k, x, y, b, w, h) => { root.pointer(i, k, x, y, b, w, h); }
                    wheel(x, y, dx, dy, w, h) => { root.wheel(i, x, y, dx, dy, w, h); }
                    key(t, d, c, s) => { root.key(i, t, d, c, s); }
                    resized(w, h) => { root.resized(i, w, h); }
                    navigate(u) => { root.navigate(i, u); }
                    set-device(d) => { root.set-device(i, d); }
                    clear-marks => { root.clear-marks(i); }
                    history(h) => { root.history(i, h); }
                    toggle-annotate => { root.annotating = !root.annotating; }
                }
            }
        }
    }
}
