// The PC client's look: one constant theme (DESIGN.md, rule 2). The colours
// are the web UI's palette; every size is a step of a scale, and the few
// named sizes are the client's structure (the window, the bars, the
// sidebar, the pane header, control heights, icons). Screens never type a
// number but 0 and 1px hairlines: they use these. tools/tokens.sh lists any
// left.

/// A soft shadow or glow (widgets.slint SoftShadow): it fades from `c` at
/// the box's edge to nothing over `blur`, moved down by `y`.
export struct Shadow { blur: length, y: length, c: color }

/// A faint glow on the sign-in page: a circle at a fraction of the window
/// (fx across, fy down) with a radius of a fraction `fr` of its height.
export struct Glow { fx: float, fy: float, fr: float }

export global Theme {
    // Surfaces, darkest first.
    out property <color> bg-primary: #0a0a0f;
    out property <color> bg-secondary: #12121a;
    out property <color> bg-tertiary: #1a1a28;
    out property <color> bg-hover: #22223a;
    out property <color> bg-card: #14141f;
    out property <color> border: #2a2a3d;
    out property <color> border-subtle: #1e1e30;

    // Text. `white` is text and icons on an accent or red fill.
    out property <color> text-primary: #e8e8f0;
    out property <color> text-secondary: #8888a8;
    out property <color> text-muted: #5a5a78;
    out property <color> white: #ffffff;

    // Accent (the mark's indigo) and the one warm colour.
    out property <color> accent: #6366f1;
    out property <color> accent-hover: #818cf8;
    out property <color> accent-deep: #4f46e5;
    out property <color> accent-dim: #6366f126;
    out property <color> amber: #fbbf24;

    // States.
    out property <color> green: #10b981;
    out property <color> green-dim: #10b98126;
    out property <color> red: #ef4444;
    out property <color> red-dim: #ef444426;
    out property <color> yellow: #f59e0b;
    out property <color> yellow-dim: #f59e0b26;
    out property <color> sky: #38bdf8;
    out property <color> sky-dim: #38bdf829;
    out property <color> sky-ring: #38bdf82e;
    // Plan mode's border (the mode button).
    out property <color> sky-edge: #38bdf873;

    // Tints of the palette.
    out property <color> error-text: #fca5a5;
    out property <color> error-edge: #ef444466;
    out property <color> red-ring: #ef444434;
    out property <color> green-ring: #10b98134;
    out property <color> accent-edge: #6366f159;
    out property <color> accent-line: #6366f166;
    out property <color> accent-ring: #6366f147;
    out property <color> accent-glow: #6366f140;
    out property <color> accent-haze: #6366f11a;
    out property <color> accent-mist: #6366f10f;
    out property <color> accent-mist2: #6366f11f;
    out property <color> accent-clear: #6366f100;
    out property <color> accent-hover-edge: #818cf8d9;
    out property <color> accent-hover-mist: #818cf80f;
    out property <color> accent-hover-clear: #818cf800;
    out property <color> usage-used: #6366f138;
    out property <color> usage-time: #7daaff29;
    out property <color> hairline-light: #ffffff0d;
    out property <color> card-top: #17171f;
    out property <color> placeholder: #757575;
    out property <color> annotate: #ea580c;
    out property <color> slate-dim: #94a3b826;
    // A handed-over message's drawer (2.9): its edge and its fill.
    out property <color> slate-edge: #94a3b873;
    out property <color> slate-haze: #94a3b817;
    // Selected text in a text field.
    out property <color> selection: #0236a1;
    // A modal's backdrop.
    out property <color> scrim: #0000008c;

    // Spacing: 2, 4, 6, 8, 10, 12, 16, 20, 24, 32, 40, 48. Every gap,
    // padding and small box is one of these (or a sum of two).
    out property <length> sp-2: 2px;
    out property <length> sp-4: 4px;
    out property <length> sp-6: 6px;
    out property <length> sp-8: 8px;
    out property <length> sp-10: 10px;
    out property <length> sp-12: 12px;
    out property <length> sp-16: 16px;
    out property <length> sp-20: 20px;
    out property <length> sp-24: 24px;
    out property <length> sp-32: 32px;
    out property <length> sp-40: 40px;
    out property <length> sp-48: 48px;

    // Radius: a chip, a control, a field, a card or pane, a bubble, a pill
    // (also any circle: a radius is held to half the size).
    out property <length> r-chip: 4px;
    out property <length> r-control: 6px;
    out property <length> r-field: 8px;
    out property <length> r-card: 10px;
    out property <length> r-bubble: 12px;
    out property <length> r-pill: 999px;

    // Font sizes: 10, 11, 12, 13, 14, 15, 16, 20, 26.
    out property <length> text-10: 10px;
    out property <length> text-11: 11px;
    out property <length> text-12: 12px;
    out property <length> text-13: 13px;
    out property <length> text-14: 14px;
    out property <length> text-15: 15px;
    out property <length> text-16: 16px;
    out property <length> text-20: 20px;
    out property <length> text-26: 26px;
    // Weights: 400, 500, 600, 700.
    out property <int> w-regular: 400;
    out property <int> w-medium: 500;
    out property <int> w-semibold: 600;
    out property <int> w-bold: 700;
    // Line heights. The chat's line box is 1.55 × its text size (line-chat,
    // for padding a line to it) and the UI's 1.3; as Slint's
    // line-height-factor (over the font's own line) those are lh-chat and lh-ui.
    out property <float> line-chat: 1.55;
    out property <float> lh-chat: 1.33;
    out property <float> lh-ui: 1.12;
    // Shares: a user bubble's widest (of the log's width), a square icon
    // button's icon (of the button).
    out property <float> bubble-share: 0.86;
    out property <float> icon-share: 0.55;
    // A queued message's drawer shows at most this many rows (2.9).
    out property <int> queue-rows: 4;
    // The schedule panel (2.10): its message box's rows (and an item's text
    // at most), and its tallest, a share of the chat's height.
    out property <int> sched-rows: 3;
    out property <float> sched-share: 0.82;
    // Letter spacing: tight (packed marks, small bold capitals) and wide
    // (capitals in labels, a code's characters).
    out property <length> track-tight: -0.5px;
    out property <length> track-wide: 1px;

    // ─── Structure: the only named sizes ───
    // The window.
    out property <length> window-w: 1400px;
    out property <length> window-h: 860px;
    out property <length> window-min-w: 900px;
    out property <length> window-min-h: 520px;
    // The bars and the sidebar.
    out property <length> topbar-height: 48px;
    out property <length> tabbar-height: 36px;
    out property <length> sidebar-width: 240px;
    out property <length> sidebar-folded: 60px;
    // Panes (src/mosaic.rs and src/head.rs hold the same numbers): the
    // header (narrow under pane-fold), a pane's least width, the gutter
    // between panes, a title's widest, the composer's stacking width and
    // tallest input.
    out property <length> pane-head: 28px;
    out property <length> pane-head-narrow: 26px;
    out property <length> pane-min: 340px;
    out property <length> pane-fold: 560px;
    out property <length> gutter: 7px;
    out property <length> title-cap: 160px;
    out property <length> composer-stack: 520px;
    out property <length> composer-max: 180px;
    // The browser drawer: its width, its least, and what it leaves the panes.
    out property <length> drawer-w: 560px;
    out property <length> drawer-min: 320px;
    out property <length> drawer-reserve: 420px;
    // A small modal dialog (the permission-mode picker): its width and its
    // tallest.
    out property <length> dialog-w: 380px;
    out property <length> dialog-max-h: 560px;
    // Control heights: small (header and toolbar buttons, chips), regular
    // (buttons, inputs), large (fields, tabs, launcher buttons).
    out property <length> control-sm: 28px;
    out property <length> control: 34px;
    out property <length> control-lg: 36px;
    // Icons.
    out property <length> icon-sm: 12px;
    out property <length> icon-md: 14px;
    out property <length> icon-lg: 16px;
    out property <length> icon-xl: 20px;

    // Motion.
    out property <duration> motion-fast: 120ms;
    out property <duration> motion: 220ms;
    out property <duration> menu-linger: 350ms;
    // How long the pointer rests before a tooltip shows.
    out property <duration> tip-delay: 600ms;
    out property <duration> frame: 16ms;
    // Opacity of things that are there but quiet.
    out property <float> o-faint: 0.3;
    out property <float> o-dim: 0.4;
    out property <float> o-caret: 0.55;
    out property <float> o-soft: 0.6;
    out property <float> o-usage: 0.7;
    out property <float> o-clone: 0.92;

    // Gradients.
    out property <brush> grad-accent: @linear-gradient(135deg, #6366f1 0%, #818cf8 100%);
    out property <brush> grad-card: @linear-gradient(180deg, #17171f 0%, #12121a 100%);
    out property <brush> glow-mascot: @radial-gradient(circle, #6366f140 0%, #6366f100 65%);
    // The sign-in page's two glows (top right, bottom left), in accent-haze
    // and accent-hover-mist.
    out property <Glow> glow-a: { fx: 0.82, fy: -0.12, fr: 0.43 };
    out property <Glow> glow-b: { fx: -0.08, fy: 1.12, fr: 0.33 };

    // Shadows and glows (SoftShadow): a menu or toast, a dragged pane, the
    // sign-in card, the Send button, the folded rail's working and active
    // avatars.
    out property <Shadow> shadow-menu: { blur: 16px, y: 6px, c: #00000052 };
    out property <Shadow> shadow-clone: { blur: 24px, y: 12px, c: #00000047 };
    out property <Shadow> shadow-card: { blur: 40px, y: 24px, c: #00000040 };
    out property <Shadow> glow-send: { blur: 8px, y: 2px, c: #6366f133 };
    out property <Shadow> glow-yellow: { blur: 8px, y: 0px, c: #f59e0b59 };
    out property <Shadow> glow-accent: { blur: 10px, y: 0px, c: #6366f159 };

    // Type: the mono stack, set at start for the system (src/main.rs).
    in-out property <string> mono: "DejaVu Sans Mono";
}

/// Easing curves (a global of their own: Theme is shared with the Rust side,
/// which can't take an easing). The layout's ease, as the web's.
export global Motion {
    out property <easing> layout: cubic-bezier(0.2, 0.7, 0.2, 1);
}
