// The PC client's look: one constant theme (DESIGN.md, rule 2). The colours
// are the web UI's palette; every size is a step of a scale, and the few
// named sizes are the client's structure (the window, the bars, the
// sidebar, the pane header, control heights, icons). Screens never type a
// number but 0 and 1px hairlines: they use these. tools/tokens.sh lists any
// left.

/// A soft shadow or glow (widgets.slint SoftShadow): it fades from `c` at
/// the box's edge to nothing over `blur`, moved down by `y`.
export struct Shadow { blur: length, y: length, c: color }

/// A faint glow on the sign-in page: a circle at a fraction of the window
/// (fx across, fy down) with a radius of a fraction `fr` of its height.
export struct Glow { fx: float, fy: float, fr: float }

export global Theme {
    // Surfaces, darkest first.
    out property <color> bg-primary: #0a0a0f;
    out property <color> bg-secondary: #12121a;
    out property <color> bg-tertiary: #1a1a28;
    out property <color> bg-hover: #22223a;
    out property <color> bg-card: #14141f;
    out property <color> border: #2a2a3d;
    out property <color> border-subtle: #1e1e30;

    // Text. `white` is text and icons on an accent or red fill.
    out property <color> text-primary: #e8e8f0;
    out property <color> text-secondary: #8888a8;
    out property <color> text-muted: #5a5a78;
    out property <color> white: #ffffff;

    // Accent (the mark's indigo) and the one warm colour.
    out property <color> accent: #6366f1;
    out property <color> accent-hover: #818cf8;
    out property <color> accent-deep: #4f46e5;
    out property <color> accent-dim: #6366f126;
    out property <color> amber: #fbbf24;

    // States.
    out property <color> green: #10b981;
    out property <color> green-dim: #10b98126;
    out property <color> red: #ef4444;
    out property <color> red-dim: #ef444426;
    out property <color> yellow: #f59e0b;
    out property <color> yellow-dim: #f59e0b26;
    out property <color> sky: #38bdf8;
    out property <color> sky-dim: #38bdf829;
    out property <color> sky-ring: #38bdf82e;
    // Plan mode's border (the mode button).
    out property <color> sky-edge: #38bdf873;
    // The parked card's warning edge (2.23): yellow at .35.
    out property <color> yellow-edge: #f59e0b59;

    // Tints of the palette.
    out property <color> error-text: #fca5a5;
    out property <color> error-edge: #ef444466;
    out property <color> red-ring: #ef444434;
    out property <color> green-ring: #10b98134;
    out property <color> accent-edge: #6366f159;
    out property <color> accent-line: #6366f166;
    out property <color> accent-ring: #6366f147;
    out property <color> accent-glow: #6366f140;
    out property <color> accent-haze: #6366f11a;
    out property <color> accent-mist: #6366f10f;
    out property <color> accent-mist2: #6366f11f;
    out property <color> accent-clear: #6366f100;
    out property <color> accent-hover-edge: #818cf8d9;
    out property <color> accent-hover-mist: #818cf80f;
    out property <color> accent-hover-clear: #818cf800;
    out property <color> usage-used: #6366f138;
    out property <color> usage-time: #7daaff29;
    out property <color> hairline-light: #ffffff0d;
    out property <color> card-top: #17171f;
    out property <color> placeholder: #757575;
    out property <color> annotate: #ea580c;
    out property <color> slate-dim: #94a3b826;
    // A handed-over message's drawer (2.9): its edge and its fill.
    out property <color> slate-edge: #94a3b873;
    out property <color> slate-haze: #94a3b817;
    // Selected text in a text field.
    out property <color> selection: #0236a1;
    // A modal's backdrop.
    out property <color> scrim: #0000008c;
    // A reply StyledText's default colour (K3): its text is in an explicit
    // colour; a dark default makes Slint draw inline code's faint outline.
    out property <color> chip-key: #0a0a0f;
    // Media (2.16m): the picture viewer's backdrop, a frame's box, a video's
    // play button and its ring (over a picture: white on dark).
    out property <color> backdrop: #000000db;
    // A parked pane (2.23): its conversation darkened (the web's
    // brightness .55; no blur, PLAN.md), then the veil, darkest at the centre.
    out property <color> park-dim: #00000073;
    out property <brush> park-veil: @radial-gradient(circle, #0a0a0f8c 0%, #0a0a0f26 70%);
    out property <color> frame-bg: #0f0f14;
    // The suggestion's dashed edge, and its edge on hover (2.17).
    out property <color> sug-edge: #818cf88c;
    out property <color> sug-edge-on: #6366f18c;
    // A rule in a reply: the browser's 2px inset line (dark top, light bottom).
    out property <color> rule-dark: #9a9a9a;
    out property <color> rule-light: #eeeeee;
    out property <color> play-bg: #0000008c;
    out property <color> play-edge: #ffffff40;
    out property <color> ring-faint: #ffffff2e;

    // Spacing: 2, 4, 6, 8, 10, 12, 16, 20, 24, 32, 40, 48. Every gap,
    // padding and small box is one of these (or a sum of two).
    out property <length> sp-2: 2px;
    out property <length> sp-4: 4px;
    out property <length> sp-6: 6px;
    out property <length> sp-8: 8px;
    out property <length> sp-10: 10px;
    out property <length> sp-12: 12px;
    out property <length> sp-16: 16px;
    out property <length> sp-20: 20px;
    out property <length> sp-24: 24px;
    out property <length> sp-32: 32px;
    out property <length> sp-40: 40px;
    out property <length> sp-48: 48px;

    // Radius: a chip, a control, a field, a card or pane, a bubble, a pill
    // (also any circle: a radius is held to half the size).
    out property <length> r-chip: 4px;
    out property <length> r-control: 6px;
    out property <length> r-field: 8px;
    out property <length> r-card: 10px;
    out property <length> r-bubble: 12px;
    out property <length> r-pill: 999px;

    // Font sizes: 10, 11, 12, 13, 14, 15, 16, 20, 26.
    out property <length> text-10: 10px;
    out property <length> text-11: 11px;
    out property <length> text-12: 12px;
    out property <length> text-13: 13px;
    out property <length> text-14: 14px;
    out property <length> text-15: 15px;
    out property <length> text-16: 16px;
    out property <length> text-20: 20px;
    out property <length> text-26: 26px;
    // Weights: 400, 500, 600, 700.
    out property <int> w-regular: 400;
    out property <int> w-medium: 500;
    out property <int> w-semibold: 600;
    out property <int> w-bold: 700;
    // Line heights. The chat's line box is 1.55 × its text size (line-chat,
    // for padding a line to it) and the UI's 1.3; as Slint's
    // line-height-factor (over the font's own line) those are lh-chat and lh-ui.
    out property <float> line-chat: 1.55;
    // The composer's line (the web's .cc-input, K5).
    out property <float> line-composer: 1.45;
    // Set at start from the UI font's own line (src/fonts.rs: these are
    // DejaVu Sans's; Segoe UI's and San Francisco's own lines differ, K2).
    in-out property <float> lh-chat: 1.33;
    in-out property <float> lh-ui: 1.12;
    // The composer's box: the web's 1.45 (K5).
    in-out property <float> lh-composer: 1.246;
    // The chat's font (K1): the UI font with a line of line-chat, so a
    // StyledText's wrapped lines sit as the web's. Empty when it could not
    // be made (the system's font then, and the one-line padding).
    in-out property <string> chat-font;
    // The window's scale (src/main.rs): shadows snap to whole screen pixels.
    in-out property <float> px-scale: 1;
    // The font's own line (StyledText's: a user bubble's selectable copy
    // lines up with the drawn text, F122).
    out property <float> lh-plain: 1;
    // Shares: a user bubble's widest (of the log's width), a square icon
    // button's icon (of the button).
    out property <float> bubble-share: 0.86;
    out property <float> icon-share: 0.55;
    // A queued message's drawer shows at most this many rows (2.9).
    out property <int> queue-rows: 4;
    // The schedule panel (2.10): its message box's rows (and an item's text
    // at most), and its tallest, a share of the chat's height.
    out property <int> sched-rows: 3;
    out property <float> sched-share: 0.82;
    // The slash menu's tallest (2.11), about six and a half items.
    out property <length> slash-max-h: 190px;
    // The chat secrets dialog (2.12): its width, its pick list's tallest,
    // a lock field's width.
    out property <length> dialog-w-lg: 460px;
    // The resume picker (2.22): the web's 560 (dialog-w-lg wraps every title).
    out property <length> dialog-w-xl: 560px;
    // The parked card's widest (2.23), and the body heights its short and
    // very short forms start at.
    out property <length> park-card-w: 330px;
    // A widget check's screenshot's height (2.20, the web's 150).
    out property <length> shot-h: 150px;
    // The factory card's note: three lines tall, growing to six (2.20).
    out property <int> note-rows: 3;
    out property <int> note-rows-max: 6;
    out property <length> park-short-h: 330px;
    out property <length> park-tiny-h: 210px;
    out property <length> pick-max-h: 240px;
    out property <length> lock-field-w: 150px;
    // Secret requests (2.12b): a run's command box at its tallest, and the
    // window width at or under which the dock spans the window.
    out property <length> cmd-max-h: 140px;
    out property <length> dock-narrow: 640px;
    // Letter spacing: tight (packed marks, small bold capitals) and wide
    // (capitals in labels, a code's characters).
    out property <length> track-tight: -0.5px;
    out property <length> track-wide: 1px;

    // ─── Structure: the only named sizes ───
    // The window.
    out property <length> window-w: 1400px;
    out property <length> window-h: 860px;
    out property <length> window-min-w: 900px;
    out property <length> window-min-h: 520px;
    // The bars and the sidebar.
    out property <length> topbar-height: 48px;
    out property <length> tabbar-height: 36px;
    out property <length> sidebar-width: 240px;
    out property <length> sidebar-folded: 60px;
    // Panes (src/mosaic.rs and src/head.rs hold the same numbers): the
    // header (narrow under pane-fold), a pane's least width, the gutter
    // between panes, a title's widest, the composer's stacking width and
    // tallest input.
    out property <length> pane-head: 28px;
    out property <length> pane-head-narrow: 26px;
    out property <length> pane-min: 340px;
    out property <length> pane-fold: 560px;
    out property <length> gutter: 7px;
    out property <length> title-cap: 160px;
    out property <length> composer-stack: 520px;
    out property <length> composer-max: 180px;
    // The browser drawer: its width, its least, and what it leaves the panes.
    out property <length> drawer-w: 560px;
    out property <length> drawer-min: 320px;
    out property <length> drawer-reserve: 420px;
    // A small modal dialog (the permission-mode picker): its width and its
    // tallest.
    out property <length> dialog-w: 380px;
    out property <length> dialog-max-h: 560px;
    // Control heights: small (header and toolbar buttons, chips), regular
    // (buttons, inputs), large (fields, tabs, launcher buttons).
    out property <length> control-sm: 28px;
    out property <length> control: 34px;
    out property <length> control-lg: 36px;
    // Icons.
    out property <length> icon-sm: 12px;
    out property <length> icon-md: 14px;
    out property <length> icon-lg: 16px;
    out property <length> icon-xl: 20px;

    // Motion.
    out property <duration> motion-fast: 120ms;
    out property <duration> motion: 220ms;
    out property <duration> menu-linger: 350ms;
    // How long a two-click button stays armed ("Sure?") before it disarms
    // (kit.slint SmallBtn, the web's .confirming).
    out property <duration> confirm-arm: 3s;
    // The shared context menu's least width (.ctx-menu min-width).
    out property <length> menu-min-w: 190px;
    // How long the pointer rests before a tooltip shows.
    out property <duration> tip-delay: 600ms;
    out property <duration> frame: 16ms;
    // A tool card's spinner: one turn (2.14, the web's 0.7 s), and its ring.
    out property <duration> spin: 700ms;
    out property <length> spin-stroke: 1.5px;
    // A launching button's spinner (the web's .cr-busy): 15 across, a 2px
    // white ring at .35 with a white arc.
    out property <length> spin-busy: 15px;
    out property <color> spin-busy-ring: #ffffff59;
    out property <angle> turn: 360deg;
    // A live thinking block (2.15): the label's shimmer, the caret's blink.
    out property <duration> shimmer: 1600ms;
    out property <duration> blink: 1000ms;
    // Voice input (2.24): the recording dot's blink, and the mic's ring
    // while Claude speaks (sky at .35).
    out property <duration> rec-blink: 1200ms;
    // A live frame on the log tells it is there this often (2.16f).
    out property <duration> frame-seen: 250ms;
    out property <color> sky-ring-voice: #38bdf859;
    // The log (2.16): following the bottom within this of it; the jump
    // button past the larger of this and a third of the log.
    out property <length> stick-within: 60px;
    out property <length> jump-at: 240px;
    out property <float> jump-share: 0.3333;
    // The jump button's glide, at most this many frames.
    out property <int> glide-frames: 20;
    // Media boxes: one item at most this wide; files at most this wide; the
    // download rows' width.
    out property <length> media-max-w: 640px;
    out property <length> file-max-w: 460px;
    out property <length> dl-w: 320px;
    // A chat's dock (suggestion, recap; 2.18's badges) at its widest.
    out property <length> chat-dock-w: 320px;
    // A permission card's input box at its tallest (the web's 200).
    out property <length> pre-max-h: 200px;
    // The viewer's zoom: a step, a double click's, the most.
    out property <float> zoom-step: 1.4;
    out property <float> zoom-double: 2.5;
    out property <float> zoom-max: 8;
    // Opacity of things that are there but quiet.
    out property <float> o-faint: 0.3;
    out property <float> o-dim: 0.4;
    out property <float> o-caret: 0.55;
    out property <float> o-soft: 0.6;
    out property <float> o-usage: 0.7;
    out property <float> o-clone: 0.92;

    // Gradients.
    out property <brush> grad-accent: @linear-gradient(135deg, #6366f1 0%, #818cf8 100%);
    out property <brush> grad-card: @linear-gradient(180deg, #17171f 0%, #12121a 100%);
    out property <brush> glow-mascot: @radial-gradient(circle, #6366f140 0%, #6366f100 65%);
    // The sign-in page's two glows (top right, bottom left), in accent-haze
    // and accent-hover-mist.
    out property <Glow> glow-a: { fx: 0.82, fy: -0.12, fr: 0.43 };
    out property <Glow> glow-b: { fx: -0.08, fy: 1.12, fr: 0.33 };

    // Shadows and glows (SoftShadow): a menu or toast, a dragged pane, the
    // sign-in card, the Send button, the folded rail's working and active
    // avatars.
    out property <Shadow> shadow-menu: { blur: 20px, y: 6px, c: #00000080 };
    out property <Shadow> shadow-clone: { blur: 32px, y: 12px, c: #0000008c };
    out property <Shadow> shadow-card: { blur: 60px, y: 24px, c: #00000099 };
    out property <Shadow> glow-send: { blur: 12px, y: 2px, c: #6366f159 };
    out property <Shadow> glow-yellow: { blur: 8px, y: 0px, c: #f59e0b59 };
    out property <Shadow> glow-accent: { blur: 10px, y: 0px, c: #6366f159 };
    // SoftShadow's Gaussian (K4): how much of the colour each stop leaves
    // out (1 − the erfc profile at 0, ¼, ½, ¾ and 1 of the 2 × blur fade),
    // and the stops' spacing.
    out property <float> gauss-0: 0.023;
    out property <float> gauss-1: 0.159;
    out property <float> gauss-2: 0.5;
    out property <float> gauss-3: 0.841;
    out property <float> gauss-4: 0.977;
    out property <float> gauss-step: 0.25;
    // The parked card's Resume (0 0 24px accent at .35).
    out property <Shadow> glow-resume: { blur: 24px, y: 0px, c: #6366f159 };

    // Type: the mono stack, set at start for the system (src/main.rs).
    in-out property <string> mono: "DejaVu Sans Mono";
    // The UI font: empty for the system's own; on Linux the bundled DejaVu
    // Sans (src/main.rs), whose italic faces the system may lack.
    in-out property <string> ui-font;

    // ── The areas' named sizes (AREAS.md) ──
    // An area adds a token only inside its own section below (scales above
    // are the Lead's), named after its screen (kanban-col-w…), and only for
    // structure: anything else is a scale step. Never edit another area's.
    // ── workspace ──
    // The file editor's highlighting (CodeMirror's oneDark, the web's editor).
    out property <color> ws-hl-plain: #abb2bf;
    out property <color> ws-hl-keyword: #c678dd;
    out property <color> ws-hl-string: #98c379;
    out property <color> ws-hl-comment: #7d8799;
    out property <color> ws-hl-number: #d19a66;
    out property <color> ws-hl-func: #61afef;
    out property <color> ws-hl-type: #e5c07b;
    out property <color> ws-hl-prop: #e06c75;
    out property <color> ws-hl-op: #56b6c2;
    out property <color> ws-editor-bg: #282c34;
    out property <color> ws-editor-gutter: #7d8799;
    out property <color> ws-editor-line: #2c313a;
    // The Git diff's rows (feOpenDiff): removed, added, the empty side, the
    // changed words, a chunk's bar.
    out property <color> ws-diff-del: #2d1215;
    out property <color> ws-diff-add: #0f291a;
    out property <color> ws-diff-del-pad: #1a1215;
    out property <color> ws-diff-add-pad: #0f1a15;
    out property <color> ws-diff-del-word: #5c2020;
    out property <color> ws-diff-add-word: #1a4a2a;
    out property <color> ws-diff-del-text: #f87171;
    out property <color> ws-diff-add-text: #34d399;
    out property <color> ws-diff-chunk: #1e293b;
    // The terminal's palette (TERM_THEME) beyond the theme's own colours.
    out property <color> ws-term-magenta: #a855f7;
    out property <color> ws-term-magenta-hi: #c084fc;
    out property <color> ws-term-cyan: #06b6d4;
    out property <color> ws-term-cyan-hi: #22d3ee;
    out property <color> ws-term-sel: #6366f14d;
    // The Files list's per-type marks (fileIcon).
    out property <color> ws-ft-js: #f7df1e;
    out property <color> ws-ft-ts: #3178c6;
    out property <color> ws-ft-jsx: #61dafb;
    out property <color> ws-ft-json: #a8a8a2;
    out property <color> ws-ft-html: #e34c26;
    out property <color> ws-ft-css: #264de4;
    out property <color> ws-ft-scss: #cd6799;
    out property <color> ws-ft-py: #3776ab;
    out property <color> ws-ft-go: #00add8;
    out property <color> ws-ft-rs: #dea584;
    out property <color> ws-ft-java: #f89820;
    out property <color> ws-ft-c: #555555;
    out property <color> ws-ft-cpp: #659ad2;
    out property <color> ws-ft-sh: #4eaa25;
    out property <color> ws-ft-ps: #012456;
    out property <color> ws-ft-sql: #e38c00;
    out property <color> ws-ft-md: #519aba;
    out property <color> ws-ft-yml: #cb171e;
    out property <color> ws-ft-xml: #e37933;
    out property <color> ws-ft-svg: #ffb13b;
    out property <color> ws-ft-pdf: #e5252a;
    out property <color> ws-ft-lock: #ecd53f;
    out property <color> ws-ft-vue: #42b883;
    out property <color> ws-ft-svelte: #ff3e00;
    out property <color> ws-ft-docker: #2496ed;
    out property <color> ws-ft-git: #f1502f;
    out property <color> ws-ft-npm: #cb3837;
    // Media: the checker behind a thumbnail.
    out property <color> ws-checker: #ffffff08;
    // Structure: the editor window (.fe-window: min(900, 80%) x min(72%, 820),
    // at least 360 x 200), a media card (.media-card) and its thumbnail, the
    // terminal's longest input before it scrolls, the media search.
    out property <length> ws-win-w: 900px;
    out property <length> ws-win-h: 820px;
    out property <length> ws-win-min-w: 360px;
    out property <length> ws-win-min-h: 200px;
    out property <length> ws-media-card: 150px;
    out property <length> ws-media-thumb: 110px;
    out property <length> ws-term-input-max: 120px;
    out property <length> ws-search-w: 280px;
    // ── end workspace ──
    // ── planning ──
    // Kanban: a column's narrowest and widest (.kanban-col), the panel width
    // under which columns stack (@container 700px), the width under which
    // the toolbar folds to icons (480px), and a card under which its
    // action labels fold (220px; 320px for a compact card).
    out property <length> kanban-col-min: 220px;
    out property <length> kanban-col-max: 360px;
    out property <length> kanban-stack: 700px;
    out property <length> kanban-fold: 480px;
    out property <length> kanban-card-fold: 220px;
    out property <length> kanban-card-fold-compact: 320px;
    // The attachments strip's width bounds (.kc-media-pop) and its thumbs.
    out property <length> kanban-pop-min: 220px;
    out property <length> kanban-pop-max: 360px;
    out property <length> kanban-thumb: 48px;
    // ── end planning ──
    // ── ops ──
    // Vault (ui/ops/vault*.slint): a PIN's letter spacing, the PIN modal's
    // card (.pin-box 320), the lock dialogs' (.csl-card 420).
    out property <length> vault-pin-track: 6px;
    out property <length> vault-pin-w: 320px;
    out property <length> vault-lock-w: 420px;
    // Extras (ui/ops/extras*.slint): the approvals panel (.appr-panel 420,
    // its detail's most 140), the add-project card (.modal 400), What's new
    // (its copy column's least 340, the stage 640 x 400, the frame's most
    // 760, the title, a key's column 150).
    out property <length> extras-appr-w: 420px;
    out property <length> extras-appr-detail-h: 140px;
    out property <length> extras-add-w: 400px;
    out property <length> extras-wn-copy-min: 340px;
    out property <length> extras-wn-stage-w: 640px;
    out property <length> extras-wn-stage-h: 400px;
    out property <length> extras-wn-frame-max: 760px;
    out property <length> extras-wn-title: 40px;
    out property <length> extras-wn-key-w: 150px;
    // What's new's copy column (42% of the window), the approvals panel's
    // most height (70% of it).
    out property <float> extras-wn-copy-share: 0.42;
    out property <float> extras-appr-max-share: 0.7;
    // Panels (widgets, ui/ops/panels.slint): the tab's list column, a tab
    // row, the slot <select>, an inline card's and a dock's frame limits,
    // the chip popover, a chip's widest.
    out property <length> panels-list-w: 232px;
    out property <length> panels-item-h: 40px;
    out property <length> panels-select-w: 132px;
    out property <length> panels-frame-min: 36px;
    out property <length> panels-frame-start: 80px;
    out property <length> panels-inline-max: 460px;
    out property <length> panels-dock-floor: 120px;
    out property <float> panels-dock-share: 0.44;
    out property <length> panels-pop-w: 440px;
    out property <length> panels-pop-h: 560px;
    out property <length> panels-chip-max: 220px;
    out property <length> panels-chip-face-max: 260px;
    // Skills + Info (ui/ops/skills.slint, ui/ops/info.slint): an info row's
    // value share (.info-row .value max-width 60%), the server log box's
    // height (300), the status key column (.bk-k 92), the restore card (340).
    out property <float> info-value-share: 0.6;
    out property <length> info-logs-h: 300px;
    out property <length> skills-key-w: 92px;
    out property <length> skills-restore-w: 340px;
    // Settings (ui/ops/settings.slint): the notification matrix's mode
    // column (.ntf-row 62px), the idle-minutes field (110), the Telegram
    // chat id field (260), Cru's selects and fields (340), the pairing
    // picture (300).
    out property <length> settings-ntf-col: 62px;
    out property <length> settings-num-w: 110px;
    out property <length> settings-chat-w: 260px;
    out property <length> settings-select-w: 340px;
    out property <length> settings-pair-pic: 300px;
    // Docker + Homepool (ui/ops/docker*.slint, ui/ops/homepool.slint): a
    // row's number columns (.dk-num 64, .mem 76), the nav's filter (180),
    // the pull field (300), the log filter (280), a key column (.dk-kv 160),
    // a chart's height (84), the job drawer's share of the tab (46%), a
    // chart's fill (opacity .13), the log's ANSI colours the theme lacks
    // (.dk-a-31/32/35/36), homepool's dialog (.hp-dlg 560), its QR (180).
    out property <length> docker-num-w: 64px;
    out property <length> docker-mem-w: 76px;
    out property <length> docker-filter-w: 180px;
    out property <length> docker-pull-w: 300px;
    out property <length> docker-log-filter-w: 280px;
    out property <length> docker-kv-w: 160px;
    out property <length> docker-chart-h: 84px;
    out property <float> docker-job-share: 0.46;
    out property <float> docker-fill: 0.13;
    out property <color> docker-red: #f87171;
    out property <color> docker-green: #34d399;
    out property <color> docker-magenta: #c084fc;
    out property <color> docker-cyan: #22d3ee;
    out property <length> homepool-dlg-w: 560px;
    out property <length> homepool-qr: 180px;
    // ── end ops ──
    // ── desktop ──
    // The browser drawer (crundi-browser-drawer.js): a tab's widest, a
    // mark's label, the picker's selector tag, a popover, the chat picker,
    // a mark's note field.
    out property <length> drawer-tab-w: 200px;
    out property <length> drawer-label-w: 240px;
    out property <length> drawer-sel-w: 320px;
    out property <length> drawer-pop-w: 210px;
    out property <length> drawer-pop-max-h: 420px;
    out property <length> drawer-chat-w: 110px;
    out property <length> drawer-note-w: 240px;
    // The Inbox (.inbox-*): the thread list's width, a picture's widest.
    out property <length> inbox-list-w: 360px;
    out property <length> inbox-msg-w: 760px;
    out property <length> inbox-pic-h: 240px;
    // Cru's screen (crundi-voice.js .cv-*): its width, tallest, the field, the chat view.
    out property <length> cru-w: 420px;
    out property <length> cru-h: 760px;
    out property <length> cru-field: 120px;
    out property <length> cru-chat-h: 260px;
    // ── end desktop ──
}

/// Easing curves (a global of their own: Theme is shared with the Rust side,
/// which can't take an easing). The layout's ease, as the web's.
export global Motion {
    out property <easing> layout: cubic-bezier(0.2, 0.7, 0.2, 1);
}
