// Crundi's PC client, native: the window, laid out as the web UI's app shell
// (src/webapp-html.js #app): the top bar; then the sidebar, the project area
// (tab bar, then the workbench or another tab) and the browser drawer.

import { Theme } from "theme.slint";
import { Pointer } from "widgets.slint";
import { Icons } from "icons.slint";
import { SignInPage } from "signin.slint";
import { TopBar, ProjectSidebar, TabBar, ProjectItem, TabItem } from "shell.slint";
import { Workbench, AddMenu, PaneView, GutterView, PaneCard } from "workbench.slint";
import { EntryView, ToolView } from "chat.slint";
import { BrowserDrawer, PanelData } from "browser.slint";

export { PanelData, EntryView, ToolView, ProjectItem, PaneView, GutterView, Theme, Pointer }

export component MainWindow inherits Window {
    title: "Crundi";
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 900px;
    min-height: 520px;
    background: Theme.bg-primary;
    default-font-size: 13px;
    // No system frame, as the Electron client: the top bar has the window buttons.
    no-frame: !root.browser-only;

    // ─── The session ───
    in property <bool> signed-in;
    in property <bool> browser-only;
    in property <bool> online;
    in property <string> username;
    in property <string> server;
    callback sign-out();
    // The top bar: usage, the inbox, the window buttons.
    in property <bool> usage-on;
    in property <float> wk-used;
    in property <float> wk-time;
    in property <string> wk-left;
    in property <float> fh-used;
    in property <float> fh-time;
    in property <string> fh-left;
    in property <string> usage-age;
    in property <int> inbox-unread;
    callback win-drag();
    callback win-min();
    callback win-max();
    callback win-close();

    // ─── Signing in ───
    // "server" (which server) or "login" (signing in to it).
    in property <string> signin-step: "server";
    in-out property <string> signin-server;
    in property <string> signin-error;
    in property <bool> signin-busy;
    in property <bool> signin-checked;
    in property <bool> offer-password;
    in property <bool> offer-google;
    in property <bool> offer-github;
    in property <bool> offer-telegram;
    in property <string> oauth-code;
    callback check-server(string);
    callback change-server();
    callback cancel-server();
    callback sign-in-pair(string);
    callback sign-in-password(string, string, string);
    callback sign-in-oauth(string, string);
    callback cancel-sign-in();

    // ─── Projects and tabs ───
    in property <[ProjectItem]> projects;
    in property <string> current-project;
    in property <string> project-name;
    in-out property <string> current-tab: "workbench";
    callback select-project(string);
    property <[TabItem]> tabs: [
        { id: "workbench", label: "Workbench", icon: Icons.terminal },
        { id: "git", label: "Git", icon: Icons.git-branch },
        { id: "files", label: "Files", icon: Icons.folder },
        { id: "kanban", label: "Kanban", icon: Icons.kanban },
        { id: "notes", label: "Notes", icon: Icons.file-text },
        { id: "mindmap", label: "Mindmap", icon: Icons.mindmap },
        { id: "media", label: "Media", icon: Icons.images },
        { id: "panels", label: "Panels", icon: Icons.panel },
        { id: "factories", label: "Factories", icon: Icons.factory },
        { id: "schedule", label: "Schedule", icon: Icons.clock },
        { id: "services", label: "Services", icon: Icons.server },
        { id: "docker", label: "Docker", icon: Icons.docker },
        { id: "homepool", label: "Homepool", icon: Icons.network },
        { id: "info", label: "Info", icon: Icons.info },
        { id: "secrets", label: "Secrets", icon: Icons.lock },
        { id: "settings", label: "Settings", icon: Icons.settings },
    ];

    // ─── The workbench ───
    in property <[PaneView]> panes;
    in property <[GutterView]> gutters;
    in property <length> content-width;
    in-out property <bool> add-menu-open;
    callback wb-area(length, length);
    callback focus-pane(int);
    callback close-pane(int);
    callback gutter-drag(int, int, length, length);
    callback gutter-even(int, int);
    callback split(int, bool);
    callback launch-chat(int, bool);
    callback add-pane(string);
    callback send(string, string);
    callback stop(string);
    callback respond(string, string, string, bool);
    callback answer(string, string, string);
    // The pane header (specs/pane-header-wide.md).
    callback pane-close(int);
    callback pane-full(int);
    callback pane-font(int, int);
    callback pane-pin(int);
    callback pane-secrets(int);
    callback pane-rename(int, string);
    callback pane-maximize(int);
    callback pane-menu(int, bool);
    callback draft-changed(string, string);
    // The pane in full screen, if one is (it covers the window; Esc leaves).
    in property <bool> full-on;
    in property <PaneView> full-pane;
    // A toast: the web UI's, top right under the top bar (3.5 s).
    in property <string> toast;
    in property <bool> toast-error;

    // ─── The browser drawer ───
    in property <[PanelData]> panels;
    in-out property <bool> drawer-open;
    in-out property <length> drawer-width: 560px;
    in-out property <int> drawer-active;
    in-out property <bool> annotating;
    in property <string> status;
    callback pointer(int, int, length, length, int, length, length);
    callback wheel(int, length, length, length, length, length, length);
    callback key(int, string, bool, bool, bool);
    callback resized(int, length, length);
    callback navigate(int, string);
    callback set-device(int, int);
    callback clear-marks(int);
    callback history(int, int);

    if root.browser-only: BrowserDrawer {
        panels: root.panels;
        active <=> root.drawer-active;
        annotating <=> root.annotating;
        pointer(i, k, x, y, b, w, h) => { root.pointer(i, k, x, y, b, w, h); }
        wheel(i, x, y, dx, dy, w, h) => { root.wheel(i, x, y, dx, dy, w, h); }
        key(i, t, d, c, s) => { root.key(i, t, d, c, s); }
        resized(i, w, h) => { root.resized(i, w, h); }
        navigate(i, u) => { root.navigate(i, u); }
        set-device(i, d) => { root.set-device(i, d); }
        clear-marks(i) => { root.clear-marks(i); }
        history(i, h) => { root.history(i, h); }
    }

    if !root.browser-only && !root.signed-in: SignInPage {
        step: root.signin-step;
        server <=> root.signin-server;
        error: root.signin-error;
        busy: root.signin-busy;
        offer-password: root.offer-password;
        offer-google: root.offer-google;
        offer-github: root.offer-github;
        offer-telegram: root.offer-telegram;
        oauth-code: root.oauth-code;
        save-server(s) => { root.check-server(s); }
        change-server => { root.change-server(); }
        cancel-server => { root.cancel-server(); }
        sign-in-pair(l) => { root.sign-in-pair(l); }
        sign-in-password(s, p, c) => { root.sign-in-password(s, p, c); }
        sign-in-oauth(s, p) => { root.sign-in-oauth(s, p); }
        cancel => { root.cancel-sign-in(); }
        drag => { root.win-drag(); }
        minimize => { root.win-min(); }
        maximize => { root.win-max(); }
        close => { root.win-close(); }
    }

    if !root.browser-only && root.signed-in: VerticalLayout {
        TopBar {
            project-name: root.project-name;
            online: root.online;
            usage-on: root.usage-on;
            wk-used: root.wk-used; wk-time: root.wk-time; wk-left: root.wk-left;
            fh-used: root.fh-used; fh-time: root.fh-time; fh-left: root.fh-left;
            usage-age: root.usage-age;
            drag => { root.win-drag(); }
            minimize => { root.win-min(); }
            maximize => { root.win-max(); }
            close => { root.win-close(); }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            ProjectSidebar {
                projects: root.projects;
                current: root.current-project;
                inbox-unread: root.inbox-unread;
                select(a) => { root.select-project(a); }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                TabBar {
                    tabs: root.tabs;
                    current: root.current-tab;
                    drawer-open: root.drawer-open;
                    drawer-has-tabs: root.panels.length > 0;
                    select(t) => { root.current-tab = t; root.add-menu-open = false; }
                    add-menu => { root.add-menu-open = !root.add-menu-open; }
                    toggle-browser => { root.drawer-open = true; }
                }
                Rectangle {
                    vertical-stretch: 1;
                    Workbench {
                        width: parent.width;
                        height: parent.height;
                        visible: root.current-tab == "workbench";
                        panes: root.panes;
                        gutters: root.gutters;
                        content-width: root.content-width;
                        has-project: root.current-project != "";
                        area(w, h) => { root.wb-area(w, h); }
                        focus-pane(id) => { root.focus-pane(id); }
                        close-pane(id) => { root.close-pane(id); }
                        gutter-drag(s, i, d, span) => { root.gutter-drag(s, i, d, span); }
                        gutter-even(s, i) => { root.gutter-even(s, i); }
                        split(id, down) => { root.split(id, down); }
                        launch-chat(id, skip) => { root.launch-chat(id, skip); }
                        send(k, t) => { root.send(k, t); }
                        stop(k) => { root.stop(k); }
                        respond(k, id, b, a) => { root.respond(k, id, b, a); }
                        answer(k, id, o) => { root.answer(k, id, o); }
                        pane-close(id) => { root.pane-close(id); }
                        pane-full(id) => { root.pane-full(id); }
                        pane-font(id, d) => { root.pane-font(id, d); }
                        pane-pin(id) => { root.pane-pin(id); }
                        pane-secrets(id) => { root.pane-secrets(id); }
                        pane-rename(id, t) => { root.pane-rename(id, t); }
                        pane-maximize(id) => { root.pane-maximize(id); }
                        pane-menu(id, on) => { root.pane-menu(id, on); }
                        draft-changed(k, t) => { root.draft-changed(k, t); }
                    }
                    if root.current-tab != "workbench": VerticalLayout {
                        alignment: center;
                        spacing: 14px;
                        Text { text: "This tab comes in a later phase of the native client"; color: Theme.text-muted; font-size: 13px; horizontal-alignment: center; }
                        // Settings: signing out lives here, as in the PC client.
                        if root.current-tab == "settings": HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: so.preferred-width + 28px; height: 34px;
                                border-radius: 6px; border-width: 1px; border-color: Theme.border;
                                background: sh.has-hover ? Theme.red-dim : Theme.bg-tertiary;
                                so := Text { text: "Sign out of " + root.server; font-size: 12px; font-weight: 600; color: sh.has-hover ? Theme.red : Theme.text-primary; }
                                sh := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.sign-out(); } }
                            }
                        }
                    }
                }
            }
            if root.drawer-open: BrowserDrawer {
                width: root.drawer-width;
                panels: root.panels;
                active <=> root.drawer-active;
                annotating <=> root.annotating;
                pointer(i, k, x, y, b, w, h) => { root.pointer(i, k, x, y, b, w, h); }
                wheel(i, x, y, dx, dy, w, h) => { root.wheel(i, x, y, dx, dy, w, h); }
                key(i, t, d, c, s) => { root.key(i, t, d, c, s); }
                resized(i, w, h) => { root.resized(i, w, h); }
                navigate(i, u) => { root.navigate(i, u); }
                set-device(i, d) => { root.set-device(i, d); }
                clear-marks(i) => { root.clear-marks(i); }
                history(i, h) => { root.history(i, h); }
                hide => { root.drawer-open = false; }
                close-all => { root.drawer-open = false; }
                drag-width(d) => { root.drawer-width = max(320px, min(root.width - Theme.sidebar-width - 420px, root.drawer-width + d)); }
            }
        }
    }

    // Full screen: the pane covers the whole window (position: fixed; inset: 0;
    // radius 0), with no drag handle and no ×. Esc leaves (the web leaves with
    // the browser's full screen; Electron has no Esc: the spec asks for it).
    if root.signed-in && root.full-on: FocusScope {
        x: 0; y: 0; width: root.width; height: root.height;
        init => { self.focus(); }
        key-pressed(ev) => {
            if ev.text == Key.Escape { root.pane-full(root.full-pane.id); return accept; }
            return reject;
        }
        PaneCard {
            p: root.full-pane;
            close => { root.pane-close(root.full-pane.id); }
            full-screen => { root.pane-full(root.full-pane.id); }
            font(d) => { root.pane-font(root.full-pane.id, d); }
            font-reset => { root.pane-font(root.full-pane.id, 0); }
            pin => { root.pane-pin(root.full-pane.id); }
            open-secrets => { root.pane-secrets(root.full-pane.id); }
            rename(t) => { root.pane-rename(root.full-pane.id, t); }
            send(t) => { root.send(root.full-pane.key, t); }
            stop => { root.stop(root.full-pane.key); }
            respond(id, b, a) => { root.respond(root.full-pane.key, id, b, a); }
            answer(id, o) => { root.answer(root.full-pane.key, id, o); }
            draft-changed(t) => { root.draft-changed(root.full-pane.key, t); }
        }
    }

    // The toast: top: topbar + 10px; right 16px; at most 420px; bg-secondary,
    // a 1px border with a 3px accent (red: an error) left edge, radius 6,
    // padding 12px 20px, 13.6px text, shadow-md (0 6px 20px rgba(0,0,0,.5)).
    if root.toast != "": Rectangle {
        property <length> w: min(420px, tm.preferred-width + 40px + 3px);
        x: root.width - 16px - self.w;
        y: Theme.topbar-height + 10px;
        width: self.w;
        height: tt.preferred-height + 24px + 2px;
        background: Theme.bg-secondary;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: root.toast-error ? Theme.red : Theme.border;
        drop-shadow-blur: 20px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: #00000080;
        Rectangle { x: 0; width: 3px; border-top-left-radius: Theme.radius-sm; border-bottom-left-radius: Theme.radius-sm; background: root.toast-error ? Theme.red : Theme.accent; }
        tm := Text { visible: false; text: root.toast; font-size: 13.6px; }
        tt := Text {
            x: 23px; y: 13px; width: parent.width - 43px;
            text: root.toast; font-size: 13.6px; color: Theme.text-primary; wrap: word-wrap;
        }
    }

    // The "+" menu, under the "+" by Workbench.
    if root.signed-in && root.add-menu-open: TouchArea {
        clicked => { root.add-menu-open = false; }
    }
    if root.signed-in && root.add-menu-open: AddMenu {
        x: Theme.sidebar-width + 134px;
        y: Theme.topbar-height + 35px;
        pick(k) => { root.add-menu-open = false; root.add-pane(k); }
    }
}
