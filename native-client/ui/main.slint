// The prototype window: a toolbar, and two browser panels side by side. Each
// panel shows its CEF browser's frames as an image (off-screen rendering), with
// an annotation layer drawn by Slint on top of it: the page is part of the
// layout, so anything can be drawn over it.

import { Button, ComboBox, LineEdit, CheckBox } from "std-widgets.slint";

export struct PanelData {
    frame: image,
    // The page's own size (CSS px) and how it sits in the panel (image-fit: contain).
    view-width: float,
    view-height: float,
    title: string,
    url: string,
    // Which device it emulates (an index into the device list), and who drives it.
    device: int,
    driver: string,
    // Annotation strokes, as SVG path commands in panel pixels.
    strokes: [string],
    // A pin dropped by a chat (browserPoint), in panel pixels; -1 when none.
    pin-x: float,
    pin-y: float,
    pin-label: string,
}

component BrowserPanel inherits Rectangle {
    in property <PanelData> data;
    in property <[string]> devices;
    in property <bool> annotating;
    in property <int> index;
    callback pointer(int /* kind: 0 move, 1 down, 2 up, 3 exit */, length, length, int /* button */, length, length);
    callback wheel(length, length, length, length, length, length);
    callback key(string, bool /* down */, bool /* ctrl */, bool /* shift */);
    callback resized(length, length);
    callback navigate(string);
    callback set-device(int);
    callback clear-marks();

    horizontal-stretch: 1;
    // Equal halves: the page image's own size must not widen a panel.
    preferred-width: 100px;
    min-width: 300px;
    background: #12121a;
    border-color: #2a2a3d;
    border-width: 1px;
    border-radius: 8px;
    clip: true;

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            height: 30px;
            url-edit := LineEdit {
                text: root.data.url;
                accepted(t) => { root.navigate(t); }
            }
            ComboBox {
                width: 170px;
                model: root.devices;
                current-index: root.data.device;
                selected(v) => { root.set-device(self.current-index); }
            }
            Button {
                text: "Clear marks";
                clicked => { root.clear-marks(); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Text { text: root.data.title; color: #8888a8; font-size: 11px; overflow: elide; horizontal-stretch: 1; }
            Text { text: root.data.driver; color: #818cf8; font-size: 11px; }
        }
        stage := Rectangle {
            background: #0a0a0f;
            // The page, scaled to fit the stage when it emulates a device bigger than the panel.
            page := Image {
                source: root.data.frame;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }
            // The annotation layer: Slint draws over the browser.
            for s in root.data.strokes: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                commands: s;
                stroke: #ea580c;
                stroke-width: 3px;
                fill: transparent;
            }
            if root.data.pin-x >= 0: Rectangle {
                x: root.data.pin-x * 1px - 11px;
                y: root.data.pin-y * 1px - 11px;
                width: 22px; height: 22px; border-radius: 11px;
                background: #6366f1; border-color: white; border-width: 2px;
            }
            if root.data.pin-x >= 0 && root.data.pin-label != "": Rectangle {
                x: root.data.pin-x * 1px + 16px;
                y: root.data.pin-y * 1px - 10px;
                height: 20px;
                width: pin-text.preferred-width + 14px;
                border-radius: 6px;
                background: #6366f1;
                pin-text := Text { text: root.data.pin-label; color: white; font-size: 12px; }
            }
            changed width => { root.resized(self.width, self.height); }
            changed height => { root.resized(self.width, self.height); }
            init => { root.resized(self.width, self.height); }

            fs := FocusScope {
                key-pressed(e) => { root.key(e.text, true, e.modifiers.control, e.modifiers.shift); accept }
                key-released(e) => { root.key(e.text, false, e.modifiers.control, e.modifiers.shift); accept }
                touch := TouchArea {
                    mouse-cursor: root.annotating ? crosshair : default;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) { fs.focus(); }
                        root.pointer(
                            e.kind == PointerEventKind.down ? 1 : e.kind == PointerEventKind.up ? 2 : 0,
                            self.mouse-x, self.mouse-y,
                            e.button == PointerEventButton.right ? 2 : e.button == PointerEventButton.middle ? 1 : 0,
                            stage.width, stage.height);
                    }
                    moved => { root.pointer(0, self.mouse-x, self.mouse-y, 0, stage.width, stage.height); }
                    scroll-event(e) => {
                        root.wheel(self.mouse-x, self.mouse-y, e.delta-x, e.delta-y, stage.width, stage.height);
                        accept
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Crundi (native prototype: Slint + CEF)";
    preferred-width: 1400px;
    preferred-height: 860px;
    background: #0a0a0f;

    in property <[PanelData]> panels;
    in property <[string]> devices;
    in property <string> status;
    in-out property <bool> annotating;

    callback pointer(int, int, length, length, int, length, length);
    callback wheel(int, length, length, length, length, length, length);
    callback key(int, string, bool, bool, bool);
    callback resized(int, length, length);
    callback navigate(int, string);
    callback set-device(int, int);
    callback clear-marks(int);

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            height: 32px;
            Text { text: "Crundi"; color: #818cf8; font-size: 16px; font-weight: 700; vertical-alignment: center; }
            CheckBox {
                text: "Annotate (draw over the page)";
                checked <=> root.annotating;
            }
            Text { text: root.status; color: #8888a8; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        }
        HorizontalLayout {
            spacing: 10px;
            for p[i] in root.panels: BrowserPanel {
                data: p;
                index: i;
                devices: root.devices;
                annotating: root.annotating;
                pointer(k, x, y, b, w, h) => { root.pointer(i, k, x, y, b, w, h); }
                wheel(x, y, dx, dy, w, h) => { root.wheel(i, x, y, dx, dy, w, h); }
                key(t, d, c, s) => { root.key(i, t, d, c, s); }
                resized(w, h) => { root.resized(i, w, h); }
                navigate(u) => { root.navigate(i, u); }
                set-device(d) => { root.set-device(i, d); }
                clear-marks => { root.clear-marks(i); }
            }
        }
    }
}
