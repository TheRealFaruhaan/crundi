// Crundi's PC client, native: the window. Signed out, the sign-in page;
// signed in, the sidebar (projects and chats) and the main area (a chat, or
// the browser panels).

import { Theme } from "theme.slint";
import { SignInPage } from "signin.slint";
import { Sidebar, ProjectItem, ChatItem } from "sidebar.slint";
import { ChatView, EntryView } from "chat.slint";
import { BrowserArea, PanelData } from "browser.slint";

export { PanelData, EntryView, ProjectItem, ChatItem }

export component MainWindow inherits Window {
    title: "Crundi";
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 760px;
    min-height: 480px;
    background: Theme.bg-primary;
    default-font-size: Theme.font-size;

    // ─── The session ───
    in property <bool> signed-in;
    // The browser panels on their own (driven by a server, for tests).
    in property <bool> browser-only;
    in property <bool> online;
    in property <string> username;
    in property <string> server;
    callback sign-out();

    // ─── Signing in ───
    in-out property <string> signin-server;
    in property <string> signin-error;
    in property <bool> signin-busy;
    in property <bool> signin-checked;
    in property <bool> offer-password;
    in property <bool> offer-google;
    in property <bool> offer-github;
    in property <string> oauth-code;
    callback check-server(string);
    callback sign-in-pair(string);
    callback sign-in-password(string, string, string);
    callback sign-in-oauth(string, string);
    callback cancel-sign-in();

    // ─── Projects and chats ───
    in property <[ProjectItem]> projects;
    in property <string> current-project;
    in property <[ChatItem]> chats;
    in property <string> current-chat;
    in-out property <string> view: "chat";
    callback select-project(string);
    callback select-chat(string);
    callback new-chat();

    // ─── The open chat ───
    in property <[EntryView]> entries;
    in property <string> chat-title;
    in property <string> chat-state;
    in property <string> chat-error;
    in-out property <string> draft;
    callback send(string);
    callback stop();
    callback respond(string, string, bool);
    callback answer(string, string);

    // ─── Browser panels ───
    in property <[PanelData]> panels;
    in-out property <bool> annotating;
    in property <string> status;
    callback pointer(int, int, length, length, int, length, length);
    callback wheel(int, length, length, length, length, length, length);
    callback key(int, string, bool, bool, bool);
    callback resized(int, length, length);
    callback navigate(int, string);
    callback set-device(int, int);
    callback clear-marks(int);

    if root.browser-only: BrowserArea {
        panels: root.panels;
        annotating <=> root.annotating;
        status: root.status;
        pointer(i, k, x, y, b, w, h) => { root.pointer(i, k, x, y, b, w, h); }
        wheel(i, x, y, dx, dy, w, h) => { root.wheel(i, x, y, dx, dy, w, h); }
        key(i, t, d, c, s) => { root.key(i, t, d, c, s); }
        resized(i, w, h) => { root.resized(i, w, h); }
        navigate(i, u) => { root.navigate(i, u); }
        set-device(i, d) => { root.set-device(i, d); }
        clear-marks(i) => { root.clear-marks(i); }
    }

    if !root.browser-only && !root.signed-in: SignInPage {
        server <=> root.signin-server;
        error: root.signin-error;
        busy: root.signin-busy;
        checked: root.signin-checked;
        offer-password: root.offer-password;
        offer-google: root.offer-google;
        offer-github: root.offer-github;
        oauth-code: root.oauth-code;
        check-server(s) => { root.check-server(s); }
        sign-in-pair(l) => { root.sign-in-pair(l); }
        sign-in-password(s, p, c) => { root.sign-in-password(s, p, c); }
        sign-in-oauth(s, p) => { root.sign-in-oauth(s, p); }
        cancel => { root.cancel-sign-in(); }
    }

    if !root.browser-only && root.signed-in: HorizontalLayout {
        Sidebar {
            projects: root.projects;
            current-project: root.current-project;
            chats: root.chats;
            current-chat: root.current-chat;
            view: root.view;
            username: root.username;
            server: root.server;
            online: root.online;
            select-project(a) => { root.view = "chat"; root.select-project(a); }
            select-chat(id) => { root.view = "chat"; root.select-chat(id); }
            new-chat => { root.view = "chat"; root.new-chat(); }
            show(v) => { root.view = v; }
            sign-out => { root.sign-out(); }
        }
        // Both stay alive (the browsers keep their pages); one is shown.
        Rectangle {
            horizontal-stretch: 1;
            ChatView {
                visible: root.view == "chat";
                entries: root.entries;
                title: root.chat-title;
                state: root.chat-state;
                error: root.chat-error;
                has-chat: root.current-chat != "";
                draft <=> root.draft;
                send(t) => { root.send(t); }
                stop => { root.stop(); }
                respond(id, b, a) => { root.respond(id, b, a); }
                answer(id, o) => { root.answer(id, o); }
                new-chat => { root.new-chat(); }
            }
            BrowserArea {
                visible: root.view == "browser";
                panels: root.panels;
                annotating <=> root.annotating;
                status: root.status;
                pointer(i, k, x, y, b, w, h) => { root.pointer(i, k, x, y, b, w, h); }
                wheel(i, x, y, dx, dy, w, h) => { root.wheel(i, x, y, dx, dy, w, h); }
                key(i, t, d, c, s) => { root.key(i, t, d, c, s); }
                resized(i, w, h) => { root.resized(i, w, h); }
                navigate(i, u) => { root.navigate(i, u); }
                set-device(i, d) => { root.set-device(i, d); }
                clear-marks(i) => { root.clear-marks(i); }
            }
        }
    }
}
