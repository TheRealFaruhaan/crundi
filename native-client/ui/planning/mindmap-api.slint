// the Mind map (4.3): the mindmap tab and panel: the globals and structs Rust
// uses (src/planning/mindmap.rs). The web's #mindmap-panel: loadMindmap,
// renderMindmap, layoutMindmap, the node detail modal (#mm-detail-modal),
// the link picker (#link-modal) and the shortcut sheet (#mm-help-modal).

/// A box on the canvas, laid out by Rust (the web's layoutMindmap): `kind`
/// "node" (an idea), "ghost" (the dashed "add idea" under an idea; `parent`
/// is that idea), "draft" (where the idea being typed sits: drawn by the
/// draft layer) or "drop" (the placeholder a drag opens). `x` its left and
/// `y` its middle, unscaled (the canvas scales them by the zoom); `h` its
/// measured height (the ring's and a placeholder's).
export struct PlanningMmNode {
    id: string,
    kind: string,
    parent: string,
    x: length,
    y: length,
    h: length,
    text: string,
    root: bool,
    linked: bool,
    scoped: bool,
    pending: bool,
    // The meta chip: "" none, "link", "missing", "scope", "inherited"; its
    // words, its tooltip, and for a subtask link its box (1 open, 2 done).
    chip: string,
    chip-text: string,
    chip-tip: string,
    todo: int,
    notes: int,
    kids: bool,
    collapsed: bool,
    // The filter: a match lights up, the rest dims; ghosts hide.
    hit: bool,
    dim: bool,
    hidden: bool,
    // A drag: the idea held (faded), the one it would land under (outlined).
    lifted: bool,
    target: bool,
    flash: bool,
}

/// A project chip of the bar over the canvas (.mm-proj-chip).
export struct PlanningMmChip { key: string, label: string, off: bool }

/// One piece of a shortcut's keys: "kbd" a key cap, "plus" / "or" the
/// muted joiners, "word" a word in accent (Click, Hover…).
export struct PlanningMmKey { kind: string, text: string }
export struct PlanningMmKeyLine { keys: [PlanningMmKey] }

/// A box of a shortcut's little tree: its column and row, its words, and
/// "" / "new" (accent fill) / "held" (dashed accent).
export struct PlanningMmBox { col: int, row: int, label: string, kind: string }

/// A row of the shortcut sheet: a section heading (`head`), or keys and
/// what they do; `dia` rows open to a little tree (`open`) with its lines
/// (`path` solid, `dash` dashed, in its own units) and a note under it.
export struct PlanningMmHelp {
    head: string,
    lines: [PlanningMmKeyLine],
    text: string,
    dia: bool,
    open: bool,
    boxes: [PlanningMmBox],
    path: string,
    dash: string,
    dia-w: length,
    dia-h: length,
    note: string,
}

/// A row of the link picker's list: a task (`todo` "") or one of its
/// subtasks.
export struct PlanningMmLinkRow { task: string, todo: string, text: string, status: string, done: bool }

/// A thumbnail in the idea dialog's media strip.
export struct PlanningMmThumb { id: string, name: string, kind: string, has-image: bool, image: image }

export global PlanningMindmap {
    /// "loading", "error" (the panel is the error line), "empty" (no ideas
    /// and none being typed), "ok".
    in-out property <string> state: "loading";
    in-out property <string> error;
    /// What the filter box holds (the toolbar's "Filter ideas…").
    in-out property <string> search;

    // The project bar: shown when an idea is in a project; how many are off.
    in-out property <bool> bar;
    in-out property <[PlanningMmChip]> chips;
    in-out property <int> hidden-count;

    // The map, unscaled: the boxes, the links (solid to ideas, dashed to the
    // "add idea" boxes) and its size; the zoom; where the canvas is scrolled
    // to (bound to its viewport) and the canvas's own size (set by it).
    in-out property <[PlanningMmNode]> nodes;
    in-out property <string> edges;
    in-out property <string> dashes;
    in-out property <length> base-w;
    in-out property <length> base-h;
    in-out property <float> zoom: 1;
    in-out property <length> scroll-x;
    in-out property <length> scroll-y;
    in-out property <length> view-w;
    in-out property <length> view-h;
    // Window position of the canvas (reported when measure-gen moves).
    in-out property <length> canvas-x;
    in-out property <length> canvas-y;
    in-out property <int> measure-gen;

    // An idea opened up over its neighbours: under the pointer (the whole
    // of a long one) and the one being edited (its text box).
    in-out property <PlanningMmNode> hover-node;
    in-out property <bool> hover-on;
    in-out property <PlanningMmNode> edit-node;
    in-out property <bool> edit-on;
    in-out property <string> edit-text;
    // The idea being typed: where it sits, and what is in it.
    in-out property <bool> draft-on;
    in-out property <length> draft-x;
    in-out property <length> draft-y;
    in-out property <string> draft-text;
    // Bumped to put the caret back in the open text box / give the keys to
    // the canvas.
    in-out property <int> focus-gen;
    in-out property <int> canvas-gen;

    // The ring on the idea the keyboard is on (unscaled), and the first
    // press of Delete's warning.
    in-out property <bool> ring-on;
    in-out property <length> ring-x;
    in-out property <length> ring-y;
    in-out property <length> ring-h;
    in-out property <bool> ring-warn;
    in-out property <string> ring-msg;

    // A drag: the idea held, the pointer (unscaled canvas point), where it
    // was grabbed inside the idea, and the idea's words for the clone.
    in-out property <string> drag-id;
    in-out property <length> drag-x;
    in-out property <length> drag-y;
    in-out property <length> grab-x;
    in-out property <length> grab-y;
    in-out property <string> drag-text;

    // The idea dialog (#mm-detail-modal).
    in-out property <bool> d-open;
    in-out property <string> d-title;
    // The link line: "" none, "link", "missing", "scope"; its words, a
    // subtask's box (1 open, 2 done) and its words, the muted part after.
    in-out property <string> d-link-kind;
    in-out property <string> d-link-main;
    in-out property <string> d-link-text;
    in-out property <string> d-link-st;
    in-out property <int> d-link-todo;
    in-out property <[string]> d-notes;
    in-out property <[PlanningMmThumb]> d-thumbs;
    in-out property <string> d-link-label: "Link / scope";
    in-out property <bool> d-editing;
    in-out property <string> d-text;
    in-out property <[string]> d-edit-notes;
    in-out property <int> d-focus-gen;
    in-out property <int> d-note-focus: -1;

    // The link picker (#link-modal).
    in-out property <bool> l-open;
    in-out property <[string]> l-names;
    in-out property <int> l-sel;
    in-out property <bool> l-locked;
    in-out property <string> l-locked-text;
    in-out property <string> l-scope-label;
    in-out property <string> l-search;
    in-out property <bool> l-loading;
    in-out property <[PlanningMmLinkRow]> l-rows;

    // The shortcut sheet (#mm-help-modal).
    in-out property <bool> h-open;
    in-out property <bool> h-all;
    in-out property <[PlanningMmHelp]> h-rows;

    // The toolbar and the panel: add-root, media, help, toggle (an idea's
    // − / +), ghost (its "add idea"), chip (a project), chip-all.
    callback act(string, string);
    callback searched(string);
    // A press on the bare canvas (lets go of the ring, closes a box).
    callback canvas-press();
    // A click and a double click on an idea.
    callback node-click(string);
    callback node-dbl(string);
    // An idea's (or box's) height, unscaled, as drawn.
    callback measured(string, length);
    // Ctrl and the wheel (its delta, the pointer in the canvas's view).
    callback wheel-zoom(length, length, length);
    // The keys: the canvas's (no box open), and the text boxes' (the idea
    // being typed, the one edited): text, Ctrl, Shift, Alt or Meta. True:
    // taken.
    callback key(string, bool, bool, bool) -> bool;
    callback draft-key(string, bool, bool, bool) -> bool;
    callback edit-key(string, bool, bool, bool) -> bool;
    // A text box lost the keys.
    callback draft-blur();
    callback edit-blur();
    // Opened up under the pointer, or not.
    callback hover(string, bool);
    // A drag: start (idea), move (unscaled canvas point), end (commit).
    callback drag-start(string);
    callback drag-move(length, length);
    callback drag-end(bool);
    // The idea dialog's buttons: edit, save, child, link, media, delete,
    // close, add-note; a thumbnail; a note box typed in / removed.
    callback d-act(string);
    callback d-thumb(string);
    callback d-note-edit(int, string);
    callback d-note-del(int);
    // The link picker: project (index), search, scope, pick (task, todo), cancel.
    callback l-act(string, string, string);
    // The shortcut sheet: a row opened or closed; all of them; close.
    callback h-toggle(int);
    callback h-act(string);
}
