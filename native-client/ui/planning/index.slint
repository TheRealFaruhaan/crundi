// The planning area (AREAS.md): phase 4: Kanban, Mind map, Notes, Schedules, webhooks, Factories.
//
// This file is the area's entry point: main.slint and the workbench reach
// the area only through PlanningView (a tab, or a panel in a workbench pane) and
// PlanningOverlay (the area's dialogs, over the whole window). Everything else
// the area draws lives in ui/planning/ and is imported from here. What Rust
// sets and hears (globals, and the structs of their models) goes in
// ui/planning/api.slint, named with the Planning prefix.
//
// Kinds: kanban, notes, mindmap, factories, schedule (tabs); kanban, notes, mindmap, factory (panels)

import { Theme, Icons, PanelPage, EmptyState } from "../kit.slint";
import { PlanningUi } from "api.slint";

/// One of the area's screens: `kind` is the tab's id (or the pane's kind),
/// `key` the pane's key when embedded in a workbench pane ("" in a tab).
export component PlanningView inherits Rectangle {
    in property <string> kind;
    in property <string> key;
    in property <bool> embedded;
    background: Theme.bg-primary;
    // Placeholder until the area builds its screens.
    PanelPage {
        embedded: root.embedded;
        EmptyState { has-icon: false; title: "Not built yet: " + root.kind; hint: "The planning area builds this screen."; }
    }
}

/// The area's layer over the whole window (its dialogs and popovers); it
/// takes no input where it draws nothing.
export component PlanningOverlay inherits Rectangle {
}

