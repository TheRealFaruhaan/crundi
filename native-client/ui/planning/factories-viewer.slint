// Factories (4.8): the live graph of a run (tools/factory-flow/src/Viewer.jsx),
// full in the tab (with Back, the minimap and the replay bar) or in the
// project's Factory panel (Follow, Details as a drawer, a person's
// transcript over the graph). Driven by src/planning/factories.rs through
// PlanningFactories.v and its v-* models.

import { Theme, Icons, Icon, ScrollThumb, CheckRow, TextField, TextArea, LoadingState, SoftShadow } from "../kit.slint";
import { PlanningFactories, PlanningFxTl } from "factories-api.slint";
import { FxBtn, FxIconBtn, FxChip, FxNote, FxSummary, FxIcons, FxTone, FxIssue } from "factories-parts.slint";
import { FxCanvas } from "factories-graph.slint";

/// A scrolling pane (.ff-panel > .ff-pane: padding 12, gap 10).
component Pane inherits Rectangle {
    fl := Flickable {
        width: parent.width; height: parent.height;
        content-height: max(self.height, col.preferred-height);
        col := VerticalLayout { width: fl.width; padding: Theme.sp-12; spacing: Theme.sp-10; alignment: start; @children }
    }
    ScrollThumb { width: root.width; height: root.height; view-h: fl.height; content-h: fl.content-height; offset: -fl.content-y; }
}

/// .ff-actor: a card that needs the person (an ask, a wait, a crash).
component Actor inherits Rectangle {
    in property <image> icon;
    in property <string> head;
    background: Theme.bg-card;
    border-radius: Theme.r-field;
    border-width: 1px;
    border-color: Theme.border;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: Theme.sp-10; spacing: Theme.sp-8;
        HorizontalLayout {
            spacing: Theme.sp-6;
            VerticalLayout { alignment: start; padding-top: Theme.sp-2; Icon { width: Theme.icon-md; height: Theme.icon-md; source: root.icon; tint: Theme.text-primary; } }
            Text { horizontal-stretch: 1; text: root.head; font-size: Theme.text-13; font-weight: Theme.w-semibold; color: Theme.text-primary; wrap: word-wrap; }
        }
        @children
    }
}

/// .ff-kv: muted keys, values beside them.
component Kv inherits HorizontalLayout {
    in property <string> k;
    in property <string> v;
    spacing: Theme.sp-10;
    Text { width: Theme.sp-48 + Theme.sp-24; text: root.k; font-size: Theme.text-12; color: Theme.text-muted; }
    Text { horizontal-stretch: 1; text: root.v; font-size: Theme.text-12; color: Theme.text-primary; wrap: word-wrap; }
}

/// The Run pane (runInfo).
component RunPane inherits Pane {
    property <bool> fopen;
    for x in PlanningFactories.v-kv: Kv { k: x.k; v: x.v; }
    if PlanningFactories.v.has-limits: FxSummary {
        text: "Usage limits: " + PlanningFactories.v.limits-sum;
        open: PlanningFactories.v.limits-open;
        toggled => { PlanningFactories.act("v-limits-open", "", ""); }
    }
    if PlanningFactories.v.has-limits && PlanningFactories.v.limits-open: VerticalLayout {
        spacing: Theme.sp-8;
        HorizontalLayout { spacing: Theme.sp-8;
            VerticalLayout { horizontal-stretch: 1; spacing: Theme.sp-4; Text { text: "5-hour, pause at %"; font-size: Theme.text-12; color: Theme.text-secondary; } TextField { text: PlanningFactories.v.l5h; edited(t) => { PlanningFactories.edit("limits", "pauseAt5h", t); } } }
            VerticalLayout { horizontal-stretch: 1; spacing: Theme.sp-4; Text { text: "Weekly, pause at %"; font-size: Theme.text-12; color: Theme.text-secondary; } TextField { text: PlanningFactories.v.lweek; edited(t) => { PlanningFactories.edit("limits", "pauseAtWeek", t); } } }
        }
        HorizontalLayout { spacing: Theme.sp-8;
            VerticalLayout { horizontal-stretch: 1; spacing: Theme.sp-4; Text { text: "People at once (0: any)"; font-size: Theme.text-12; color: Theme.text-secondary; } TextField { text: PlanningFactories.v.lpar; edited(t) => { PlanningFactories.edit("limits", "maxParallel", t); } } }
            VerticalLayout { horizontal-stretch: 1; spacing: Theme.sp-4; Text { text: "One at a time above %"; font-size: Theme.text-12; color: Theme.text-secondary; } TextField { text: PlanningFactories.v.lone; edited(t) => { PlanningFactories.edit("limits", "oneAtATimeAbove", t); } } }
        }
        HorizontalLayout { alignment: start; FxBtn { text: "Apply to this run"; kind: "primary"; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-limits", "", ""); } } }
    }
    if PlanningFactories.v.manager-talks: FxNote { kind: "hint"; text: "The Manager is talking to you in its chat."; }
    if PlanningFactories.v.manager-chat: HorizontalLayout { alignment: start;
        FxBtn { text: "Open the Manager's chat"; has-icon: true; icon: FxIcons.crown; clicked => { PlanningFactories.act("v-manager-chat", "", ""); } }
    }
    for a in PlanningFactories.v-asks: Actor {
        icon: FxIcons.ask; head: a.prompt;
        if PlanningFactories.v.live: TextArea {
            rows: 2; placeholder: "Optional note"; text: PlanningFactories.v-ask-note;
            edited(t) => { PlanningFactories.v-ask-note = t; }
        }
        if PlanningFactories.v.live: HorizontalLayout { spacing: Theme.sp-6; alignment: start;
            for r in a.replies: FxBtn { text: r.label; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-ask", a.token, r.id); } }
        }
    }
    for w in PlanningFactories.v-waits: Actor {
        icon: Icons.clock; head: w.head;
        if w.gives != "": FxNote { kind: "hint"; text: w.gives; }
        if w.last != "": Rectangle {
            background: Theme.bg-primary; border-radius: Theme.r-control; height: lt.preferred-height + Theme.sp-12;
            lt := Text { x: Theme.sp-6; width: parent.width - Theme.sp-12; text: w.last; font-family: Theme.mono; font-size: Theme.text-11; color: Theme.text-secondary; wrap: word-wrap; }
        }
        if w.url != "": VerticalLayout {
            spacing: Theme.sp-4;
            Text { text: "Signal URL (POST)"; font-size: Theme.text-12; color: Theme.text-secondary; }
            HorizontalLayout { spacing: Theme.sp-6;
                TextField { horizontal-stretch: 1; mono: true; text: w.url; }
                FxBtn { text: "curl"; has-icon: true; icon: Icons.copy; clicked => { PlanningFactories.act("v-copy-curl", w.token, w.url); } }
            }
            FxNote { kind: "hint"; text: "Body optional: {\"note\": \"…\"}, or {\"outcome\": \"failed\"} for Timed out."; }
        }
        HorizontalLayout { spacing: Theme.sp-6; alignment: start;
            FxBtn { text: "End the wait now"; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-end-wait", w.token, "done"); } }
            if w.two: FxBtn { text: "Treat as timed out"; kind: "ghost"; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-end-wait", w.token, "timeout"); } }
        }
    }
    if PlanningFactories.v.findings != "": FxSummary {
        text: PlanningFactories.v.findings;
        open: root.fopen;
        toggled => { root.fopen = !root.fopen; }
    }
    if root.fopen && PlanningFactories.v.findings != "": VerticalLayout { spacing: Theme.sp-4;
        for f in PlanningFactories.v-findings: FxNote { kind: "hint"; text: f; }
    }
    if PlanningFactories.v.crashed: Actor {
        icon: FxIcons.alert; head: "It stopped: " + PlanningFactories.v.crash;
        TextArea { rows: 2; placeholder: "Anything the team should know (optional)"; text: PlanningFactories.v.note; edited(t) => { PlanningFactories.edit("viewer", "note", t); } }
        HorizontalLayout { alignment: start; FxBtn { text: "Recover"; kind: "primary"; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-recover", "", ""); } } }
    }
    if PlanningFactories.v.cap != "": Actor {
        icon: FxIcons.alert; head: "It reached its limit (" + PlanningFactories.v.cap + ").";
        HorizontalLayout { alignment: start; FxBtn { text: "Let it carry on"; kind: "primary"; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-resume", "", ""); } } }
    }
    if PlanningFactories.v.err != "": FxIssue { level: "error"; message: PlanningFactories.v.err; }
    FxNote { kind: "hint"; text: PlanningFactories.v.hint; }
}

/// The Step pane (nodeInfo): who, now, visits, the transcript, each visit.
component StepPane inherits Pane {
    HorizontalLayout {
        spacing: Theme.sp-8;
        FxIconBtn { icon: FxIcons.back; tip: "Back"; clicked => { PlanningFactories.act("v-unselect", "", ""); } }
        Text { horizontal-stretch: 1; text: PlanningFactories.v.sel-title; font-size: Theme.text-13; font-weight: Theme.w-semibold; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
    }
    if PlanningFactories.v.who != "": Kv { k: "Who"; v: PlanningFactories.v.who; }
    Kv { k: "Now"; v: PlanningFactories.v.now; }
    if PlanningFactories.v.visits != "": Kv { k: "Visits"; v: PlanningFactories.v.visits; }
    if PlanningFactories.v.open-chat != "": HorizontalLayout { alignment: start;
        FxBtn { text: PlanningFactories.v.open-chat; kind: "primary"; has-icon: true; icon: FxIcons.ask; clicked => { PlanningFactories.act("v-step-chat", "", ""); } }
    }
    if PlanningFactories.v.no-chat != "": FxNote { kind: "hint"; text: PlanningFactories.v.no-chat; }
    for st in PlanningFactories.v-steps: Rectangle {
        background: Theme.bg-card; border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border;
        height: sl.preferred-height;
        sl := VerticalLayout {
            padding: Theme.sp-10; spacing: Theme.sp-4;
            HorizontalLayout {
                Text { horizontal-stretch: 1; text: st.who; font-size: Theme.text-11; color: Theme.text-muted; overflow: elide; }
                Text { text: st.num; font-size: Theme.text-11; color: Theme.text-muted; }
            }
            Text { text: st.summary; font-size: Theme.text-12; color: Theme.text-primary; wrap: word-wrap; }
            if st.answers != "": FxNote { kind: "hint"; text: st.answers; }
            if st.skills != "": Text { text: st.skills; font-size: Theme.text-10; color: Theme.green; wrap: word-wrap; }
        }
    }
}

/// The Timeline pane: newest first; a click replays up to that moment.
component TimelinePane inherits Pane {
    for t in PlanningFactories.v-timeline: Rectangle {
        border-radius: Theme.r-control;
        background: t.on ? Theme.accent-dim : ta.has-hover ? Theme.bg-hover : transparent;
        opacity: t.future ? Theme.o-dim : 1;
        height: tl.preferred-height;
        ta := TouchArea { mouse-cursor: pointer; clicked => { PlanningFactories.act("v-at", "" + t.i, ""); } }
        tl := HorizontalLayout {
            padding: Theme.sp-6; spacing: Theme.sp-8;
            Text { width: Theme.sp-40; text: t.time; font-family: Theme.mono; font-size: Theme.text-11; color: Theme.text-muted; }
            VerticalLayout { alignment: start; padding-top: Theme.sp-4;
                Rectangle { width: Theme.sp-8; height: Theme.sp-8; border-radius: Theme.sp-4;
                    background: t.k == "start" || t.k == "finish" || t.k == "merged" ? Theme.green : t.k == "escalate" ? Theme.yellow : t.k == "crash" ? Theme.red : t.k == "handoff" ? Theme.accent : Theme.text-muted; }
            }
            VerticalLayout { horizontal-stretch: 1; spacing: Theme.sp-2;
                Text { text: t.main; font-size: Theme.text-12; wrap: word-wrap;
                    color: t.k == "escalate" || t.k == "crash" ? Theme.yellow : t.k == "merged" || t.k == "finish" ? Theme.green : Theme.text-primary; }
                if t.sub != "": Text { text: t.sub; font-size: Theme.text-11; color: Theme.text-muted; wrap: word-wrap; overflow: elide; height: min(self.preferred-height, 2 * Theme.text-11 * Theme.lh-ui + Theme.sp-4); }
            }
        }
    }
}

/// The right side (.ff-right): the tabs (Run / Step, Timeline) and the pane.
component Side inherits Rectangle {
    background: Theme.bg-secondary;
    Rectangle { x: 0; width: 1px; background: Theme.border; }
    VerticalLayout {
        Rectangle {
            height: tabs.preferred-height;
            tabs := HorizontalLayout {
                padding: Theme.sp-6; spacing: Theme.sp-2;
                for t[i] in [{ id: "run", ic: FxIcons.sliders }, { id: "timeline", ic: FxIcons.route }]: Rectangle {
                    horizontal-stretch: 1;
                    height: Theme.control-sm + Theme.sp-2;
                    border-radius: Theme.r-control;
                    background: PlanningFactories.v.tab == t.id || ta.has-hover ? Theme.bg-hover : transparent;
                    HorizontalLayout { alignment: center; spacing: Theme.sp-6;
                        VerticalLayout { alignment: center; Icon { width: Theme.icon-md; height: Theme.icon-md; source: t.ic; tint: PlanningFactories.v.tab == t.id ? Theme.text-primary : Theme.text-secondary; } }
                        Text { text: i == 0 ? (PlanningFactories.v.sel != "" ? "Step" : "Run") : "Timeline"; font-size: Theme.text-12; vertical-alignment: center; color: PlanningFactories.v.tab == t.id ? Theme.text-primary : Theme.text-secondary; }
                    }
                    ta := TouchArea { mouse-cursor: pointer; clicked => { PlanningFactories.act("v-tab", t.id, ""); } }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        if PlanningFactories.v.tab == "timeline": TimelinePane { vertical-stretch: 1; }
        if PlanningFactories.v.tab != "timeline" && PlanningFactories.v.sel != "": StepPane { vertical-stretch: 1; }
        if PlanningFactories.v.tab != "timeline" && PlanningFactories.v.sel == "": RunPane { vertical-stretch: 1; }
    }
}

/// The replay bar (.ff-replay): step back, the slider, step forward, where.
component Replay inherits Rectangle {
    background: Theme.bg-secondary;
    height: Theme.control + Theme.sp-8;
    Rectangle { y: 0; height: 1px; background: Theme.border; }
    property <int> n: PlanningFactories.v.at;
    property <int> total: PlanningFactories.v.events;
    HorizontalLayout {
        padding-left: Theme.sp-8; padding-right: Theme.sp-8; spacing: Theme.sp-8;
        VerticalLayout { alignment: center; FxIconBtn { icon: FxIcons.undo; tip: "Step back"; enabled: root.n > 1; clicked => { PlanningFactories.act("v-at", "" + max(1, root.n - 1), ""); } } }
        track := Rectangle {
            horizontal-stretch: 1;
            Rectangle { height: Theme.sp-4; border-radius: Theme.sp-2; background: Theme.bg-tertiary; }
            Rectangle {
                x: 0; height: Theme.sp-4; border-radius: Theme.sp-2; background: Theme.accent;
                width: root.total > 1 ? parent.width * (root.n - 1) / (root.total - 1) : parent.width;
            }
            Rectangle {
                x: (root.total > 1 ? parent.width * (root.n - 1) / (root.total - 1) : parent.width) - self.width / 2;
                width: Theme.sp-16 - Theme.sp-2; height: self.width; border-radius: self.width / 2; background: Theme.white;
            }
            TouchArea {
                mouse-cursor: pointer;
                pointer-event(ev) => { if ev.kind == PointerEventKind.down { PlanningFactories.act("v-at", "" + round(1 + clamp(self.mouse-x / parent.width, 0, 1) * (root.total - 1)), ""); } }
                moved => { if self.pressed { PlanningFactories.act("v-at", "" + round(1 + clamp(self.mouse-x / parent.width, 0, 1) * (root.total - 1)), ""); } }
            }
        }
        VerticalLayout { alignment: center; FxIconBtn { icon: FxIcons.redo; tip: "Step forward"; enabled: !PlanningFactories.v.live; clicked => { PlanningFactories.act("v-at", "" + (root.n + 1), ""); } } }
        Text { text: PlanningFactories.v.at-label; font-size: Theme.text-12; color: Theme.text-secondary; vertical-alignment: center; }
        if !PlanningFactories.v.live: VerticalLayout { alignment: center; FxBtn { text: "Back to live"; clicked => { PlanningFactories.act("v-live", "", ""); } } }
    }
}

/// A person's transcript, read-only (the web shows the chat page in a frame).
export component TranscriptBody inherits Rectangle {
    if PlanningFactories.chat-state == "loading": LoadingState { }
    if PlanningFactories.chat-state == "error": VerticalLayout { alignment: start; padding: Theme.sp-16; FxNote { kind: "err"; text: "Could not load the chat."; } }
    if PlanningFactories.chat-state == "ok": Pane {
        if PlanningFactories.chat-lines.length == 0: FxNote { text: "Nothing in this chat yet."; }
        for l in PlanningFactories.chat-lines: Rectangle {
            border-radius: Theme.r-field;
            background: l.k == "user" ? Theme.accent-dim : Theme.bg-card;
            height: ll.preferred-height;
            ll := VerticalLayout {
                padding: Theme.sp-8; spacing: Theme.sp-2;
                Text { text: l.k == "user" ? "Prompt" : l.k == "tool" ? "Tool" : "Claude"; font-size: Theme.text-10; letter-spacing: Theme.track-wide; color: Theme.text-muted; }
                Text { text: l.v; font-size: Theme.text-12; color: l.k == "tool" ? Theme.text-secondary : Theme.text-primary; wrap: word-wrap; font-family: l.k == "tool" ? Theme.mono : Theme.ui-font; }
            }
        }
    }
}

/// The live graph.
export component FxViewer inherits Rectangle {
    background: Theme.bg-primary;
    property <bool> compact: root.width < Theme.factories-compact;
    property <bool> panel: PlanningFactories.v.panel;
    if PlanningFactories.v.state == "loading": VerticalLayout { alignment: start; padding: Theme.sp-24; FxNote { text: "Loading the run…"; } }
    if PlanningFactories.v.state == "error": VerticalLayout {
        alignment: start; padding: Theme.sp-16; spacing: Theme.sp-10;
        FxNote { kind: "err"; text: PlanningFactories.v.error; }
        if PlanningFactories.v.back: HorizontalLayout { alignment: start; FxBtn { text: "Back"; clicked => { PlanningFactories.act("v-back", "", ""); } } }
    }
    if PlanningFactories.v.state == "ok": VerticalLayout {
        // .ff-top
        Rectangle {
            background: Theme.bg-secondary;
            height: max(Theme.control + Theme.sp-10, top.preferred-height);
            top := HorizontalLayout {
                padding-left: Theme.sp-8; padding-right: Theme.sp-8; padding-top: Theme.sp-6; padding-bottom: Theme.sp-6;
                spacing: Theme.sp-6;
                if PlanningFactories.v.back: VerticalLayout { alignment: center; FxIconBtn { icon: FxIcons.back; tip: "Back"; clicked => { PlanningFactories.act("v-back", "", ""); } } }
                if root.panel && PlanningFactories.v.chat: VerticalLayout { alignment: center;
                    FxBtn { text: "Graph"; kind: "primary"; has-icon: true; icon: FxIcons.back; fold: root.compact; clicked => { PlanningFactories.act("v-chat-close", "", ""); } }
                }
                Text { text: PlanningFactories.v.name; font-size: Theme.text-14; font-weight: Theme.w-semibold; color: Theme.text-primary; vertical-alignment: center; overflow: elide; min-width: Theme.sp-48; }
                VerticalLayout { alignment: center; FxChip { text: PlanningFactories.v.st-label; tone: PlanningFactories.v.live ? FxTone.state(PlanningFactories.v.st) : ""; } }
                if !root.compact && PlanningFactories.v.progress != "": Text { text: PlanningFactories.v.progress; font-size: Theme.text-11; color: Theme.text-muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                if root.compact || PlanningFactories.v.progress == "": Rectangle { horizontal-stretch: 1; }
                if root.panel && !PlanningFactories.v.chat: VerticalLayout { alignment: center;
                    FxBtn { text: "Follow"; has-icon: true; icon: FxIcons.route; on: PlanningFactories.v.follow; fold: root.compact; clicked => { PlanningFactories.act("v-follow", "", ""); } }
                }
                if root.panel: VerticalLayout { alignment: center;
                    FxBtn { text: "Details"; has-icon: true; icon: FxIcons.sliders; on: PlanningFactories.v.drawer; fold: root.compact; clicked => { PlanningFactories.act("v-drawer", "", ""); } }
                }
                if PlanningFactories.v.can-pause: VerticalLayout { alignment: center;
                    FxBtn { text: "Pause"; has-icon: root.compact; icon: Icons.pause; fold: root.compact; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-pause", "", ""); } }
                }
                if PlanningFactories.v.can-resume: VerticalLayout { alignment: center;
                    FxBtn { text: "Resume"; has-icon: root.compact; icon: Icons.play; fold: root.compact; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-resume", "", ""); } }
                }
                if PlanningFactories.v.can-stop: VerticalLayout { alignment: center;
                    FxBtn { text: "Stop"; kind: "ghost"; has-icon: root.compact; icon: Icons.stop; fold: root.compact; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-stop", "", ""); } }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        // Pause's choices (.ff-needs.info.ff-pause-choice).
        if PlanningFactories.v.pause-menu: Rectangle {
            background: Theme.bg-card;
            height: pm.preferred-height;
            pm := VerticalLayout {
                padding-left: Theme.sp-12; padding-right: Theme.sp-12; padding-top: Theme.sp-8; padding-bottom: Theme.sp-8; spacing: Theme.sp-6;
                Text { text: "Pause: nobody new starts a step."; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
                HorizontalLayout { spacing: Theme.sp-8; alignment: start;
                    CheckRow { checked: PlanningFactories.v.pause-reset; text: "Carry on by itself when usage resets"; toggled(v) => { PlanningFactories.act("v-pause-reset", "", ""); } }
                    VerticalLayout { alignment: center; FxBtn { text: "Let current steps finish"; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-pause-go", "finish", ""); } } }
                    VerticalLayout { alignment: center; FxBtn { text: "Stop them now"; kind: "ghost"; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-pause-go", "now", ""); } } }
                    VerticalLayout { alignment: center; FxIconBtn { icon: Icons.x; tip: "Cancel"; clicked => { PlanningFactories.act("v-pause", "", ""); } } }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        // What needs the person (.ff-needs).
        if PlanningFactories.v.needs-kind != "": Rectangle {
            background: PlanningFactories.v.needs-kind == "bad" ? Theme.red-dim : PlanningFactories.v.needs-kind == "you" ? Theme.yellow-dim : Theme.bg-card;
            height: nb.preferred-height;
            nb := HorizontalLayout {
                padding: Theme.sp-8; spacing: Theme.sp-8;
                VerticalLayout { alignment: center; Icon { width: Theme.icon-md; height: Theme.icon-md; source: FxIcons.alert;
                    tint: PlanningFactories.v.needs-kind == "bad" ? Theme.error-text : PlanningFactories.v.needs-kind == "you" ? Theme.yellow : Theme.text-secondary; } }
                Text { horizontal-stretch: 1; text: PlanningFactories.v.needs-text; font-size: Theme.text-12; vertical-alignment: center; wrap: word-wrap;
                    color: PlanningFactories.v.needs-kind == "bad" ? Theme.error-text : PlanningFactories.v.needs-kind == "you" ? Theme.yellow : Theme.text-secondary; }
                if PlanningFactories.v.needs-act != "": VerticalLayout { alignment: center;
                    FxBtn { text: PlanningFactories.v.needs-act; kind: "primary"; enabled: !PlanningFactories.v.busy; clicked => { PlanningFactories.act("v-needs", "", ""); } }
                }
            }
        }
        // Everyone at work right now (.ff-working).
        if PlanningFactories.v-working.length > 0: Rectangle {
            height: wk.preferred-height;
            wk := HorizontalLayout {
                padding: Theme.sp-6; spacing: Theme.sp-6; alignment: start;
                for w in PlanningFactories.v-working: Rectangle {
                    height: Theme.control-sm;
                    width: min(wl.preferred-width, Theme.factories-right);
                    border-radius: Theme.r-pill;
                    border-width: 1px;
                    border-color: w.blocked ? Theme.yellow-edge : w.busy ? Theme.green-ring : Theme.border;
                    background: wt.has-hover && w.chat != "" ? Theme.bg-hover : Theme.bg-card;
                    opacity: w.queued ? Theme.o-soft : 1;
                    wl := HorizontalLayout {
                        padding-left: Theme.sp-10; padding-right: Theme.sp-10; spacing: Theme.sp-6;
                        VerticalLayout { alignment: center; Rectangle { width: Theme.sp-8; height: Theme.sp-8; border-radius: Theme.sp-4; background: w.blocked ? Theme.yellow : w.busy ? Theme.green : Theme.text-muted; } }
                        Text { text: w.name; font-size: Theme.text-12; font-weight: Theme.w-semibold; color: Theme.text-primary; vertical-alignment: center; }
                        Text { text: w.what; font-size: Theme.text-12; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
                    }
                    wt := TouchArea { enabled: w.chat != ""; mouse-cursor: pointer; clicked => { PlanningFactories.act("v-person", w.chat, w.name); } }
                }
            }
        }
        // .ff-body: the canvas and the side; on a narrow tab the side goes
        // under the canvas; in the panel it is a drawer over it (Details).
        vbody := Rectangle {
            vertical-stretch: 1;
            property <bool> column: !root.panel && root.width < Theme.dock-narrow;
            if !vbody.column: HorizontalLayout {
                FxCanvas {
                    which: "v";
                    nodes: PlanningFactories.v-nodes; edges: PlanningFactories.v-edges;
                    zoom: PlanningFactories.v.zoom; pan-x: PlanningFactories.v.pan-x; pan-y: PlanningFactories.v.pan-y;
                    minimap: !root.panel; bx: PlanningFactories.v.bx; by: PlanningFactories.v.by; bw: PlanningFactories.v.bw; bh: PlanningFactories.v.bh;
                }
                if !root.panel: Side { width: Theme.factories-right; }
            }
            if vbody.column: VerticalLayout {
                FxCanvas {
                    height: parent.height * Theme.factories-canvas-share;
                    which: "v";
                    nodes: PlanningFactories.v-nodes; edges: PlanningFactories.v-edges;
                    zoom: PlanningFactories.v.zoom; pan-x: PlanningFactories.v.pan-x; pan-y: PlanningFactories.v.pan-y;
                }
                Rectangle { height: 1px; background: Theme.border; }
                Side { vertical-stretch: 1; }
            }
            if root.panel && PlanningFactories.v.drawer: Rectangle {
                x: parent.width - self.width;
                width: min(Theme.factories-right + Theme.sp-20, parent.width * Theme.factories-drawer-share);
                SoftShadow { width: parent.width; height: parent.height; radius: 0; shadow: Theme.shadow-menu; }
                Side { }
            }
            // A person's transcript over the graph (the panel).
            if root.panel && PlanningFactories.v.chat: Rectangle {
                background: Theme.bg-primary;
                TranscriptBody { }
            }
        }
        if !root.panel && PlanningFactories.v.events > 1: Replay { }
    }
}

