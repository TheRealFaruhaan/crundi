// Factories (4.7, 4.8): the dialogs over the window: Start a factory (the
// change request: startDialog()), the PIN prompt for the factory's secrets
// (askSecretPins()), a trigger (triggerDialog()) and a person's transcript
// (openChat()'s .fx-chatwrap). Driven by src/planning/factories.rs.
//
// Slint limits (PLAN.md Known gaps): files cannot be dropped or pasted on
// the change request (Attach picks them); the transcript is read-only text,
// not the chat page.

import { Theme, Icons, Icon, ScrollThumb, CheckRow, TextField, TextArea, Select, SoftShadow } from "../kit.slint";
import { PlanningFactories } from "factories-api.slint";
import { FxBtn, FxIconBtn, FxNote, FxField, FxSummary, FxIcons } from "factories-parts.slint";
import { TranscriptBody } from "factories-viewer.slint";

/// .fx-modal-bg + .fx-modal: the scrim (a click closes), the card with its
/// title, a scrolling body, Esc closes.
component FxModal inherits Rectangle {
    in property <string> title;
    in property <length> card-w: Theme.factories-modal-w;
    callback close();
    background: Theme.scrim;
    TouchArea { clicked => { root.close(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(ev) => { if ev.text == Key.Escape { root.close(); return accept; } return reject; }
    }
    card := Rectangle {
        width: min(root.card-w, root.width - 2 * Theme.sp-16);
        height: min(col.preferred-height, root.height - 2 * Theme.sp-16);
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-bubble; shadow: Theme.shadow-card; }
        Rectangle { background: Theme.bg-secondary; border-radius: Theme.r-bubble; border-width: 1px; border-color: Theme.border; }
        TouchArea { }
        fl := Flickable {
            width: parent.width; height: parent.height;
            content-height: col.preferred-height;
            col := VerticalLayout {
                width: fl.width;
                padding: Theme.sp-16; spacing: Theme.sp-12;
                Text { text: root.title; font-size: Theme.text-15; font-weight: Theme.w-semibold; color: Theme.text-primary; wrap: word-wrap; }
                @children
            }
        }
        ScrollThumb { width: parent.width; height: parent.height; view-h: fl.height; content-h: fl.content-height; offset: -fl.content-y; }
    }
}

/// Start a factory.
component StartDialog inherits FxModal {
    title: "Start a factory";
    card-w: Theme.factories-modal-wide;
    close => { PlanningFactories.act("st-close", "", ""); }
    property <bool> stack: self.width < Theme.factories-pair-stack;
    if PlanningFactories.start.loading: FxNote { text: "Loading…"; }
    if !PlanningFactories.start.loading && PlanningFactories.start.empty: VerticalLayout { spacing: Theme.sp-12;
        FxNote { text: "There are no factories yet. Create one in the Factories tab first."; }
        HorizontalLayout { alignment: end; FxBtn { text: "Close"; kind: "ghost"; clicked => { PlanningFactories.act("st-close", "", ""); } } }
    }
    if !PlanningFactories.start.loading && !PlanningFactories.start.empty: VerticalLayout {
        spacing: Theme.sp-8;
        if !root.stack: HorizontalLayout { spacing: Theme.sp-10;
            FxField { horizontal-stretch: 1; label: "Project"; Select { options: PlanningFactories.st-projects; selected: PlanningFactories.start.project-i; picked(i) => { PlanningFactories.edit("start", "project", "" + i); } } }
            FxField { horizontal-stretch: 1; label: "Factory"; Select { options: PlanningFactories.st-factories; selected: PlanningFactories.start.factory-i; picked(i) => { PlanningFactories.edit("start", "factory", "" + i); } } }
        }
        if root.stack: VerticalLayout { spacing: Theme.sp-10;
            FxField { label: "Project"; Select { options: PlanningFactories.st-projects; selected: PlanningFactories.start.project-i; picked(i) => { PlanningFactories.edit("start", "project", "" + i); } } }
            FxField { label: "Factory"; Select { options: PlanningFactories.st-factories; selected: PlanningFactories.start.factory-i; picked(i) => { PlanningFactories.edit("start", "factory", "" + i); } } }
        }
        // .fx-cr: the change request.
        Rectangle {
            border-radius: Theme.r-card; border-width: 1px; border-color: Theme.border; background: Theme.bg-primary;
            height: cr.preferred-height;
            cr := VerticalLayout {
                padding: Theme.sp-12; spacing: Theme.sp-10;
                VerticalLayout { spacing: Theme.sp-2;
                    Text { text: "Change request"; font-size: Theme.text-13; font-weight: Theme.w-bold; color: Theme.text-primary; }
                    Text { text: "The Manager gets all of it; every step gets the title, goal and the checks for done, and can open the rest."; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
                }
                FxField { label: "Title"; tag: "required";
                    ttl := TextField {
                        text: PlanningFactories.start.title; placeholder: "One line: what should change"; invalid: PlanningFactories.start.title-bad;
                        property <int> g: PlanningFactories.start.gen;
                        changed g => { self.text = PlanningFactories.start.title; if PlanningFactories.start.title-bad { self.focus-input(); } }
                        init => { self.focus-input(); }
                        edited(t) => { PlanningFactories.edit("start", "title", t); }
                    }
                }
                for sec in PlanningFactories.st-sections: FxField {
                    label: sec.label; tag: sec.required ? "required" : "";
                    Rectangle {
                        height: ta.height;
                        border-radius: Theme.r-control;
                        border-width: sec.bad ? Theme.sp-2 : 0px; border-color: Theme.red;
                        ta := TextArea { width: parent.width; rows: sec.rows; text: sec.value; placeholder: sec.hint; edited(t) => { PlanningFactories.edit("start", "sec:" + sec.id, t); } }
                    }
                }
                // .fx-cr-att
                VerticalLayout { spacing: Theme.sp-6;
                    HorizontalLayout { spacing: Theme.sp-6; alignment: start;
                        VerticalLayout { alignment: center; Text { text: "Attachments"; font-size: Theme.text-12; color: Theme.text-secondary; } }
                        for f[i] in PlanningFactories.st-files: Rectangle {
                            height: Theme.control-sm - Theme.sp-2;
                            width: min(Theme.factories-chip-max, fc.preferred-width);
                            border-radius: Theme.r-pill; border-width: 1px; border-color: Theme.border; background: Theme.bg-tertiary;
                            fc := HorizontalLayout { padding-left: Theme.sp-8; padding-right: Theme.sp-4; spacing: Theme.sp-4;
                                VerticalLayout { alignment: center; Icon { width: Theme.icon-md; height: Theme.icon-md; source: f.image ? Icons.image : Icons.file; tint: Theme.text-secondary; } }
                                Text { text: f.name; font-size: Theme.text-12; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
                                VerticalLayout { alignment: center;
                                    Rectangle { width: Theme.sp-20; height: Theme.sp-20; border-radius: Theme.sp-10; background: fx.has-hover ? Theme.bg-hover : transparent;
                                        Icon { width: Theme.icon-sm; height: Theme.icon-sm; source: Icons.x; tint: fx.has-hover ? Theme.text-primary : Theme.text-secondary; }
                                        fx := TouchArea { mouse-cursor: pointer; clicked => { PlanningFactories.act("st-unattach", "" + i, ""); } }
                                    }
                                }
                            }
                        }
                        FxBtn { text: "Attach"; has-icon: true; icon: Icons.paperclip; clicked => { PlanningFactories.act("st-attach", "", ""); } }
                    }
                    Text { text: "Screenshots, mockups, specs, logs. Attach picks them from this PC."; font-size: Theme.text-11; color: Theme.text-secondary; wrap: word-wrap; }
                }
            }
        }
        FxField { label: "When the work is done";
            Select { options: ["As the factory says", "Show me first, I decide", "Merge automatically (with Undo)"]; selected: PlanningFactories.start.merge-i; picked(i) => { PlanningFactories.edit("start", "merge", "" + i); } }
        }
        for l in PlanningFactories.st-info: VerticalLayout {
            if l.kind == "open": HorizontalLayout { alignment: start; FxBtn { text: "Open it"; has-icon: true; icon: FxIcons.route; clicked => { PlanningFactories.act("st-open-active", l.id, ""); } } }
            if l.kind == "anyway": HorizontalLayout { alignment: start; FxBtn { text: "Start anyway"; has-icon: true; icon: Icons.play; clicked => { PlanningFactories.act("st-go", "anyway", ""); } } }
            if l.kind != "open" && l.kind != "anyway": FxNote { kind: l.kind; text: l.text; }
        }
        HorizontalLayout {
            spacing: Theme.sp-8;
            FxBtn { text: "Clear form"; kind: "ghost"; clicked => { PlanningFactories.act("st-clear", "", ""); } }
            Rectangle { horizontal-stretch: 1; }
            FxBtn { text: "Cancel"; kind: "ghost"; clicked => { PlanningFactories.act("st-close", "", ""); } }
            FxBtn { text: PlanningFactories.start.go-label; kind: "primary"; has-icon: true; icon: Icons.play; enabled: PlanningFactories.start.go-enabled; clicked => { PlanningFactories.act("st-go", "", ""); } }
        }
    }
}

/// The PIN prompt (.fx-pin).
component PinDialog inherits Rectangle {
    background: Theme.scrim;
    TouchArea { }
    card := Rectangle {
        width: min(Theme.factories-pin-w, root.width - 2 * Theme.sp-20);
        height: col.preferred-height;
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-bubble; shadow: Theme.shadow-card; }
        Rectangle { background: Theme.bg-secondary; border-radius: Theme.r-bubble; border-width: 1px; border-color: Theme.border; }
        TouchArea { }
        col := VerticalLayout {
            padding: Theme.sp-20; spacing: Theme.sp-10;
            HorizontalLayout { alignment: center; spacing: Theme.sp-6;
                VerticalLayout { alignment: center; Icon { width: Theme.icon-lg; height: Theme.icon-lg; source: Icons.lock; tint: Theme.text-primary; } }
                Text { text: PlanningFactories.pin.name; font-size: Theme.text-15; font-weight: Theme.w-semibold; color: Theme.text-primary; vertical-alignment: center; }
            }
            if PlanningFactories.pin.step != "": Text { text: PlanningFactories.pin.step; horizontal-alignment: center; font-size: Theme.text-11; color: Theme.text-muted; }
            Text { text: PlanningFactories.pin.sub; horizontal-alignment: center; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
            input := TextField {
                height: Theme.control-lg + Theme.sp-4;
                password: true;
                placeholder: PlanningFactories.pin.pass ? "Passphrase" : "••••••";
                text: PlanningFactories.pin.value;
                property <int> g: PlanningFactories.pin.gen;
                changed g => { self.text = PlanningFactories.pin.value; self.focus-input(); self.select-all(); }
                init => { self.focus-input(); }
                edited(t) => { PlanningFactories.edit("pin", "value", t); }
                accepted(t) => { PlanningFactories.act("pin-unlock", "", ""); }
                escape => { PlanningFactories.act("pin-cancel", "", ""); }
            }
            Text { text: PlanningFactories.pin.err; horizontal-alignment: center; font-size: Theme.text-12; color: Theme.red; min-height: Theme.sp-16; }
            HorizontalLayout { spacing: Theme.sp-8;
                FxBtn { horizontal-stretch: 1; text: "Cancel"; kind: "ghost"; clicked => { PlanningFactories.act("pin-cancel", "", ""); } }
                FxBtn { horizontal-stretch: 1; text: "Skip"; clicked => { PlanningFactories.act("pin-skip", "", ""); } }
                FxBtn { horizontal-stretch: 1; text: "Unlock"; kind: "primary"; has-icon: true; icon: Icons.lock; enabled: !PlanningFactories.pin.busy; clicked => { PlanningFactories.act("pin-unlock", "", ""); } }
            }
        }
    }
}

/// A trigger (triggerDialog()).
component TriggerDialog inherits FxModal {
    title: PlanningFactories.trig.title;
    card-w: Theme.factories-modal-wide;
    close => { PlanningFactories.act("tr-close", "", ""); }
    property <bool> stack: self.width < Theme.factories-pair-stack;
    property <bool> sample-open;
    property <bool> history-open;
    property <int> kind: PlanningFactories.trig.kind-i;   // 0 kanban, 1 schedule, 2 webhook
    if PlanningFactories.trig.loading: FxNote { text: "Loading…"; }
    if !PlanningFactories.trig.loading && PlanningFactories.trig.empty: VerticalLayout { spacing: Theme.sp-12;
        FxNote { text: "There are no runnable factories yet. Create one in the Factories tab first."; }
        HorizontalLayout { alignment: start; FxBtn { text: "Close"; kind: "ghost"; clicked => { PlanningFactories.act("tr-close", "", ""); } } }
    }
    if !PlanningFactories.trig.loading && !PlanningFactories.trig.empty: VerticalLayout {
        spacing: Theme.sp-12;
        property <int> g: PlanningFactories.trig.gen;
        HorizontalLayout { spacing: Theme.sp-10;
            FxField { horizontal-stretch: 1; label: "Name";
                TextField { text: PlanningFactories.trig.name; placeholder: "Cards to the team"; edited(t) => { PlanningFactories.edit("trig", "name", t); } }
            }
            FxField { horizontal-stretch: 1; label: "Factory";
                Select { options: PlanningFactories.tr-factories; selected: PlanningFactories.trig.factory-i; picked(i) => { PlanningFactories.edit("trig", "factory", "" + i); } }
            }
        }
        FxField { label: "Start when";
            Select { options: ["A kanban card enters a column", "A time of day", "A webhook is called"]; selected: root.kind; picked(i) => { PlanningFactories.edit("trig", "kind", "" + i); } }
        }
        if root.kind == 1: FxField { label: "At (this server's time)";
            TextField { text: PlanningFactories.trig.at; placeholder: "09:00"; edited(t) => { PlanningFactories.edit("trig", "at", t); } }
        }
        if root.kind == 1: FxField { label: "On (none = every day)";
            HorizontalLayout { spacing: Theme.sp-4; alignment: start;
                for d[i] in ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]: Rectangle {
                    property <bool> on: i < PlanningFactories.tr-days.length && PlanningFactories.tr-days[i];
                    height: Theme.control-sm; width: dt.preferred-width + Theme.sp-16;
                    border-radius: Theme.r-control; border-width: 1px;
                    border-color: self.on ? Theme.accent : Theme.border;
                    background: self.on ? Theme.accent : Theme.bg-card;
                    dt := Text { text: d; font-size: Theme.text-12; color: parent.on ? Theme.white : Theme.text-secondary; }
                    TouchArea { mouse-cursor: pointer; clicked => { PlanningFactories.edit("trig", "day", "" + i); } }
                }
            }
        }
        if root.kind == 0: FxField { label: "Column";
            Select { options: ["Backlog", "To do", "In progress", "Done"]; selected: PlanningFactories.trig.column-i; picked(i) => { PlanningFactories.edit("trig", "column", "" + i); } }
        }
        // The change request (.fx-cr).
        Rectangle {
            border-radius: Theme.r-card; border-width: 1px; border-color: Theme.border; background: Theme.bg-primary;
            height: cr.preferred-height;
            cr := VerticalLayout {
                padding: Theme.sp-12; spacing: Theme.sp-10;
                VerticalLayout { spacing: Theme.sp-2;
                    Text { text: "Change request"; font-size: Theme.text-13; font-weight: Theme.w-bold; color: Theme.text-primary; }
                    Text { text: PlanningFactories.trig.cr-head; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
                }
                FxField { label: "Title"; tag: "required";
                    TextField { text: PlanningFactories.trig.cr-title; property <int> g: PlanningFactories.trig.gen; changed g => { self.text = PlanningFactories.trig.cr-title; } edited(t) => { PlanningFactories.edit("trig", "title", t); } }
                }
                for sec in PlanningFactories.tr-sections: FxField {
                    label: sec.label;
                    TextArea { rows: sec.rows; text: sec.value; placeholder: sec.hint; edited(t) => { PlanningFactories.edit("trig", "sec:" + sec.id, t); } }
                }
            }
        }
        HorizontalLayout { spacing: Theme.sp-10;
            FxField { horizontal-stretch: 1; label: "When the work is done";
                Select { options: ["As the factory says", "Show me first, I decide", "Merge automatically (with Undo)"]; selected: PlanningFactories.trig.merge-i; picked(i) => { PlanningFactories.edit("trig", "merge", "" + i); } }
            }
            FxField { horizontal-stretch: 1; label: "If a run is already going";
                Select { options: ["Tell its Manager (a run of the same factory)", "Wait its turn, then start", "Skip it"]; selected: PlanningFactories.trig.busy-i; picked(i) => { PlanningFactories.edit("trig", "busy", "" + i); } }
            }
        }
        FxField { label: "Start a run";
            Select { options: ["Always", "Only if Backlog has a card", "Only if To do has a card", "Only if In progress has a card", "Only if Done has a card"]; selected: PlanningFactories.trig.needs-i; picked(i) => { PlanningFactories.edit("trig", "needs", "" + i); } }
        }
        CheckRow { checked: PlanningFactories.trig.enabled; text: "On"; toggled(v) => { PlanningFactories.edit("trig", "enabled", v ? "1" : "0"); } }
        // Webhook settings.
        if root.kind == 2: VerticalLayout {
            spacing: Theme.sp-10;
            VerticalLayout { spacing: Theme.sp-2;
                Text { text: "Webhook"; font-size: Theme.text-13; font-weight: Theme.w-bold; color: Theme.text-primary; }
                Text { text: "Public URL, so every call must prove it is from you: the key, or a signature made with the secret. Calls are answered at once; the change request above is filled from the call's JSON."; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
            }
            FxField { label: "Security";
                Select { options: ["A key in the URL (or X-Crundi-Key / Bearer header)", "Signed with a secret (HMAC-SHA256)"]; selected: PlanningFactories.trig.auth-i; picked(i) => { PlanningFactories.edit("trig", "auth", "" + i); } }
            }
            if PlanningFactories.trig.auth-i == 1: HorizontalLayout { spacing: Theme.sp-10;
                FxField { horizontal-stretch: 1; label: "Signature header"; TextField { mono: true; text: PlanningFactories.trig.sig-h; placeholder: "x-crundi-signature"; edited(t) => { PlanningFactories.edit("trig", "sig-h", t); } } }
                FxField { horizontal-stretch: 1; label: "Timestamp header (optional)"; TextField { mono: true; text: PlanningFactories.trig.ts-h; placeholder: "None (Grafana: X-Grafana-Alerting-Signature-Timestamp)"; edited(t) => { PlanningFactories.edit("trig", "ts-h", t); } } }
            }
            FxField { label: "Idempotency key"; tag: "a call with a key already seen is not processed again";
                TextField { mono: true; text: PlanningFactories.trig.idem; placeholder: "{{payload.messageId}}"; edited(t) => { PlanningFactories.edit("trig", "idem", t); } }
            }
            FxSummary { text: "Try it with a sample payload"; open: root.sample-open; toggled => { root.sample-open = !root.sample-open; } }
            if root.sample-open: VerticalLayout { spacing: Theme.sp-8;
                TextArea { rows: 4; mono: true; text: PlanningFactories.trig.sample; placeholder: "{\"messageId\": \"a1\", \"message\": \"CPU above 90% on web-1\"}"; edited(t) => { PlanningFactories.edit("trig", "sample", t); } }
                HorizontalLayout { alignment: start; FxBtn { text: "Preview"; kind: "ghost"; clicked => { PlanningFactories.act("tr-preview", "", ""); } } }
                for l in PlanningFactories.tr-preview: FxNote { kind: l.kind; text: l.text; }
            }
        }
        // The saved webhook's URL and secret.
        if PlanningFactories.trig.hook: VerticalLayout {
            spacing: Theme.sp-8;
            FxField { label: "Webhook URL (POST, JSON body)"; TextField { mono: true; text: PlanningFactories.trig.hook-url; } }
            if PlanningFactories.trig.hook-signed: FxField { label: "Secret (sign the raw body with HMAC-SHA256)"; TextField { mono: true; text: PlanningFactories.trig.hook-secret; } }
            if PlanningFactories.trig.hook-hint != "": FxNote { kind: "meta"; text: PlanningFactories.trig.hook-hint; }
            if PlanningFactories.trig.hook-curl != "": Text { text: PlanningFactories.trig.hook-curl; font-family: Theme.mono; font-size: Theme.text-11; color: Theme.text-muted; wrap: word-wrap; }
            if PlanningFactories.trig.hook-seen != "": FxNote { kind: "meta"; text: PlanningFactories.trig.hook-seen; }
            HorizontalLayout { alignment: start; FxBtn { text: PlanningFactories.trig.hook-signed ? "New secret" : "New key"; kind: "ghost"; clicked => { PlanningFactories.act("tr-rotate", "", ""); } } }
        }
        if PlanningFactories.tr-history.length > 0: FxSummary { text: "What it did (" + PlanningFactories.tr-history.length + ")"; open: root.history-open; toggled => { root.history-open = !root.history-open; } }
        if root.history-open: VerticalLayout { spacing: Theme.sp-4;
            for h in PlanningFactories.tr-history: FxNote { kind: "meta"; text: h; }
        }
        HorizontalLayout {
            spacing: Theme.sp-8;
            if PlanningFactories.trig.editing: FxBtn { text: "Delete"; kind: "ghost"; has-icon: true; icon: Icons.trash; clicked => { PlanningFactories.act("tr-delete", "", ""); } }
            if PlanningFactories.trig.editing: FxBtn { text: "Run now"; has-icon: true; icon: Icons.play; clicked => { PlanningFactories.act("tr-run", "", ""); } }
            Rectangle { horizontal-stretch: 1; }
            FxBtn { text: "Close"; kind: "ghost"; clicked => { PlanningFactories.act("tr-close", "", ""); } }
            FxBtn { text: "Save"; kind: "primary"; has-icon: true; icon: Icons.check; clicked => { PlanningFactories.act("tr-save", "", ""); } }
        }
    }
}

/// A person's transcript (.fx-chatwrap): a sheet on the right.
component ChatSheet inherits Rectangle {
    background: Theme.scrim;
    TouchArea { clicked => { PlanningFactories.act("chat-close", "", ""); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(ev) => { if ev.text == Key.Escape { PlanningFactories.act("chat-close", "", ""); return accept; } return reject; }
    }
    Rectangle {
        x: root.width - self.width;
        width: min(Theme.factories-sheet-w, root.width);
        background: Theme.bg-primary;
        TouchArea { }
        Rectangle { x: 0; width: 1px; background: Theme.border; }
        VerticalLayout {
            Rectangle {
                height: bar.preferred-height;
                bar := HorizontalLayout {
                    padding-left: Theme.sp-10; padding-right: Theme.sp-10; padding-top: Theme.sp-8; padding-bottom: Theme.sp-8; spacing: Theme.sp-8;
                    Text { horizontal-stretch: 1; text: PlanningFactories.chat-name; font-size: Theme.text-14; font-weight: Theme.w-bold; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
                    FxBtn { text: "Open in a new tab"; kind: "ghost"; clicked => { PlanningFactories.act("chat-tab", "", ""); } }
                    FxBtn { text: "Close"; kind: "ghost"; has-icon: true; icon: Icons.x; clicked => { PlanningFactories.act("chat-close", "", ""); } }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
            TranscriptBody { vertical-stretch: 1; }
        }
    }
}

/// Every dialog of the screen; nothing (and no input) when none is open.
export component FxDialogs inherits Rectangle {
    if PlanningFactories.chat-open && !PlanningFactories.v.chat: ChatSheet { width: root.width; height: root.height; }
    if PlanningFactories.trig.open: TriggerDialog { width: root.width; height: root.height; }
    if PlanningFactories.start.open: StartDialog { width: root.width; height: root.height; }
    if PlanningFactories.pin.open: PinDialog { width: root.width; height: root.height; }
}
