// The planning area's layers over the window: a dragged card's clone, a
// card's attachments strip (.kc-media-pop), and the ask dialog (the web's
// askText with its choice row: Add task, Edit task).

import { Theme, Icons, Icon, SoftShadow, Modal, ModalActions, Btn, TextField, TextArea, FormLabel } from "../kit.slint";
import { PlanningKanban, PlanningAsk, PlanningThumb } from "api.slint";

/// The dragged card's clone (.drag-clone): the card's box and title,
/// following the pointer, a little transparent.
export component DragClone inherits Rectangle {
    x: PlanningKanban.drag-x - PlanningKanban.grab-x;
    y: PlanningKanban.drag-y - PlanningKanban.grab-y;
    width: PlanningKanban.drag-w;
    height: PlanningKanban.drag-h;
    opacity: Theme.o-clone;
    SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-card; shadow: Theme.shadow-menu; }
    Rectangle {
        border-radius: Theme.r-card; border-width: 1px; border-color: Theme.accent; background: Theme.bg-card;
        VerticalLayout {
            padding: Theme.sp-12;
            alignment: start;
            Text { text: PlanningKanban.drag-title; wrap: word-wrap; font-size: Theme.text-14; font-weight: Theme.w-semibold; color: Theme.text-primary; }
        }
    }
}

/// A card's attachments: a strip of thumbnails (or "No attachments yet")
/// and the + that opens the task's media, under the paperclip.
export component ClipPop inherits Rectangle {
    // A press outside closes it.
    TouchArea { clicked => { PlanningKanban.clip-close(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(ev) => { if ev.text == Key.Escape { PlanningKanban.clip-close(); return accept; } return reject; }
    }
    pop := Rectangle {
        width: max(Theme.kanban-pop-min, min(Theme.kanban-pop-max, PlanningKanban.clip-w - Theme.sp-8));
        height: Theme.kanban-thumb + 2 * Theme.sp-8;
        x: max(Theme.sp-8, min(PlanningKanban.clip-x - self.width, root.width - self.width - Theme.sp-8));
        y: PlanningKanban.clip-y + self.height > root.height - Theme.sp-8 ? max(Theme.sp-8, PlanningKanban.clip-y - self.height - Theme.sp-32) : PlanningKanban.clip-y;
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-field; shadow: Theme.shadow-menu; }
        Rectangle { background: Theme.bg-secondary; border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border; }
        TouchArea { }
        HorizontalLayout {
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                strip := Flickable {
                    content-width: sl.preferred-width;
                    sl := HorizontalLayout {
                        padding: Theme.sp-8;
                        spacing: Theme.sp-6;
                        alignment: start;
                        if PlanningKanban.clip-items.length == 0: Text { text: "No attachments yet"; vertical-alignment: center; font-size: Theme.text-12; color: Theme.text-muted; }
                        for t in PlanningKanban.clip-items: Rectangle {
                            width: Theme.kanban-thumb; height: Theme.kanban-thumb;
                            border-radius: Theme.r-control;
                            border-width: 1px; border-color: tta.has-hover ? Theme.accent : Theme.border;
                            background: Theme.bg-tertiary;
                            clip: true;
                            if t.has-image: Image { width: parent.width; height: parent.height; source: t.image; image-fit: cover; }
                            if !t.has-image: Icon {
                                source: t.kind == "video" ? Icons.film : t.kind == "audio" ? Icons.music : t.kind == "pdf" ? Icons.file-text : t.kind == "image" ? Icons.image : Icons.file;
                                tint: Theme.text-secondary;
                            }
                            tta := TouchArea { mouse-cursor: pointer; clicked => { PlanningKanban.thumb-open(t.id); } }
                        }
                    }
                }
            }
            Rectangle {
                width: Theme.sp-40 + Theme.sp-4;
                background: ata.has-hover ? Theme.accent : Theme.bg-tertiary;
                border-radius: Theme.r-field;
                Rectangle { x: 0; width: Theme.r-field; background: parent.background; }
                Rectangle { x: 0; width: 1px; background: Theme.border-subtle; }
                Icon { source: Icons.plus; width: Theme.icon-xl - Theme.sp-2; height: Theme.icon-xl - Theme.sp-2; tint: ata.has-hover ? Theme.white : Theme.accent-hover; }
                ata := TouchArea { mouse-cursor: pointer; clicked => { PlanningKanban.clip-add(PlanningKanban.clip-task); } }
            }
        }
    }
}

/// The ask dialog: its title, the label, a field (or a box for many lines),
/// the choice row of pills, Cancel and the action.
export component AskDialog inherits Rectangle {
    Modal {
        width: root.width; height: root.height;
        title: PlanningAsk.title;
        close => { PlanningAsk.answer(false); }
        if PlanningAsk.label != "": FormLabel { text: PlanningAsk.label; }
        if !PlanningAsk.multiline: TextField {
            text <=> PlanningAsk.value;
            init => { self.focus-input(); self.select-all(); }
            accepted => { PlanningAsk.answer(true); }
            escape => { PlanningAsk.answer(false); }
        }
        if PlanningAsk.multiline: TextArea {
            text <=> PlanningAsk.value;
            rows: 6;
            init => { self.focus-input(); }
            submit => { PlanningAsk.answer(true); }
        }
        if PlanningAsk.choice-keys.length > 0: VerticalLayout {
            spacing: Theme.sp-6;
            padding-top: Theme.sp-2;
            if PlanningAsk.choice-label != "": Text { text: PlanningAsk.choice-label; font-size: Theme.text-12; color: Theme.text-secondary; }
            HorizontalLayout {
                spacing: Theme.sp-6;
                alignment: start;
                for k[i] in PlanningAsk.choice-keys: pill := Rectangle {
                    property <bool> on: PlanningAsk.choice == k;
                    height: Theme.control-sm;
                    width: pl.preferred-width;
                    border-radius: Theme.r-pill;
                    border-width: 1px;
                    border-color: self.on ? Theme.accent : pta.has-hover ? Theme.slate-edge : Theme.border;
                    background: self.on ? Theme.accent-dim : transparent;
                    accessible-role: button;
                    accessible-label: PlanningAsk.choice-texts[i];
                    pl := HorizontalLayout {
                        padding-left: Theme.sp-12; padding-right: Theme.sp-12;
                        Text { text: PlanningAsk.choice-texts[i]; vertical-alignment: center; font-size: Theme.text-12; color: pill.on ? Theme.accent-hover : pta.has-hover ? Theme.text-primary : Theme.text-secondary; }
                    }
                    pta := TouchArea { mouse-cursor: pointer; clicked => { PlanningAsk.choice = k; } }
                }
            }
        }
        ModalActions {
            Btn { text: "Cancel"; clicked => { PlanningAsk.answer(false); } }
            Btn { text: PlanningAsk.ok-label; primary: true; clicked => { PlanningAsk.answer(true); } }
        }
    }
}
