// Notes (4.4): the parts the notes screens share: a line of rich text
// (the web's contenteditable .nt-text), the header's small buttons, a page
// in a list (.nt-item).
//
// Slint limit: there is no rich-text editor. A text block is edited as its
// source (**bold**, *italic*, __underline__, ~~strike~~, `code`,
// [text](url), src/planning/notes_doc.rs) and drawn formatted (StyledText)
// whenever it is not being edited; the formatting keys and the format bar
// write the marks for you.

import { Theme, Icons, Icon, DashedBox } from "../kit.slint";
import { Tip } from "../chat.slint";
import { PlanningNotes, PlanningNotesItem } from "notes-api.slint";

/// A block's text: drawn formatted, edited as source. The pane's focus
/// request (`focus-*`) puts the caret in it.
export component RichText inherits Rectangle {
    in property <string> pkey;
    in property <string> bid;
    in property <int> r: -1;
    in property <int> c: -1;
    in property <string> src;
    in property <styled-text> md;
    in property <string> ph;
    in property <length> fs;
    in property <int> weight: Theme.w-regular;
    in property <color> ink: Theme.text-primary;
    in property <bool> mono;
    in property <bool> nowrap;
    in property <string> focus-id;
    in property <int> focus-r;
    in property <int> focus-c;
    in property <int> focus-a;
    in property <int> focus-b;
    in property <int> focus-gen;
    out property <bool> editing: input.has-focus;
    // The width the text needs unwrapped (a code block that scrolls sideways).
    out property <length> natural-w: max(input.preferred-width, st.preferred-width);
    callback edited(string, int);
    callback key(string, int, int, bool, bool) -> bool;
    // Ctrl held while editing: the drawn text comes on top, so a link in it
    // can be Ctrl+clicked (the web's "Ctrl+click to open").
    property <bool> ctrl;
    // The caret's top inside the input (its first and last line).
    property <length> cy;
    property <string> family: root.mono ? Theme.mono : (Theme.chat-font != "" ? Theme.chat-font : Theme.ui-font);
    height: max(root.editing ? input.preferred-height : st.preferred-height, root.fs);
    st := StyledText {
        x: 0; y: 0;
        width: parent.width;
        visible: !root.editing;
        text: root.md;
        default-font-family: root.family;
        default-font-size: root.fs;
        default-color: root.ink;
        link-color: Theme.accent-hover;
    }
    if root.editing && root.src == "" && root.ph != "": Text {
        x: 0; y: 0;
        text: root.ph;
        font-family: root.family;
        font-size: root.fs;
        font-weight: root.weight;
        color: Theme.text-muted;
    }
    input := TextInput {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        text: root.src;
        single-line: false;
        wrap: root.nowrap ? no-wrap : word-wrap;
        font-family: root.family;
        font-size: root.fs;
        font-weight: root.weight;
        // Not being edited: the drawn text shows through (the input stays
        // on top so a click puts the caret where it lands).
        color: root.editing && !root.ctrl ? root.ink : transparent;
        selection-background-color: Theme.selection;
        edited => { root.edited(self.text, self.cursor-position-byte-offset); }
        cursor-position-changed(p) => {
            root.cy = p.y;
            if self.has-focus {
                PlanningNotes.sel-moved(root.pkey, root.bid, self.anchor-position-byte-offset, self.cursor-position-byte-offset, self.absolute-position.x + p.x, self.absolute-position.y + p.y);
            }
        }
        key-pressed(ev) => {
            if ev.text == Key.Control || ev.text == Key.Meta { root.ctrl = true; return reject; }
            if !ev.modifiers.control && !ev.modifiers.meta { root.ctrl = false; }
            if PlanningNotes.key-name(ev) == "" { return reject; }
            if root.key(PlanningNotes.key-name(ev), self.anchor-position-byte-offset, self.cursor-position-byte-offset, root.cy < root.fs, root.cy + 2 * root.fs > self.height) { return accept; }
            return reject;
        }
        key-released(ev) => {
            if ev.text == Key.Control || ev.text == Key.Meta { root.ctrl = false; }
            return reject;
        }
        changed has-focus => {
            if self.has-focus { PlanningNotes.focused(root.pkey, root.bid, root.r, root.c); }
            else { root.ctrl = false; PlanningNotes.blur(root.pkey, root.bid); }
        }
    }
    if root.editing && root.ctrl: StyledText {
        x: 0; y: 0;
        width: parent.width;
        text: root.md;
        default-font-family: root.family;
        default-font-size: root.fs;
        default-color: root.ink;
        link-color: Theme.accent-hover;
        link-clicked(u) => { PlanningNotes.link(u); }
    }
    changed src => { if input.text != root.src { input.text = root.src; } }
    function apply-focus() {
        if root.focus-id != root.bid || root.focus-r != root.r || root.focus-c != root.c { return; }
        if input.text != root.src { input.text = root.src; }
        input.focus();
        input.set-selection-offsets(root.focus-a, root.focus-b);
    }
    property <int> fg: root.focus-gen;
    changed fg => { root.apply-focus(); }
    init => { if root.focus-id == root.bid { root.apply-focus(); } }
}

/// The pane header's small buttons (.term-font-btn): a label or an icon.
export component FontBtn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <string> tip;
    callback clicked();
    width: max(Theme.sp-24, lbl.preferred-width + Theme.sp-8);
    height: Theme.sp-24;
    border-radius: Theme.r-chip;
    background: ta.has-hover ? Theme.bg-hover : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    lbl := Text {
        visible: !root.has-icon;
        text: root.text;
        font-size: Theme.text-12;
        font-weight: Theme.w-semibold;
        color: ta.has-hover ? Theme.text-primary : Theme.text-secondary;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    if root.has-icon: Icon { source: root.icon; width: Theme.icon-md; height: Theme.icon-md; tint: ta.has-hover ? Theme.text-primary : Theme.text-secondary; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Tip { on: ta.has-hover; text: root.tip; }
}

/// The text size buttons the tab bar and a pane share: A-, reset, A+.
export component FontBtns inherits HorizontalLayout {
    spacing: Theme.sp-2;
    FontBtn { text: "A-"; tip: "Smaller text (all notes)"; clicked => { PlanningNotes.font(-1); } }
    FontBtn { has-icon: true; icon: Icons.rotate-ccw; tip: "Reset text size"; clicked => { PlanningNotes.font(0); } }
    FontBtn { text: "A+"; tip: "Larger text (all notes)"; clicked => { PlanningNotes.font(1); } }
}

/// "+ New page" (.nt-new): dashed, solid accent on hover.
export component NewPage inherits Rectangle {
    in property <bool> busy;
    in property <length> pad: Theme.sp-10;
    callback clicked();
    height: t.preferred-height + 2 * root.pad;
    border-radius: Theme.r-card;
    border-width: ta.has-hover && !root.busy ? 1px : 0;
    border-color: Theme.accent;
    background: ta.has-hover && !root.busy ? Theme.accent-dim : transparent;
    opacity: root.busy ? Theme.o-soft : 1;
    if !ta.has-hover || root.busy: DashedBox { width: parent.width; height: parent.height; corner: Theme.r-card; line: Theme.border; }
    t := Text { text: "+ New page"; font-size: Theme.text-13; font-weight: Theme.w-semibold; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { enabled: !root.busy; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// The trash's small buttons (.nt-trash-acts button).
component TrashBtn inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked();
    height: Theme.sp-24;
    width: tl.preferred-width + 2 * Theme.sp-8;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: ta.has-hover && root.danger ? Theme.red : Theme.border;
    background: ta.has-hover && !root.danger ? Theme.bg-tertiary : transparent;
    tl := Text { text: root.text; font-size: Theme.text-11; color: ta.has-hover ? (root.danger ? Theme.red : Theme.text-primary) : Theme.text-secondary; vertical-alignment: center; horizontal-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// A page in a list (.nt-item): title, preview (two lines), meta.
export component PageItem inherits Rectangle {
    in property <PlanningNotesItem> it;
    in property <bool> quiet;
    in property <bool> trash;
    callback clicked();
    callback context(length, length);
    callback restore();
    callback purge();
    height: col.preferred-height;
    border-radius: Theme.r-field;
    border-width: 1px;
    border-color: root.it.cur ? Theme.accent : ta.has-hover && !root.quiet ? Theme.border : transparent;
    background: root.it.cur ? Theme.accent-dim : root.quiet ? (ta.has-hover && !root.trash ? Theme.bg-tertiary : transparent) : Theme.bg-card;
    opacity: root.it.busy ? Theme.o-soft : 1;
    ta := TouchArea {
        mouse-cursor: root.trash ? MouseCursor.default : root.it.busy ? MouseCursor.not-allowed : MouseCursor.pointer;
        clicked => { if !root.trash { root.clicked(); } }
        pointer-event(ev) => {
            if !root.trash && ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right { root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        }
    }
    if root.it.busy: Tip { on: ta.has-hover; text: "Already open in another pane: one page, one pane"; }
    col := VerticalLayout {
        padding-left: Theme.sp-10; padding-right: Theme.sp-10;
        padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
        spacing: Theme.sp-2;
        Text { text: root.it.title; wrap: word-wrap; font-size: Theme.text-13; font-weight: Theme.w-semibold; color: Theme.text-primary; }
        if root.it.preview != "": Rectangle {
            // Two lines at most (-webkit-line-clamp: 2).
            height: min(pv.preferred-height, 2 * Theme.text-12 * Theme.lh-ui);
            clip: true;
            pv := Text { y: 0; width: parent.width; text: root.it.preview; wrap: word-wrap; overflow: elide; font-size: Theme.text-12; color: Theme.text-secondary; }
        }
        Text { text: root.it.meta; font-size: Theme.text-11; color: Theme.text-muted; wrap: word-wrap; }
        if root.trash: HorizontalLayout {
            padding-top: Theme.sp-4;
            spacing: Theme.sp-6;
            alignment: start;
            TrashBtn { text: "Restore"; clicked => { root.restore(); } }
            TrashBtn { text: "Delete for good"; danger: true; clicked => { root.purge(); } }
        }
    }
}

/// A quiet bordered button (.nt-selbar button, .nt-tbar button).
export component QuietBtn inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <bool> danger;
    in property <length> fs: Theme.text-12;
    in property <length> h: Theme.sp-24 + Theme.sp-2;
    callback clicked();
    height: root.h;
    width: ql.preferred-width + 2 * Theme.sp-8;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: ta.has-hover && root.danger ? Theme.red : Theme.border;
    background: ta.has-hover ? (root.danger ? Theme.red-dim : Theme.bg-hover) : transparent;
    ql := Text { text: root.text; font-size: root.fs; color: ta.has-hover && root.danger ? Theme.red : Theme.text-primary; vertical-alignment: center; horizontal-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    if root.tip != "": Tip { on: ta.has-hover; text: root.tip; }
}

/// The grip (.nt-grip): click for the block's menu, drag to move the block
/// (or onto a chat or terminal, as Markdown).
export component Grip inherits Rectangle {
    in property <string> pkey;
    in property <string> bid;
    in property <string> tip;
    in property <length> fs: Theme.text-14;
    callback clicked(length, length);
    width: Theme.sp-20;
    height: Theme.sp-24;
    border-radius: Theme.r-chip;
    background: ta.has-hover || ta.pressed ? Theme.bg-hover : transparent;
    Text { text: "⋮⋮"; letter-spacing: Theme.track-tight; font-size: root.fs; color: ta.has-hover ? Theme.text-primary : Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
    property <bool> moving;
    ta := TouchArea {
        mouse-cursor: root.moving ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left { root.moving = false; }
            if ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left {
                if root.moving { root.moving = false; PlanningNotes.drag-end(root.pkey, true); }
                else { root.clicked(self.absolute-position.x, self.absolute-position.y + self.height + Theme.sp-4); }
            }
        }
        moved => {
            if !self.pressed { return; }
            if !root.moving && (abs(self.mouse-x - self.pressed-x) > Theme.sp-4 || abs(self.mouse-y - self.pressed-y) > Theme.sp-4) {
                root.moving = true;
                PlanningNotes.drag-start(root.pkey, root.bid);
            }
            if root.moving { PlanningNotes.drag-move(root.pkey, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        }
    }
    if root.tip != "" && !root.moving: Tip { on: ta.has-hover; text: root.tip; }
}
