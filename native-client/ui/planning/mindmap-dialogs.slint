// the Mind map (4.3): its dialogs over the window: an idea's details
// (#mm-detail-modal: its words, notes, link, media; Edit, Save, + Child,
// Link / scope or Unlink, Media, Delete, Close), the link picker
// (#link-modal: scope to a project, or link a task or subtask), and the
// shortcut sheet (#mm-help-modal, mmHelpHtml). Driven by
// src/planning/mindmap.rs through PlanningMindmap.

import { Theme, Icons, Icon, IconButton, SoftShadow, DashedBox, TextArea, TextField, Select, ScrollThumb } from "../kit.slint";
import { PlanningMindmap, PlanningMmHelp, PlanningMmLinkRow } from "mindmap-api.slint";

/// The screen's icons the web draws but ICON_PATHS lacks (its emoji 🔗 and
/// 🔽 are flat icons here), the chevron of an opened sheet row, and the
/// canvas's dots.
export global MmIcons {
    out property <image> link: @image-url("icons/mindmap-link.svg");
    out property <image> filter: @image-url("icons/mindmap-filter.svg");
    out property <image> chevron-down: @image-url("icons/mindmap-chevron-down.svg");
    out property <image> dots: @image-url("icons/mindmap-dots.svg");
}

/// The web's .input-modal: the scrim (a click on it closes) and the card
/// (.im-box: bg-secondary, a border, padding 20). Esc closes too.
component MmDialog inherits Rectangle {
    in property <length> card-w: Theme.mindmap-dialog-w;
    in property <length> pad: Theme.sp-20;
    callback close();
    background: Theme.scrim;
    TouchArea { clicked => { root.close(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(ev) => { if ev.text == Key.Escape { root.close(); return accept; } return reject; }
    }
    card := Rectangle {
        width: min(root.card-w, root.width - 2 * Theme.sp-20);
        height: min(col.preferred-height, root.height - 2 * Theme.sp-20);
        SoftShadow { width: parent.width; height: parent.height; radius: Theme.r-card; shadow: Theme.shadow-card; }
        Rectangle { background: Theme.bg-secondary; border-radius: Theme.r-card; border-width: 1px; border-color: Theme.border; }
        TouchArea { }
        col := VerticalLayout {
            padding: root.pad;
            spacing: Theme.sp-10;
            @children
        }
    }
}

/// A button of the dialog's action row (.mmd-actions button): they share
/// the row; `primary` accent, `danger` red words.
component MmdBtn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    callback clicked();
    horizontal-stretch: 1;
    min-width: Theme.sp-48 + Theme.sp-24;
    height: Theme.control;
    border-radius: Theme.r-control;
    border-width: 1px;
    property <bool> hot: ta.has-hover;
    background: root.primary ? (root.hot ? Theme.accent-hover : Theme.accent) : root.danger && root.hot ? Theme.red-dim : Theme.bg-tertiary;
    border-color: root.primary ? Theme.accent : root.hot ? (root.danger ? Theme.red : Theme.accent) : Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    Text { text: root.text; font-size: Theme.text-13; color: root.primary ? Theme.white : root.danger ? Theme.red : Theme.text-primary; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// A label over a field (#mm-detail-modal label.im-label).
component MmLabel inherits Text {
    font-size: Theme.text-12; color: Theme.text-secondary;
}

/// An idea's details (#mm-detail-modal).
export component MmDetailDialog inherits Rectangle {
    MmDialog {
        width: root.width; height: root.height;
        close => { PlanningMindmap.d-act("close"); }
        // #mmd-title: the idea's words, whole.
        Text { text: PlanningMindmap.d-title; wrap: word-wrap; font-size: Theme.text-16; font-weight: Theme.w-semibold; color: Theme.text-primary; }
        if !PlanningMindmap.d-editing: VerticalLayout {
            spacing: Theme.sp-6;
            // The link (.mmd-link): a task or subtask, a project scope, or gone.
            if PlanningMindmap.d-link-kind != "": lk := Rectangle {
                height: ll.preferred-height;
                border-radius: Theme.r-field;
                background: PlanningMindmap.d-link-kind == "missing" ? Theme.bg-tertiary : Theme.green-dim;
                property <color> fg: PlanningMindmap.d-link-kind == "missing" ? Theme.text-muted : Theme.green;
                ll := HorizontalLayout {
                    padding-left: Theme.sp-10; padding-right: Theme.sp-10;
                    padding-top: Theme.sp-6 + 1px; padding-bottom: Theme.sp-6 + 1px;
                    spacing: Theme.sp-6;
                    VerticalLayout { alignment: start; padding-top: Theme.sp-2; Icon { source: PlanningMindmap.d-link-kind == "scope" ? Icons.folder : MmIcons.link; width: Theme.icon-md; height: Theme.icon-md; tint: lk.fg; } }
                    Text { text: PlanningMindmap.d-link-main; wrap: word-wrap; font-size: Theme.text-13; color: lk.fg; horizontal-stretch: PlanningMindmap.d-link-todo > 0 ? 0 : 1; }
                    if PlanningMindmap.d-link-todo > 0: VerticalLayout { alignment: start; padding-top: Theme.sp-2; Icon { source: PlanningMindmap.d-link-todo == 2 ? Icons.check : Icons.square; width: Theme.icon-md; height: Theme.icon-md; tint: lk.fg; } }
                    if PlanningMindmap.d-link-todo > 0: Text { horizontal-stretch: 1; text: PlanningMindmap.d-link-text; wrap: word-wrap; font-size: Theme.text-13; color: lk.fg; }
                    if PlanningMindmap.d-link-st != "": Text { text: PlanningMindmap.d-link-st; wrap: word-wrap; font-size: Theme.text-13; color: Theme.text-muted; }
                }
            }
            // The notes (.mmd-notes): a list, each with its dot.
            if PlanningMindmap.d-notes.length > 0: Flickable {
                height: min(nl.preferred-height, root.height / 2 - Theme.sp-48);
                content-height: nl.preferred-height;
                nl := VerticalLayout {
                    padding-top: Theme.sp-6; padding-bottom: Theme.sp-6;
                    spacing: Theme.sp-6;
                    for t in PlanningMindmap.d-notes: Rectangle {
                        height: nt.preferred-height + 2 * Theme.sp-8;
                        border-radius: Theme.r-control;
                        border-width: 1px; border-color: Theme.border-subtle;
                        background: Theme.bg-tertiary;
                        Rectangle { x: Theme.sp-10 + 1px; y: Theme.sp-12 + Theme.sp-2; width: Theme.sp-4 + 1px; height: self.width; border-radius: self.width / 2; background: Theme.accent; }
                        nt := Text {
                            x: Theme.sp-24 + Theme.sp-2; y: Theme.sp-8;
                            width: parent.width - Theme.sp-24 - Theme.sp-2 - Theme.sp-10;
                            text: t; wrap: word-wrap; font-size: Theme.text-14; color: Theme.text-secondary;
                        }
                    }
                }
            }
            // The media strip (.card-media): thumbnails, then the paperclip.
            HorizontalLayout {
                spacing: Theme.sp-4 + 1px;
                alignment: start;
                padding-top: Theme.sp-6;
                for t in PlanningMindmap.d-thumbs: Rectangle {
                    width: Theme.sp-40; height: Theme.sp-40;
                    border-radius: Theme.r-field;
                    border-width: 1px; border-color: tta.has-hover ? Theme.accent : Theme.border;
                    background: Theme.bg-tertiary;
                    clip: true;
                    if t.has-image: Image { width: parent.width; height: parent.height; source: t.image; image-fit: cover; }
                    if !t.has-image: Icon {
                        width: Theme.icon-xl - Theme.sp-2; height: self.width;
                        source: t.kind == "video" ? Icons.film : t.kind == "audio" ? Icons.music : t.kind == "pdf" ? Icons.file-text : t.kind == "image" ? Icons.image : Icons.file;
                        tint: Theme.text-muted;
                    }
                    tta := TouchArea { mouse-cursor: pointer; clicked => { PlanningMindmap.d-thumb(t.id); } }
                }
                Rectangle {
                    width: Theme.sp-40; height: Theme.sp-40;
                    border-radius: Theme.r-field;
                    if !ata.has-hover: DashedBox { width: parent.width; height: parent.height; corner: Theme.r-field; }
                    if ata.has-hover: Rectangle { border-radius: Theme.r-field; border-width: 1px; border-color: Theme.accent; }
                    Icon { source: Icons.paperclip; width: Theme.icon-md; height: Theme.icon-md; tint: ata.has-hover ? Theme.accent-hover : Theme.text-muted; }
                    ata := TouchArea { mouse-cursor: pointer; clicked => { PlanningMindmap.d-act("media"); } }
                }
            }
        }
        if PlanningMindmap.d-editing: VerticalLayout {
            spacing: Theme.sp-4;
            MmLabel { text: "Idea"; }
            TextArea {
                text <=> PlanningMindmap.d-text;
                rows: 2;
                init => { self.focus-input(); }
            }
            Rectangle { height: Theme.sp-6; }
            MmLabel { text: "Notes"; }
            // The notes as rows (.mmd-note-row): a box each, and ✕.
            nfl := Flickable {
                height: min(nel.preferred-height, root.height / 2 - Theme.sp-48);
                content-height: nel.preferred-height;
                nel := VerticalLayout {
                    spacing: Theme.sp-6;
                    for t[i] in PlanningMindmap.d-edit-notes: HorizontalLayout {
                        spacing: Theme.sp-6;
                        TextArea {
                            horizontal-stretch: 1;
                            text: t;
                            placeholder: "Note…";
                            rows: 2;
                            init => { if i == PlanningMindmap.d-note-focus { self.focus-input(); } }
                            edited(v) => { PlanningMindmap.d-note-edit(i, v); }
                        }
                        Rectangle {
                            width: Theme.sp-32;
                            border-radius: Theme.r-control;
                            border-width: 1px;
                            border-color: dta.has-hover ? Theme.red : Theme.border;
                            background: Theme.bg-tertiary;
                            Icon { source: Icons.x; width: Theme.icon-md; height: Theme.icon-md; tint: dta.has-hover ? Theme.red : Theme.text-muted; }
                            dta := TouchArea { mouse-cursor: pointer; clicked => { PlanningMindmap.d-note-del(i); } }
                        }
                    }
                }
            }
            // "+ Add note" (.mmd-add-note): dashed, the width of the dialog.
            Rectangle {
                height: Theme.control-sm + Theme.sp-2;
                border-radius: Theme.r-control;
                if !nta.has-hover: DashedBox { width: parent.width; height: parent.height; corner: Theme.r-control; }
                if nta.has-hover: Rectangle { border-radius: Theme.r-control; border-width: 1px; border-color: Theme.accent; }
                Text { text: "+ Add note"; font-size: Theme.text-13; color: nta.has-hover ? Theme.accent-hover : Theme.text-secondary; }
                nta := TouchArea { mouse-cursor: pointer; clicked => { PlanningMindmap.d-act("add-note"); } }
            }
        }
        HorizontalLayout {
            padding-top: Theme.sp-4;
            spacing: Theme.sp-8;
            if !PlanningMindmap.d-editing: MmdBtn { text: "Edit"; clicked => { PlanningMindmap.d-act("edit"); } }
            if PlanningMindmap.d-editing: MmdBtn { text: "Save"; primary: true; clicked => { PlanningMindmap.d-act("save"); } }
            MmdBtn { text: "+ Child"; clicked => { PlanningMindmap.d-act("child"); } }
            MmdBtn { text: PlanningMindmap.d-link-label; clicked => { PlanningMindmap.d-act("link"); } }
            MmdBtn { text: "Media"; clicked => { PlanningMindmap.d-act("media"); } }
            MmdBtn { text: "Delete"; danger: true; clicked => { PlanningMindmap.d-act("delete"); } }
            MmdBtn { text: "Close"; clicked => { PlanningMindmap.d-act("close"); } }
        }
    }
}

/// The link picker (#link-modal): the project, a search, "Scope to …",
/// and the project's tasks with their subtasks.
export component MmLinkDialog inherits Rectangle {
    MmDialog {
        width: root.width; height: root.height;
        close => { PlanningMindmap.l-act("cancel", "", ""); }
        Text { text: "Scope to a project — or link a task"; wrap: word-wrap; font-size: Theme.text-16; font-weight: Theme.w-semibold; color: Theme.text-primary; }
        HorizontalLayout {
            spacing: Theme.sp-8;
            Select {
                max-width: Theme.sp-48 + Theme.sp-48 + Theme.sp-48 + Theme.sp-48 + Theme.sp-24;
                options: PlanningMindmap.l-names;
                selected: PlanningMindmap.l-sel;
                enabled: !PlanningMindmap.l-locked;
                picked(i) => { PlanningMindmap.l-act("project", "" + i, ""); }
            }
            TextField {
                horizontal-stretch: 1;
                text <=> PlanningMindmap.l-search;
                placeholder: "Search tasks & subtasks…";
                init => { self.focus-input(); }
                edited(v) => { PlanningMindmap.l-act("search", v, ""); }
                escape => { PlanningMindmap.l-act("cancel", "", ""); }
            }
        }
        // .lm-locked: a child keeps its parent's project.
        if PlanningMindmap.l-locked: HorizontalLayout {
            spacing: Theme.sp-6;
            VerticalLayout { alignment: start; padding-top: 1px; Icon { source: Icons.lock; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.yellow; } }
            Text { horizontal-stretch: 1; text: PlanningMindmap.l-locked-text; wrap: word-wrap; font-size: Theme.text-12; color: Theme.yellow; }
        }
        // .lm-scope-btn
        Rectangle {
            height: sbl.preferred-height;
            border-radius: Theme.r-control;
            border-width: 1px;
            border-color: Theme.accent;
            background: sta.has-hover ? Theme.accent : Theme.accent-dim;
            sbl := HorizontalLayout {
                padding-left: Theme.sp-10 + 1px; padding-right: Theme.sp-10 + 1px;
                padding-top: Theme.sp-8 + 1px; padding-bottom: Theme.sp-8 + 1px;
                spacing: Theme.sp-6;
                VerticalLayout { alignment: center; Icon { source: Icons.folder; width: Theme.icon-md; height: Theme.icon-md; tint: sta.has-hover ? Theme.white : Theme.text-primary; } }
                Text { horizontal-stretch: 1; text: PlanningMindmap.l-scope-label; wrap: word-wrap; vertical-alignment: center; font-size: Theme.text-13; color: sta.has-hover ? Theme.white : Theme.text-primary; }
            }
            sta := TouchArea { mouse-cursor: pointer; clicked => { PlanningMindmap.l-act("scope", "", ""); } }
        }
        Text { text: "— or link a specific task —"; horizontal-alignment: center; font-size: Theme.text-11; color: Theme.text-muted; }
        // .lm-list
        Rectangle {
            height: min(Theme.pick-max-h + Theme.sp-48 + Theme.sp-32, ll.preferred-height + Theme.sp-2);
            border-radius: Theme.r-control;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            lfl := Flickable {
                x: 1px; y: 1px; width: parent.width - Theme.sp-2; height: parent.height - Theme.sp-2;
                content-height: ll.preferred-height;
                ll := VerticalLayout {
                    if PlanningMindmap.l-loading || PlanningMindmap.l-rows.length == 0: Rectangle {
                        height: et.preferred-height + 2 * Theme.sp-16;
                        et := Text {
                            text: PlanningMindmap.l-loading ? "Loading…" : "No matching tasks or subtasks.";
                            font-size: Theme.text-13; color: Theme.text-muted;
                        }
                    }
                    if !PlanningMindmap.l-loading: VerticalLayout {
                        for r[i] in PlanningMindmap.l-rows: Rectangle {
                            height: rl.preferred-height + 1px;
                            background: rta.has-hover ? Theme.bg-hover : transparent;
                            rl := HorizontalLayout {
                                padding-left: r.todo != "" ? Theme.sp-24 + Theme.sp-4 : Theme.sp-10;
                                padding-right: Theme.sp-10;
                                padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
                                spacing: Theme.sp-6;
                                if r.todo != "": VerticalLayout { alignment: center; Icon { source: r.done ? Icons.check : Icons.square; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.text-secondary; } }
                                Text { horizontal-stretch: r.status == "" ? 1 : 0; text: r.text; wrap: word-wrap; vertical-alignment: center; font-size: r.todo != "" ? Theme.text-12 : Theme.text-13; color: r.todo != "" ? Theme.text-secondary : Theme.text-primary; }
                                if r.status != "": Text { text: "[" + r.status + "]"; vertical-alignment: center; font-size: Theme.text-11; color: Theme.text-muted; }
                                if r.status != "": Rectangle { horizontal-stretch: 1; }
                            }
                            if i < PlanningMindmap.l-rows.length - 1: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
                            rta := TouchArea { mouse-cursor: pointer; clicked => { PlanningMindmap.l-act("pick", r.task, r.todo); } }
                        }
                    }
                }
            }
        }
        // .im-buttons: Cancel.
        HorizontalLayout {
            padding-top: Theme.sp-2;
            MmdBtn { text: "Cancel"; clicked => { PlanningMindmap.l-act("cancel", "", ""); } }
        }
    }
}

/// A key cap (.mmh-keys kbd).
component Kbd inherits Rectangle {
    in property <string> text;
    height: kt.preferred-height + Theme.sp-4;
    width: kt.preferred-width + Theme.sp-12;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg-primary;
    // The thicker bottom edge.
    Rectangle { y: parent.height - Theme.sp-2; height: Theme.sp-2; x: Theme.sp-2; width: parent.width - Theme.sp-4; background: Theme.border; }
    kt := Text { y: Theme.sp-2 - 1px; text: root.text; font-family: Theme.mono; font-size: Theme.text-11; font-weight: Theme.w-semibold; color: Theme.text-primary; }
}

/// A shortcut's little tree (mmDiagram): boxes in columns and rows, the
/// lines between them, and the note under it.
component MmDia inherits Rectangle {
    in property <PlanningMmHelp> item;
    height: dl.preferred-height;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg-primary;
    dl := VerticalLayout {
        padding: Theme.sp-10;
        spacing: Theme.sp-8;
        alignment: start;
        Rectangle {
            width: root.item.dia-w; height: root.item.dia-h;
            Path {
                x: 0; y: 0; width: parent.width; height: parent.height;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: root.item.dia-w / 1px; viewbox-height: root.item.dia-h / 1px;
                commands: root.item.path;
                stroke: Theme.border; stroke-width: Theme.sp-2 - 1px;
            }
            Path {
                x: 0; y: 0; width: parent.width; height: parent.height;
                viewbox-x: 0; viewbox-y: 0; viewbox-width: root.item.dia-w / 1px; viewbox-height: root.item.dia-h / 1px;
                commands: root.item.dash;
                stroke: Theme.border; stroke-width: Theme.sp-2 - 1px;
            }
            for b in root.item.boxes: Rectangle {
                x: Theme.sp-6 + b.col * Theme.mindmap-dia-col;
                y: Theme.sp-6 + b.row * Theme.mindmap-dia-row;
                width: Theme.mindmap-dia-box-w; height: Theme.mindmap-dia-box-h;
                border-radius: Theme.r-control;
                background: b.kind == "new" ? Theme.accent-dim : Theme.bg-card;
                border-width: b.kind == "held" ? 0 : 1px;
                border-color: b.kind != "" ? Theme.accent : Theme.border;
                if b.kind == "held": DashedBox { width: parent.width; height: parent.height; corner: Theme.r-control; line: Theme.accent; }
                Text { text: b.label; font-size: Theme.text-10; font-weight: Theme.w-semibold; color: b.kind != "" ? Theme.accent-hover : Theme.text-secondary; }
            }
        }
        Text { text: root.item.note; wrap: word-wrap; font-size: Theme.text-12; color: Theme.text-secondary; }
    }
}

/// The shortcut sheet (#mm-help-modal): every way of working the map, by
/// section; a row with a picture opens to it.
export component MmHelpDialog inherits Rectangle {
    MmDialog {
        width: root.width; height: root.height;
        card-w: Theme.dialog-w-xl;
        pad: 0;
        close => { PlanningMindmap.h-act("close"); }
        // .mmh-head
        Rectangle {
            height: hl.preferred-height;
            hl := HorizontalLayout {
                padding-left: Theme.sp-16; padding-right: Theme.sp-16;
                padding-top: Theme.sp-12 + Theme.sp-2; padding-bottom: Theme.sp-10;
                spacing: Theme.sp-8;
                Text { horizontal-stretch: 1; text: "Mindmap shortcuts"; vertical-alignment: center; font-size: Theme.text-16; font-weight: Theme.w-semibold; color: Theme.text-primary; }
                Rectangle {
                    height: Theme.sp-24 + Theme.sp-2; width: al.preferred-width;
                    border-radius: Theme.r-control; border-width: 1px;
                    border-color: ata.has-hover ? Theme.accent : Theme.border;
                    al := HorizontalLayout { padding-left: Theme.sp-8 + 1px; padding-right: Theme.sp-8 + 1px; Text { text: PlanningMindmap.h-all ? "Hide all pictures" : "Show all pictures"; vertical-alignment: center; font-size: Theme.text-12; color: ata.has-hover ? Theme.text-primary : Theme.text-secondary; } }
                    ata := TouchArea { mouse-cursor: pointer; clicked => { PlanningMindmap.h-act("all"); } }
                }
                Rectangle {
                    height: Theme.sp-24 + Theme.sp-2; width: self.height + Theme.sp-4;
                    border-radius: Theme.r-control; border-width: 1px;
                    border-color: xta.has-hover ? Theme.accent : Theme.border;
                    Icon { source: Icons.x; width: Theme.icon-md; height: Theme.icon-md; tint: xta.has-hover ? Theme.text-primary : Theme.text-secondary; }
                    xta := TouchArea { mouse-cursor: pointer; clicked => { PlanningMindmap.h-act("close"); } }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        // .mmh-body: scrolls.
        Rectangle {
            height: min(bl.preferred-height, root.height - Theme.sp-48 * 2 - Theme.sp-48 - Theme.sp-24);
            bfl := Flickable {
                content-height: bl.preferred-height;
                bl := VerticalLayout {
                    padding-left: Theme.sp-16; padding-right: Theme.sp-16;
                    padding-top: Theme.sp-4; padding-bottom: Theme.sp-16;
                    for r[i] in PlanningMindmap.h-rows: VerticalLayout {
                        // A section's heading (.mmh-body h4).
                        if r.head != "": Rectangle {
                            height: ht.preferred-height + Theme.sp-16 + Theme.sp-4;
                            ht := Text {
                                x: 0; y: parent.height - self.height - Theme.sp-4;
                                text: r.head; font-size: Theme.text-11; font-weight: Theme.w-semibold;
                                letter-spacing: Theme.track-wide; color: Theme.text-muted;
                            }
                        }
                        if r.head == "": Rectangle {
                            height: rl.preferred-height;
                            rl := VerticalLayout {
                                HorizontalLayout {
                                    padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
                                    padding-left: Theme.sp-2; padding-right: Theme.sp-2;
                                    spacing: Theme.sp-10;
                                    // .mmh-keys: the keys, a line each.
                                    VerticalLayout {
                                        width: Theme.mindmap-help-keys;
                                        spacing: Theme.sp-4;
                                        alignment: start;
                                        for line in r.lines: HorizontalLayout {
                                            spacing: Theme.sp-2;
                                            alignment: start;
                                            for k in line.keys: HorizontalLayout {
                                                if k.kind == "kbd": Kbd { text: k.text; }
                                                if k.kind == "plus" || k.kind == "or": Text { text: k.text; vertical-alignment: center; font-size: Theme.text-11; color: Theme.text-muted; }
                                                if k.kind == "word": Text { text: k.text; vertical-alignment: center; font-size: Theme.text-12; font-weight: Theme.w-semibold; color: Theme.accent-hover; }
                                            }
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: r.text; wrap: word-wrap;
                                        font-size: Theme.text-13;
                                        color: r.dia && rta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                    }
                                    if r.dia: VerticalLayout {
                                        alignment: center;
                                        Icon { source: r.open ? MmIcons.chevron-down : Icons.chevron-right; width: Theme.icon-md; height: Theme.icon-md; tint: r.open ? Theme.accent-hover : Theme.text-muted; }
                                    }
                                }
                                if r.dia && r.open: HorizontalLayout {
                                    padding-left: Theme.mindmap-help-keys + Theme.sp-10;
                                    padding-bottom: Theme.sp-10;
                                    MmDia { item: r; }
                                }
                            }
                            rta := TouchArea { enabled: r.dia; mouse-cursor: r.dia ? MouseCursor.pointer : MouseCursor.default; clicked => { PlanningMindmap.h-toggle(i); } }
                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
                        }
                    }
                }
            }
            ScrollThumb {
                width: parent.width; height: parent.height;
                view-h: bfl.height; content-h: bfl.content-height; offset: -bfl.content-y;
            }
        }
    }
}
