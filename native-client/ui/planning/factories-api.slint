// Factories (4.7, 4.8): the factories tab, the factory panel, the run graph: the globals and structs Rust uses (src/planning/factories.rs).
// Export every global and struct Rust needs by adding its name to this
// screen's line in ui/planning/api.slint (`export { ... } from "factories-api.slint";`).

/// A factory in the Library (.fx-card): Ready or "Draft · n to fix".
export struct PlanningFxCard { id: string, name: string, runnable: bool, chip: string, desc: string, meta: string }

/// A row of the Library's grid (as many cards as fit; blanks fill the last).
export struct PlanningFxCardRow { cards: [PlanningFxCard] }

/// A provided template (.fx-card.fx-tpl).
export struct PlanningFxTpl { id: string, name: string, good-for: string, description: string, team: string, busy: bool }
export struct PlanningFxTplRow { cards: [PlanningFxTpl] }

/// A run row (.fx-run) in Runs and the panel's Earlier runs; a trigger row
/// too (`off`: a trigger that is off; `tag1`/`tag2`: its small chips).
export struct PlanningFxRun { id: string, name: string, project: string, chip: string, tone: string, task: string, meta: string, off: bool, tag1: string, tag2: string }

/// A Cleanup row (the table's What, Size, Age, and its box).
export struct PlanningFxClean { id: string, title: string, meta: string, why: string, warn: string, size: string, age: string, picked: bool }

/// A line in a form or a pane: kind "note" | "warn" | "err" | "meta" |
/// "open" (a button that opens run `id`) | "anyway" (Start anyway) | "b" (bold).
export struct PlanningFxLine { kind: string, text: string, id: string }

/// A section of a change request form: its textarea.
export struct PlanningFxSec { id: string, label: string, hint: string, required: bool, rows: int, value: string, bad: bool }

/// An attachment chip.
export struct PlanningFxFile { name: string, image: bool }

/// A pair: an id and its words (options, replies, palette items).
export struct PlanningFxOpt { id: string, label: string }

/// A row of pills (the Team's persona templates).
export struct PlanningFxOptRow { items: [PlanningFxOpt] }

/// A ticked choice (presets, secrets).
export struct PlanningFxCheck { id: string, label: string, sub: string, on: bool, enabled: bool }

/// An output under a node: its label; `finish` the Manager's green Finish.
export struct PlanningFxOut { id: string, label: string, finish: bool }

/// A step on the canvas (flow units: x, y, w, h; the canvas scales them).
export struct PlanningFxNode {
    id: string, kind: string, kind-label: string, title: string, body: string, lines: int,
    x: float, y: float, w: float, h: float,
    sel: bool, bad: bool, active: bool, visited: bool, retired: bool,
    badge: int, badge-level: string, token: string, token-kind: string,
    doing: bool, doing-who: string, doing-text: string, doing-busy: bool,
    skills: string, outs: [PlanningFxOut], agent: bool, has-in: bool,
}

/// A connection: its SVG path and arrow (flow units), its look (tone:
/// flow, note, loop, bad, used, job), its label and where that sits.
export struct PlanningFxEdge { id: string, path: string, arrow: string, tone: string, sel: bool, pulse: bool, label: string, icon: string, lx: float, ly: float }

/// Someone at work (.ff-worker), or waiting for a seat (`queued`).
export struct PlanningFxWorker { id: string, name: string, what: string, busy: bool, blocked: bool, chat: string, queued: bool }

export struct PlanningFxKv { k: string, v: string }
export struct PlanningFxAsk { token: string, prompt: string, replies: [PlanningFxOpt] }
/// A wait in progress (WaitCard / the panel's waitCard).
export struct PlanningFxWait { token: string, head: string, gives: string, last: string, url: string, two: bool }
/// A timeline line (.ff-tl-item): k is the kind (start, handoff, escalate…).
export struct PlanningFxTl { i: int, time: string, k: string, main: string, sub: string, on: bool, future: bool }
/// A visit to the selected step (.ff-step).
export struct PlanningFxStep { who: string, num: string, summary: string, answers: string, skills: string }
/// An issue (.ff-issue): level error | warning; `key` what a click goes to.
export struct PlanningFxIssue { level: string, message: string, fix: string, key: string }
/// A person in the Team list (.ff-person).
export struct PlanningFxPerson { id: string, name: string, meta: string, manager: bool }
/// A section of the factory's change request form, in the editor.
export struct PlanningFxCrSec { id: string, label: string, hint: string, required: bool, list: bool }

/// The live graph (Viewer.jsx), in the tab (`panel` false) or the panel.
export struct PlanningFxView {
    state: string,            // loading | error | ok
    error: string,
    panel: bool,
    back: bool,               // the tab's Back (onClose)
    name: string,
    live: bool,
    st: string,               // the run's status (its look)
    st-label: string,         // "Running", "Replay"…
    progress: string,
    follow: bool,
    drawer: bool,
    chat: bool,               // a person's transcript over the graph (panel)
    can-pause: bool, can-resume: bool, can-stop: bool,
    busy: bool,
    pause-menu: bool, pause-reset: bool, pause-opts: bool,
    needs-kind: string,       // "" | bad | you | info
    needs-text: string,
    needs-act: string,        // the button's words, "" none
    tab: string,              // run | timeline
    sel: string,              // the selected step's id
    sel-title: string,
    err: string,
    hint: string,
    events: int, at: int, at-label: string,
    // The step pane.
    who: string, now: string, visits: string, open-chat: string, no-chat: string,
    // The run pane.
    has-limits: bool, limits-open: bool, limits-sum: string, l5h: string, lweek: string, lpar: string, lone: string,
    manager-talks: bool, manager-chat: bool,
    findings: string, crashed: bool, crash: string, cap: string, note: string,
    // The view on the canvas.
    zoom: float, pan-x: float, pan-y: float,
    bx: float, by: float, bw: float, bh: float,
}

/// The editor's top bar and side (Editor.jsx).
export struct PlanningFxEd {
    state: string,            // loading | error | ok
    error: string,
    name: string,
    save: string,             // saved | saving | dirty | conflict | error
    save-label: string,
    draft: bool,
    can-undo: bool, can-redo: bool,
    tab: string,              // edit | team | issues | dry
    issues-label: string,
    issues-bad: bool,
    toast: string,
    zoom: float, pan-x: float, pan-y: float,
    bx: float, by: float, bw: float, bh: float,
    // A connection being drawn: from (flow) to the pointer (flow).
    conn: bool, conn-path: string,
}

/// The editor's right pane: what it edits (one row; replaced when the
/// selection changes, so its fields start from these values).
export struct PlanningFxInsp {
    mode: string,             // node | edge | settings | team | person | issues | dry
    gen: int,
    kind: string, kind-label: string, can-delete: bool,
    issues: [PlanningFxIssue],
    label: string, label-ph: string,
    // employee
    who: [string], who-i: int, has-person: bool,
    // decision
    question: string, dkind-i: int, options: [PlanningFxOpt], review: bool, answered: [string], answered-i: int,
    // ask
    prompt: string, replies: [PlanningFxOpt],
    // wait
    wkind-i: int, minutes: string, at: string, command: string, every: string, what: string, timeout: string,
    // join
    forks: [string], fork-i: int,
    // edge
    edge-desc: string, note: bool, note-label: string, rounds: string, require-note: bool,
    // settings
    name: string, description: string, cr: [PlanningFxCrSec], cr-default: bool, cr-full: bool,
    mmode-i: int, mmode-hint: string, tmode-i: int, tmode-hint: string, bypass-warn: bool,
    presets: [PlanningFxCheck], rules: string, manager-rules: bool, mrules-hint: string,
    gatekeeper: bool, gk-i: int,
    secrets-on: bool, secrets: [PlanningFxCheck], secrets-gone: [string],
    merge-i: int, auto-recover: bool, setup: string, max-handoffs: string, max-minutes: string,
    tick: string, tick-hint: string, l5h: string, lweek: string, lim-hint: string, lpar: string, lone: string,
    // team / person
    people: [PlanningFxPerson], persona-rows: [PlanningFxOptRow],
    manager: bool, persona: string, model-i: int, effort-i: int, memory-i: int, memory-hint: string,
    can-edit: bool, pinned: string, p-presets: [PlanningFxCheck], show-presets: bool, allow: string, deny: string, steps-hint: string,
    // skill mentions under a text: "name|ok" pairs for the field in `mention-for`
    mentions-q: [PlanningFxCheck], mentions-p: [PlanningFxCheck], mentions-d: [PlanningFxCheck],
    // issues pane
    ok: bool, issues-title: string, issues-hint: string,
}

/// The Start a factory dialog (startDialog()).
export struct PlanningFxStart {
    open: bool, loading: bool, empty: bool,
    project-i: int, factory-i: int, merge-i: int,
    title: string, title-bad: bool,
    go-enabled: bool, go-label: string,
    gen: int,
}

/// The PIN prompt at the start of a run (askSecretPins()).
export struct PlanningFxPin { open: bool, name: string, step: string, sub: string, pass: bool, value: string, err: string, busy: bool, gen: int }

/// The trigger dialog (triggerDialog()).
export struct PlanningFxTrig {
    open: bool, loading: bool, empty: bool, title: string, editing: bool,
    name: string, factory-i: int, kind-i: int, at: string, column-i: int,
    cr-head: string, cr-title: string,
    merge-i: int, busy-i: int, needs-i: int, enabled: bool,
    auth-i: int, sig-h: string, ts-h: string, idem: string, sample: string,
    hook: bool, hook-url: string, hook-secret: string, hook-signed: bool, hook-hint: string, hook-curl: string, hook-seen: string,
    gen: int,
}

export global PlanningFactories {
    // ── The tab ──
    in-out property <string> view: "library";        // library | runs | cleanup
    in-out property <string> sub;                    // "" | editor | viewer | loading | error
    in-out property <string> sub-error;
    in-out property <bool> lib-loading: true;
    in-out property <bool> lib-empty;
    in-out property <int> lib-cols: 1;
    in-out property <[PlanningFxCardRow]> factories;
    in-out property <[PlanningFxTplRow]> templates;
    in-out property <bool> runs-loading: true;
    in-out property <[PlanningFxRun]> runs;
    in-out property <bool> clean-loading: true;
    in-out property <[PlanningFxClean]> clean;
    in-out property <string> clean-days: "0";
    in-out property <int> clean-gen;

    // ── The factory panel ──
    in-out property <string> panel: "loading";       // none | loading | idle | live
    in-out property <[PlanningFxRun]> earlier;
    in-out property <bool> earlier-open;
    in-out property <[PlanningFxRun]> triggers;
    in-out property <bool> triggers-open;
    in-out property <bool> triggers-loaded;

    // ── The live graph (one: the tab's or the panel's, never both on show) ──
    in-out property <PlanningFxView> v;
    in-out property <[PlanningFxNode]> v-nodes;
    in-out property <[PlanningFxEdge]> v-edges;
    in-out property <[PlanningFxWorker]> v-working;
    in-out property <[PlanningFxKv]> v-kv;
    in-out property <[PlanningFxAsk]> v-asks;
    in-out property <[PlanningFxWait]> v-waits;
    in-out property <[string]> v-findings;
    in-out property <[PlanningFxTl]> v-timeline;
    in-out property <[PlanningFxStep]> v-steps;
    in-out property <string> v-ask-note;

    // ── The editor ──
    in-out property <PlanningFxEd> ed;
    in-out property <[PlanningFxNode]> e-nodes;
    in-out property <[PlanningFxEdge]> e-edges;
    in-out property <[PlanningFxOpt]> e-people;
    in-out property <[PlanningFxInsp]> e-insp;

    // ── Dialogs ──
    in-out property <PlanningFxStart> start;
    in-out property <[string]> st-projects;
    in-out property <[string]> st-factories;
    in-out property <[PlanningFxSec]> st-sections;
    in-out property <[PlanningFxFile]> st-files;
    in-out property <[PlanningFxLine]> st-info;
    in-out property <PlanningFxPin> pin;
    in-out property <PlanningFxTrig> trig;
    in-out property <[string]> tr-factories;
    in-out property <[bool]> tr-days;
    in-out property <[PlanningFxSec]> tr-sections;
    in-out property <[PlanningFxLine]> tr-preview;
    in-out property <[string]> tr-history;
    // A person's transcript (the web's .fx-chatwrap).
    in-out property <bool> chat-open;
    in-out property <string> chat-name;
    in-out property <string> chat-state;             // loading | error | ok
    in-out property <[PlanningFxKv]> chat-lines;

    // Everything a button does: act(what, id, more).
    callback act(string, string, string);
    // A field's text or a choice changed: edit(form, key, value).
    callback edit(string, string, string);
    // The canvases: which is "v" (the live graph) or "e" (the editor).
    callback cv-size(string, length, length);
    callback cv-pan(string, length, length);
    callback cv-zoom(string, float, length, length);
    callback cv-node-down(string, string);
    callback cv-node-drag(string, string, length, length);
    callback cv-node-up(string, string, bool);
    callback cv-handle-drag(string, string, string, length, length);
    callback cv-handle-up(string, string, string, length, length);
    callback cv-edge(string, string);
    callback cv-pane(string);
    callback cv-key(string, string);
    callback cv-mini(string, float, float);
}
