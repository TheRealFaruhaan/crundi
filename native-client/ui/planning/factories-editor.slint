// Factories (4.7): the factory editor (tools/factory-flow/src/Editor.jsx,
// Palette.jsx, Inspector.jsx, Roster.jsx, CrTemplate.jsx, DryRun.jsx): the
// top bar (Back, the name, Saved / Unsaved · draft, Undo, Redo, Tidy, Fit),
// the palette, the canvas, and the side with Edit, Team, Issues and Dry
// run. Driven by src/planning/factories.rs through PlanningFactories.ed,
// e-nodes, e-edges, e-people and e-insp (the pane, one row).
//
// Slint limits (PLAN.md Known gaps): typing "/" in a persona or a question
// does not offer the skills (the named skills still show under the text,
// marked when not installed for all projects).

import { Theme, Icons, Icon, ScrollThumb, CheckRow, TextField, TextArea, Select, Toggle } from "../kit.slint";
import { PlanningFactories, PlanningFxInsp, PlanningFxCheck, PlanningFxOpt } from "factories-api.slint";
import { FxBtn, FxIconBtn, FxNote, FxField, FxSummary, FxIssue, FxMentions, FxIcons } from "factories-parts.slint";
import { FxCanvas } from "factories-graph.slint";

component Pane inherits Rectangle {
    fl := Flickable {
        width: parent.width; height: parent.height;
        content-height: max(self.height, col.preferred-height);
        col := VerticalLayout { width: fl.width; padding: Theme.sp-12; spacing: Theme.sp-10; alignment: start; @children }
    }
    ScrollThumb { width: root.width; height: root.height; view-h: fl.height; content-h: fl.content-height; offset: -fl.content-y; }
}

/// .ff-subtitle: small, upper case, muted.
component Sub inherits Text {
    font-size: Theme.text-11; letter-spacing: Theme.track-wide; color: Theme.text-muted;
}

/// .ff-toggle: a box and its words.
component Tick inherits CheckRow { }

/// A pane's title row (.ff-pane-title): back, kind, delete.
component PaneTitle inherits HorizontalLayout {
    in property <string> text;
    in property <bool> back;
    in property <bool> del;
    in property <string> del-tip: "Delete";
    callback backed();
    callback deleted();
    spacing: Theme.sp-8;
    if root.back: FxIconBtn { icon: FxIcons.back; tip: "Back to the team"; clicked => { root.backed(); } }
    Text { horizontal-stretch: 1; text: root.text; font-size: Theme.text-13; font-weight: Theme.w-semibold; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
    if root.del: FxIconBtn { icon: Icons.trash; tip: root.del-tip; danger: true; clicked => { root.deleted(); } }
}

/// A list of labelled choices (ChoiceList): options, replies.
component Choices inherits VerticalLayout {
    in property <[PlanningFxOpt]> items;
    in property <int> min;
    in property <string> key;        // the field: options | replies
    in property <string> add-label;
    spacing: Theme.sp-6;
    for it[i] in root.items: HorizontalLayout {
        spacing: Theme.sp-4;
        TextField { horizontal-stretch: 1; text: it.label; placeholder: "Choice " + (i + 1); edited(t) => { PlanningFactories.edit("ed", root.key + "-label:" + it.id, t); } }
        FxIconBtn { icon: Icons.x; tip: "Remove"; enabled: root.items.length > root.min; clicked => { PlanningFactories.edit("ed", root.key + "-remove", it.id); } }
    }
    HorizontalLayout { alignment: start; FxBtn { text: root.add-label; kind: "ghost"; has-icon: true; icon: Icons.plus; clicked => { PlanningFactories.edit("ed", root.key + "-add", ""); } } }
}

/// The checks of a list (presets, secrets).
component Checks inherits VerticalLayout {
    in property <[PlanningFxCheck]> items;
    in property <string> key;
    spacing: Theme.sp-6;
    for c in root.items: VerticalLayout {
        Tick { checked: c.on; text: c.label + (c.sub != "" ? " · " + c.sub : ""); enabled: c.enabled; toggled(v) => { PlanningFactories.edit("ed", root.key + ":" + c.id, v ? "1" : "0"); } }
    }
}

/// The step inspector (NodeInspector).
component NodeInsp inherits Pane {
    in property <PlanningFxInsp> d;
    PaneTitle { text: root.d.kind-label; del: root.d.can-delete; deleted => { PlanningFactories.act("e-delete", "", ""); } }
    for it in root.d.issues: FxIssue { level: it.level; message: it.message; fix: it.fix; }
    FxField { label: "Label"; hint: "Shown on the canvas; also how the team refers to this step.";
        TextField { text: root.d.label; placeholder: root.d.kind-label; edited(t) => { PlanningFactories.edit("ed", "label", t); } }
    }
    if root.d.kind == "employee": FxField { label: "Who does this step";
        Select { options: root.d.who; selected: root.d.who-i; picked(i) => { PlanningFactories.edit("ed", "who", "" + i); } }
    }
    if root.d.kind == "employee" && root.d.has-person: HorizontalLayout { alignment: start;
        FxBtn { text: "Edit their persona"; kind: "ghost"; has-icon: true; icon: FxIcons.user; clicked => { PlanningFactories.act("e-person", "", ""); } }
    }
    if root.d.kind == "manager": HorizontalLayout { alignment: start;
        FxBtn { text: "Edit the Manager's persona"; kind: "ghost"; has-icon: true; icon: FxIcons.crown; clicked => { PlanningFactories.act("e-person", "manager", ""); } }
    }
    if root.d.kind == "decision": VerticalLayout {
        spacing: Theme.sp-10;
        FxField { label: "Question"; hint: "Answered at handoff. You can name skills with /skill-name.";
            TextArea { rows: 2; text: root.d.question; placeholder: "Does it need a UI change?"; edited(t) => { PlanningFactories.edit("ed", "question", t); } }
            FxMentions { items: root.d.mentions-q; }
        }
        FxField { label: "Kind of answer";
            Select { options: ["Yes or no", "Pick one", "Pick any (runs them in parallel)"]; selected: root.d.dkind-i; picked(i) => { PlanningFactories.edit("ed", "dkind", "" + i); } }
        }
        if root.d.dkind-i != 0: FxField { label: "Options";
            Choices { items: root.d.options; min: 2; key: "options"; add-label: "Add option"; }
        }
        if root.d.dkind-i == 0: Tick { checked: root.d.review; text: "This is a review gate (approval)"; toggled(v) => { PlanningFactories.edit("ed", "review", v ? "1" : "0"); } }
        if root.d.dkind-i == 0 && root.d.review: FxNote { kind: "hint"; text: "\"No\" needs at least one open blocking finding saying what must change; \"yes\" needs none left open. Findings carry over between rounds, so reviewers check last round's requests first, and nits become follow-ups instead of blocking."; }
        FxField { label: "Who answers"; hint: "Usually whoever arrives here. After a Join or an Ask me, someone has to be named.";
            Select { options: root.d.answered; selected: root.d.answered-i; picked(i) => { PlanningFactories.edit("ed", "answered", "" + i); } }
        }
    }
    if root.d.kind == "ask": VerticalLayout {
        spacing: Theme.sp-10;
        FxField { label: "What you are asked"; hint: "You get a notification and the run waits for your reply.";
            TextArea { rows: 2; text: root.d.prompt; placeholder: "Ship it?"; edited(t) => { PlanningFactories.edit("ed", "prompt", t); } }
            FxMentions { items: root.d.mentions-q; }
        }
        FxField { label: "Replies"; Choices { items: root.d.replies; min: 1; key: "replies"; add-label: "Add reply"; } }
    }
    if root.d.kind == "wait": VerticalLayout {
        spacing: Theme.sp-10;
        FxField { label: "Wait for";
            Select {
                options: ["A command to succeed (CI, a deploy, a health check)", "A signal (a URL called by CI or a hook, or you)", "A length of time", "A time of day"];
                selected: root.d.wkind-i; picked(i) => { PlanningFactories.edit("ed", "wkind", "" + i); }
            }
        }
        if root.d.wkind-i == 2: FxField { label: "Minutes"; TextField { text: root.d.minutes; edited(t) => { PlanningFactories.edit("ed", "minutes", t); } } }
        if root.d.wkind-i == 3: FxField { label: "Until (this server's time)"; hint: "The next time the clock says this; tomorrow if it has passed today.";
            TextField { text: root.d.at; placeholder: "07:30"; edited(t) => { PlanningFactories.edit("ed", "wat", t); } }
        }
        if root.d.wkind-i == 0: FxField { label: "Command"; hint: "Run in the run's worktree; the wait is over when it exits 0. E.g. gh run watch --exit-status, curl -fs localhost:4310/health, npm test.";
            TextField { mono: true; text: root.d.command; placeholder: "gh run watch --exit-status"; edited(t) => { PlanningFactories.edit("ed", "command", t); } }
        }
        if root.d.wkind-i == 0: FxField { label: "Try every (seconds)"; TextField { text: root.d.every; edited(t) => { PlanningFactories.edit("ed", "every", t); } } }
        if root.d.wkind-i == 1: FxField { label: "Waiting for"; hint: "Shown on the live graph. Each run gets a secret URL to POST to; you can also end the wait from the run.";
            TextField { text: root.d.what; placeholder: "The staging deploy to finish"; edited(t) => { PlanningFactories.edit("ed", "what", t); } }
        }
        if root.d.wkind-i <= 1: FxField { label: "Give up after (minutes)"; hint: "Then it goes down Timed out, so the run never waits forever.";
            TextField { text: root.d.timeout; edited(t) => { PlanningFactories.edit("ed", "timeout", t); } }
        }
        FxNote { kind: "hint"; text: "What came in (the last summary, any note) goes on to whoever is next, with what happened during the wait. Waits survive a restart."; }
    }
    if root.d.kind == "join": FxField { label: "Joins the branches of"; hint: "The pick-any decision whose parallel branches meet here.";
        Select { options: root.d.forks; selected: root.d.fork-i; picked(i) => { PlanningFactories.edit("ed", "fork", "" + i); } }
    }
    if root.d.kind == "start": FxNote { kind: "hint"; text: "The task you give when starting the factory enters here and goes to the Manager."; }
    if root.d.kind == "end": FxNote { kind: "hint"; text: "Only the Manager's Finish reaches here. The Manager then presents the result and you decide whether to merge it."; }
}

/// The connection inspector (EdgeInspector).
component EdgeInsp inherits Pane {
    in property <PlanningFxInsp> d;
    PaneTitle { text: root.d.note ? "Note" : "Connection"; del: root.d.can-delete; deleted => { PlanningFactories.act("e-delete", "", ""); } }
    FxNote { kind: "hint"; text: root.d.edge-desc; }
    for it in root.d.issues: FxIssue { level: it.level; message: it.message; fix: it.fix; }
    if root.d.note: FxNote { kind: "hint"; text: root.d.label; }
    if root.d.note: FxField { label: "What the note is for";
        TextField { text: root.d.note-label; placeholder: "Instructions for reviewers"; edited(t) => { PlanningFactories.edit("ed", "note-label", t); } }
    }
    if !root.d.note: FxField { label: "Round limit"; hint: "Set it on the connection that goes back round a loop. When it runs out, the Manager takes over. Empty means no limit.";
        TextField { text: root.d.rounds; placeholder: "No limit"; edited(t) => { PlanningFactories.edit("ed", "rounds", t); } }
    }
    if !root.d.note: Tick { checked: root.d.require-note; text: "Require a note on this route"; toggled(v) => { PlanningFactories.edit("ed", "require-note", v ? "1" : "0"); } }
    if !root.d.note && root.d.require-note: FxField { label: "What the note says";
        TextField { text: root.d.note-label; placeholder: "What to change"; edited(t) => { PlanningFactories.edit("ed", "note-label", t); } }
    }
}

/// The factory's settings (FactorySettings), with its change request form (CrTemplateEditor).
component SettingsInsp inherits Pane {
    in property <PlanningFxInsp> d;
    property <bool> cr-open;
    property <bool> secrets-gone: root.d.secrets-gone.length > 0;
    PaneTitle { text: "Factory"; }
    FxField { label: "Name"; TextField { text: root.d.name; edited(t) => { PlanningFactories.edit("ed", "name", t); } } }
    FxField { label: "Description"; hint: "What this factory is for. /skill-name works here too.";
        TextArea { rows: 3; text: root.d.description; edited(t) => { PlanningFactories.edit("ed", "description", t); } }
        FxMentions { items: root.d.mentions-d; }
    }
    FxSummary { text: "Change request form"; open: root.cr-open; toggled => { root.cr-open = !root.cr-open; } }
    if root.cr-open: VerticalLayout {
        spacing: Theme.sp-8;
        FxNote { kind: "hint"; text: "What the person fills in to start a run. The Manager gets all of it; every step gets the title, the goal and the \"done\" checks. The title and attachments are always there."; }
        for sec[i] in root.d.cr: Rectangle {
            background: Theme.bg-card; border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border;
            height: sl.preferred-height;
            sl := VerticalLayout {
                padding: Theme.sp-8; spacing: Theme.sp-6;
                HorizontalLayout { spacing: Theme.sp-4;
                    TextField { horizontal-stretch: 1; text: sec.label; placeholder: "Section name"; edited(t) => { PlanningFactories.edit("ed", "cr-label:" + i, t); } }
                    FxIconBtn { icon: FxIcons.up; tip: "Move up"; enabled: i > 0; clicked => { PlanningFactories.edit("ed", "cr-up", "" + i); } }
                    FxIconBtn { icon: FxIcons.down; tip: "Move down"; enabled: i < root.d.cr.length - 1; clicked => { PlanningFactories.edit("ed", "cr-down", "" + i); } }
                    FxIconBtn { icon: Icons.trash; tip: "Remove"; enabled: root.d.cr.length > 1; clicked => { PlanningFactories.edit("ed", "cr-remove", "" + i); } }
                }
                TextField { text: sec.hint; placeholder: "Hint: what to write here"; edited(t) => { PlanningFactories.edit("ed", "cr-hint:" + i, t); } }
                HorizontalLayout { spacing: Theme.sp-16; alignment: start;
                    Tick { checked: sec.required; text: "Required"; toggled(v) => { PlanningFactories.edit("ed", "cr-required:" + i, v ? "1" : "0"); } }
                    Tick { checked: sec.list; text: "A list"; toggled(v) => { PlanningFactories.edit("ed", "cr-list:" + i, v ? "1" : "0"); } }
                }
            }
        }
        HorizontalLayout { spacing: Theme.sp-6; alignment: start;
            FxBtn { text: "Add a section"; has-icon: true; icon: Icons.plus; enabled: !root.d.cr-full; clicked => { PlanningFactories.edit("ed", "cr-add", ""); } }
            if !root.d.cr-default: FxBtn { text: "Back to the default"; kind: "ghost"; clicked => { PlanningFactories.edit("ed", "cr-default", ""); } }
        }
    }
    FxField { label: "Manager's permissions"; hint: root.d.mmode-hint;
        Select { options: ["Normal: ask me for the Manager's own actions", "Bypass: I trust the Manager"]; selected: root.d.mmode-i; picked(i) => { PlanningFactories.edit("ed", "mmode", "" + i); } }
    }
    FxField { label: "The team's permissions"; hint: root.d.tmode-hint;
        Select { options: [root.d.gatekeeper ? "Ask the Manager (through the Gatekeeper)" : "Ask the Manager", "Bypass too"]; selected: root.d.tmode-i; picked(i) => { PlanningFactories.edit("ed", "tmode", "" + i); } }
    }
    if root.d.bypass-warn: Rectangle {
        border-radius: Theme.r-control; background: Theme.yellow-dim; height: bw.preferred-height;
        bw := HorizontalLayout { padding: Theme.sp-8; spacing: Theme.sp-8;
            VerticalLayout { alignment: start; padding-top: Theme.sp-2; Icon { width: Theme.icon-md; height: Theme.icon-md; source: FxIcons.alert; tint: Theme.yellow; } }
            VerticalLayout { horizontal-stretch: 1; spacing: Theme.sp-6;
                Text { text: "You trust the Manager with bypass, and it would approve most of its team's requests anyway. Giving the team bypass too saves every one of those round trips."; wrap: word-wrap; font-size: Theme.text-12; color: Theme.yellow; }
                HorizontalLayout { alignment: start; FxBtn { text: "Give the team bypass too"; clicked => { PlanningFactories.edit("ed", "tmode", "1"); } } }
            }
        }
    }
    if root.d.tmode-i == 0: VerticalLayout {
        spacing: Theme.sp-10;
        FxField { label: "Everyone may, without asking"; hint: "Each person can have more in the Team panel.";
            Checks { items: root.d.presets; key: "preset"; }
        }
        FxField { label: "More rules for everyone"; hint: "One per line, Claude Code style: Bash(docker compose up:*), WebFetch(domain:docs.example.com). Too broad or forbidden rules are ignored.";
            TextArea { rows: 3; mono: true; text: root.d.rules; edited(t) => { PlanningFactories.edit("ed", "rules", t); } }
        }
        Tick { checked: root.d.manager-rules; text: "The Manager may set standing rules"; toggled(v) => { PlanningFactories.edit("ed", "manager-rules", v ? "1" : "0"); } }
        FxNote { kind: "hint"; text: root.d.mrules-hint; }
        Tick { checked: root.d.gatekeeper; text: "A Gatekeeper answers requests first"; toggled(v) => { PlanningFactories.edit("ed", "gatekeeper", v ? "1" : "0"); } }
        if root.d.gatekeeper: FxField { label: "Gatekeeper model"; hint: "A small, cheap model is enough: it follows the Manager's policy and passes the unclear requests on, so the Manager's own conversation stays on the work.";
            Select { options: ["Haiku", "Sonnet", "Opus"]; selected: root.d.gk-i; picked(i) => { PlanningFactories.edit("ed", "gk", "" + i); } }
        }
    }
    if root.d.secrets-on: FxField { label: "Secrets the run may use"; hint: "Their PINs are asked when you start a run and kept in memory for that run only, so it does not stop at every use. Values are never shown. The Manager and the Gatekeeper use them directly; anyone else asks them first. Any other secret asks you each time.";
        if root.d.secrets.length == 0: FxNote { kind: "hint"; text: "No secrets on this machine yet. Add them under Secrets."; }
        Checks { items: root.d.secrets; key: "secret"; }
        for g in root.d.secrets-gone: Rectangle {
            border-radius: Theme.r-control; background: Theme.yellow-dim; height: sg.preferred-height;
            sg := VerticalLayout { padding: Theme.sp-8; spacing: Theme.sp-6;
                Text { text: "A secret this factory lists no longer exists."; wrap: word-wrap; font-size: Theme.text-12; color: Theme.yellow; }
                HorizontalLayout { alignment: start; FxBtn { text: "Remove it"; clicked => { PlanningFactories.edit("ed", "secret:" + g, "0"); } } }
            }
        }
    }
    FxField { label: "When the work is done"; hint: "Either way it is a single squash commit, and nothing is ever pushed.";
        Select { options: ["Show me first, I decide", "Merge automatically (with Undo)"]; selected: root.d.merge-i; picked(i) => { PlanningFactories.edit("ed", "merge", "" + i); } }
    }
    Tick { checked: root.d.auto-recover; text: "Recover by itself after a crash"; toggled(v) => { PlanningFactories.edit("ed", "auto-recover", v ? "1" : "0"); } }
    FxField { label: "Setup command"; hint: "Runs in each new worktree before the team starts, e.g. npm ci.";
        TextField { mono: true; text: root.d.setup; placeholder: "npm ci"; edited(t) => { PlanningFactories.edit("ed", "setup", t); } }
    }
    HorizontalLayout { spacing: Theme.sp-8;
        FxField { horizontal-stretch: 1; label: "Max handoffs"; TextField { text: root.d.max-handoffs; edited(t) => { PlanningFactories.edit("ed", "max-handoffs", t); } } }
        FxField { horizontal-stretch: 1; label: "Max minutes"; TextField { text: root.d.max-minutes; edited(t) => { PlanningFactories.edit("ed", "max-minutes", t); } } }
    }
    FxNote { kind: "hint"; text: "When a limit is reached the run waits for you; you can let it carry on."; }
    FxField { label: "Manager check-in every (minutes)"; hint: root.d.tick-hint;
        TextField { text: root.d.tick; placeholder: "The Manager chooses"; edited(t) => { PlanningFactories.edit("ed", "tick", t); } }
    }
    Sub { text: "USAGE"; }
    FxNote { kind: "hint"; text: "Your Claude usage is shared with your own chats. These keep a run inside what you choose; each can also be changed on a running run."; }
    HorizontalLayout { spacing: Theme.sp-8;
        FxField { horizontal-stretch: 1; label: "5-hour, pause at %"; TextField { text: root.d.l5h; edited(t) => { PlanningFactories.edit("ed", "l5h", t); } } }
        FxField { horizontal-stretch: 1; label: "Weekly, pause at %"; TextField { text: root.d.lweek; edited(t) => { PlanningFactories.edit("ed", "lweek", t); } } }
    }
    FxNote { kind: "hint"; text: root.d.lim-hint; }
    HorizontalLayout { spacing: Theme.sp-8;
        FxField { horizontal-stretch: 1; label: "People at once"; hint: "0: no limit"; TextField { text: root.d.lpar; edited(t) => { PlanningFactories.edit("ed", "lpar", t); } } }
        FxField { horizontal-stretch: 1; label: "One at a time above %"; hint: "Of the 5-hour. 0: off"; TextField { text: root.d.lone; edited(t) => { PlanningFactories.edit("ed", "lone", t); } } }
    }
    FxNote { kind: "hint"; text: "Parallel steps beyond the limit wait their turn instead of all running together, which spreads the load. Each person's model is in the Team panel: a cheaper model for routine roles stretches usage too."; }
}

/// The Team (RosterPane without a selection): everyone, and Add someone.
component TeamInsp inherits Pane {
    in property <PlanningFxInsp> d;
    PaneTitle { text: "Team"; }
    VerticalLayout {
        spacing: Theme.sp-4;
        for p in root.d.people: Rectangle {
            background: pt.has-hover ? Theme.bg-hover : Theme.bg-card; border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border;
            height: pl.preferred-height;
            pl := HorizontalLayout {
                padding-left: Theme.sp-10; padding-right: Theme.sp-10; padding-top: Theme.sp-8; padding-bottom: Theme.sp-8; spacing: Theme.sp-8;
                VerticalLayout { alignment: center; Icon { width: Theme.icon-lg; height: Theme.icon-lg; source: p.manager ? FxIcons.crown : FxIcons.user; tint: Theme.text-secondary; } }
                VerticalLayout { horizontal-stretch: 1;
                    Text { text: p.name; font-size: Theme.text-13; font-weight: Theme.w-semibold; color: Theme.text-primary; overflow: elide; }
                    Text { text: p.meta; font-size: Theme.text-11; color: Theme.text-muted; overflow: elide; }
                }
            }
            pt := TouchArea { mouse-cursor: pointer; clicked => { PlanningFactories.act("e-person", p.id, ""); } }
        }
    }
    Sub { text: "ADD SOMEONE"; }
    // .ff-templates: pills, wrapping (Rust puts three to a row).
    for row in root.d.persona-rows: HorizontalLayout {
        spacing: Theme.sp-6; alignment: start;
        for p in row.items: Rectangle {
            width: pp.preferred-width + Theme.sp-20;
            height: Theme.control-sm - Theme.sp-2;
            border-radius: Theme.r-pill; border-width: 1px;
            border-color: pa.has-hover ? Theme.accent : Theme.border;
            pp := HorizontalLayout { alignment: center; spacing: Theme.sp-4;
                VerticalLayout { alignment: center; Icon { width: Theme.icon-sm; height: Theme.icon-sm; source: Icons.plus; tint: pa.has-hover ? Theme.text-primary : Theme.text-secondary; } }
                Text { text: p.label; font-size: Theme.text-12; vertical-alignment: center; color: pa.has-hover ? Theme.text-primary : Theme.text-secondary; }
            }
            pa := TouchArea { mouse-cursor: pointer; clicked => { PlanningFactories.act("e-add-person", p.id, ""); } }
        }
    }
    FxNote { kind: "hint"; text: "Templates are starting points: change the persona however you like."; }
}

/// One person (RosterPane with a selection).
component PersonInsp inherits Pane {
    in property <PlanningFxInsp> d;
    property <bool> more;
    PaneTitle {
        text: root.d.manager ? "Manager" : "Employee"; back: true; del: !root.d.manager; del-tip: "Remove from the team";
        backed => { PlanningFactories.act("e-team", "", ""); }
        deleted => { PlanningFactories.act("e-remove-person", "", ""); }
    }
    for it in root.d.issues: FxIssue { level: it.level; message: it.message; fix: it.fix; }
    FxField { label: "Name"; TextField { text: root.d.name; edited(t) => { PlanningFactories.edit("ed", "p-name", t); } } }
    FxField { label: "Persona"; hint: "Who they are and how they work. They read it and act as it says. /skill-name names a skill they should use.";
        TextArea { rows: 9; text: root.d.persona; edited(t) => { PlanningFactories.edit("ed", "persona", t); } }
        FxMentions { items: root.d.mentions-p; }
    }
    HorizontalLayout { spacing: Theme.sp-8;
        FxField { horizontal-stretch: 1; label: "Model"; Select { options: ["Default", "Opus", "Sonnet", "Haiku"]; selected: root.d.model-i; picked(i) => { PlanningFactories.edit("ed", "model", "" + i); } } }
        FxField { horizontal-stretch: 1; label: "Effort"; Select { options: ["Default", "low", "medium", "high", "xhigh", "max"]; selected: root.d.effort-i; picked(i) => { PlanningFactories.edit("ed", "effort", "" + i); } } }
    }
    if !root.d.manager: FxField { label: "Memory"; hint: root.d.memory-hint;
        Select { options: ["Keeps memory", "Fresh each time"]; selected: root.d.memory-i; picked(i) => { PlanningFactories.edit("ed", "memory", "" + i); } }
    }
    if !root.d.manager: Tick { checked: root.d.can-edit; text: "Can edit files"; toggled(v) => { PlanningFactories.edit("ed", "can-edit", v ? "1" : "0"); } }
    FxField { label: "Pinned skills"; hint: "Comma separated. Same as naming them in the persona.";
        TextField { text: root.d.pinned; placeholder: "frontend-design, run"; edited(t) => { PlanningFactories.edit("ed", "pinned", t); } }
    }
    if root.d.show-presets: FxField { label: "This person may also, without asking"; hint: "On top of what everyone may (factory settings).";
        Checks { items: root.d.p-presets; key: "p-preset"; }
    }
    FxSummary { text: "More tool rules"; open: root.more; toggled => { root.more = !root.more; } }
    if root.more: VerticalLayout { spacing: Theme.sp-8;
        FxField { label: "Always allowed (this person only)"; hint: "Claude Code rules, comma separated, e.g. Bash(npm test:*).";
            TextField { mono: true; text: root.d.allow; edited(t) => { PlanningFactories.edit("ed", "allow", t); } }
        }
        FxField { label: "Never allowed"; TextField { mono: true; text: root.d.deny; edited(t) => { PlanningFactories.edit("ed", "deny", t); } } }
    }
    if !root.d.manager: FxNote { kind: "hint"; text: root.d.steps-hint; }
}

/// What to fix (IssuesPane).
component IssuesInsp inherits Pane {
    in property <PlanningFxInsp> d;
    PaneTitle { text: root.d.issues-title; }
    if root.d.ok && root.d.issues.length == 0: HorizontalLayout { spacing: Theme.sp-6;
        VerticalLayout { alignment: center; Icon { width: Theme.icon-md; height: Theme.icon-md; source: Icons.check; tint: Theme.green; } }
        Text { horizontal-stretch: 1; text: "Every path can finish, every loop has a limit, every answer is wired."; color: Theme.green; font-size: Theme.text-13; wrap: word-wrap; }
    }
    if root.d.issues-hint != "": FxNote { kind: "hint"; text: root.d.issues-hint; }
    for it in root.d.issues: FxIssue { level: it.level; message: it.message; fix: it.fix; pick: it.key != ""; clicked => { PlanningFactories.act("e-issue", it.key, ""); } }
}

/// Dry run (DryRun): walking the flow needs the factory engine (src/factory-engine.js), which this client does not carry.
component DryInsp inherits Pane {
    in property <PlanningFxInsp> d;
    PaneTitle { text: "Dry run"; }
    FxNote { kind: "hint"; text: "Walk through the flow by hand, answering for each person, before spending anything on Claude. The canvas shows where the work is and how many rounds each loop has used."; }
    if !root.d.ok: FxIssue { level: "error"; message: "Fix the problems first: a factory that cannot run cannot be walked either."; }
    HorizontalLayout { alignment: start; FxBtn { text: "Start a dry run"; kind: "primary"; has-icon: true; icon: Icons.play; enabled: false; } }
    FxNote { kind: "hint"; text: "The dry run is in the web app for now: it walks the flow with the server's factory engine, which this client does not have yet."; }
}

/// A palette item (.ff-pal-item): a click adds it in the middle of the
/// view; dragged onto the canvas, where it is let go.
component PalItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> ghost;
    in property <string> kind;
    callback drag(string, string, length, length);
    callback drop(string, length, length);
    height: Theme.control-sm + Theme.sp-2;
    border-radius: Theme.r-field;
    background: root.ghost ? transparent : Theme.bg-card;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.accent : Theme.border;
    HorizontalLayout {
        padding-left: Theme.sp-8; padding-right: Theme.sp-8; spacing: Theme.sp-8;
        VerticalLayout { alignment: center; Icon { width: Theme.icon-md; height: Theme.icon-md; source: root.icon; tint: root.ghost ? Theme.text-secondary : Theme.text-primary; } }
        Text { horizontal-stretch: 1; text: root.text; font-size: Theme.text-12; vertical-alignment: center; overflow: elide; color: root.ghost ? Theme.text-secondary : Theme.text-primary; }
    }
    property <length> ax;
    property <length> ay;
    property <bool> moved;
    ta := TouchArea {
        mouse-cursor: self.pressed ? grabbing : grab;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down { root.ax = self.mouse-x; root.ay = self.mouse-y; root.moved = false; }
            if ev.kind == PointerEventKind.up && root.moved { root.drop(root.kind, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
        }
        moved => {
            if self.pressed && (root.moved || abs(self.mouse-x - root.ax) > Theme.sp-4 || abs(self.mouse-y - root.ay) > Theme.sp-4) {
                root.moved = true;
                root.drag(root.kind, root.text, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { if !root.moved { PlanningFactories.act("e-add", root.kind, ""); } }
    }
}

/// The editor.
export component FxEditor inherits Rectangle {
    background: Theme.bg-primary;
    property <bool> narrow: root.width < Theme.dock-narrow;
    // A palette item being dragged onto the canvas.
    property <string> drag-kind;
    property <string> drag-label;
    property <length> drag-x;
    property <length> drag-y;
    // The canvas's window position (the drop's point is made relative to it).
    property <length> cv-x;
    property <length> cv-y;
    function pal-drag(k: string, l: string, x: length, y: length) {
        root.drag-kind = k; root.drag-label = l;
        root.drag-x = x - root.absolute-position.x; root.drag-y = y - root.absolute-position.y;
    }
    function pal-drop(k: string, x: length, y: length) {
        root.drag-kind = "";
        PlanningFactories.act("e-add-at", k, (x - root.cv-x) / 1px + "," + (y - root.cv-y) / 1px);
    }
    keys := FocusScope {
        key-pressed(ev) => {
            if (ev.modifiers.control || ev.modifiers.meta) && (ev.text == "s" || ev.text == "S") { PlanningFactories.act("e-save", "", ""); return accept; }
            if (ev.modifiers.control || ev.modifiers.meta) && (ev.text == "z" || ev.text == "Z") { PlanningFactories.act(ev.modifiers.shift ? "e-redo" : "e-undo", "", ""); return accept; }
            if (ev.modifiers.control || ev.modifiers.meta) && (ev.text == "y" || ev.text == "Y") { PlanningFactories.act("e-redo", "", ""); return accept; }
            return reject;
        }
    }
    if PlanningFactories.ed.state == "loading": VerticalLayout { alignment: start; padding: Theme.sp-24; FxNote { text: "Loading…"; } }
    if PlanningFactories.ed.state == "error": VerticalLayout { alignment: start; padding: Theme.sp-24; spacing: Theme.sp-10;
        FxNote { text: PlanningFactories.ed.error; }
        HorizontalLayout { alignment: start; FxBtn { text: "Back"; clicked => { PlanningFactories.act("e-back", "", ""); } } }
    }
    if PlanningFactories.ed.state == "ok": VerticalLayout {
        // .ff-top
        Rectangle {
            background: Theme.bg-secondary;
            height: Theme.control + Theme.sp-10;
            HorizontalLayout {
                padding-left: Theme.sp-8; padding-right: Theme.sp-8; spacing: Theme.sp-6;
                VerticalLayout { alignment: center; FxIconBtn { icon: FxIcons.back; tip: "Back"; clicked => { PlanningFactories.act("e-back", "", ""); } } }
                Rectangle {
                    width: min(nm.preferred-width + Theme.sp-12, root.width * Theme.jump-share);
                    border-radius: Theme.r-control;
                    background: na.has-hover ? Theme.bg-hover : transparent;
                    nm := Text { x: Theme.sp-6; width: parent.width - Theme.sp-12; text: PlanningFactories.ed.name != "" ? PlanningFactories.ed.name : "Untitled factory"; font-size: Theme.text-14; font-weight: Theme.w-semibold; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
                    na := TouchArea { mouse-cursor: pointer; clicked => { PlanningFactories.act("e-settings", "", ""); } }
                }
                Text {
                    text: PlanningFactories.ed.save-label + (PlanningFactories.ed.draft ? " · draft" : "");
                    font-size: Theme.text-11; vertical-alignment: center;
                    color: PlanningFactories.ed.save == "conflict" || PlanningFactories.ed.save == "error" ? Theme.red : PlanningFactories.ed.draft ? Theme.yellow
                        : PlanningFactories.ed.save == "saving" || PlanningFactories.ed.save == "dirty" ? Theme.text-secondary : Theme.text-muted;
                }
                if PlanningFactories.ed.save == "conflict": VerticalLayout { alignment: center; FxBtn { text: "Reload"; clicked => { PlanningFactories.act("e-reload", "", ""); } } }
                if PlanningFactories.ed.save == "error": VerticalLayout { alignment: center; FxBtn { text: "Retry"; clicked => { PlanningFactories.act("e-save", "", ""); } } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; FxIconBtn { icon: FxIcons.undo; tip: "Undo (Ctrl+Z)"; enabled: PlanningFactories.ed.can-undo; clicked => { PlanningFactories.act("e-undo", "", ""); } } }
                VerticalLayout { alignment: center; FxIconBtn { icon: FxIcons.redo; tip: "Redo (Ctrl+Shift+Z)"; enabled: PlanningFactories.ed.can-redo; clicked => { PlanningFactories.act("e-redo", "", ""); } } }
                VerticalLayout { alignment: center; FxIconBtn { icon: FxIcons.layout; tip: "Tidy the layout"; clicked => { PlanningFactories.act("e-tidy", "", ""); } } }
                VerticalLayout { alignment: center; FxIconBtn { icon: Icons.fit; tip: "Fit to screen"; clicked => { PlanningFactories.act("cv-fit", "e", ""); } } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            // .ff-left: the palette.
            if !root.narrow: Rectangle {
                width: Theme.factories-left;
                background: Theme.bg-secondary;
                Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
                Pane {
                    Sub { text: "PEOPLE"; }
                    for p in PlanningFactories.e-people: PalItem { text: p.label; icon: FxIcons.user; kind: "employee:" + p.id; drag(k, l, x, y) => { root.pal-drag(k, l, x, y); } drop(k, x, y) => { root.pal-drop(k, x, y); } }
                    PalItem { text: "Someone new"; icon: Icons.plus; ghost: true; kind: "employee:"; drag(k, l, x, y) => { root.pal-drag(k, l, x, y); } drop(k, x, y) => { root.pal-drop(k, x, y); } }
                    Sub { text: "FLOW"; }
                    PalItem { text: "Yes / no question"; icon: FxIcons.branch; kind: "decision:yesno"; drag(k, l, x, y) => { root.pal-drag(k, l, x, y); } drop(k, x, y) => { root.pal-drop(k, x, y); } }
                    PalItem { text: "Pick one"; icon: FxIcons.branch; kind: "decision:one"; drag(k, l, x, y) => { root.pal-drag(k, l, x, y); } drop(k, x, y) => { root.pal-drop(k, x, y); } }
                    PalItem { text: "Pick any (parallel)"; icon: FxIcons.branch; kind: "decision:many"; drag(k, l, x, y) => { root.pal-drag(k, l, x, y); } drop(k, x, y) => { root.pal-drop(k, x, y); } }
                    PalItem { text: "Join"; icon: FxIcons.merge; kind: "join"; drag(k, l, x, y) => { root.pal-drag(k, l, x, y); } drop(k, x, y) => { root.pal-drop(k, x, y); } }
                    PalItem { text: "Ask me"; icon: FxIcons.ask; kind: "ask"; drag(k, l, x, y) => { root.pal-drag(k, l, x, y); } drop(k, x, y) => { root.pal-drop(k, x, y); } }
                    PalItem { text: "Wait"; icon: Icons.clock; kind: "wait"; drag(k, l, x, y) => { root.pal-drag(k, l, x, y); } drop(k, x, y) => { root.pal-drop(k, x, y); } }
                    FxNote { kind: "hint"; text: "Drag onto the canvas, or tap to add. Connect an output (bottom) to a step's top. Drag from the side dot of a person to leave a note."; }
                }
            }
            cv := Rectangle {
                horizontal-stretch: 1;
                property <length> ax: self.absolute-position.x;
                property <length> ay: self.absolute-position.y;
                init => { root.cv-x = self.ax; root.cv-y = self.ay; }
                changed ax => { root.cv-x = self.ax; }
                changed ay => { root.cv-y = self.ay; }
                FxCanvas {
                    which: "e"; editable: true;
                    nodes: PlanningFactories.e-nodes; edges: PlanningFactories.e-edges;
                    zoom: PlanningFactories.ed.zoom; pan-x: PlanningFactories.ed.pan-x; pan-y: PlanningFactories.ed.pan-y;
                    minimap: !root.narrow; controls-top: root.narrow;
                    bx: PlanningFactories.ed.bx; by: PlanningFactories.ed.by; bw: PlanningFactories.ed.bw; bh: PlanningFactories.ed.bh;
                    conn: PlanningFactories.ed.conn; conn-path: PlanningFactories.ed.conn-path;
                }
                if PlanningFactories.ed.toast != "": Rectangle {
                    y: parent.height - self.height - Theme.sp-16;
                    width: min(tt.preferred-width + Theme.sp-24, parent.width * Theme.factories-drawer-share);
                    height: tt.preferred-height + Theme.sp-16;
                    border-radius: Theme.r-field; border-width: 1px; border-color: Theme.border; background: Theme.bg-card;
                    tt := Text { x: Theme.sp-12; width: parent.width - Theme.sp-24; text: PlanningFactories.ed.toast; font-size: Theme.text-12; color: Theme.text-primary; wrap: word-wrap; }
                }
            }
            // .ff-right: the tabs and the pane.
            Rectangle {
                width: Theme.factories-right;
                background: Theme.bg-secondary;
                Rectangle { x: 0; width: 1px; background: Theme.border; }
                VerticalLayout {
                    Rectangle {
                        height: tabs.preferred-height;
                        tabs := HorizontalLayout {
                            padding: Theme.sp-6; spacing: Theme.sp-2;
                            for t in [{ id: "edit", ic: FxIcons.sliders, label: "Edit" }, { id: "team", ic: FxIcons.team, label: "Team" }, { id: "issues", ic: FxIcons.alert, label: "" }, { id: "dry", ic: FxIcons.route, label: "Dry run" }]: tb := Rectangle {
                                horizontal-stretch: 1;
                                height: Theme.control-sm + Theme.sp-2;
                                border-radius: Theme.r-control;
                                property <bool> on: PlanningFactories.ed.tab == t.id;
                                property <color> fg: t.id == "issues" && PlanningFactories.ed.issues-bad ? Theme.yellow : self.on || ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                background: self.on || ta.has-hover ? Theme.bg-hover : transparent;
                                HorizontalLayout { alignment: center; spacing: Theme.sp-4;
                                    VerticalLayout { alignment: center; Icon { width: Theme.icon-md; height: Theme.icon-md; source: t.ic; tint: tb.fg; } }
                                    Text { text: t.id == "issues" ? PlanningFactories.ed.issues-label : t.label; font-size: Theme.text-12; vertical-alignment: center; color: tb.fg; }
                                }
                                ta := TouchArea { mouse-cursor: pointer; clicked => { PlanningFactories.act("e-tab", t.id, ""); } }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        for d in PlanningFactories.e-insp: Rectangle {
                            if d.mode == "node": NodeInsp { d: d; }
                            if d.mode == "edge": EdgeInsp { d: d; }
                            if d.mode == "settings": SettingsInsp { d: d; }
                            if d.mode == "team": TeamInsp { d: d; }
                            if d.mode == "person": PersonInsp { d: d; }
                            if d.mode == "issues": IssuesInsp { d: d; }
                            if d.mode == "dry": DryInsp { d: d; }
                        }
                    }
                }
            }
        }
    }
    // The palette item being dragged.
    if root.drag-kind != "": Rectangle {
        x: root.drag-x + Theme.sp-8; y: root.drag-y + Theme.sp-8;
        width: dl.preferred-width + Theme.sp-20; height: Theme.control-sm;
        border-radius: Theme.r-field; background: Theme.bg-card; border-width: 1px; border-color: Theme.accent;
        dl := Text { text: root.drag-label; font-size: Theme.text-12; color: Theme.text-primary; }
    }
}
