// Factories (4.7, 4.8): the factories tab, the factory panel, the run graph.
// The web's app/vendor/crundi-factories.js: mountTab (the head with
// Library / Runs / Cleanup and its actions; the library's cards and the
// templates; the runs; the leftovers) and mountPanel (the project's
// Factory panel: the live graph while a run is going, else the start, the
// earlier runs and the triggers); the editor and the live graph
// (factory-flow.js) are factories-editor.slint and factories-viewer.slint;
// the dialogs factories-dialogs.slint. Driven by src/planning/factories.rs.

import { Theme, Icons, Icon, ScrollThumb, EmptyState, LoadingState, CheckRow, TextField } from "../kit.slint";
import { PlanningFactories, PlanningFxCard, PlanningFxTpl, PlanningFxRun, PlanningFxClean } from "factories-api.slint";
import { FxBtn, FxChip, FxSeg, FxNote, FxSummary, FxIcons } from "factories-parts.slint";
import { FxViewer } from "factories-viewer.slint";
import { FxEditor } from "factories-editor.slint";
import { FxDialogs } from "factories-dialogs.slint";

/// A scrolling column (the .fx-body / .fx-panel).
component FxScroll inherits Rectangle {
    in property <length> pad: Theme.sp-16;
    in property <length> gap: Theme.sp-12;
    out property <length> inner-w: fl.width - 2 * root.pad;
    fl := Flickable {
        width: parent.width; height: parent.height;
        content-height: max(self.height, col.preferred-height);
        col := VerticalLayout {
            width: fl.width;
            padding: root.pad;
            spacing: root.gap;
            alignment: start;
            @children
        }
    }
    ScrollThumb { width: root.width; height: root.height; view-h: fl.height; content-h: fl.content-height; offset: -fl.content-y; }
}

/// A factory's card in the Library (.fx-card).
component FactoryCard inherits Rectangle {
    in property <PlanningFxCard> f;
    background: Theme.bg-card;
    border-radius: Theme.r-card;
    border-width: 1px;
    border-color: Theme.border;
    property <bool> wide: self.width - Theme.sp-32 >= b1.want + b2.want + b3.want + b4.want + b5.want + Theme.sp-24;
    VerticalLayout {
        padding-top: Theme.sp-12; padding-bottom: Theme.sp-12; padding-left: Theme.sp-16; padding-right: Theme.sp-16;
        spacing: Theme.sp-8;
        HorizontalLayout {
            spacing: Theme.sp-8;
            Text { horizontal-stretch: 1; text: root.f.name; font-size: Theme.text-14; font-weight: Theme.w-semibold; color: Theme.text-primary; overflow: elide; vertical-alignment: center; }
            VerticalLayout { alignment: center; FxChip { text: root.f.chip; tone: root.f.runnable ? "ok" : "warn"; } }
        }
        Text { text: root.f.desc; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; overflow: elide; height: 2 * Theme.text-12 * Theme.lh-ui + Theme.sp-6; vertical-alignment: top; }
        Text { text: root.f.meta; font-size: Theme.text-11; color: Theme.text-muted; overflow: elide; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: Theme.sp-6; alignment: start;
            b1 := FxBtn { text: "Edit"; kind: "primary"; has-icon: true; icon: Icons.pencil; clicked => { PlanningFactories.act("edit", root.f.id, ""); } }
            b2 := FxBtn { text: "Start"; has-icon: true; icon: Icons.play; enabled: root.f.runnable; clicked => { PlanningFactories.act("start-one", root.f.id, ""); } }
            b3 := FxBtn { text: "Copy"; kind: "ghost"; has-icon: true; icon: Icons.copy; clicked => { PlanningFactories.act("copy", root.f.id, ""); } }
            if root.wide: HorizontalLayout { spacing: Theme.sp-6;
                FxBtn { text: "Export"; kind: "ghost"; has-icon: true; icon: Icons.download; clicked => { PlanningFactories.act("export", root.f.id, ""); } }
                FxBtn { text: "Delete"; kind: "ghost-danger"; has-icon: true; icon: Icons.trash; clicked => { PlanningFactories.act("delete", root.f.id, ""); } }
            }
        }
        // The row wraps (flex-wrap) when the card is narrow.
        if !root.wide: HorizontalLayout {
            spacing: Theme.sp-6; alignment: start;
            FxBtn { text: "Export"; kind: "ghost"; has-icon: true; icon: Icons.download; clicked => { PlanningFactories.act("export", root.f.id, ""); } }
            FxBtn { text: "Delete"; kind: "ghost-danger"; has-icon: true; icon: Icons.trash; clicked => { PlanningFactories.act("delete", root.f.id, ""); } }
        }
    }
    // Measures for the wrap (never drawn).
    b4 := FxBtn { visible: false; text: "Export"; kind: "ghost"; has-icon: true; icon: Icons.download; }
    b5 := FxBtn { visible: false; text: "Delete"; kind: "ghost"; has-icon: true; icon: Icons.trash; }
}

/// A provided template (.fx-card.fx-tpl).
component TemplateCard inherits Rectangle {
    in property <PlanningFxTpl> t;
    background: Theme.bg-card;
    border-radius: Theme.r-card;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding-top: Theme.sp-12; padding-bottom: Theme.sp-12; padding-left: Theme.sp-16; padding-right: Theme.sp-16;
        spacing: Theme.sp-8;
        HorizontalLayout {
            spacing: Theme.sp-8;
            Text { horizontal-stretch: 1; text: root.t.name; font-size: Theme.text-14; font-weight: Theme.w-semibold; color: Theme.text-primary; overflow: elide; vertical-alignment: center; }
            VerticalLayout { alignment: center; FxChip { text: "Template"; } }
        }
        Text { text: root.t.good-for; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; overflow: elide; height: min(self.preferred-height, (Theme.text-12 + Theme.text-12 + Theme.text-12) * Theme.lh-ui + Theme.sp-8); }
        Text { text: root.t.description; font-size: Theme.text-11; color: Theme.text-muted; wrap: word-wrap; }
        Text { text: "Team: Manager, " + root.t.team; font-size: Theme.text-11; color: Theme.text-muted; wrap: word-wrap; }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout { alignment: start;
            FxBtn { text: "Use this"; kind: "primary"; has-icon: true; icon: Icons.copy; enabled: !root.t.busy; clicked => { PlanningFactories.act("use-template", root.t.id, ""); } }
        }
    }
}

/// A run row (.fx-run): name (and project), status chip, task, meta.
export component RunRow inherits Rectangle {
    in property <PlanningFxRun> r;
    in property <bool> with-project;
    callback clicked();
    background: Theme.bg-card;
    border-radius: Theme.r-card;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.accent : Theme.border;
    opacity: root.r.off ? Theme.o-soft : 1;
    height: lay.preferred-height;
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    lay := VerticalLayout {
        padding-top: Theme.sp-10; padding-bottom: Theme.sp-10; padding-left: Theme.sp-12; padding-right: Theme.sp-12;
        spacing: Theme.sp-6;
        HorizontalLayout {
            spacing: Theme.sp-8;
            HorizontalLayout {
                horizontal-stretch: 1; spacing: Theme.sp-4;
                Text { text: root.r.name; font-size: Theme.text-13; font-weight: Theme.w-semibold; color: Theme.text-primary; overflow: elide; vertical-alignment: center; }
                if root.with-project: Text { text: "in " + root.r.project; font-size: Theme.text-11; color: Theme.text-muted; vertical-alignment: center; overflow: elide; }
                if root.r.tag1 != "": VerticalLayout { alignment: center; FxChip { text: root.r.tag1; } }
                if root.r.tag2 != "": VerticalLayout { alignment: center; FxChip { text: root.r.tag2; } }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.r.chip != "": VerticalLayout { alignment: center; FxChip { text: root.r.chip; tone: root.r.tone; } }
        }
        if root.r.task != "": Text { text: root.r.task; font-size: Theme.text-12; color: Theme.text-secondary; overflow: elide; }
        if root.r.meta != "": Text { text: root.r.meta; font-size: Theme.text-11; color: Theme.text-muted; overflow: elide; }
    }
}

/// Cleanup: what was kept, auto-delete, the table, Delete selected.
component CleanupBody inherits VerticalLayout {
    spacing: Theme.sp-10;
    FxNote { text: "Merging and discarding clean up after themselves. What is listed here was kept: stopped runs, kept branches, and folders no run knows about. Nothing is deleted unless you choose to."; }
    HorizontalLayout {
        spacing: Theme.sp-8;
        VerticalLayout { alignment: center; Text { text: "Delete leftovers older than"; font-size: Theme.text-12; color: Theme.text-muted; } }
        days := TextField {
            width: Theme.factories-days-w;
            text: PlanningFactories.clean-days;
            property <int> g: PlanningFactories.clean-gen;
            changed g => { self.text = PlanningFactories.clean-days; }
            accepted(v) => { PlanningFactories.edit("cleanup", "days", v); }
            changed has-focus => { if !self.has-focus { PlanningFactories.edit("cleanup", "days", self.text); } }
        }
        VerticalLayout { alignment: center; horizontal-stretch: 1;
            Text { text: "days automatically (0 = never; never one with uncommitted work, never a kept branch)."; font-size: Theme.text-12; color: Theme.text-muted; wrap: word-wrap; }
        }
    }
    if PlanningFactories.clean.length == 0: FxNote { text: "Nothing to clean up."; }
    if PlanningFactories.clean.length > 0: Rectangle {
        height: tbl.preferred-height;
        tbl := VerticalLayout {
            // head
            HorizontalLayout {
                padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
                spacing: Theme.sp-12;
                Rectangle { width: Theme.sp-16; }
                Text { horizontal-stretch: 1; text: "What"; font-size: Theme.text-11; color: Theme.text-muted; font-weight: Theme.w-medium; }
                Text { width: Theme.sp-48 + Theme.sp-24; text: "Size"; font-size: Theme.text-11; color: Theme.text-muted; font-weight: Theme.w-medium; }
                Text { width: Theme.sp-40; text: "Age"; font-size: Theme.text-11; color: Theme.text-muted; font-weight: Theme.w-medium; }
            }
            Rectangle { height: 1px; background: Theme.border; }
            for it in PlanningFactories.clean: VerticalLayout {
                HorizontalLayout {
                    padding-top: Theme.sp-8; padding-bottom: Theme.sp-8;
                    spacing: Theme.sp-12;
                    VerticalLayout { alignment: start; padding-top: Theme.sp-2;
                        CheckRow { width: Theme.sp-16; checked: it.picked; text: ""; toggled(v) => { PlanningFactories.edit("cleanup", "pick:" + it.id, v ? "1" : "0"); } }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: Theme.sp-2;
                        Text { text: it.title; font-size: Theme.text-12; font-weight: Theme.w-semibold; color: Theme.text-primary; wrap: word-wrap; }
                        Text { text: it.meta; font-size: Theme.text-11; color: Theme.text-muted; wrap: word-wrap; }
                        Text { text: it.why; font-size: Theme.text-11; color: Theme.text-muted; wrap: word-wrap; }
                        if it.warn != "": VerticalLayout { padding-top: Theme.sp-4; FxNote { kind: "warn"; text: it.warn; } }
                    }
                    Text { width: Theme.sp-48 + Theme.sp-24; text: it.size; font-size: Theme.text-12; color: Theme.text-primary; }
                    Text { width: Theme.sp-40; text: it.age; font-size: Theme.text-12; color: Theme.text-primary; }
                }
                Rectangle { height: 1px; background: Theme.border; }
            }
        }
    }
    if PlanningFactories.clean.length > 0: HorizontalLayout { alignment: start;
        FxBtn { text: "Delete selected"; kind: "danger"; has-icon: true; icon: Icons.trash; clicked => { PlanningFactories.act("cleanup-delete", "", ""); } }
    }
}

/// The Factories tab's own page: the head and the view on show.
component FactoriesTab inherits Rectangle {
    background: Theme.bg-primary;
    property <bool> narrow: root.width < Theme.dock-narrow;
    VerticalLayout {
        // .fx-head
        Rectangle {
            height: head.preferred-height;
            head := HorizontalLayout {
                padding-left: root.narrow ? Theme.sp-10 : Theme.sp-16; padding-right: root.narrow ? Theme.sp-10 : Theme.sp-16;
                padding-top: Theme.sp-10; padding-bottom: Theme.sp-10;
                spacing: Theme.sp-8;
                Text { text: "Factories"; font-size: Theme.text-15; font-weight: Theme.w-semibold; color: Theme.text-primary; vertical-alignment: center; }
                VerticalLayout { alignment: center;
                    FxSeg {
                        options: ["Library", "Runs", "Cleanup"];
                        selected: PlanningFactories.view == "runs" ? 1 : PlanningFactories.view == "cleanup" ? 2 : 0;
                        picked(i) => { PlanningFactories.act("view", i == 1 ? "runs" : i == 2 ? "cleanup" : "library", ""); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if PlanningFactories.view == "library": HorizontalLayout {
                    spacing: Theme.sp-6;
                    VerticalLayout { alignment: center; FxBtn { text: "Start one"; has-icon: true; icon: Icons.play; fold: root.narrow; clicked => { PlanningFactories.act("start-one", "", ""); } } }
                    VerticalLayout { alignment: center; FxBtn { text: "Import"; kind: "ghost"; has-icon: true; icon: Icons.upload; fold: root.narrow; clicked => { PlanningFactories.act("import", "", ""); } } }
                    VerticalLayout { alignment: center; FxBtn { text: "New factory"; kind: "primary"; has-icon: true; icon: Icons.plus; fold: root.narrow; clicked => { PlanningFactories.act("new", "", ""); } } }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        // .fx-body
        if PlanningFactories.view == "library": FxScroll {
            vertical-stretch: 1;
            pad: root.narrow ? Theme.sp-10 : Theme.sp-16;
            changed width => { PlanningFactories.cv-size("lib", self.inner-w, self.height); }
            init => { PlanningFactories.cv-size("lib", self.inner-w, self.height); }
            if PlanningFactories.lib-loading: FxNote { text: "Loading…"; }
            if !PlanningFactories.lib-loading && PlanningFactories.lib-empty: FxNote {
                text: "No factories of your own yet. A factory is a team: a Manager who owns the change request and employees with personas, wired together as a flow of steps and decisions. Start from one of the templates below, build your own with New factory, or ask any Claude chat to build one for you.";
            }
            for row in PlanningFactories.factories: HorizontalLayout {
                spacing: Theme.sp-12;
                for c in row.cards: VerticalLayout {
                    width: (parent.width - (PlanningFactories.lib-cols - 1) * Theme.sp-12) / max(1, PlanningFactories.lib-cols);
                    if c.id != "": FactoryCard { vertical-stretch: 1; f: c; }
                }
            }
            if !PlanningFactories.lib-loading && PlanningFactories.templates.length > 0: VerticalLayout {
                padding-top: Theme.sp-8; padding-bottom: Theme.sp-2;
                spacing: Theme.sp-2;
                Text { text: "Templates"; font-size: Theme.text-14; font-weight: Theme.w-bold; color: Theme.text-primary; }
                Text { text: "Modelled on how real teams work. Use one as it is, copy it and change it to fit how your team works, or build your own from scratch."; font-size: Theme.text-12; color: Theme.text-secondary; wrap: word-wrap; }
            }
            for row in PlanningFactories.templates: HorizontalLayout {
                spacing: Theme.sp-12;
                for c in row.cards: VerticalLayout {
                    width: (parent.width - (PlanningFactories.lib-cols - 1) * Theme.sp-12) / max(1, PlanningFactories.lib-cols);
                    if c.id != "": TemplateCard { vertical-stretch: 1; t: c; }
                }
            }
        }
        if PlanningFactories.view == "runs": FxScroll {
            vertical-stretch: 1;
            pad: root.narrow ? Theme.sp-10 : Theme.sp-16;
            gap: Theme.sp-8;
            if PlanningFactories.runs-loading: FxNote { text: ""; }
            if !PlanningFactories.runs-loading && PlanningFactories.runs.length == 0: FxNote { text: "No runs yet. Start a factory from the Library, or from a project's Factory panel."; }
            for r in PlanningFactories.runs: RunRow { r: r; with-project: true; clicked => { PlanningFactories.act("open-run", r.id, ""); } }
        }
        if PlanningFactories.view == "cleanup": FxScroll {
            vertical-stretch: 1;
            pad: root.narrow ? Theme.sp-10 : Theme.sp-16;
            gap: Theme.sp-10;
            if PlanningFactories.clean-loading: FxNote { text: "Looking for leftovers…"; }
            if !PlanningFactories.clean-loading: CleanupBody { }
        }
    }
}

/// The project's Factory panel when no run is going (.fx-panel).
component PanelIdle inherits FxScroll {
    pad: Theme.sp-12;
    gap: Theme.sp-10;
    FxNote { text: "A factory is a team of Claude employees, run by a Manager, that takes a large piece of work from start to finish in its own worktree. One runs at a time per project."; }
    HorizontalLayout { alignment: start;
        FxBtn { text: "Start a factory"; kind: "primary"; has-icon: true; icon: Icons.play; clicked => { PlanningFactories.act("panel-start", "", ""); } }
    }
    if PlanningFactories.earlier.length > 0: FxSummary {
        text: "Earlier runs (" + PlanningFactories.earlier.length + ")";
        open: PlanningFactories.earlier-open;
        toggled => { PlanningFactories.earlier-open = !PlanningFactories.earlier-open; }
    }
    if PlanningFactories.earlier.length > 0 && PlanningFactories.earlier-open: VerticalLayout {
        spacing: Theme.sp-8;
        for r in PlanningFactories.earlier: RunRow { r: r; clicked => { PlanningFactories.act("open-run", r.id, ""); } }
    }
    if PlanningFactories.triggers-loaded: VerticalLayout {
        padding-top: Theme.sp-2;
        FxSummary {
            text: "Triggers" + (PlanningFactories.triggers.length > 0 ? " (" + PlanningFactories.triggers.length + ")" : "") + ": start a run by itself";
            open: PlanningFactories.triggers-open;
            toggled => { PlanningFactories.triggers-open = !PlanningFactories.triggers-open; }
        }
    }
    if PlanningFactories.triggers-loaded && PlanningFactories.triggers-open: VerticalLayout {
        spacing: Theme.sp-8;
        if PlanningFactories.triggers.length == 0: FxNote { text: "Start a factory at a time of day, when a kanban card enters a column, or when a webhook is called (CI, an issue tracker). The change request is filled in from the card or the call."; }
        for r in PlanningFactories.triggers: RunRow { r: r; clicked => { PlanningFactories.act("trigger", r.id, ""); } }
        HorizontalLayout { alignment: start;
            FxBtn { text: "Add a trigger"; has-icon: true; icon: Icons.plus; clicked => { PlanningFactories.act("trigger", "", ""); } }
        }
    }
}

/// The screen: `kind` the tab id or pane kind, `key` the pane's key ("" in a tab).
export component FactoriesView inherits Rectangle {
    in property <string> kind;
    in property <string> key;
    in property <bool> embedded;
    background: Theme.bg-primary;
    if root.kind == "factories": Rectangle {
        if PlanningFactories.sub == "": FactoriesTab { }
        if PlanningFactories.sub == "loading": VerticalLayout { alignment: start; padding: Theme.sp-24; FxNote { text: "Loading…"; } }
        if PlanningFactories.sub == "error": VerticalLayout {
            alignment: start; padding: Theme.sp-16; spacing: Theme.sp-10;
            FxNote { kind: "err"; text: PlanningFactories.sub-error; }
            HorizontalLayout { alignment: start; FxBtn { text: "Back"; clicked => { PlanningFactories.act("sub-back", "", ""); } } }
        }
        if PlanningFactories.sub == "viewer": FxViewer { }
        if PlanningFactories.sub == "editor": FxEditor { }
    }
    if root.kind == "factory": Rectangle {
        if PlanningFactories.panel == "loading": LoadingState { }
        if PlanningFactories.panel == "idle": PanelIdle { }
        if PlanningFactories.panel == "live": FxViewer { }
    }
}

/// This screen's dialogs and popovers over the window; no input where it draws nothing.
export component FactoriesOverlay inherits Rectangle {
    FxDialogs { width: root.width; height: root.height; }
}
