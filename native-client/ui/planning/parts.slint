// Parts the planning screens share (Kanban, Mind map, Notes, Schedules,
// Factories): the web's .kanban-btn, the drawn checkbox, a bare text line.

import { Theme, Icons, Icon } from "../kit.slint";

/// The web's .kanban-btn: quiet (bg-tertiary, border), `primary` (accent),
/// `toggled` (accent-dim, accent border: the view on show). An icon before
/// the label; `fold` hides the label (a narrow panel), the icon stays.
export component KBtn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> primary;
    in property <bool> toggled;
    in property <bool> fold;
    in property <bool> enabled: true;
    callback clicked();
    height: Theme.control-sm;
    width: lay.preferred-width;
    border-radius: Theme.r-control;
    border-width: 1px;
    property <bool> hot: ta.has-hover && root.enabled;
    background: root.primary ? (root.hot ? Theme.accent-hover : Theme.accent)
        : root.toggled ? Theme.accent-dim
        : root.hot ? Theme.bg-hover : Theme.bg-tertiary;
    border-color: root.primary || root.toggled ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1 : Theme.o-dim;
    property <color> fg: root.primary ? Theme.white : root.toggled ? Theme.accent-hover : Theme.text-primary;
    accessible-role: button;
    accessible-label: root.text;
    lay := HorizontalLayout {
        padding-left: root.fold ? Theme.sp-8 : Theme.sp-12;
        padding-right: root.fold ? Theme.sp-8 : Theme.sp-12;
        spacing: Theme.sp-4;
        if root.has-icon: VerticalLayout { alignment: center; Icon { width: Theme.icon-md; height: Theme.icon-md; source: root.icon; tint: root.fg; } }
        if !root.fold || !root.has-icon: Text { text: root.text; vertical-alignment: center; font-size: root.fold ? Theme.text-12 : Theme.text-13; color: root.fg; }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// The subtask's drawn checkbox (.kanban-todo input[type=checkbox]): a
/// rounded box, accent with a white check when done; the accent edge on
/// hover.
export component KCheck inherits Rectangle {
    in property <bool> checked;
    in property <bool> ghost;
    callback toggled(bool);
    width: Theme.sp-16; height: Theme.sp-16;
    border-radius: Theme.r-chip;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : ta.has-hover && !root.ghost ? Theme.accent-hover : Theme.slate-edge;
    background: root.checked ? Theme.accent : root.ghost ? transparent : Theme.bg-primary;
    if root.ghost: Rectangle { border-radius: Theme.r-chip; background: Theme.bg-tertiary; }
    if root.checked: Icon { source: Icons.check; width: Theme.icon-sm; height: Theme.icon-sm; tint: Theme.white; }
    ta := TouchArea { enabled: !root.ghost; mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
}

/// A small quiet button with an icon and maybe a label (a card's footer and
/// action row: .card-foot button, .card-actions button). `on`: the accent
/// look (the open menu); `danger`: red on hover; `square`: icon only.
export component CardBtn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> tip;
    in property <bool> on;
    in property <bool> danger;
    in property <bool> square;
    callback clicked();
    height: Theme.sp-24 + Theme.sp-2;
    width: root.square ? Theme.sp-24 + Theme.sp-4 : lay.preferred-width;
    border-radius: Theme.r-control;
    border-width: 1px;
    property <bool> hot: ta.has-hover;
    background: root.on ? Theme.accent-dim : root.hot ? (root.danger ? Theme.red-dim : Theme.bg-tertiary) : transparent;
    border-color: root.on ? Theme.accent : root.hot ? (root.danger ? Theme.red : Theme.slate-edge) : Theme.border;
    property <color> fg: root.on ? Theme.accent-hover : root.hot ? (root.danger ? Theme.red : Theme.text-primary) : Theme.text-secondary;
    accessible-role: button;
    accessible-label: root.tip != "" ? root.tip : root.text;
    lay := HorizontalLayout {
        padding-left: root.square ? 0 : Theme.sp-8;
        padding-right: root.square ? 0 : Theme.sp-8;
        spacing: Theme.sp-4;
        alignment: center;
        VerticalLayout { alignment: center; Icon { width: Theme.icon-md; height: Theme.icon-md; source: root.icon; tint: root.fg; } }
        if !root.square && root.text != "": Text { text: root.text; vertical-alignment: center; font-size: Theme.text-12; font-weight: Theme.w-medium; color: root.fg; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
