// Schedules and webhooks (4.5, 4.6): the schedule tab: the globals and structs Rust uses (src/planning/schedule.rs).
// Export every global and struct Rust needs by adding its name to this
// screen's line in ui/planning/api.slint (`export { ... } from "schedule-api.slint";`).

/// A schedule in the list (.sched-item): its power, name (and project chip
/// when all projects show), the action's summary, the when chip and the
/// extra conditions' chips, and "last run …" ("" for never).
export struct PlanningSched {
    id: string,
    name: string,
    project: string,
    enabled: bool,
    summary: string,
    when: string,
    conds: [string],
    last: string,
}

/// An extra condition's row in the dialog (.sm-cond). `kind`: usage,
/// terminals or kanban. `title` the row's label (5h usage, Weekly usage,
/// Open terminals, Kanban). Usage and terminals: `op` (below, above,
/// equal) and `value`. Kanban: the task (0 = "— pick task —"), the
/// subtask (0 = "whole task") with its options, and the status with its
/// options (the board's columns, or done/pending for a subtask).
export struct PlanningSchedCond {
    kind: string,
    title: string,
    op: int,
    value: string,
    task: int,
    todo: int,
    todo-opts: [string],
    status: int,
    status-opts: [string],
}

export global PlanningSchedule {
    // ── The list (#schedule-panel) ──
    /// "loading", "error", "ok".
    in-out property <string> state: "loading";
    in-out property <string> error;
    /// A project is open: the filter button shows.
    in-out property <bool> has-project;
    /// true: this project only ("This project"); false: "All projects".
    in-out property <bool> filter: true;
    in-out property <string> empty-text: "No scheduled tasks";
    in-out property <[PlanningSched]> items;
    // add, filter, edit, delete, enable (with the schedule's id).
    callback act(string, string);

    // ── The add/edit dialog (#sched-modal) ──
    in-out property <bool> open;
    in-out property <bool> editing;
    // Bumped when the dialog opens, so its first field takes the caret.
    in-out property <int> gen;
    in-out property <string> name;
    in-out property <[string]> project-opts;
    in-out property <int> project;
    /// once | recurring | webhook
    in-out property <string> when-mode: "recurring";
    in-out property <string> date;
    in-out property <string> time: "09:00";
    in-out property <[bool]> days;
    // The webhook ("When called"): key | signature, the headers, the
    // idempotency key; once saved its URL (and secret when signed).
    in-out property <string> hook-auth: "key";
    in-out property <string> sig-header;
    in-out property <string> ts-header;
    in-out property <string> idem;
    in-out property <string> hook-url;
    in-out property <string> hook-secret;
    // agent | chat | command | service
    in-out property <string> kind: "agent";
    in-out property <string> agent: "claude";
    in-out property <[string]> model-opts;
    in-out property <int> model;
    in-out property <[string]> effort-opts;
    in-out property <int> effort;
    // normal | skip
    in-out property <string> mode: "normal";
    // new | continue | resume
    in-out property <string> session: "new";
    in-out property <string> session-id;
    // Its first 8 characters (the web's "Resuming 8441d374…").
    in-out property <string> session-short;
    in-out property <bool> provisioning;
    in-out property <string> prompt;
    in-out property <string> cwd;
    in-out property <string> cwd-hint;
    in-out property <string> command;
    in-out property <[string]> service-opts;
    in-out property <int> service;
    in-out property <bool> has-services;
    // start | stop | toggle
    in-out property <string> op: "start";
    in-out property <[PlanningSchedCond]> conds;
    in-out property <[string]> task-opts;

    // A segment: whenmode, hookauth, kind, agent, mode, session, op.
    callback seg(string, string);
    callback day(int);
    // A drop-down: project, model, effort, service.
    callback pick(string, int);
    // A condition's drop-down (row, op | task | todo | status, index) and its number.
    callback cond-pick(int, string, int);
    callback cond-value(int, string);
    // usage | usage-week | terminals | kanban
    callback add-cond(string);
    callback remove-cond(int);
    callback save();
    callback close();
    callback provision();
    callback rotate();
}
