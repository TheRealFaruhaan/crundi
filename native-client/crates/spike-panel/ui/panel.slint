// Spike: a screen compiled in its own crate, embedded through ComponentContainer.
export global PanelState {
    in-out property <int> clicks;
    in-out property <string> typed;
    in-out property <string> last-key;
    in-out property <bool> popup-shown;
    in-out property <int> popup-clicks;
    in-out property <[string]> rows;
    in-out property <length> scroll;
    in-out property <length> abs-x;
    // Where this instance's container sits in the window (set from Rust):
    // a compiled root has no parent, so its absolute positions are its own.
    in-out property <length> origin-x;
    in-out property <length> origin-y;
    callback hook(string) -> string;
}

export component SpikePanel inherits Window {
    background: #202040;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        btn := Rectangle {
            height: 30px;
            background: ta.pressed ? #aa0000 : #444444;
            Text { text: "Click " + PanelState.clicks; color: white; }
            ta := TouchArea { clicked => { PanelState.clicks += 1; PanelState.abs-x = PanelState.origin-x + self.absolute-position.x; } }
        }
        Rectangle {
            height: 24px;
            background: #303030;
            ti := TextInput { text <=> PanelState.typed; color: white; }
        }
        fs := FocusScope {
            height: 24px;
            key-pressed(e) => { PanelState.last-key = e.text; return accept; }
            Rectangle { background: fs.has-focus ? #006600 : #303030; }
            TouchArea { clicked => { fs.focus(); } }
        }
        Rectangle {
            height: 30px;
            background: #666666;
            Text { text: "popup"; color: white; }
            TouchArea { clicked => { pop.show(); } }
        }
        fl := Flickable {
            height: 90px;
            content-height: 30px * PanelState.rows.length;
            for r[i] in PanelState.rows: Text { y: i * 30px; height: 30px; text: r; color: white; }
        }
    }
    property <length> sy: fl.content-y;
    changed sy => { PanelState.scroll = -fl.content-y; }
    pop := PopupWindow {
        x: PanelState.origin-x + 40px; y: PanelState.origin-y + 40px; width: 120px; height: 60px;
        init => { PanelState.popup-shown = true; }
        Rectangle { background: #00cc00; TouchArea { clicked => { PanelState.popup-clicks += 1; } } }
    }
    public function focus-text() { ti.focus(); }
}
