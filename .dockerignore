# Keep the build context small and free of anything host-specific.
node_modules
dist
.git
.github
data
*.log
.env
crundi_attachments
app/main.js
app/preload.js
app/index.html
# NOT assets/ - the server serves the logo, favicons and PWA icons from
# there, and without them every /assets/* is a 404 and the app cannot be
# installed to a home screen.
build
