<?xml version="1.0" encoding="utf-8"?>
<!-- The chat's video player (ui/chats/MediaPlayer.kt VideoViewer). A TextureView
     surface, unlike the default SurfaceView, can be scaled and moved, which is
     how pinch to zoom works on the picture without scaling the controls. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:show_buffering="when_playing" />
