{
  "ok": true,
  "factory": {
    "id": "fac_pair",
    "name": "Pair and review",
    "description": "One developer builds; a reviewer with fresh eyes approves or sends it back with findings. The simplest team that still has a second pair of eyes.",
    "version": 3,
    "createdAt": "2026-10-20T09:00:00.000Z",
    "updatedAt": "2026-10-23T18:30:00.000Z",
    "settings": {
      "managerMode": "normal",
      "mergeMode": "ask",
      "setupCommand": "",
      "autoRecover": false,
      "teamMode": "ask",
      "presets": [
        "git-read",
        "tests"
      ],
      "rules": [],
      "managerRules": true,
      "crTemplate": [
        {
          "id": "goal",
          "label": "Goal",
          "hint": "Why this change, and what it should achieve. One or two sentences.",
          "required": true,
          "list": false
        },
        {
          "id": "current",
          "label": "Current situation",
          "hint": "What exists or happens today, and what is wrong or missing. For a new project: what there is to start from.",
          "required": false,
          "list": false
        },
        {
          "id": "expected",
          "label": "Expected result",
          "hint": "What it should do when finished: behaviour, screens, data, APIs. Concrete examples help.",
          "required": true,
          "list": false
        },
        {
          "id": "done",
          "label": "Done when",
          "hint": "One check per line. The reviewers hold the work to these, and the Manager finishes only when they all pass.",
          "required": true,
          "list": true
        },
        {
          "id": "scope",
          "label": "Out of scope",
          "hint": "What not to do or touch, one per line.",
          "required": false,
          "list": true
        },
        {
          "id": "notes",
          "label": "Constraints and references",
          "hint": "Tech to use or avoid, conventions, links, anything the team should know.",
          "required": false,
          "list": false
        }
      ],
      "limits": {
        "pauseAt5h": 100,
        "pauseAtWeek": 100,
        "maxParallel": 0,
        "oneAtATimeAbove": 0
      },
      "tickMinutes": 0,
      "secrets": [],
      "gatekeeper": {
        "enabled": false,
        "model": "haiku"
      },
      "caps": {
        "maxHandoffs": 200,
        "maxMinutes": 480,
        "tokenBudget": 0
      }
    },
    "roster": [
      {
        "id": "manager",
        "name": "Manager",
        "persona": "You lead the team like a good engineering manager: you make sure the change request is understood before work starts (ask the person when it is not), give each person what they need, keep the work moving, and only finish when every \"Done when\" check is met and the reviewers are satisfied. When something goes wrong you decide; you do not do the work yourself.",
        "model": "",
        "effort": "",
        "memory": "keep",
        "tools": {
          "allow": [],
          "deny": []
        },
        "skills": [],
        "presets": []
      },
      {
        "id": "dev",
        "name": "Developer",
        "persona": "You are a developer working across the whole project. Make the change the change request asks for, in the project's existing style, with tests where the project has them. Run the tests before you hand off and say what you ran.",
        "model": "",
        "effort": "",
        "memory": "keep",
        "tools": {
          "allow": [],
          "deny": []
        },
        "skills": [
          "crundi"
        ],
        "presets": []
      },
      {
        "id": "rev",
        "name": "Reviewer",
        "persona": "You review the team's change with fresh eyes. Read the diff against where the run started, check it meets the change request's \"Done when\" checks, and look for bugs, missing edge cases and anything that breaks existing behaviour. File each problem as a finding; blocking only for what you would not ship. Check last round's findings before raising new ones. You do not edit code.",
        "model": "",
        "effort": "",
        "memory": "fresh",
        "tools": {
          "allow": [],
          "deny": [
            "Edit",
            "Write",
            "MultiEdit",
            "NotebookEdit"
          ]
        },
        "skills": [],
        "presets": []
      }
    ],
