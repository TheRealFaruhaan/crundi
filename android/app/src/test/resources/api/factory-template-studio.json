  "ok": true,
  "factory": {
    "id": "fac_studio",
    "name": "Design studio",
    "description": "A designer makes a working mock-up, a frontend developer builds to it, a UI reviewer checks it in a real browser on phone and desktop, and you sign it off before it is finished.",
    "version": 3,
    "createdAt": "2026-10-20T09:00:00.000Z",
    "updatedAt": "2026-10-23T18:30:00.000Z",
    "settings": {
      "managerMode": "normal",
      "mergeMode": "ask",
      "setupCommand": "",
      "autoRecover": false,
      "teamMode": "ask",
      "presets": [
        "git-read",
        "tests"
      ],
      "rules": [],
      "managerRules": true,
      "crTemplate": [
        {
          "id": "goal",
          "label": "Goal",
          "hint": "Why this change, and what it should achieve. One or two sentences.",
          "required": true,
          "list": false
        },
        {
          "id": "current",
          "label": "Current situation",
          "hint": "What exists or happens today, and what is wrong or missing. For a new project: what there is to start from.",
          "required": false,
          "list": false
        },
        {
          "id": "expected",
          "label": "Expected result",
          "hint": "What it should do when finished: behaviour, screens, data, APIs. Concrete examples help.",
          "required": true,
          "list": false
        },
        {
          "id": "done",
          "label": "Done when",
          "hint": "One check per line. The reviewers hold the work to these, and the Manager finishes only when they all pass.",
          "required": true,
          "list": true
        },
        {
          "id": "scope",
          "label": "Out of scope",
          "hint": "What not to do or touch, one per line.",
          "required": false,
          "list": true
        },
        {
          "id": "notes",
          "label": "Constraints and references",
          "hint": "Tech to use or avoid, conventions, links, anything the team should know.",
          "required": false,
          "list": false
        }
      ],
      "limits": {
        "pauseAt5h": 100,
        "pauseAtWeek": 100,
        "maxParallel": 0,
        "oneAtATimeAbove": 0
      },
      "tickMinutes": 0,
      "gatekeeper": {
        "enabled": false,
        "model": "haiku"
      },
      "caps": {
        "maxHandoffs": 200,
        "maxMinutes": 480,
        "tokenBudget": 0
      }
    },
    "roster": [
      {
        "id": "manager",
        "name": "Manager",
        "persona": "You lead the team like a good engineering manager: you make sure the change request is understood before work starts (ask the person when it is not), give each person what they need, keep the work moving, and only finish when every \"Done when\" check is met and the reviewers are satisfied. When something goes wrong you decide; you do not do the work yourself.",
        "model": "",
        "effort": "",
        "memory": "keep",
        "tools": {
          "allow": [],
          "deny": []
        },
        "skills": [],
        "presets": []
      },
      {
        "id": "des",
        "name": "Designer",
        "persona": "You design before anyone builds: the screens, the flow between them, the states (empty, loading, error), type, colour and spacing that fit the product. Produce it as a working HTML mock-up in the shared folder (design/), with notes on what matters and what is flexible, so the developers can build from it. Check it on a phone width as well as desktop.",
        "model": "",
        "effort": "",
        "memory": "keep",
        "tools": {
          "allow": [],
          "deny": []
        },
        "skills": [
          "frontend-design",
          "logo-design"
        ],
        "presets": []
      },
      {
        "id": "fe",
        "name": "Frontend dev",
        "persona": "You are a frontend developer. You build interfaces that match the project's existing style and components, work on narrow phone screens as well as desktop, and handle loading, empty and error states. Check your work in a real browser before you hand off. Keep changes focused on the change request and follow the plan in the shared folder if there is one.",
        "model": "",
        "effort": "",
        "memory": "keep",
        "tools": {
          "allow": [],
          "deny": []
        },
        "skills": [
          "frontend-design",
          "crundi"
        ],
        "presets": []
      },
      {
        "id": "uir",
        "name": "UI reviewer",
        "persona": "You review interface changes in a real browser: layout on desktop and phone widths, consistency with the existing design, empty and error states, and accessibility basics (labels, contrast, keyboard). File each problem as a finding with where it is; blocking only for what you would not ship. You do not edit code.",
        "model": "",
        "effort": "",
        "memory": "fresh",
        "tools": {
          "allow": [],
          "deny": [
            "Edit",
            "Write",
            "MultiEdit",
            "NotebookEdit"
          ]
        },
        "skills": [
          "frontend-design",
          "crundi"
        ],
        "presets": []
      }
    ],
